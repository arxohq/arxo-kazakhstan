    label ru-KZ official "действующие органы правосудия сохраняют полномочия до формирования новых (редакция 1995)";
}
pub relation constitutional_council_acts_until_court_1995() kind institutional {
    label ru-KZ official "Конституционный Совет действует до образования Конституционного Суда (редакция 1995)";
}

// --- Конституционные числа редакции 1995 ----------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert parliamentary_amendment_numerator_1995(4);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert parliamentary_amendment_denominator_1995(5);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_KK")
assert transitional_constitutional_law_years_1995(1);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_KK")
assert transitional_other_law_years_1995(2);

// Неизменяемое ядро ст. 91 п. 2 — перечень ПРЕДМЕТОВ, а не локаторов.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("independence");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("unitarity");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("territorial-integrity");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("form-of-government");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("fundamental-principles");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("presidential-seven-year-term");

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
assert protected_subject_1995("single-presidential-election");

// --- Ст. 90. Вступление в силу ---------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART90_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART90_KK")
assert constitution_day_is_state_holiday_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART90_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART90_KK")
rule Constitution1995InForceOnPublication strict {
    when constitution_1995_referendum_results_published();
    then constitution_1995_in_force();
    label ru-KZ official "Статья 90 пункт 1 (ред. 1995). Конституция вступает в силу со дня официального опубликования результатов референдума с одновременным прекращением действия ранее принятой Конституции";
}

// --- Ст. 91. Изменение Конституции ------------------------------------------

// РАСХОЖДЕНИЕ 1. Парламентский путь с порогом четыре пятых КАЖДОЙ Палаты.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
rule ParliamentaryAmendmentFourFifths1995(
    act: ParliamentaryAmendmentLaw,
    amendment: Amendment,
    senate_yes: Integer,
    senate_all: Integer,
    mazhilis_yes: Integer,
    mazhilis_all: Integer,
) strict {
    when parliamentary_amendment_law(act, amendment)
        and amendment_referendum_declined_by_president(amendment)
        and amendment_senate_votes(act, senate_yes)
        and amendment_senate_total(act, senate_all)
        and amendment_mazhilis_votes(act, mazhilis_yes)
        and amendment_mazhilis_total(act, mazhilis_all)
        and (senate_yes * 5 >= senate_all * 4)
        and (mazhilis_yes * 5 >= mazhilis_all * 4);
    then parliamentary_amendment_adopted_1995(act);
    label ru-KZ official "Статья 91 пункт 1 (ред. 1995). Если Президент отклоняет предложение Парламента о референдуме, Парламент вправе большинством не менее четырёх пятых голосов от общего числа депутатов каждой из Палат принять закон о внесении изменений в Конституцию";
}

// РАСХОЖДЕНИЕ 2. Ядро 1995 задано предметами, а не локаторами статей.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
rule AmendmentViolatesEntrenchedCore1995(amendment: Amendment, subject: Text) strict {
    when protected_subject_1995(subject);
    when amendment_touches_subject(amendment, subject);
    then amendment_violates_entrenched_core_1995(amendment);
    label ru-KZ official "Статья 91 пункт 2 (ред. 1995). Независимость, унитарность, территориальная целостность, форма правления, основополагающие принципы, семилетний срок Президента и однократность его избрания являются неизменными";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
rule EntrenchmentConclusion1995(conclusion: ConstitutionalConclusion, amendment: Amendment) strict {
    when conclusion_for_amendment(conclusion, amendment);
    when conclusion_confirms_article_91_paragraph_2(conclusion);
    then constitutional_court_positive_conclusion_1995(amendment);
    label ru-KZ official "Статья 91 пункт 3 (ред. 1995). Изменения выносятся на референдум или на рассмотрение Парламента при наличии заключения Конституционного Суда об их соответствии требованиям пункта 2";
}

// ИЗМЕРЕНО 30.08.2026: прежняя строгая форма с `not
// amendment_violates_entrenched_core_1995` была МЁРТВОЙ НОРМОЙ — `not` в
// строгом теле требует установленного отрицания (FALSE_ONLY), а установить
// «не посягает» пакету неоткуда: замыкание §70 унарно и на бинарное
// amendment_touches_subject не ложится, негативных фактов пакет не ассертит.
// Голова не выводилась НИ НА ОДНОМ деле (зонд: невинная поправка с
// заключением — NEITHER), и ни один сценарий этого не видел. Каноническая
// форма поражаемого слоя выражает ровно текст 91.3: заключение открывает
// путь, посягательство на ядро 91.2 его поражает.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART91_KK")
rule AmendmentMayBeSubmitted1995(amendment: Amendment) defeasible {
    when constitutional_court_positive_conclusion_1995(amendment);
    then amendment_may_be_submitted_1995(amendment);
    unless amendment_violates_entrenched_core_1995(amendment);
    label ru-KZ official "Статья 91 пункт 3 (ред. 1995). Без положительного заключения Конституционного Суда изменения на референдум и в Парламент не выносятся";
}

// --- Ст. 92. Переходное законодательство -------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART92_KK")
rule OldActsApplyIfCompatible1995(act: LegalAct) defeasible {
    when old_act_predating_1995(act);
    when not contrary_to_1995_constitution(act);
    then old_act_applicable_1995(act);
    label ru-KZ official "Статья 92 пункт 4 (ред. 1995). Действующее на момент вступления Конституции в силу законодательство применяется в части, не противоречащей ей";
}

// --- Ст. 93–99. Однократные переходные положения ------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART93_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART93_KK")
assert language_conditions_duty_declared_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_KK")
assert vice_president_powers_preserved_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART95_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART95_KK")
assert first_senate_split_term_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART96_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART96_KK")
assert cabinet_becomes_government_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART97_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART97_KK")
assert first_constitutional_council_composition_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART98_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART98_KK")
assert existing_justice_bodies_continue_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART99_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART99_KK")
assert constitutional_council_acts_until_court_1995();

// --- Ст. 94-1, 94-2 редакции 1995: правила действия во времени -------------
// Обе статьи адресуют ПРИМЕНЕНИЕ уже действующих норм к определённому кругу
// лиц. Антецедента, вычислимого из дела, у них нет — они сами задают, к кому
// применяется норма. Поэтому это конститутивные факты, а не правила.

pub relation seven_year_term_applies_from_post_2005_election_1995() kind institutional {
    label ru-KZ official "семилетний срок полномочий Президента применяется к лицу, избранному после 2005 года (редакция 1995)";
}
pub relation single_election_rule_applies_prospectively_1995() kind institutional {
    label ru-KZ official "правило о единственном избрании применяется на будущее время (редакция 1995)";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_1_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_1_KK")
assert seven_year_term_applies_from_post_2005_election_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART94_2_KK")
assert single_election_rule_applies_prospectively_1995();

// =========================================================================
// ОСЬ САМОПРИМЕНИМОСТИ СТ. 91 («лазейка Гёделя» в казахстанской редакции,
// 30.08.2026; пара к us.constitution/self-amendment.law).
//
// Перечень ст. 91 п. 2 защищает ПРЕДМЕТЫ, но не называет саму статью 91.
// Гёделевская двухходовка здесь свелась бы к первому же шагу: проходит ли
// фильтр 91.3 поправка, СУЖАЮЩАЯ перечень? Ответ зависит от прочтения,
// которого закреплённый текст не даёт:
//   А) перечень — не предмет: сужение не «касается» защищённых предметов;
//   Б) перечень сам входит в «основополагающие принципы»: его сужение —
//      посягательство на ядро.
// Спор известен доктрине (та же развилка у вечной оговорки 79(3) Основного
// закона ФРГ) и решается не формализатором: обе стороны заведены
// прочтениями §152 в группе exactly_one — без выбранного прочтения вывод
// останавливается INTERPRETATION_REQUIRED, а не молчит. Содержание
// гипотетической поправки — факт дела, как и у оси США.

relation amendment_narrows_entrenched_list_1995(amendment: Amendment) kind empirical {
    label ru-KZ unofficial "содержание поправки: исключить предмет из перечня пункта 2 статьи 91";
}
relation narrowing_deemed_outside_core_1995(amendment: Amendment) kind institutional {
    label ru-KZ unofficial "сужение перечня признано не касающимся защищённых предметов пункта 2";
}
relation narrowing_amendment_passes_filter_1995(amendment: Amendment) kind institutional {
    label ru-KZ unofficial "поправка, сужающая перечень пункта 2, проходит фильтр пункта 3 статьи 91";
}

// Прочтение А: сужение перечня — вне защищённых предметов.
rule NarrowingOutsideCore1995(amendment: Amendment) strict {
    when amendment_narrows_entrenched_list_1995(amendment);
    then narrowing_deemed_outside_core_1995(amendment);
    label ru-KZ unofficial "прочтение А: перечень пункта 2 сам не есть защищённый предмет, его сужение — обычная поправка";
}

// Прочтение Б: перечень сам защищён как основополагающий принцип.
rule NarrowingTouchesCore1995(amendment: Amendment) strict {
    when amendment_narrows_entrenched_list_1995(amendment);
    then amendment_violates_entrenched_core_1995(amendment);
    label ru-KZ unofficial "прочтение Б: неизменность перечня пункта 2 — основополагающий принцип, его сужение посягает на ядро";
}

// Вопрос двухходовки: сужающая поправка с заключением суда проходит фильтр
// ТОЛЬКО под прочтением А. Без выбора прочтения — громкая остановка.
rule NarrowingAmendmentFilter1995(amendment: Amendment) defeasible {
    when constitutional_court_positive_conclusion_1995(amendment);
    when narrowing_deemed_outside_core_1995(amendment);
    then narrowing_amendment_passes_filter_1995(amendment);
    unless amendment_violates_entrenched_core_1995(amendment);
    label ru-KZ unofficial "сужающая поправка выносима при заключении суда, если сужение не признано посягательством на ядро";
}

interpretation ListIsNotASubjectReading {
    status disputed;
    label ru-KZ unofficial "прочтение А статьи 91 пункта 2: перечень защищает предметы, но не сам себя";
    include NarrowingOutsideCore1995;
}

interpretation ListItselfEntrenchedReading {
    status disputed;
    label ru-KZ unofficial "прочтение Б статьи 91 пункта 2: неизменность перечня — основополагающий принцип";
    include NarrowingTouchesCore1995;
}

// Метки §218 группа не принимает (LDC-E0201, замер blefuscu 30.08.2026);
// имя развилки живёт в метках обеих альтернатив.
interpretation_group Article91SelfEntrenchmentDoctrine {
    alternatives ListIsNotASubjectReading, ListItselfEntrenchedReading;
    selection exactly_one;
}

// --- Константы §54 (E-0032 п. 1 / E-0117) ------------------------------------
//
// Две редакции Конституции как индивиды: слот
// `constitution_effective_date(version_obj: ConstitutionEdition, date: Date)`
// и парный ему `constitution_ceases_date` типизированы `ConstitutionEdition`.
const constitution_1995: ConstitutionEdition = entity_ref("urn:kz:constitution:amendment#constitution_1995") {
    label ru-KZ unofficial "Конституция 1995 года";
};
const constitution_2026: ConstitutionEdition = entity_ref("urn:kz:constitution:amendment#constitution_2026") {
    label ru-KZ unofficial "Конституция 2026 года";
};
