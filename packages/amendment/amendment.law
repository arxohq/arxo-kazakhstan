    label ru-KZ official "полномочия Вице-Президента сохраняются в переходный период (редакция 1995)";
}
pub relation first_senate_split_term_1995() kind institutional {
    label ru-KZ official "половина депутатов Сената первого созыва избрана на укороченный срок (редакция 1995)";
}
pub relation cabinet_becomes_government_1995() kind institutional {
    label ru-KZ official "Кабинет Министров приобретает статус Правительства Республики (редакция 1995)";
}
pub relation first_constitutional_council_composition_1995() kind institutional {
    label ru-KZ official "первый состав Конституционного Совета образован в порядке переходных положений (редакция 1995)";
}
