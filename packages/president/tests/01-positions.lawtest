}

// Государственная измена: полномочие органа побеждает иммунитет по
// `priority`, и ответственность наступает. Иммунитет при этом остаётся
// ACTIVE — побеждён он в фазе материализации эффекта §127, а не снят.
test "urn:query:kzcp-22" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
