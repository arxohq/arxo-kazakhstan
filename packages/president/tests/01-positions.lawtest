// Обеспечение не предоставлено. ГРАНИЦА МОДЕЛИРОВАНИЯ, ИЗМЕРЕННАЯ ЗДЕСЬ:
// цель достижения объявлена с ОТКРЫТЫМ окном `[@2026-07-01, infinity)`, и
// такая обязанность не получает VIOLATED НИКОГДА — окно не закрывается, срок
// не наступает. Сторож фиксирует и ACTIVE, и отсутствие VIOLATED; если норма
// однажды получит срок, тест обязан упасть.
test "urn:query:kzcp-26" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p26-1": state_authority(entity_ref("urn:kz:constitution:president:test:authority1")) { origin case_input; }
        assert "p26-2": presidential_family_support_case(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p26-3": not state_support_provided(entity_ref("urn:kz:constitution:president:test:authority1"), entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
    }
    evaluate positions();
    expect position(ProvidePresidentialSupportAndProtection, ACTIVE);
    expect not position(ProvidePresidentialSupportAndProtection, VIOLATED);
}

// ─────────────────────────────────────────────────────────────────────────
// Ст. 43 п. 1. Одно и то же лицо не избирается Президентом дважды (§128).
// ─────────────────────────────────────────────────────────────────────────

test "urn:query:kzcp-27" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p27-1": previously_elected_president(entity_ref("urn:kz:constitution:president:test:person1")) { origin case_input; }
    }
    evaluate positions();
    expect position(NoSecondPresidentialElection, ACTIVE);

    evaluate truth(elected_president(entity_ref("urn:kz:constitution:president:test:person1")));
    expect truth_status == NEITHER;
}

// ГРАНИЦА, ИЗМЕРЕННАЯ ЗДЕСЬ, А НЕ ПРЕДПОЛОЖЕННАЯ: защищаемый эффект
// `elected_president` выводит СТРОГОЕ ПРАВИЛО подсчёта голосов
// (`PresidentialElectionMajority`), а не осуществление полномочия §127.
// Блокировка §128 живёт только в материализации эффекта power, поэтому лицо,
// уже бывшее Президентом, всё равно числится избранным. Иммунитет ACTIVE, а
// запрета он не производит — это дефект моделирования нормы, а не свойство
// набора; тест закрепляет измеренное поведение.
test "urn:query:kzcp-28" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p28-1": previously_elected_president(entity_ref("urn:kz:constitution:president:test:person1")) { origin case_input; }
        assert "p28-2": presidential_election_attempt(entity_ref("urn:kz:constitution:president:test:election1"), entity_ref("urn:kz:constitution:president:test:person1")) { origin case_input; }
        assert "p28-3": presidential_vote(entity_ref("urn:kz:constitution:president:test:election1"), entity_ref("urn:kz:constitution:president:test:person1"), 60) { origin case_input; }
        assert "p28-4": participating_voters(entity_ref("urn:kz:constitution:president:test:election1"), 100) { origin case_input; }
    }
    evaluate positions();
    expect position(NoSecondPresidentialElection, ACTIVE);

    evaluate truth(elected_president(entity_ref("urn:kz:constitution:president:test:person1")));
    expect truth_status == TRUE_ONLY;
}

