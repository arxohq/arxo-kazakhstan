// ─────────────────────────────────────────────────────────────────────────
// Ст. 62. Роспуск Курултая и четыре защищённых периода (§128).
// ─────────────────────────────────────────────────────────────────────────

// Полномочие создано, попытки роспуска нет.
test "urn:query:kzcp-7" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p7-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p7-2": kurultai(entity_ref("urn:kz:constitution:president:test:kurultai1")) { origin case_input; }
        assert "p7-3": repeated_refusal_of_presidential_nominee(entity_ref("urn:kz:constitution:president:test:kurultai1")) { origin case_input; }
        assert "p7-4": required_consultations_completed(entity_ref("urn:kz:constitution:president:test:kurultai1")) { origin case_input; }
    }
    evaluate positions();
    expect position(DissolveKurultai, ACTIVE);
    expect not position(NoDissolutionInEmergency, ACTIVE);

    evaluate truth(kurultai_dissolved(entity_ref("urn:kz:constitution:president:test:kurultai1")));
    expect truth_status == NEITHER;
}

// Роспуск при отсутствии защищённого периода: эффект наступает.
test "urn:query:kzcp-8" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p8-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p8-2": kurultai(entity_ref("urn:kz:constitution:president:test:kurultai2")) { origin case_input; }
        assert "p8-3": repeated_refusal_of_presidential_nominee(entity_ref("urn:kz:constitution:president:test:kurultai2")) { origin case_input; }
        assert "p8-4": required_consultations_completed(entity_ref("urn:kz:constitution:president:test:kurultai2")) { origin case_input; }
        assert "p8-5": dissolution_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:kurultai2")) { origin case_input; }
    }
    evaluate truth(kurultai_dissolved(entity_ref("urn:kz:constitution:president:test:kurultai2")));
    expect truth_status == TRUE_ONLY;
}

// Основание первое: чрезвычайное или военное положение. Иммунитет побеждает
// полномочие по `priority` — эффект заблокирован именно им.
test "urn:query:kzcp-9" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p9-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p9-2": kurultai(entity_ref("urn:kz:constitution:president:test:kurultai3")) { origin case_input; }
        assert "p9-3": repeated_refusal_of_presidential_nominee(entity_ref("urn:kz:constitution:president:test:kurultai3")) { origin case_input; }
        assert "p9-4": required_consultations_completed(entity_ref("urn:kz:constitution:president:test:kurultai3")) { origin case_input; }
        assert "p9-5": dissolution_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:kurultai3")) { origin case_input; }
        assert "p9-6": emergency_or_martial_law_active() { origin case_input; }
    }
    evaluate positions();
    expect position(NoDissolutionInEmergency, ACTIVE);

    evaluate truth(kurultai_dissolved(entity_ref("urn:kz:constitution:president:test:kurultai3")));
    expect truth_status == NEITHER;
    expect issue(EFFECT_BLOCKED_BY_IMMUNITY);
}

// Основание второе: последние шесть месяцев полномочий Президента. Срок семи
// лет отсчитывается от 1 января 2020 года, истекает 1 января 2027-го, вопрос
// о роспуске рассматривается 1 сентября 2026-го — внутри шести месяцев.
test "urn:query:kzcp-10" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p10-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p10-2": kurultai(entity_ref("urn:kz:constitution:president:test:kurultai4")) { origin case_input; }
        assert "p10-3": repeated_refusal_of_presidential_nominee(entity_ref("urn:kz:constitution:president:test:kurultai4")) { origin case_input; }
        assert "p10-4": required_consultations_completed(entity_ref("urn:kz:constitution:president:test:kurultai4")) { origin case_input; }
        assert "p10-5": dissolution_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:kurultai4")) { origin case_input; }
        assert "p10-6": president_assumed_office_on(entity_ref("urn:kz:constitution:president:test:president1"), @2020-01-01) { origin case_input; }
        assert "p10-7": dissolution_considered_on(@2026-09-01) { origin case_input; }
    }
    evaluate positions();
    expect position(NoDissolutionInLastSixMonths, ACTIVE);

    evaluate truth(kurultai_dissolved(entity_ref("urn:kz:constitution:president:test:kurultai4")));
    expect truth_status == NEITHER;
    expect issue(EFFECT_BLOCKED_BY_IMMUNITY);
}

