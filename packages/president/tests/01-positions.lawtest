// ─────────────────────────────────────────────────────────────────────────
// Ст. 46. Референдум и обращение в Конституционный Суд.
// ─────────────────────────────────────────────────────────────────────────

test "urn:query:kzcp-15" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p15-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p15-2": constitutional_petition(entity_ref("urn:kz:constitution:president:test:petition1")) { origin case_input; }
    }
    evaluate positions();
    expect position(CallReferendum, ACTIVE);
    expect position(PetitionConstitutionalCourt, ACTIVE);

    evaluate truth(referendum_called());
    expect truth_status == NEITHER;

    evaluate truth(constitutional_review_requested(entity_ref("urn:kz:constitution:president:test:petition1")));
