language "law.core" version "0.2";
package kz.constitution.president version "0.1.0";
namespace "urn:kz:constitution:president";

// ПОЗИЦИИ §§122–137 РАЗДЕЛА III «ПРЕЗИДЕНТ».
//
// В пакете 39 норм-шаблонов: 31 полномочие §127, семь иммунитетов §128 и одна
// обязанность §136/§138. Набор наблюдает каждый.
//
// ЧТО НАБЛЮДАЕМО У ПОЛНОМОЧИЯ. §127 различает три состояния: позиция без
// осуществления, осуществление при выполненном `valid_when` (эффект наступает)
// и осуществление при невыполненном (issue POWER_INVALID_EXERCISE, событие
// сохранено, эффекта нет). Третье состояние ВЫРАЗИМО ДАЛЕКО НЕ У ВСЕХ:
// у 27 полномочий из 31 `valid_when` читает предикат, который УЖЕ стоит
// посылкой создающего правила (чаще всего сам `president(president)`), и
// недействительное осуществление там невозможно по построению — где
// полномочие есть, там условие действительности выполнено всегда. Это
// измерено по CLIR, а не предположено. Наблюдаемая пара у таких полномочий —
// наличие и отсутствие осуществления.
//
// Раздельная пара «действительно / недействительно» есть ровно у четырёх:
// SignLaw и ReturnLawWithObjections (`presidential_signature_timely`),
// AppointWithConsent (`kurultai_majority_consent`) и AdoptMartialMeasure
// (`kurultai_immediately_informed`). Все четыре проверены с обеих сторон.

// Политика счёта сроков §86 (LDC-E1333: inline-запись в контексте дела в 0.2
// удалена — политика объявляется файлом и предъявляется по имени). Значения
// повторяют профиль KZ_CONSTITUTION_TERMS регрессии Конституции:
// `no_roll` + `include_end` не спрашивают снимок календаря §85.
deadline policy KZ_CONSTITUTION_TERMS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

// ─────────────────────────────────────────────────────────────────────────
// Ст. 46 подп. 3. Подписание закона и возвращение с возражениями.
// ─────────────────────────────────────────────────────────────────────────

// Закон представлен 1 августа, подписан 15 августа — срок одного месяца
// соблюдён, эффект наступает.
test "urn:query:kzcp-1" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p1-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p1-2": law_presented(entity_ref("urn:kz:constitution:president:test:law1"), entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p1-3": law_presented_on(entity_ref("urn:kz:constitution:president:test:law1"), @2026-08-01) { origin case_input; }
        assert "p1-4": presidential_signature_day(entity_ref("urn:kz:constitution:president:test:law1"), @2026-08-15) { origin case_input; }
        assert "p1-5": presidential_signature_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:law1")) { origin case_input; }
    }
    evaluate positions();
    expect issues_within(info);
    expect position(SignLaw, ACTIVE);
    expect position(ReturnLawWithObjections, ACTIVE);

    evaluate truth(law_signed(entity_ref("urn:kz:constitution:president:test:law1")));
    expect truth_status == TRUE_ONLY;
}

// Тот же закон подписан 15 сентября — позже срока. Полномочие остаётся,
// эффекта нет, осуществление помечено недействительным.
test "urn:query:kzcp-2" {
    given {
        context { decision_time @2026-09-20T12:00:00+05:00; knowledge_time @2026-09-20T12:00:00+05:00; legal_time @2026-09-20; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p2-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p2-2": law_presented(entity_ref("urn:kz:constitution:president:test:law2"), entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p2-3": law_presented_on(entity_ref("urn:kz:constitution:president:test:law2"), @2026-08-01) { origin case_input; }
        assert "p2-4": presidential_signature_day(entity_ref("urn:kz:constitution:president:test:law2"), @2026-09-15) { origin case_input; }
        assert "p2-5": presidential_signature_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:law2")) { origin case_input; }
    }
    evaluate positions();
    expect position(SignLaw, ACTIVE);

    evaluate truth(law_signed(entity_ref("urn:kz:constitution:president:test:law2")));
    expect truth_status == NEITHER;
    expect issue(POWER_INVALID_EXERCISE);
}

