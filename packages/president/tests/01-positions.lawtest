        assert "p22-2": state_authority(entity_ref("urn:kz:constitution:president:test:authority1")) { origin case_input; }
        assert "p22-3": state_treason_by_president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p22-4": presidential_liability_attempt(entity_ref("urn:kz:constitution:president:test:authority1"), entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
    }
    evaluate positions();
    expect position(HoldPresidentLiableForTreason, ACTIVE);
    expect position(PresidentialImmunityForActsInOffice, ACTIVE);

    evaluate truth(president_held_criminally_or_administratively_liable(entity_ref("urn:kz:constitution:president:test:president1")));
    expect truth_status == TRUE_ONLY;
}

