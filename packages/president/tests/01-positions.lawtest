// Перечни подп. 5 и 14 закрыты: должность и вид отличия вне перечня
// полномочия не создают вовсе.
test "urn:query:kzcp-31" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p31-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p31-2": office_appointment(entity_ref("urn:kz:constitution:president:test:appointment6"), entity_ref("urn:kz:constitution:president:test:office-outside-list")) { origin case_input; }
        assert "p31-3": office_appointment_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:appointment6")) { origin case_input; }
        assert "p31-4": distinction_kind(entity_ref("urn:kz:constitution:president:test:distinction2"), entity_ref("urn:kz:constitution:president:test:kind-outside-list")) { origin case_input; }
        assert "p31-5": distinction_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:distinction2")) { origin case_input; }
    }
    evaluate positions();
    expect not position(AppointToPresidentialOffice, ACTIVE);
    expect not position(ConferDistinction, ACTIVE);

    evaluate truth(office_appointment_effective(entity_ref("urn:kz:constitution:president:test:appointment6")));
    expect truth_status == NEITHER;

    evaluate truth(distinction_conferred(entity_ref("urn:kz:constitution:president:test:distinction2")));
    expect truth_status == NEITHER;
}

// Орган Президенту не подчинён: ни одно из трёх полномочий подп. 6 не
// создаётся, и акт силы не имеет.
test "urn:query:kzcp-32" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; deadline_policy KZ_CONSTITUTION_TERMS; }
        assert "p32-1": president(entity_ref("urn:kz:constitution:president:test:president1")) { origin case_input; }
        assert "p32-2": state_body_act(entity_ref("urn:kz:constitution:president:test:bodyact2"), Abolish) { origin case_input; }
        assert "p32-3": state_body_act_attempt(entity_ref("urn:kz:constitution:president:test:president1"), entity_ref("urn:kz:constitution:president:test:bodyact2")) { origin case_input; }
        assert "p32-4": subordinate_body_head_appointment(entity_ref("urn:kz:constitution:president:test:appointment7"), entity_ref("urn:kz:constitution:president:test:bodyact2")) { origin case_input; }
        assert "p32-5": subordinate_body_head_release(entity_ref("urn:kz:constitution:president:test:release4"), entity_ref("urn:kz:constitution:president:test:bodyact2")) { origin case_input; }
    }
    evaluate positions();
    expect not position(OrganiseSubordinateBody, ACTIVE);
    expect not position(AppointSubordinateBodyHead, ACTIVE);
    expect not position(ReleaseSubordinateBodyHead, ACTIVE);

    evaluate truth(state_body_act_effective(entity_ref("urn:kz:constitution:president:test:bodyact2")));
    expect truth_status == NEITHER;
}
