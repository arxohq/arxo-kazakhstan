@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_KK")
assert president_term(7 calendar_year);
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU") {
    assert president_minimum_age(40);
    assert president_residence_years(15);
    assert president_experience_years(5);
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU") {
    assert regular_oath_period(1 calendar_month);
    assert succession_oath_days(7);
}
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
assert early_election_announcement_days(7);

// Пять сроков в календарных единицах §86. Единица едет вместе с величиной по
// той же причине, что и срок полномочий: грамматика допускает unit_symbol
// только у литерала, из переменной Quantity не собрать.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU")
assert presidential_signature_period(1 calendar_month);
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU")
assert impeachment_final_decision_period(2 calendar_month);
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
assert early_election_conduct_period(2 calendar_month);
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART62_RU") {
    assert dissolution_final_period(6 calendar_month);
    assert dissolution_interval_after_prior(1 calendar_year);
}

// Ст. 43.3: «не позднее двух месяцев до окончания срока полномочий».
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
assert regular_election_lead_period(2 calendar_month);
// Ст. 50.2: «большинством не менее трёх четвертей голосов от общего числа
// депутатов» — своя величина, не переиспользованная у импичмента: совпадение
// долей здесь случайно, статьи разные и меняться могут порознь.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    assert health_removal_numerator(3);
    assert health_removal_denominator(4);
    // Ст. 50.3, второе предложение: «Решение по данному вопросу принимается
    // большинством голосов от общего числа депутатов Курултая» — отдельная
    // стадия между инициативой и расследованием.
    assert impeachment_question_numerator(1);
    assert impeachment_question_denominator(2);
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART53_KK")
assert kurultai_seat_count(145);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    assert impeachment_initiative_numerator(1);
    assert impeachment_initiative_denominator(3);
    assert impeachment_final_numerator(3);
    assert impeachment_final_denominator(4);
    // Ст. 50.3: «Расследование обвинения организуется Курултаем и его результаты
    // большинством голосов от общего числа депутатов выносятся на рассмотрение».
    assert impeachment_investigation_numerator(1);
    assert impeachment_investigation_denominator(2);
}
// Ст. 43.4: «Кандидат, набравший более пятидесяти процентов голосов
// избирателей, принявших участие в голосовании, считается избранным».
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU") {
    assert presidential_election_majority_numerator(1);
    assert presidential_election_majority_denominator(2);
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_KK")
rule PresidentialCandidateEligibility(
    candidate: Candidate,
    person: Person,
    age: Integer,
    residence: Integer,
    experience: Integer,
    min_age: Integer,
    min_residence: Integer,
    min_experience: Integer,
) strict {
    when candidate_person(candidate, person)
        and citizen_by_birth(person)
        and age_years(person, age)
        and resides_last_years(person, residence)
        and state_service_or_elected_years(person, experience)
        and higher_education(person)
        and fluent_in_state_language(person)
        and president_minimum_age(min_age)
        and president_residence_years(min_residence)
        and president_experience_years(min_experience)
        and (age >= min_age)
        and (residence >= min_residence)
        and (experience >= min_experience);
    then eligible_presidential_candidate(candidate);
    label ru-KZ official "Статья 43 пункт 2. Президентом может быть избран гражданин Республики по рождению, не моложе сорока лет, свободно владеющий государственным языком, проживающий в Казахстане последние пятнадцать лет, имеющий высшее образование и опыт работы не менее пяти лет";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
rule PresidentialElectionMajority(
    election: Election,
    person: Person,
    votes: Integer,
    participants: Integer,
    num: Integer,
    den: Integer,
) strict {
    when presidential_election_attempt(election, person)
        and presidential_vote(election, person, votes)
        and participating_voters(election, participants)
        and presidential_election_majority_numerator(num)
        and presidential_election_majority_denominator(den)
        and (votes * den > participants * num);
    then elected_president(person);
    label ru-KZ official "Статья 43 пункт 4. Избранным считается кандидат, набравший более пятидесяти процентов голосов избирателей, принявших участие в голосовании";
}

// Ст. 43.1: одно и то же лицо не избирается более одного раза.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_KK")
rule OnePresidentialElectionImmunity(person: Person) strict {
    when previously_elected_president(person);
    then immunity NoSecondPresidentialElection {
        holder person;
        protected_effect elected_president(person);
    };
    label ru-KZ official "Статья 43 пункт 1. Одно и то же лицо не может быть избрано Президентом более одного раза";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU") {
    rule PresidentialSignaturePower(president: President, law: Law) strict {
        when president(president);
        when law_presented(law, president);
        then power SignLaw {
            holder president;
            exercise presidential_signature_attempt(president, law);
            valid_when presidential_signature_timely(law);
            effect law_signed(law);
        };
        label ru-KZ official "Статья 46. Президент подписывает представленный Курултаем закон";
    }

    rule PresidentialReturnPower(president: President, law: Law) strict {
        when president(president);
        when law_presented(law, president);
        then power ReturnLawWithObjections {
            holder president;
            exercise presidential_return_attempt(president, law);
            valid_when presidential_signature_timely(law);
            effect law_returned_with_objections(law);
        };
        label ru-KZ official "Статья 46. Президент вправе возвратить закон в Курултай со своими возражениями";
    }

    rule AppointmentWithKurultaiConsentPower(
        president: President,
        appointment: Appointment,
    ) strict {
        when president(president);
        when appointment_requires_kurultai_consent(appointment);
        then power AppointWithConsent {
            holder president;
            exercise presidential_appointment_attempt(president, appointment);
            valid_when kurultai_majority_consent(appointment);
            effect appointment_effective(appointment);
        };
        label ru-KZ official "Статья 46. Президент назначает должностных лиц, назначение которых производится с согласия Курултая";
    }
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART62_RU") {
    rule KurultaiDissolutionPower(president: President, kurultai: Kurultai) strict {
        when president(president);
        when repeated_refusal_of_presidential_nominee(kurultai);
        when required_consultations_completed(kurultai);
        then power DissolveKurultai {
            holder president;
            exercise dissolution_attempt(president, kurultai);
            valid_when repeated_refusal_of_presidential_nominee(kurultai);
            effect kurultai_dissolved(kurultai);
        };
        label ru-KZ official "Статья 62 пункт 2. Президент вправе распустить Курултай при повторном отказе в даче согласия на предложенную им кандидатуру";
    }

    // ВАЖНО о ИМЕНАХ НОРМ. Четыре правила не могут объявлять ОДНУ инлайн-норму:
    // lowering присваивает норм-шаблону StableId по имени, и четыре объявления
    // дают `A3 StableId collision`. `lawc check` этого не видит — коллизия
    // возникает на lowering, то есть ещё один способ получить зелёный check и
    // нерабочую программу. Поэтому норма названа ПО ОСНОВАНИЮ: дело в период
    // чрезвычайного положения получает `NoDissolutionInEmergency`, а не общий
    // иммунитет. Это следствие модели идентичности норм v1, а не выбор автора;
    // побочно ответ становится информативнее — он называет основание защиты.
    //
    // Ст. 62.3 перечисляет ЧЕТЫРЕ основания через «или». Дизъюнкция в теле
    // принимается парсером и `lawc check`, но отвергается ОБОИМИ исполнителями
    // (`flatten_body` знает только `and` — solver.py и порт solver.rs), поэтому
    // правило компилировалось и молчало. Каноническое расщепление §206: одна
    // голова, четыре правила, по одному на основание. Побочно чинится и §190 —
    // носитель нормы связывается предикатом `kurultai`.
    rule DissolutionBarrierEmergencyOrMartialLaw(kurultai: Kurultai) strict {
        when kurultai(kurultai);
        when emergency_or_martial_law_active();
        then immunity NoDissolutionInEmergency {
            holder kurultai;
            protected_effect kurultai_dissolved(kurultai);
        };
        label ru-KZ official "Статья 62 пункт 3. Курултай не может быть распущен в период чрезвычайного или военного положения";
    }

    rule DissolutionBarrierLastSixMonths(kurultai: Kurultai) strict {
        when kurultai(kurultai);
        when in_final_period_of_presidential_term();
        then immunity NoDissolutionInLastSixMonths {
            holder kurultai;
            protected_effect kurultai_dissolved(kurultai);
        };
        label ru-KZ official "Статья 62 пункт 3. Курултай не может быть распущен в последние шесть месяцев полномочий Президента";
    }

    rule DissolutionBarrierWithinYearAfterPrior(kurultai: Kurultai) strict {
        when kurultai(kurultai);
        when within_period_after_prior_dissolution();
        then immunity NoDissolutionWithinYearAfterPrior {
            holder kurultai;
            protected_effect kurultai_dissolved(kurultai);
        };
        label ru-KZ official "Статья 62 пункт 3. Курултай не может быть распущен в течение одного года после предыдущего роспуска";
    }
}

// Четвёртое основание — отсылка: «в случае, установленном пунктом 3 статьи 51».
// Это тот же запрет, что выражен в ст. 51.3 правилом SuccessorCannotDissolveKurultai,
// но с другой стороны: там он адресован ЛИЦУ, принявшему полномочия, здесь —
// защищает Курултай. Обе стороны нормы выражены, и это не дублирование.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
rule DissolutionBarrierSuccessionPresident(kurultai: Kurultai) strict {
    when kurultai(kurultai);
    when succession_president_in_office();
    then immunity NoDissolutionUnderSuccessionPresident {
        holder kurultai;
        protected_effect kurultai_dissolved(kurultai);
    };
    label ru-KZ official "Статья 62 пункт 3. Курултай не может быть распущен в случае, установленном пунктом 3 статьи 51 Конституции";
}

// Приоритет расщеплён вслед за правилом: `prefer` называет ПРАВИЛО, и одна
// запись на четыре основания сослалась бы на имя, которого больше нет.
priority ProtectedPeriodOverDissolutionEmergency: DissolutionBarrierEmergencyOrMartialLaw > KurultaiDissolutionPower reason lex_specialis;

priority ProtectedPeriodOverDissolutionLastMonths: DissolutionBarrierLastSixMonths > KurultaiDissolutionPower reason lex_specialis;

priority ProtectedPeriodOverDissolutionAfterPrior: DissolutionBarrierWithinYearAfterPrior > KurultaiDissolutionPower reason lex_specialis;

priority ProtectedPeriodOverDissolutionSuccession: DissolutionBarrierSuccessionPresident > KurultaiDissolutionPower reason lex_specialis;

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU") {
    rule ReferendumPower(president: President) strict {
        when president(president);
        then power CallReferendum {
            holder president;
            exercise referendum_decision_attempt(president);
            valid_when president(president);
            effect referendum_called();
        };
        label ru-KZ official "Статья 46. Президент принимает решение о проведении всенародного референдума";
    }

    rule ConstitutionalReviewPetitionPower(
        president: President,
        petition: ConstitutionalPetition,
    ) strict {
        when president(president);
        when constitutional_petition(petition);
        then power PetitionConstitutionalCourt {
            holder president;
            exercise constitutional_review_petition_attempt(president, petition);
            valid_when president(president);
            effect constitutional_review_requested(petition);
        };
        label ru-KZ official "Статья 46. Президент вправе обратиться в Конституционный Суд";
    }

    rule EmergencyPower(president: President, measure: EmergencyMeasure) strict {
        when president(president);
        when emergency_measure(measure);
        when immediate_constitutional_threat();
        when emergency_consultations_completed();
        then power AdoptEmergencyMeasure {
            holder president;
            exercise emergency_measure_attempt(president, measure);
            valid_when emergency_consultations_completed();
            effect emergency_measure_in_force(measure);
        };
        label ru-KZ official "Статья 46. При непосредственной угрозе конституционному строю и после требуемых консультаций Президент вводит меры чрезвычайного положения с незамедлительным информированием Курултая";
    }

    rule MartialPower(president: President, measure: EmergencyMeasure) strict {
        when president(president);
        when emergency_measure(measure);
        when aggression_or_immediate_external_threat();
        then power AdoptMartialMeasure {
            holder president;
            exercise martial_measure_attempt(president, measure);
            valid_when kurultai_immediately_informed();
            effect martial_measure_in_force(measure);
        };
        label ru-KZ official "Статья 46. В случае агрессии либо непосредственной внешней угрозы Президент вводит военное положение";
    }
}

// Ст. 50.3: ЧЕТЫРЕ различимых стадии, без слияния кворумов — инициатива не
// менее одной трети, решение по вопросу большинством, вынесение результатов
// расследования большинством, окончательное решение не менее трёх четвертей.
// До 28.08.2026 стадий было три, и два РАЗНЫХ большинства текста сливались в
// одно: комментарий здесь утверждал «три различимых стадии, без слияния
// кворумов», то есть заявлял ровно то, чего не было.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    rule ImpeachmentInitiativeThreshold(
        process: Impeachment,
        votes: Integer,
        total: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when impeachment_case(process)
            and not dissolution_question_under_consideration()
            and impeachment_initiating_votes(process, votes)
            and kurultai_seat_count(total)
            and impeachment_initiative_numerator(num)
            and impeachment_initiative_denominator(den)
            and (votes * den >= total * num);
        then impeachment_initiative_valid(process);
        label ru-KZ official "Статья 50. Вопрос об отрешении Президента возбуждается по инициативе не менее одной трети депутатов Курултая и не может быть возбуждён при рассмотрении вопроса о роспуске";
    }

    rule ImpeachmentInvestigationStage(
        process: Impeachment,
        votes: Integer,
        total: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when impeachment_question_approved(process)
            and investigation_approved_votes(process, votes)
            and kurultai_seat_count(total)
            and impeachment_investigation_numerator(num)
            and impeachment_investigation_denominator(den)
            and (votes * den > total * num);
        then impeachment_investigation_valid(process);
        label ru-KZ official "Статья 50. Расследование обвинения возлагается большинством голосов от общего числа депутатов Курултая";
    }

    rule ImpeachmentFinalStage(
        process: Impeachment,
        votes: Integer,
        total: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when impeachment_investigation_valid(process)
            and supreme_court_charge_supported(process)
            and constitutional_court_procedure_confirmed(process)
            and final_impeachment_votes(process, votes)
            and kurultai_seat_count(total)
            and impeachment_final_decision_timely(process)
            and impeachment_final_numerator(num)
            and impeachment_final_denominator(den)
            and (votes * den >= total * num);
        then president_removed_by_impeachment(process);
        label ru-KZ official "Статья 50. Окончательное решение об отрешении Президента принимается большинством не менее трёх четвертей голосов от общего числа депутатов Курултая";
    }
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU")
rule SuccessionOathDeadline(
    person: Person,
    event_day: Date,
    oath_day: Date,
    limit_days: Integer,
) strict {
    when succession_event(person)
        and succession_oath_date(person, event_day, oath_day)
        and succession_oath_days(limit_days)
        and (days_between(event_day, oath_day) <= limit_days);
    then succession_oath_timely(person);
    label ru-KZ official "Статья 44 пункт 2. Присяга приносится в течение одного месяца со дня принятия полномочий Президента";
}

// ── Статья 51. Замещение должности Президента ────────────────────────────
//
// Четыре основания вакансии п. 1 записаны ЧЕТЫРЬМЯ правилами с одной головой,
// а не одним правилом с `or`: дизъюнкция в теле — вне v1-подмножества оракула
// (правило выпало бы предупреждением NON_EXECUTABLE_RULE), и канонический
// приём §206 здесь тот же, что у остальных расщеплений пакета.

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule VacancyByVoluntaryResignation(vacancy: PresidentialVacancy) strict {
    when vacancy_by_voluntary_resignation(vacancy);
    then presidential_vacancy(vacancy);
    label ru-KZ official "Статья 51 пункт 1. Досрочное освобождение от должности в связи с добровольным уходом в отставку открывает замещение";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU") {
    rule VacancyByHealthIncapacity(vacancy: PresidentialVacancy) strict {
        when vacancy_by_health_incapacity(vacancy);
        then presidential_vacancy(vacancy);
        label ru-KZ official "Статья 51 пункт 1. Досрочное освобождение в связи с устойчивой неспособностью осуществлять обязанности по состоянию здоровья открывает замещение";
    }

    rule VacancyByRemovalFromOffice(vacancy: PresidentialVacancy) strict {
        when vacancy_by_removal_from_office(vacancy);
        then presidential_vacancy(vacancy);
        label ru-KZ official "Статья 51 пункт 1. Отрешение Президента от должности открывает замещение";
    }

    rule VacancyByDeath(vacancy: PresidentialVacancy) strict {
        when vacancy_by_death(vacancy);
        then presidential_vacancy(vacancy);
        label ru-KZ official "Статья 51 пункт 1. Смерть Президента открывает замещение";
    }

    // Отказ принять полномочия — не факт дела, а результат процедуры: заявление
    // подаётся в Конституционный Суд, и Суд удостоверяет его личный и
    // добровольный характер. Без заключения отказа нет.
    rule RefusalCertifiedByConstitutionalCourt(refusal: SuccessionRefusal, holder: Person) strict {
        when refusal_statement_filed(refusal, holder);
        when constitutional_court_certified_refusal(refusal);
        then refused_to_assume_presidential_powers(holder);
        label ru-KZ official "Статья 51 пункт 1. Конституционный Суд удостоверяет, что лицо лично и добровольно подало заявление об отказе принять на себя полномочия Президента";
    }

    rule CannotAssumeByHealthOrPersonalReasons(holder: Person) strict {
        when unable_by_health_or_personal_reasons(holder);
        then cannot_assume_presidential_powers(holder);
        label ru-KZ official "Статья 51 пункт 1. Невозможность принять на себя полномочия по состоянию здоровья или иным причинам личного характера";
    }

    rule CannotAssumeByCertifiedRefusal(holder: Person) strict {
        when refused_to_assume_presidential_powers(holder);
        then cannot_assume_presidential_powers(holder);
        label ru-KZ official "Статья 51 пункт 1. Удостоверенный отказ лица означает невозможность принять на себя полномочия";
    }
}

// Очередь п. 1 — три ПОРАЖАЕМЫХ правила с `not_known`. Строгое тело здесь
// не годится: §113 исполняет default negation только у поражаемых, и в
// строгом правиле конъюнкт выпал бы предупреждением. Классическое `not` §66
// не годится тем более — оно требует ВЫВЕДЕННОГО отрицательного факта, а
// «Вице-Президент не заявил о невозможности» есть молчание, а не вывод.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule SuccessionToVicePresident(vacancy: PresidentialVacancy, holder: Person) defeasible {
    when presidential_vacancy(vacancy);
    when vacancy_vice_president(vacancy, holder);
    when not_known(cannot_assume_presidential_powers(holder));
    then presidential_powers_assumed_by(vacancy, holder);
    label ru-KZ official "Статья 51 пункт 1. Полномочия Президента переходят к Вице-Президенту";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule SuccessionToKurultaiChair(
    vacancy: PresidentialVacancy,
    vice: Person,
    holder: Person,
) defeasible {
    when presidential_vacancy(vacancy);
    when vacancy_vice_president(vacancy, vice);
    when cannot_assume_presidential_powers(vice);
    when vacancy_kurultai_chair(vacancy, holder);
    when not_known(cannot_assume_presidential_powers(holder));
    then presidential_powers_assumed_by(vacancy, holder);
    label ru-KZ official "Статья 51 пункт 1. При невозможности Вице-Президента полномочия Президента переходят к Председателю Курултая";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule SuccessionToPrimeMinister(
    vacancy: PresidentialVacancy,
    vice: Person,
    chair: Person,
    holder: Person,
) defeasible {
    when presidential_vacancy(vacancy);
    when vacancy_vice_president(vacancy, vice);
    when cannot_assume_presidential_powers(vice);
    when vacancy_kurultai_chair(vacancy, chair);
    when cannot_assume_presidential_powers(chair);
    when vacancy_prime_minister(vacancy, holder);
    then presidential_powers_assumed_by(vacancy, holder);
    label ru-KZ official "Статья 51 пункт 1. При невозможности Председателя Курултая полномочия Президента переходят к Премьер-Министру";
}

// Поражаемое, а не строгое: читает вывод поражаемого правила голым атомом —
// каскад §111 (LDC-E4103) требует того же вида. То же у трёх правил ниже.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
rule PriorOfficeRelinquished(vacancy: PresidentialVacancy, holder: Person) defeasible {
    when presidential_powers_assumed_by(vacancy, holder);
    then prior_office_relinquished(holder);
    label ru-KZ official "Статья 51 пункт 1. Лицо, принявшее на себя полномочия Президента, слагает с себя полномочия Вице-Президента, Председателя Курултая, Премьер-Министра соответственно";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule EarlyElectionAnnouncedWithinSevenDays(
    vacancy: PresidentialVacancy,
    vacancy_date: Date,
    announcement_date: Date,
    limit_days: Integer,
) strict {
    when presidential_vacancy(vacancy)
        and vacancy_day(vacancy, vacancy_date)
        and early_election_announcement_day(vacancy, announcement_date)
        and early_election_announcement_days(limit_days)
        and (days_between(vacancy_date, announcement_date) <= limit_days);
    then early_election_announced_timely(vacancy);
    label ru-KZ official "Статья 51 пункт 2. В течение семи дней со дня досрочного освобождения от должности либо со дня смерти Президента Курултай объявляет о проведении выборов";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
rule EarlyElectionConductedInTime(vacancy: PresidentialVacancy) strict {
    when early_election_announced_timely(vacancy);
    when early_election_conducted_in_period(vacancy);
    then early_election_conducted_timely(vacancy);
    label ru-KZ official "Статья 51 пункт 2. Выборы проводятся в течение двух месяцев со дня принятия Курултаем соответствующего решения";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule SuccessorCannotInitiateAmendment(vacancy: PresidentialVacancy, holder: Person) defeasible {
    when presidential_powers_assumed_by(vacancy, holder);
    when successor_amendment_initiative_attempt(holder);
    then successor_amendment_initiative_barred(holder);
    label ru-KZ official "Статья 51 пункт 3. Лицо, принявшее на себя полномочия Президента, не вправе инициировать изменения и дополнения в Конституцию";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_KK")
rule SuccessorCannotDissolveKurultai(vacancy: PresidentialVacancy, holder: Person) defeasible {
    when presidential_powers_assumed_by(vacancy, holder);
    when successor_dissolution_attempt(holder);
    then successor_dissolution_barred(holder);
    label ru-KZ official "Статья 51 пункт 3. Лицо, принявшее на себя полномочия Президента, не вправе распустить Курултай";
}

// Ст. 43.1 даёт ДЛИНУ срока, ст. 44.1 — событие его начала: «вступает в
// должность с момента принесения народу присяги». Дата истечения считается
// календарным шагом §86 (единица calendar_year, errata E-0026): до неё
// величина «семь лет» лежала закреплённой и не читалась ни одним правилом,
// потому что календарные годы были неконструируемы.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU")
rule PresidentialTermExpiry(president: President, start: Date, length: Quantity) strict {
    when president_assumed_office_on(president, start);
    when president_term(length);
    then president_term_expires_on(president, add_calendar_period(start, length));
    label ru-KZ official "Статья 43 пункт 1 и статья 44 пункт 1. Срок полномочий Президента — семь лет со дня вступления в должность с момента принесения присяги";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_KK")
rule PresidentIsHeadOfState(president: President) strict {
    when president(president);
    then president_is_head_of_state(president);
    label ru-KZ official "Статья 42. Президент — глава государства";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_KK")
rule PresidentGuaranteesUnityConstitutionAndRights(president: President) strict {
    when president(president);
    then president_guarantees_unity_constitution_and_rights(president);
    label ru-KZ official "Статья 42. Президент — символ и гарант единства народа и государственной власти, незыблемости Конституции, прав и свобод";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART42_KK")
rule PresidentEnsuresCoordinatedStatePower(president: President) strict {
    when president(president);
    then president_ensures_coordinated_state_power(president);
    label ru-KZ official "Статья 42. Президент обеспечивает согласованное функционирование ветвей государственной власти";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART45_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART45_KK")
rule PresidentialOfficeIncompatibility(president: President) strict {
    when president(president)
        and (president_holds_representative_mandate(president)
            or president_holds_other_paid_office(president)
            or president_conducts_business(president)
            or president_party_member(president));
    then presidential_office_incompatible(president);
    label ru-KZ official "Статья 45 пункт 1. Несовместимости должности Президента";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART45_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART45_KK")
rule PresidentialRelativePositionProhibited(person: Person, president: President) strict {
    when close_relative_of_president(person, president);
    when relative_holds_political_office_or_quasistate_leadership(person);
    then presidential_relative_position_prohibited(person);
    label ru-KZ official "Статья 45 пункт 2. Близкие родственники Президента не занимают перечисленные должности";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_KK")
rule PresidentialActBindingNationwide(act: PresidentialAct, president: President) strict {
    when presidential_act(act, president);
    when presidential_act_based_on_constitution_and_law(act);
    then presidential_act_binding_nationwide(act);
    label ru-KZ official "Статья 47 пункт 1. Указы и распоряжения, изданные на основе Конституции и законов, обязательны по всей стране";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_KK")
rule TemporaryLegislativeDecree(act: PresidentialAct) strict {
    when temporary_kurultai_absence_after_early_termination();
    when temporary_legislative_decree(act);
    then temporary_decree_has_force_of_law(act);
    label ru-KZ official "Статья 47 пункт 2. В период временного отсутствия Курултая указ может иметь силу закона";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_KK")
rule LawCountersignatureBeforePresidentialSignature(law: Law) strict {
    when law_countersigned_by_kurultai_chair(law);
    when law_countersigned_by_prime_minister(law);
    then law_ready_for_presidential_signature(law);
    label ru-KZ official "Статья 47 пункт 3. Закон предварительно скрепляется подписями Председателя Курултая и Премьер-Министра";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART47_KK")
rule GovernmentInitiatedActCountersignature(act: PresidentialAct) strict {
    when government_initiated_presidential_act(act);
    when act_countersigned_by_prime_minister(act);
    then government_initiated_act_ready(act);
    label ru-KZ official "Статья 47 пункт 3. Акт Президента по инициативе Правительства скрепляется Премьер-Министром";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_KK")
// Ст. 48 даёт иммунитет по двум основаниям («или»): действующему Президенту за
// действия при исполнении и экс-Президенту. Та же дизъюнкция, то же молчание,
// то же расщепление §206. Носитель здесь связан обоими конъюнктами, поэтому
// §190 не задет — в отличие от барьера выше.
rule PresidentialOfficialImmunityInOffice(president: President) strict {
    when presidential_conduct_in_office(president);
    then immunity PresidentialImmunityForActsInOffice {
        holder president;
        protected_effect president_held_criminally_or_administratively_liable(president);
    };
    label ru-KZ official "Статья 48. Иммунитет Президента за действия, совершённые при исполнении полномочий";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_KK")
rule PresidentialOfficialImmunityFormer(president: President) strict {
    when ex_president(president);
    then immunity FormerPresidentImmunityForActsInOffice {
        holder president;
        protected_effect president_held_criminally_or_administratively_liable(president);
    };
    label ru-KZ official "Статья 48. Иммунитет экс-Президента за действия, совершённые при исполнении полномочий";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_KK")
rule TreasonLiabilityPower(authority: StateAuthority, president: President) strict {
    when state_authority(authority);
    when state_treason_by_president(president);
    then power HoldPresidentLiableForTreason {
        holder authority;
        over president;
        exercise presidential_liability_attempt(authority, president);
        valid_when state_treason_by_president(president);
        effect president_held_criminally_or_administratively_liable(president);
    };
    label ru-KZ official "Статья 48 пункт 1. Исключение иммунитета для государственной измены";
}

// Исключение государственной измены ст. 48 бьёт ОБА основания иммунитета —
// и действующего Президента, и экс-Президента, — поэтому приоритет расщеплён
// вслед за правилом: `prefer` называет правило, а не норму.
priority TreasonExceptionOverImmunityInOffice: TreasonLiabilityPower > PresidentialOfficialImmunityInOffice reason constitutional_exception;

priority TreasonExceptionOverImmunityFormer: TreasonLiabilityPower > PresidentialOfficialImmunityFormer reason constitutional_exception;

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART48_KK")
rule StateSupportForPresidentAndFamily(authority: StateAuthority, president: President) strict {
    when state_authority(authority);
    when presidential_family_support_case(president);
    then duty ProvidePresidentialSupportAndProtection {
        bearer authority;
        beneficiary president;
        achieve state_support_provided(authority, president) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 48 пункт 2. Обеспечение, обслуживание и охрана Президента и его семьи за счёт государства";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_KK")
rule VicePresidentAppointmentWithKurultaiConsent(
    president: President,
    vice_president: VicePresident,
) strict {
    when president(president);
    when vice_president(vice_president);
    when vice_president_appointment_attempt(president, vice_president);
    when kurultai_majority_consent_to_vice_president(vice_president);
    then vice_president_appointed(vice_president);
    label ru-KZ official "Статья 49 пункт 1. Вице-Президент назначается Президентом с согласия большинства Курултая";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_KK")
rule VicePresidentialOfficeIncompatibility(vice_president: VicePresident) strict {
    when vice_president(vice_president)
        and (vice_president_holds_representative_mandate(vice_president)
            or vice_president_holds_other_paid_office(vice_president)
            or vice_president_conducts_business(vice_president)
            or vice_president_party_member(vice_president));
    then vice_presidential_office_incompatible(vice_president);
    label ru-KZ official "Статья 49 пункт 2. Несовместимости должности Вице-Президента";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART49_KK")
rule VicePresidentRepresentationByInstruction(
    president: President,
    vice_president: VicePresident,
) strict {
    when presidential_instruction_to_vice_president(president, vice_president);
    when vice_president_representation_action(vice_president);
    then vice_president_representation_authorized(vice_president);
    label ru-KZ official "Статья 49 пункт 3. Вице-Президент представляет Президента по его поручению";
}

relation election_results_published_on(president: President, day: Date) kind empirical {
    label ru-KZ official "день опубликования итогов выборов Президента";
}
relation regular_oath_taken_on(president: President, day: Date) kind empirical {
    label ru-KZ official "день принесения присяги";
}
relation regular_oath_due_on(president: President, day: Date) kind institutional {
    key(president);
    label ru-KZ official "день окончания срока принесения присяги";
}
relation regular_oath_timely(president: President) kind institutional {
    label ru-KZ official "присяга принесена в конституционный срок";
}

// Ст. 44.2: «Присяга приносится в течение одного месяца со дня опубликования
// итогов выборов». До errata E-0026 месячный срок был неконструируем, и
// правила очередной присяги не существовало вовсе — формализована была
// только присяга ПРЕЕМНИКА (семь дней, ст. 44.2 второе предложение).
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_KK")
rule RegularOathDue(president: President, published: Date, length: Quantity) strict {
    when election_results_published_on(president, published);
    when regular_oath_period(length);
    then regular_oath_due_on(president, add_calendar_period(published, length));
    label ru-KZ official "Статья 44 пункт 2. Присяга приносится в течение одного месяца со дня опубликования итогов выборов";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU")
rule RegularOathTimely(president: President, due: Date, taken: Date) strict {
    when regular_oath_due_on(president, due)
        and regular_oath_taken_on(president, taken)
        and (taken <= due);
    then regular_oath_timely(president);
    label ru-KZ official "Статья 44 пункт 2. Присяга, принесённая не позднее дня окончания месячного срока, своевременна";
}

// ─────────────────────────────────────────────────────────────────────────
// Сроки, вычисляемые календарным шагом §86 (errata E-0026).
//
// Все пять когда-то приходили в дело готовыми булевыми фактами с величиной в
// имени предиката (`signature_within_one_month`, `final_decision_within_two_months`,
// `elections_conducted_within_two_months`, `last_six_months_of_presidential_term`,
// `within_one_year_after_prior_dissolution`). Такой предикат — признак
// недоделки, а не границы языка: дело сообщало вывод, ради которого норма
// существует, и закреплённая величина не читалась ни одним правилом.
//
// Граница дня всюду включающая (`<=`) — как у RegularOathTimely и как
// объявляет профиль контекста регрессии (`include_end`). Для срока это значит
// «действие в последний день своевременно», для запретного периода —
// «граничный день ещё защищён»; утверждение одно и то же, и оно здесь
// единообразно.
// ─────────────────────────────────────────────────────────────────────────

// Политика счёта §86 ПОД ИМЕНЕМ. До 13.09.2026 её знал только раннер
// регрессии (`contextProfiles.KZ_CONSTITUTION_TERMS` в
// `corpus/run_constitution_regression.py`): дело подавало политику полем
// запроса, а в пакете её не было. Сценарии §267 так политику передать не
// умеют — inline-запись в контексте дела удалена в 0.2 (LDC-E1333), а
// именованная ссылка разрешается ТОЛЬКО по закреплённому CLIR
// (DECISION-0111 §2.2). Поэтому политика объявлена здесь, тем же именем и
// теми же значениями, что у раннера: календарные шаги выше без неё не
// вычисляются вовсе (MISSING_POLICY), и без этой декларации ни один
// сценарий пакета не мог наблюдать ни срок подписания закона, ни два
// защищённых периода роспуска ст. 62 п. 3.
//
// `no_roll` + `include_end` выбраны не здесь, а там: при них календарный шаг
// не спрашивает снимок §85, и срок до 2033 года не требует календаря
// праздников, которого норма не читает.
deadline policy KZ_CONSTITUTION_TERMS {
    start_count same_day;
    include_end true;
    roll no_roll;
    month_end last_day_of_month;
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU") {
    rule PresidentialSignatureDue(law: Law, presented: Date, length: Quantity) strict {
        when law_presented_on(law, presented);
        when presidential_signature_period(length);
        then presidential_signature_due_on(law, add_calendar_period(presented, length));
        label ru-KZ official "Статья 46 подпункт 3. Закон подписывается в течение одного месяца со дня представления его Курултаем";
    }

    rule PresidentialSignatureTimely(law: Law, due: Date, acted: Date) strict {
        when presidential_signature_due_on(law, due)
            and presidential_signature_day(law, acted)
            and (acted <= due);
        then presidential_signature_timely(law);
        label ru-KZ official "Статья 46 подпункт 3. Подписание или возврат закона не позднее дня окончания месячного срока своевременны";
    }
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    rule ImpeachmentFinalDecisionDue(process: Impeachment, charged: Date, length: Quantity) strict {
        when charge_presented_on(process, charged);
        when impeachment_final_decision_period(length);
        then impeachment_final_decision_due_on(process, add_calendar_period(charged, length));
        label ru-KZ official "Статья 50 пункт 3. Окончательное решение принимается в течение двух месяцев с момента предъявления обвинения";
    }

    rule ImpeachmentFinalDecisionTimely(process: Impeachment, due: Date, decided: Date) strict {
        when impeachment_final_decision_due_on(process, due)
            and final_decision_day(process, decided)
            and (decided <= due);
        then impeachment_final_decision_timely(process);
        label ru-KZ official "Статья 50 пункт 3. Решение, принятое не позднее дня окончания двухмесячного срока, принято в срок";
    }
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART51_RU") {
    rule EarlyElectionConductDue(
        vacancy: PresidentialVacancy,
        announced: Date,
        length: Quantity,
    ) strict {
        when early_election_announcement_day(vacancy, announced);
        when early_election_conduct_period(length);
        then early_election_conduct_due_on(vacancy, add_calendar_period(announced, length));
        label ru-KZ official "Статья 51 пункт 2. Выборы проводятся в течение двух месяцев со дня принятия Курултаем решения об их проведении";
    }

    rule EarlyElectionConductedInPeriod(
        vacancy: PresidentialVacancy,
        due: Date,
        held: Date,
    ) strict {
        when early_election_conduct_due_on(vacancy, due)
            and early_election_day(vacancy, held)
            and (held <= due);
        then early_election_conducted_in_period(vacancy);
        label ru-KZ official "Статья 51 пункт 2. Выборы, проведённые не позднее дня окончания двухмесячного срока, проведены в срок";
    }
}

// Направление шага выбрано вперёд намеренно: `add_calendar_period` умеет
// только прибавлять, и «последние шесть месяцев» выражаются не вычитанием от
// даты истечения, а проверкой, что истечение наступает не позже, чем через
// шесть месяцев от рассматриваемого дня. Конъюнкт `today <= expiry` отсекает
// уже истёкший срок: после него норма о защите Курултая не о чем.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART62_RU") {
    rule DissolutionFinalPeriodReached(
        president: President,
        expiry: Date,
        today: Date,
        length: Quantity,
    ) strict {
        when president(president)
            and president_term_expires_on(president, expiry)
            and dissolution_considered_on(today)
            and dissolution_final_period(length)
            and (today <= expiry)
            and (expiry <= add_calendar_period(today, length));
        then in_final_period_of_presidential_term();
        label ru-KZ official "Статья 62 пункт 3. День рассмотрения вопроса о роспуске приходится на последние шесть месяцев полномочий Президента";
    }

    rule DissolutionIntervalAfterPriorNotElapsed(
        prior: Date,
        today: Date,
        length: Quantity,
    ) strict {
        when prior_dissolution_on(prior)
            and dissolution_considered_on(today)
            and dissolution_interval_after_prior(length)
            and (prior <= today)
            and (today <= add_calendar_period(prior, length));
        then within_period_after_prior_dissolution();
        label ru-KZ official "Статья 62 пункт 3. Со дня предыдущего роспуска Курултая не прошёл один год";
    }
}

// ═════════════════════════════════════════════════════════════════════════
// Ст. 43.3, 43.4, 44.3, 50.2–50.4 — нормы, которых у пакета не было (28.08).
//
// Образцы взяты у пакета редакции 1995: ст. 41.3 → RegularElectionDateAdmissible1995,
// ст. 41.5 → RunoffRequired1995/ElectedInRunoff1995, ст. 42 → presidential_powers_terminated_1995,
// ст. 47.2 → RejectedChargeTerminatesInitiators1995, ст. 47.3 → ImpeachmentBarredDuringDissolution1995.
// Две вещи сделаны иначе, и обе — не вкус: срок ст. 43.3 ВЫЧИСЛЯЕТСЯ шагом §86
// (у 1995 дата выборов приходила эмпирическим фактом, потому что до errata
// E-0026 календарных месяцев не было), и «ни один не набрал большинства»
// выводится отрицанием по выводимому предикату, а не сообщается делом.
// ═════════════════════════════════════════════════════════════════════════

// --- Ст. 43.3. Срок очередных выборов ------------------------------------

relation regular_presidential_election_day(election: Election, day: Date) kind empirical {
    label ru-KZ official "день проведения очередных выборов Президента";
}
relation kurultai_election_day(day: Date) kind empirical {
    label ru-KZ official "день проведения выборов нового состава Курултая";
}
relation regular_election_lead_period(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок, за который очередные выборы предшествуют окончанию полномочий, — два месяца";
}
relation coincides_with_kurultai_election(election: Election) kind institutional {
    label ru-KZ official "очередные выборы Президента совпадают по сроку с выборами нового состава Курултая";
}
relation regular_election_scheduled_in_time(election: Election) kind institutional {
    label ru-KZ official "очередные выборы назначены не позднее двух месяцев до окончания срока полномочий Президента";
}
relation regular_presidential_election_date_inadmissible(election: Election) kind institutional {
    label ru-KZ official "дата очередных выборов Президента недопустима";
}

// Совпадение по сроку выражено УНИФИКАЦИЕЙ переменной дня, а не оператором
// равенства: два предиката, названные одним `day`, совпадают тогда и только
// тогда, когда совпадает день. Прочтение узкое — «совпадать по срокам» здесь
// прочитано как «в один и тот же день»; более широкое (пересечение
// избирательных периодов) потребовало бы периодов, которых Конституция не
// устанавливает.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU") {
    rule RegularElectionCoincidesWithKurultaiElection(election: Election, day: Date) strict {
        when regular_presidential_election_day(election, day);
        when kurultai_election_day(day);
        then coincides_with_kurultai_election(election);
        label ru-KZ official "Статья 43 пункт 3. Очередные выборы Президента приходятся на день выборов нового состава Курултая";
    }

    // Шаг вперёд по той же причине, что у ст. 62.3: `add_calendar_period` умеет
    // только прибавлять, и «не позднее двух месяцев ДО окончания» выражается как
    // «день выборов плюс два месяца не позже дня окончания».
    rule RegularElectionScheduledInTime(
        president: President,
        election: Election,
        expiry: Date,
        day: Date,
        length: Quantity,
    ) strict {
        when president(president)
            and president_term_expires_on(president, expiry)
            and regular_presidential_election_day(election, day)
            and regular_election_lead_period(length)
            and (add_calendar_period(day, length) <= expiry);
        then regular_election_scheduled_in_time(election);
        label ru-KZ official "Статья 43 пункт 3. Очередные выборы Президента проводятся не позднее двух месяцев до окончания срока его полномочий";
    }

    // Выводится НЕДОПУСТИМОСТЬ, а не допустимость, и это следствие §118, а не
    // оборот речи: отрицание в теле требует УСТАНОВЛЕННОГО отрицательного факта
    // (умолчания замкнутого мира в языке нет — §5.1), поэтому «срок соблюдён и
    // совпадения нет» пришлось бы доказывать делу дважды. Два основания ст. 43.3
    // нарушаются порознь и каждое выражается положительно; §206-расщепление —
    // одна голова, два правила. Побочно ответ называет ОСНОВАНИЕ недопустимости,
    // как это уже сделано у барьеров ст. 62.3.
    rule RegularElectionTooLate(
        president: President,
        election: Election,
        expiry: Date,
        day: Date,
        length: Quantity,
    ) strict {
        when president(president)
            and president_term_expires_on(president, expiry)
            and regular_presidential_election_day(election, day)
            and regular_election_lead_period(length)
            and (add_calendar_period(day, length) > expiry);
        then regular_presidential_election_date_inadmissible(election);
        label ru-KZ official "Статья 43 пункт 3. Очередные выборы назначены позже чем за два месяца до окончания срока полномочий Президента";
    }

    rule RegularElectionOnKurultaiElectionDay(election: Election) strict {
        when coincides_with_kurultai_election(election);
        then regular_presidential_election_date_inadmissible(election);
        label ru-KZ official "Статья 43 пункт 3. Очередные выборы Президента не могут совпадать по срокам с выборами нового состава Курултая";
    }
}

// --- Ст. 43.4, предложения 2 и 3. Повторное голосование -------------------

relation presidential_election_held(election: Election) kind empirical {
    label ru-KZ official "выборы Президента состоялись";
}
relation majority_reached_in_election(election: Election) kind institutional {
    label ru-KZ official "на выборах кто-либо набрал более пятидесяти процентов голосов";
}
relation no_candidate_reached_majority(election: Election) kind empirical {
    label ru-KZ official "ни один из кандидатов не набрал более пятидесяти процентов голосов";
}
relation repeat_vote_required(election: Election) kind institutional {
    label ru-KZ official "проводится повторное голосование";
}
relation repeat_vote_ballot(election: Election) kind empirical {
    label ru-KZ official "повторное голосование проведено";
}
relation repeat_vote_participant(election: Election, person: Person) kind empirical {
    label ru-KZ official "кандидат участвует в повторном голосовании";
}
relation repeat_vote_votes(election: Election, person: Person, votes: Integer) kind empirical {
    label ru-KZ official "число голосов, поданных за кандидата при повторном голосовании";
}

// Голова та же, что у PresidentialElectionMajority, но факт нужен ОБ ИЗБРАНИИ
// КОГО-ЛИБО, а не о конкретном лице: «если ни один из кандидатов не набрал»
// — утверждение о выборах, и снять его отрицанием по `elected_president`
// нельзя, там свободная переменная лица.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART43_RU") {
    rule MajorityReachedInElection(
        election: Election,
        person: Person,
        votes: Integer,
        participants: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when presidential_election_attempt(election, person)
            and presidential_vote(election, person, votes)
            and participating_voters(election, participants)
            and presidential_election_majority_numerator(num)
            and presidential_election_majority_denominator(den)
            and (votes * den > participants * num);
        then majority_reached_in_election(election);
        label ru-KZ official "Статья 43 пункт 4. На выборах кто-либо из кандидатов набрал более пятидесяти процентов голосов";
    }

    // «Ни один из кандидатов не набрал» — отрицание по ЭКЗИСТЕНЦИИ над выводимым
    // предикатом: барьер §111 в чистом виде. Итог подсчёта приходит фактом дела,
    // как в пакете редакции 1995 (`no_candidate_reached_majority`), а рядом
    // остаётся выводимый положительный двойник MajorityReachedInElection — он
    // считает то же самое из голосов, и расхождение между ними видно на деле.
    rule RepeatVoteRequired(election: Election) strict {
        when presidential_election_held(election);
        when no_candidate_reached_majority(election);
        then repeat_vote_required(election);
        label ru-KZ official "Статья 43 пункт 4. Если ни один из кандидатов не набрал более пятидесяти процентов голосов, проводится повторное голосование";
    }

    // Двое участников — не допущение инструмента, а посылка самой нормы («в
    // котором участвуют два кандидата»): при ней «набравший большее число
    // голосов» и «набравший больше, чем другой участник» — одно и то же, и
    // ранжирование не нужно. При унификации `winner` и `other` в одно лицо
    // сравнение `wv > ov` ложно, поэтому отдельное условие различия не требуется.
    // Отбор самих двух кандидатов («набравших большее число голосов» на первом
    // туре) — ранжирование по всем кандидатам; в 0.1 оно невыразимо и остаётся
    // фактом дела `repeat_vote_participant`, как в пакете 1995.
    rule ElectedInRepeatVote(
        election: Election,
        winner: Person,
        other: Person,
        winner_votes: Integer,
        other_votes: Integer,
    ) strict {
        when repeat_vote_ballot(election)
            and repeat_vote_participant(election, winner)
            and repeat_vote_participant(election, other)
            and repeat_vote_votes(election, winner, winner_votes)
            and repeat_vote_votes(election, other, other_votes)
            and (winner_votes > other_votes);
        then elected_president(winner);
        label ru-KZ official "Статья 43 пункт 4. В повторном голосовании избранным считается кандидат, набравший большее число голосов избирателей, принявших участие в голосовании";
    }
}

// --- Ст. 44.3. Прекращение полномочий и звание экс-Президента -------------

relation new_president_assumed_office(previous: President) kind empirical {
    label ru-KZ official "в должность вступил вновь избранный Президент";
}
relation president_resigned(president: President) kind empirical {
    label ru-KZ official "Президент освобождён от должности в связи с добровольным уходом в отставку";
}
relation president_died(president: President) kind empirical {
    label ru-KZ official "Президент умер";
}
relation impeachment_target(impeachment: Impeachment, president: President) kind empirical {
    label ru-KZ official "обвинение в государственной измене предъявлено данному Президенту";
}
relation president_removed_from_office(president: President) kind institutional {
    label ru-KZ official "Президент отрешён от должности";
}
relation presidential_powers_terminated(president: President) kind institutional {
    label ru-KZ official "полномочия Президента прекращены";
}
relation ex_president(president: President) kind institutional {
    label ru-KZ official "лицо имеет звание экс-Президента Республики Казахстан";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU")
rule RemovedFromOfficeByImpeachment(impeachment: Impeachment, president: President) strict {
    when impeachment_target(impeachment, president);
    when president_removed_by_impeachment(impeachment);
    then president_removed_from_office(president);
    label ru-KZ official "Статья 50 пункт 3. Президент отрешён от должности решением Курултая по обвинению в государственной измене";
}

// Пять оснований прекращения — каноническое расщепление §206: одна голова,
// пять правил. Дизъюнкция в теле принимается парсером и отвергается обоими
// исполнителями, и это уже стоило пакету четырёх молчащих правил ст. 62.3.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART44_RU") {
    rule PowersTerminatedByNewPresident(president: President) strict {
        when president(president);
        when new_president_assumed_office(president);
        then presidential_powers_terminated(president);
        label ru-KZ official "Статья 44 пункт 3. Полномочия Президента прекращаются с момента вступления в должность вновь избранного Президента";
    }

    rule PowersTerminatedByResignation(president: President) strict {
        when president(president);
        when president_resigned(president);
        then presidential_powers_terminated(president);
        label ru-KZ official "Статья 44 пункт 3. Полномочия Президента прекращаются в случае досрочного освобождения от должности в связи с добровольным уходом в отставку";
    }

    rule PowersTerminatedByHealthRelease(president: President) strict {
        when president(president);
        when president_released_from_office_for_health(president);
        then presidential_powers_terminated(president);
        label ru-KZ official "Статья 44 пункт 3. Полномочия Президента прекращаются в случае досрочного освобождения от должности при устойчивой неспособности осуществлять обязанности по состоянию здоровья";
    }

    rule PowersTerminatedByRemoval(president: President) strict {
        when president(president);
        when president_removed_from_office(president);
        then presidential_powers_terminated(president);
        label ru-KZ official "Статья 44 пункт 3. Полномочия Президента прекращаются в случае отрешения его от должности";
    }

    rule PowersTerminatedByDeath(president: President) strict {
        when president(president);
        when president_died(president);
        then presidential_powers_terminated(president);
        label ru-KZ official "Статья 44 пункт 3. Полномочия Президента прекращаются в случае смерти Президента";
    }

    // «Все бывшие Президенты, КРОМЕ ОТРЕШЁННЫХ от должности». Исключение выражено
    // не отрицанием, а ПЕРЕЧНЕМ оснований: ст. 44.3 сама называет четыре способа
    // прекращения полномочий помимо отрешения, и «все, кроме отрешённых» на этом
    // перечне тождественно «по любому из остальных оснований». Отрицание здесь
    // стоило бы дорого и молча: negation §118 требует УСТАНОВЛЕННОГО
    // отрицательного факта (умолчания замкнутого мира нет — §5.1), то есть каждое
    // дело обязано было бы доказывать, что Президент не был отрешён; без такого
    // факта правило не срабатывает вовсе — проверено вызовом. Негативная голова
    // (`не имеет звания`) — отдельное v1-ограничение и тоже отпадает.
    // Освобождение по здоровью ст. 50.2 звание НЕ отнимает: ст. 44.3 перечисляет
    // отставку, здоровье, отрешение и смерть порознь, а изымает из звания только
    // отрешение — поэтому основание «здоровье» стоит в перечне ниже.
    rule ExPresidentAfterNewPresident(president: President) strict {
        when former_president(president);
        when new_president_assumed_office(president);
        then ex_president(president);
        label ru-KZ official "Статья 44 пункт 3. Президент, полномочия которого прекратились с вступлением в должность вновь избранного, имеет звание экс-Президента";
    }

    rule ExPresidentAfterResignation(president: President) strict {
        when former_president(president);
        when president_resigned(president);
        then ex_president(president);
        label ru-KZ official "Статья 44 пункт 3. Президент, ушедший в отставку добровольно, имеет звание экс-Президента";
    }

    rule ExPresidentAfterHealthRelease(president: President) strict {
        when former_president(president);
        when president_released_from_office_for_health(president);
        then ex_president(president);
        label ru-KZ official "Статья 44 пункт 3. Президент, освобождённый от должности по состоянию здоровья, имеет звание экс-Президента";
    }
}

// --- Ст. 50.2. Досрочное освобождение по состоянию здоровья ---------------

relation health_removal_case(removal: HealthRemoval) kind empirical {
    label ru-KZ official "рассматривается вопрос о досрочном освобождении Президента по состоянию здоровья";
}
relation health_removal_target(removal: HealthRemoval, president: President) kind empirical {
    label ru-KZ official "вопрос о досрочном освобождении по здоровью касается данного Президента";
}
relation persistent_health_incapacity(removal: HealthRemoval) kind empirical {
    label ru-KZ official "устойчивая неспособность Президента осуществлять свои обязанности по состоянию здоровья";
}
relation medical_commission_formed(removal: HealthRemoval) kind empirical {
    label ru-KZ official "Курултай образовал комиссию из депутатов и специалистов в соответствующих областях медицины";
}
relation commission_conclusion_issued(removal: HealthRemoval) kind empirical {
    label ru-KZ official "комиссия дала заключение";
}
relation constitutional_court_procedure_confirmed_for_release(removal: HealthRemoval) kind empirical {
    label ru-KZ official "Конституционный Суд дал заключение о соблюдении установленных конституционных процедур";
}
relation health_removal_votes(removal: HealthRemoval, votes: Integer) kind empirical {
    label ru-KZ official "число голосов депутатов Курултая за досрочное освобождение по здоровью";
}
relation health_removal_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель доли голосов, необходимой для освобождения по здоровью";
}
relation health_removal_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель доли голосов, необходимой для освобождения по здоровью";
}
relation president_released_for_health(removal: HealthRemoval) kind institutional {
    label ru-KZ official "Президент досрочно освобождён от должности по состоянию здоровья";
}
relation president_released_from_office_for_health(president: President) kind institutional {
    label ru-KZ official "данный Президент досрочно освобождён от должности по состоянию здоровья";
}

// База доли — то же «общее число депутатов Курултая» ст. 53.1, что и у
// импичмента: величина установлена Конституцией, а не сообщается делом.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    rule HealthRemovalThreshold(
        removal: HealthRemoval,
        votes: Integer,
        total: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when health_removal_case(removal)
            and persistent_health_incapacity(removal)
            and medical_commission_formed(removal)
            and commission_conclusion_issued(removal)
            and constitutional_court_procedure_confirmed_for_release(removal)
            and health_removal_votes(removal, votes)
            and kurultai_seat_count(total)
            and health_removal_numerator(num)
            and health_removal_denominator(den)
            and (votes * den >= total * num);
        then president_released_for_health(removal);
        label ru-KZ official "Статья 50 пункт 2. Решение о досрочном освобождении принимается большинством не менее трёх четвертей голосов от общего числа депутатов на основании заключения комиссии и заключения Конституционного Суда";
    }

    rule PresidentReleasedFromOfficeForHealth(removal: HealthRemoval, president: President) strict {
        when health_removal_target(removal, president);
        when president_released_for_health(removal);
        then president_released_from_office_for_health(president);
        label ru-KZ official "Статья 50 пункт 2. Данный Президент досрочно освобождён от должности по состоянию здоровья";
    }
}

// --- Ст. 50.3, остаток. Стадия решения, отклонение обвинения, санкция -----

relation impeachment_question_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число голосов депутатов Курултая по вопросу о предъявлении обвинения и его расследовании";
}
relation impeachment_question_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель доли голосов, необходимой для решения по вопросу об обвинении";
}
relation impeachment_question_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель доли голосов, необходимой для решения по вопросу об обвинении";
}
relation impeachment_question_approved(impeachment: Impeachment) kind institutional {
    label ru-KZ official "Курултай принял решение по вопросу о предъявлении обвинения и его расследовании";
}
relation impeachment_reviewed_on(impeachment: Impeachment, day: Date) kind empirical {
    label ru-KZ official "день, на который проверяется состояние дела об обвинении";
}
relation impeachment_rejected_at_stage(impeachment: Impeachment) kind empirical {
    label ru-KZ official "обвинение отклонено Курултаем на одной из стадий";
}
relation final_decision_not_taken(impeachment: Impeachment) kind empirical {
    label ru-KZ official "окончательное решение по обвинению не принято";
}
relation impeachment_charge_rejected(impeachment: Impeachment) kind institutional {
    label ru-KZ official "обвинение Президента в государственной измене отклонено";
}
relation impeachment_initiating_deputy(impeachment: Impeachment, deputy: Person) kind empirical {
    label ru-KZ official "депутат Курултая инициировал рассмотрение вопроса об обвинении";
}
relation deputy_powers_terminated(deputy: Person) kind institutional {
    label ru-KZ official "полномочия депутата Курултая прекращены досрочно";
}
relation dissolution_question_under_consideration() kind empirical {
    label ru-KZ official "Президент рассматривает вопрос о досрочном прекращении полномочий Курултая";
}
relation impeachment_may_not_be_initiated(impeachment: Impeachment) kind institutional {
    label ru-KZ official "вопрос об отрешении Президента не может быть выдвинут";
}

// Стадия, которой у пакета не было: между инициативой одной трети и
// расследованием ст. 50.3 ставит РЕШЕНИЕ по вопросу большинством голосов.
// Три стадии вместо четырёх сливали два разных большинства в одно.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART50_RU") {
    rule ImpeachmentQuestionDecision(
        process: Impeachment,
        votes: Integer,
        total: Integer,
        num: Integer,
        den: Integer,
    ) strict {
        when impeachment_initiative_valid(process)
            and impeachment_question_votes(process, votes)
            and kurultai_seat_count(total)
            and impeachment_question_numerator(num)
            and impeachment_question_denominator(den)
            and (votes * den > total * num);
        then impeachment_question_approved(process);
        label ru-KZ official "Статья 50 пункт 3. Решение по вопросу о предъявлении обвинения и его расследовании принимается большинством голосов от общего числа депутатов Курултая";
    }

    // Три основания отклонения — снова §206. Оба срочных выражены сравнением дат
    // напрямую, без отрицания: «решение принято позже срока» и «срок истёк, а
    // решение не принято». Второе берёт факт непринятия из дела — отсутствие
    // решения в языке не выводимо (§5.1: умолчаний нет), а «решения нет» —
    // обстоятельство записи, а не правовой вывод.
    rule ChargeRejectedByLateDecision(process: Impeachment, due: Date, decided: Date) strict {
        when impeachment_final_decision_due_on(process, due)
            and final_decision_day(process, decided)
            and (decided > due);
        then impeachment_charge_rejected(process);
        label ru-KZ official "Статья 50 пункт 3. Окончательное решение, принятое позже двухмесячного срока, влечёт признание обвинения отклонённым";
    }

    rule ChargeRejectedByExpiredPeriod(process: Impeachment, due: Date, day: Date) strict {
        when impeachment_final_decision_due_on(process, due)
            and impeachment_reviewed_on(process, day)
            and final_decision_not_taken(process)
            and (day > due);
        then impeachment_charge_rejected(process);
        label ru-KZ official "Статья 50 пункт 3. Непринятие окончательного решения в течение двух месяцев с момента предъявления обвинения влечёт признание обвинения отклонённым";
    }

    rule ChargeRejectedAtStage(process: Impeachment) strict {
        when impeachment_case(process);
        when impeachment_rejected_at_stage(process);
        then impeachment_charge_rejected(process);
        label ru-KZ official "Статья 50 пункт 3. Обвинение отклонено на одной из стадий его рассмотрения";
    }

    // «На любой его стадии» держится тем, что санкция читает ОБЩИЙ предикат
    // отклонения, а не конкретную стадию: любое из трёх оснований выше влечёт
    // одно и то же последствие для инициаторов.
    rule RejectedChargeTerminatesInitiators(process: Impeachment, deputy: Person) strict {
        when impeachment_charge_rejected(process);
        when impeachment_initiating_deputy(process, deputy);
        then deputy_powers_terminated(deputy);
        label ru-KZ official "Статья 50 пункт 3. Отклонение обвинения на любой стадии влечёт досрочное прекращение полномочий депутатов Курултая, инициировавших рассмотрение данного вопроса";
    }

    // --- Ст. 50.4. Барьер, зеркальный барьеру ст. 62.3 ------------------------
    //
    // ЦЕНА ЭТОГО ГАРДА названа прямо. Отрицание §118 требует установленного
    // отрицательного факта, поэтому каждое дело об отрешении обязано заявить, что
    // вопрос о роспуске Курултая не рассматривается; забыв факт, дело получит
    // NEITHER, а не молчаливое «инициатива прошла». Отказ безопасен в правильную
    // сторону, и он виден на деле. Альтернатива — смоделировать саму инициативу
    // ПОЛНОМОЧИЕМ депутатов и вернуть иммунитет: тогда барьер снова заработал бы
    // механизмом §128 без единого отрицания. Это перестройка действующего
    // правила, на которое опирается вся цепочка ст. 50.3, и она не делалась здесь
    // сознательно — форма инициативы как полномочия есть отдельное решение.
    //
    // Механизм здесь ДРУГОЙ, чем у ст. 62.3, и это не выбор автора. Барьер
    // роспуска выражен иммунитетом с приоритетом, потому что противостоит
    // ПОЛНОМОЧИЮ: §128 разрешает пару power/immunity. Ст. 50.4 противостоит
    // обычному правилу с литеральной головой (`impeachment_initiative_valid`), а
    // приоритет над strict-правилом — `LDC-E4105` (§114: приоритеты живут между
    // defeasible, а strict — логическая категория). Иммунитет здесь и по существу
    // нечего блокировать: инициатива не осуществление полномочия. Поэтому барьер
    // выражен собственной нормой и гардом в правиле инициативы — в отличие от
    // пакета 1995, где `impeachment_may_not_be_initiated_1995` выводится и ничего
    // не останавливает.
    rule ImpeachmentBarredDuringDissolutionConsideration(
        process: Impeachment,
        president: President,
    ) strict {
        when president(president);
        when impeachment_target(process, president);
        when dissolution_question_under_consideration();
        then impeachment_may_not_be_initiated(process);
        label ru-KZ official "Статья 50 пункт 4. Вопрос об отрешении Президента от должности не может быть выдвинут в период рассмотрения им вопроса о досрочном прекращении полномочий Курултая";
    }
}

// ═════════════════════════════════════════════════════════════════════════
// Ст. 46, подпункты 1, 5, 6, 7, 9, 12–16, 19–22 (28.08.2026).
//
// Четырнадцать подпунктов, у которых не было НИ ОДНОГО узла. Пакет при этом
// показывал ст. 46 как EXECUTABLE: якорь стоит на статью, и семь правил из
// двадцати двух подпунктов от двадцати двух неотличимы — мера §33.1 этого
// различия не видит по построению.
//
// ФОРМА. Почти все подпункты — КОМПЕТЕНЦИИ: «Президент назначает», «образует»,
// «осуществляет помилование». Это `power` §127, а не правило-переложение:
// у полномочия есть носитель, осуществление и эффект, и вопрос «вправе ли»
// отвечается позицией, а не истинностью факта. Условия осуществления
// Конституция по большинству подпунктов не ставит вовсе — они делегированы
// законам, — поэтому `valid_when` там держит должность носителя, как это уже
// сделано у ReferendumPower. Пустым `valid_when` быть НЕ МОЖЕТ: `lawc check`
// такой power пропускает, а `lower` отвергает (`LDC-E1305`).
//
// ЗАКРЫТЫЕ ПЕРЕЧНИ держатся нормативными фактами §71, а НЕ типом. Первая
// редакция этого раздела объявляла перечень подпункта 5 через `enum` и
// утверждала, что тип проверяется компилятором. Это неверно, и проверено
// исполнением: перечисление в 0.1 — чистый словарь, потребителя в семантике
// нет ни одного (DECISION-0047, «в lawref/…/evaluator/ слова enum нет»), а
// утверждения дела не типизируются вовсе — на месте должности из перечня
// одинаково проходят должность вне перечня, Integer, Date и произвольная
// сущность, и ни одного issue при этом не звучит. Поэтому десять должностей
// подпункта 5 и семь видов отличий подпункта 14 объявлены КОНСТАНТАМИ §54 с
// фактом принадлежности, который правило обязано прочитать: должность вне
// перечня факта не имеет, и полномочие не возникает.
//
// Перечисления ниже оставлены там, где перечень открыт либо не меняет
// последствия (действие подпункта 6, вид органа подпункта 21): они несут
// словарь и вербализацию, а не ограничение, и это здесь сказано прямо.
// ═════════════════════════════════════════════════════════════════════════

entity PresidentialAddress {
    label ru-KZ official "послание Президента народу Казахстана";
}
entity OfficeRelease {
    label ru-KZ official "освобождение от должности";
}
entity StateBodyAct {
    label ru-KZ official "акт об образовании, упразднении или реорганизации государственного органа";
}
entity AdvisoryBody {
    label ru-KZ official "консультативно-совещательный либо иной орган, образуемый Президентом";
}
entity MissionHead {
    label ru-KZ official "глава дипломатического представительства Республики Казахстан";
}
entity InternationalTreaty {
    label ru-KZ official "международный договор Республики Казахстан";
}
entity RatificationInstrument {
    label ru-KZ official "ратификационная грамота";
}
entity Credentials {
    label ru-KZ official "верительная либо отзывная грамота главы дипломатического представительства или международной организации";
}
entity AwardEstablishment {
    label ru-KZ official "учреждение государственной награды либо почётного звания";
}
entity Distinction {
    label ru-KZ official "присуждаемая Президентом награда, звание, чин, ранг либо квалификационный класс";
}
entity CitizenshipMatter {
    label ru-KZ official "вопрос гражданства Республики Казахстан";
}
entity AsylumMatter {
    label ru-KZ official "вопрос предоставления политического убежища";
}
entity PardonMatter {
    label ru-KZ official "ходатайство о помиловании";
}
entity ConferredPower {
    label ru-KZ official "полномочие Президента, установленное Конституцией либо законом";
}

// Подпункт 5: перечень закрыт самой Конституцией — десять должностей, ни
// одной сверх. Сущность плюс константы §54 плюс факт принадлежности; форма
// взята у «Жеті жарғы» (`const Tuye: MalUnit = entity_ref(...)`).
entity PresidentialOffice {
    label ru-KZ official "должность, назначение на которую Президент производит самостоятельно";
}

const ConstitutionalCourtChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#ConstitutionalCourtChair") {
    label ru-KZ official "Председатель Конституционного Суда";
};
const SupremeCourtChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#SupremeCourtChair") {
    label ru-KZ official "Председатель Верховного Суда";
};
const NationalBankChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#NationalBankChair") {
    label ru-KZ official "Председатель Национального Банка";
};
const ProsecutorGeneral: PresidentialOffice = entity_ref("urn:kz:constitution:president#ProsecutorGeneral") {
    label ru-KZ official "Генеральный Прокурор";
};
const NationalSecurityCommitteeChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#NationalSecurityCommitteeChair") {
    label ru-KZ official "Председатель Комитета национальной безопасности";
};
const CentralElectionCommissionChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#CentralElectionCommissionChair") {
    label ru-KZ official "Председатель Центральной избирательной комиссии";
};
const SupremeAuditChamberChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#SupremeAuditChamberChair") {
    label ru-KZ official "Председатель Высшей аудиторской палаты";
};
const SupremeJudicialCouncilChair: PresidentialOffice = entity_ref("urn:kz:constitution:president#SupremeJudicialCouncilChair") {
    label ru-KZ official "Председатель Высшего Судебного Совета";
};
const StateGuardServiceHead: PresidentialOffice = entity_ref("urn:kz:constitution:president#StateGuardServiceHead") {
    label ru-KZ official "Начальник Службы государственной охраны Республики Казахстан";
};
const HumanRightsCommissioner: PresidentialOffice = entity_ref("urn:kz:constitution:president#HumanRightsCommissioner") {
    label ru-KZ official "Уполномоченный по правам человека в Республике Казахстан";
};

entity DistinctionKind {
    label ru-KZ official "вид отличия, присуждаемого Президентом";
}

const StateAward: DistinctionKind = entity_ref("urn:kz:constitution:president#StateAward") {
    label ru-KZ official "государственная награда";
};
const HonoraryTitle: DistinctionKind = entity_ref("urn:kz:constitution:president#HonoraryTitle") {
    label ru-KZ official "почётное звание";
};
const HigherMilitaryRank: DistinctionKind = entity_ref("urn:kz:constitution:president#HigherMilitaryRank") {
    label ru-KZ official "высшее воинское звание";
};
const OtherRank: DistinctionKind = entity_ref("urn:kz:constitution:president#OtherRank") {
    label ru-KZ official "иное звание";
};
const ClassRank: DistinctionKind = entity_ref("urn:kz:constitution:president#ClassRank") {
    label ru-KZ official "классный чин";
};
const DiplomaticRank: DistinctionKind = entity_ref("urn:kz:constitution:president#DiplomaticRank") {
    label ru-KZ official "дипломатический ранг";
};
const QualificationClass: DistinctionKind = entity_ref("urn:kz:constitution:president#QualificationClass") {
    label ru-KZ official "квалификационный класс";
};

// Подпункт 6: три действия названы порознь, и они не синонимы; последствие у
// них одно, поэтому перечисление здесь словарное и дело не ограничивает.
enum StateBodyAction {
    label ru-KZ official "действие Президента в отношении подчинённого ему государственного органа";
    Establish;
    Abolish;
    Reorganise;
}

// Перечень видов отличий подпункта 14 объявлен константами выше — по той же
// причине, что и должности подпункта 5.

// Подпункт 21 называет три вида органов. Вид едет ДАННЫМИ, а не разбором
// варианта в теле правила: разбирать вариант перечисления в `when` корпус не
// умеет ни в одном пакете, и основания подпунктов 19, 20 и 21 поэтому
// разведены отдельными предикатами-связывателями, а не значением перечисления.
enum AdvisoryBodyKind {
    label ru-KZ official "вид органа, образуемого Президентом по подпункту 21";
    SecurityCouncil;
    SupremeJudicialCouncil;
    ConsultativeAdvisoryBody;
}

// Перечни подпунктов 5 и 14 как нормативные факты §71: правило читает
// принадлежность, и должность вне перечня полномочия не создаёт.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU") {
    assert presidential_appointment_office(ConstitutionalCourtChair);
    assert presidential_appointment_office(SupremeCourtChair);
    assert presidential_appointment_office(NationalBankChair);
    assert presidential_appointment_office(ProsecutorGeneral);
    assert presidential_appointment_office(NationalSecurityCommitteeChair);
    assert presidential_appointment_office(CentralElectionCommissionChair);
    assert presidential_appointment_office(SupremeAuditChamberChair);
    assert presidential_appointment_office(SupremeJudicialCouncilChair);
    assert presidential_appointment_office(StateGuardServiceHead);
    assert presidential_appointment_office(HumanRightsCommissioner);

    assert conferrable_distinction_kind(StateAward);
    assert conferrable_distinction_kind(HonoraryTitle);
    assert conferrable_distinction_kind(HigherMilitaryRank);
    assert conferrable_distinction_kind(OtherRank);
    assert conferrable_distinction_kind(ClassRank);
    assert conferrable_distinction_kind(DiplomaticRank);
    assert conferrable_distinction_kind(QualificationClass);
}

// --- Подпункт 1. Послания народу ------------------------------------------

relation presidential_address(address: PresidentialAddress) kind empirical {
    label ru-KZ official "послание Президента как предмет дела";
}
relation address_attempt(president: President, address: PresidentialAddress) kind empirical {
    label ru-KZ official "Президент обращается с посланием к народу Казахстана";
}
relation presidential_address_delivered(address: PresidentialAddress) kind institutional {
    label ru-KZ official "послание Президента народу Казахстана состоялось";
}

// --- Подпункт 5. Назначение и освобождение по закрытому перечню -----------

relation presidential_appointment_office(office: PresidentialOffice) kind institutional {
    key(office);
    label ru-KZ official "должность входит в перечень статьи 46 подпункта 5";
}
relation conferrable_distinction_kind(kind: DistinctionKind) kind institutional {
    key(kind);
    label ru-KZ official "вид отличия входит в перечень статьи 46 подпункта 14";
}
relation office_appointment(appointment: Appointment, office: PresidentialOffice) kind empirical {
    label ru-KZ official "назначение производится на названную статьёй должность";
}
relation office_release(release: OfficeRelease, office: PresidentialOffice) kind empirical {
    label ru-KZ official "освобождение производится с названной статьёй должности";
}
relation office_appointment_attempt(president: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент назначает на должность из перечня подпункта 5";
}
relation office_release_attempt(president: President, release: OfficeRelease) kind empirical {
    label ru-KZ official "Президент освобождает от должности из перечня подпункта 5";
}
relation office_appointment_effective(appointment: Appointment) kind institutional {
    label ru-KZ official "назначение на должность состоялось";
}
relation office_release_effective(release: OfficeRelease) kind institutional {
    label ru-KZ official "освобождение от должности состоялось";
}

// --- Подпункт 6. Органы, подчинённые Президенту, и их руководители --------

relation state_body_act(act: StateBodyAct, body_action: StateBodyAction) kind empirical {
    label ru-KZ official "акт об образовании, упразднении либо реорганизации государственного органа";
}
relation body_subordinate_to_president(act: StateBodyAct) kind empirical {
    label ru-KZ official "государственный орган непосредственно подчинён и подотчётен Президенту";
}
relation state_body_act_attempt(president: President, act: StateBodyAct) kind empirical {
    label ru-KZ official "Президент образует, упраздняет либо реорганизует государственный орган";
}
relation state_body_act_effective(act: StateBodyAct) kind institutional {
    label ru-KZ official "образование, упразднение либо реорганизация государственного органа состоялись";
}
relation subordinate_body_head_appointment(appointment: Appointment, act: StateBodyAct) kind empirical {
    label ru-KZ official "назначение касается руководителя органа, подчинённого Президенту";
}
relation body_head_appointment_attempt(president: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент назначает руководителя подчинённого ему органа";
}
relation body_head_appointment_effective(appointment: Appointment) kind institutional {
    label ru-KZ official "назначение руководителя подчинённого Президенту органа состоялось";
}
relation subordinate_body_head_release(release: OfficeRelease, act: StateBodyAct) kind empirical {
    label ru-KZ official "освобождение касается руководителя органа, подчинённого Президенту";
}
relation body_head_release_attempt(president: President, release: OfficeRelease) kind empirical {
    label ru-KZ official "Президент освобождает от должности руководителя подчинённого ему органа";
}
relation body_head_release_effective(release: OfficeRelease) kind institutional {
    label ru-KZ official "освобождение руководителя подчинённого Президенту органа состоялось";
}

// --- Подпункт 7. Главы дипломатических представительств -------------------

relation diplomatic_mission_head(head: MissionHead) kind empirical {
    label ru-KZ official "глава дипломатического представительства как предмет дела";
}
relation mission_head_appointment_attempt(president: President, head: MissionHead) kind empirical {
    label ru-KZ official "Президент назначает главу дипломатического представительства";
}
relation mission_head_recall_attempt(president: President, head: MissionHead) kind empirical {
    label ru-KZ official "Президент отзывает главу дипломатического представительства";
}
relation mission_head_appointed(head: MissionHead) kind institutional {
    label ru-KZ official "глава дипломатического представительства назначен";
}
relation mission_head_recalled(head: MissionHead) kind institutional {
    label ru-KZ official "глава дипломатического представительства отозван";
}

// --- Подпункт 9. Верховный Главнокомандующий и высшее командование --------

relation president_is_commander_in_chief(president: President) kind institutional {
    label ru-KZ official "Президент является Верховным Главнокомандующим Вооружёнными Силами Республики Казахстан";
}
relation high_command_appointment(appointment: Appointment) kind empirical {
    label ru-KZ official "назначение касается высшего командования Вооружённых Сил";
}
relation high_command_release(release: OfficeRelease) kind empirical {
    label ru-KZ official "освобождение касается высшего командования Вооружённых Сил";
}
relation high_command_appointment_attempt(president: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент назначает на должность высшего командования Вооружённых Сил";
}
relation high_command_release_attempt(president: President, release: OfficeRelease) kind empirical {
    label ru-KZ official "Президент освобождает от должности высшего командования Вооружённых Сил";
}
relation high_command_appointment_effective(appointment: Appointment) kind institutional {
    label ru-KZ official "назначение на должность высшего командования состоялось";
}
relation high_command_release_effective(release: OfficeRelease) kind institutional {
    label ru-KZ official "освобождение от должности высшего командования состоялось";
}

// --- Подпункт 12. Договоры, ратификационные и верительные грамоты ----------

relation international_treaty(treaty: InternationalTreaty) kind empirical {
    label ru-KZ official "международный договор как предмет дела";
}
relation treaty_signature_attempt(president: President, treaty: InternationalTreaty) kind empirical {
    label ru-KZ official "Президент ведёт переговоры и подписывает международный договор от имени Республики Казахстан";
}
relation treaty_signed_on_behalf_of_republic(treaty: InternationalTreaty) kind institutional {
    label ru-KZ official "международный договор подписан от имени Республики Казахстан";
}
relation ratification_instrument(instrument: RatificationInstrument) kind empirical {
    label ru-KZ official "ратификационная грамота как предмет дела";
}
relation ratification_signature_attempt(president: President, instrument: RatificationInstrument) kind empirical {
    label ru-KZ official "Президент подписывает ратификационную грамоту";
}
relation ratification_instrument_signed(instrument: RatificationInstrument) kind institutional {
    label ru-KZ official "ратификационная грамота подписана";
}
relation credentials(letter: Credentials) kind empirical {
    label ru-KZ official "верительная либо отзывная грамота как предмет дела";
}
relation credentials_acceptance_attempt(president: President, letter: Credentials) kind empirical {
    label ru-KZ official "Президент принимает верительную либо отзывную грамоту";
}
relation credentials_accepted(letter: Credentials) kind institutional {
    label ru-KZ official "верительная либо отзывная грамота принята";
}

// --- Подпункты 13 и 14. Учреждение и присуждение отличий ------------------

relation award_establishment(establishment: AwardEstablishment) kind empirical {
    label ru-KZ official "учреждение государственной награды либо почётного звания как предмет дела";
}
relation award_establishment_attempt(president: President, establishment: AwardEstablishment) kind empirical {
    label ru-KZ official "Президент учреждает государственную награду либо почётное звание";
}
relation award_established(establishment: AwardEstablishment) kind institutional {
    label ru-KZ official "государственная награда либо почётное звание учреждены";
}
relation distinction_kind(distinction: Distinction, kind: DistinctionKind) kind empirical {
    label ru-KZ official "вид присуждаемого отличия";
}
relation distinction_attempt(president: President, distinction: Distinction) kind empirical {
    label ru-KZ official "Президент награждает, присваивает звание, чин, ранг либо квалификационный класс";
}
relation distinction_conferred(distinction: Distinction) kind institutional {
    label ru-KZ official "отличие присуждено";
}

// --- Подпункты 15 и 16. Гражданство, убежище, помилование -----------------

relation citizenship_matter(matter: CitizenshipMatter) kind empirical {
    label ru-KZ official "вопрос гражданства как предмет дела";
}
relation citizenship_decision_attempt(president: President, matter: CitizenshipMatter) kind empirical {
    label ru-KZ official "Президент решает вопрос гражданства Республики Казахстан";
}
relation citizenship_matter_decided(matter: CitizenshipMatter) kind institutional {
    label ru-KZ official "вопрос гражданства решён";
}
relation asylum_matter(matter: AsylumMatter) kind empirical {
    label ru-KZ official "вопрос предоставления политического убежища как предмет дела";
}
relation asylum_decision_attempt(president: President, matter: AsylumMatter) kind empirical {
    label ru-KZ official "Президент решает вопрос предоставления политического убежища";
}
relation asylum_matter_decided(matter: AsylumMatter) kind institutional {
    label ru-KZ official "вопрос предоставления политического убежища решён";
}
relation pardon_matter(matter: PardonMatter) kind empirical {
    label ru-KZ official "ходатайство о помиловании как предмет дела";
}
relation pardon_attempt(president: President, matter: PardonMatter) kind empirical {
    label ru-KZ official "Президент осуществляет помилование";
}
relation pardon_granted(matter: PardonMatter) kind institutional {
    label ru-KZ official "помилование осуществлено";
}

// --- Подпункты 19–21. Органы, формируемые Президентом ---------------------

relation state_guard_service(body: AdvisoryBody) kind empirical {
    label ru-KZ official "Служба государственной охраны как предмет дела";
}
relation presidential_administration(body: AdvisoryBody) kind empirical {
    label ru-KZ official "Администрация Президента как предмет дела";
}
relation advisory_body(body: AdvisoryBody, kind: AdvisoryBodyKind) kind empirical {
    label ru-KZ official "орган, образуемый Президентом по подпункту 21, и его вид";
}
relation body_formation_attempt(president: President, body: AdvisoryBody) kind empirical {
    label ru-KZ official "Президент формирует либо образует орган";
}
relation state_guard_service_formed(body: AdvisoryBody) kind institutional {
    label ru-KZ official "Служба государственной охраны, подчинённая Президенту, сформирована";
}
relation presidential_administration_formed(body: AdvisoryBody) kind institutional {
    label ru-KZ official "Администрация Президента Республики Казахстан сформирована";
}
relation presidential_body_established(body: AdvisoryBody) kind institutional {
    label ru-KZ official "Совет Безопасности, иной консультативно-совещательный орган либо Высший Судебный Совет образованы";
}

// --- Подпункт 22. Иные полномочия ----------------------------------------

relation power_conferred_by_constitution_or_law(item: ConferredPower) kind empirical {
    label ru-KZ official "полномочие Президента установлено Конституцией либо законом Республики Казахстан";
}
relation conferred_power_attempt(president: President, item: ConferredPower) kind empirical {
    label ru-KZ official "Президент осуществляет полномочие, установленное Конституцией либо законом";
}
relation conferred_power_exercised(item: ConferredPower) kind institutional {
    label ru-KZ official "полномочие, установленное Конституцией либо законом, осуществлено";
}

// --- Правила подпунктов 1, 5, 6, 7, 9, 12–16, 19–22 -----------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART46_RU") {
    rule PresidentialAddressPower(president: President, address: PresidentialAddress) strict {
        when president(president);
        when presidential_address(address);
        then power AddressThePeople {
            holder president;
            exercise address_attempt(president, address);
            valid_when president(president);
            effect presidential_address_delivered(address);
        };
        label ru-KZ official "Статья 46 подпункт 1. Президент обращается с посланиями к народу Казахстана о положении в стране и основных направлениях внутренней и внешней политики";
    }

    rule PresidentialOfficeAppointmentPower(
        president: President,
        appointment: Appointment,
        office: PresidentialOffice,
    ) strict {
        when president(president);
        when office_appointment(appointment, office);
        when presidential_appointment_office(office);
        then power AppointToPresidentialOffice {
            holder president;
            exercise office_appointment_attempt(president, appointment);
            valid_when office_appointment(appointment, office);
            effect office_appointment_effective(appointment);
        };
        label ru-KZ official "Статья 46 подпункт 5. Президент назначает на должности Председателя Конституционного Суда, Председателя Верховного Суда, Председателя Национального Банка, Генерального Прокурора, Председателя Комитета национальной безопасности, Председателя Центральной избирательной комиссии, Председателя Высшей аудиторской палаты, Председателя Высшего Судебного Совета, Начальника Службы государственной охраны и Уполномоченного по правам человека";
    }

    rule PresidentialOfficeReleasePower(
        president: President,
        release: OfficeRelease,
        office: PresidentialOffice,
    ) strict {
        when president(president);
        when office_release(release, office);
        when presidential_appointment_office(office);
        then power ReleaseFromPresidentialOffice {
            holder president;
            exercise office_release_attempt(president, release);
            valid_when office_release(release, office);
            effect office_release_effective(release);
        };
        label ru-KZ official "Статья 46 подпункт 5. Президент освобождает от должностей лиц, названных в перечне подпункта 5";
    }

    rule SubordinateBodyOrganisationPower(
        president: President,
        act: StateBodyAct,
        body_action: StateBodyAction,
    ) strict {
        when president(president);
        when state_body_act(act, body_action);
        when body_subordinate_to_president(act);
        then power OrganiseSubordinateBody {
            holder president;
            exercise state_body_act_attempt(president, act);
            valid_when body_subordinate_to_president(act);
            effect state_body_act_effective(act);
        };
        label ru-KZ official "Статья 46 подпункт 6. Президент образует, упраздняет и реорганизует государственные органы, непосредственно подчинённые и подотчётные Президенту";
    }

    rule SubordinateBodyHeadAppointmentPower(
        president: President,
        appointment: Appointment,
        act: StateBodyAct,
    ) strict {
        when president(president);
        when subordinate_body_head_appointment(appointment, act);
        when body_subordinate_to_president(act);
        then power AppointSubordinateBodyHead {
            holder president;
            exercise body_head_appointment_attempt(president, appointment);
            valid_when body_subordinate_to_president(act);
            effect body_head_appointment_effective(appointment);
        };
        label ru-KZ official "Статья 46 подпункт 6. Президент назначает на должности руководителей подчинённых ему государственных органов";
    }

    rule MissionHeadAppointmentPower(president: President, head: MissionHead) strict {
        when president(president);
        when diplomatic_mission_head(head);
        then power AppointMissionHead {
            holder president;
            exercise mission_head_appointment_attempt(president, head);
            valid_when president(president);
            effect mission_head_appointed(head);
        };
        label ru-KZ official "Статья 46 подпункт 7. Президент назначает глав дипломатических представительств Республики Казахстан";
    }

    rule MissionHeadRecallPower(president: President, head: MissionHead) strict {
        when president(president);
        when diplomatic_mission_head(head);
        then power RecallMissionHead {
            holder president;
            exercise mission_head_recall_attempt(president, head);
            valid_when president(president);
            effect mission_head_recalled(head);
        };
        label ru-KZ official "Статья 46 подпункт 7. Президент отзывает глав дипломатических представительств Республики Казахстан";
    }

    rule HighCommandAppointmentPower(president: President, appointment: Appointment) strict {
        when president(president);
        when high_command_appointment(appointment);
        then power AppointHighCommand {
            holder president;
            exercise high_command_appointment_attempt(president, appointment);
            valid_when president_is_commander_in_chief(president);
            effect high_command_appointment_effective(appointment);
        };
        label ru-KZ official "Статья 46 подпункт 9. Президент назначает на должности высшее командование Вооружённых Сил";
    }

    rule HighCommandReleasePower(president: President, release: OfficeRelease) strict {
        when president(president);
        when high_command_release(release);
        then power ReleaseHighCommand {
            holder president;
            exercise high_command_release_attempt(president, release);
            valid_when president_is_commander_in_chief(president);
            effect high_command_release_effective(release);
        };
        label ru-KZ official "Статья 46 подпункт 9. Президент освобождает от должностей высшее командование Вооружённых Сил";
    }

    rule TreatySignaturePower(president: President, treaty: InternationalTreaty) strict {
        when president(president);
        when international_treaty(treaty);
        then power SignInternationalTreaty {
            holder president;
            exercise treaty_signature_attempt(president, treaty);
            valid_when president(president);
            effect treaty_signed_on_behalf_of_republic(treaty);
        };
        label ru-KZ official "Статья 46 подпункт 12. Президент ведёт переговоры и подписывает международные договоры от имени Республики Казахстан";
    }

    rule RatificationInstrumentPower(
        president: President,
        instrument: RatificationInstrument,
    ) strict {
        when president(president);
        when ratification_instrument(instrument);
        then power SignRatificationInstrument {
            holder president;
            exercise ratification_signature_attempt(president, instrument);
            valid_when president(president);
            effect ratification_instrument_signed(instrument);
        };
        label ru-KZ official "Статья 46 подпункт 12. Президент подписывает ратификационные грамоты";
    }

    rule CredentialsAcceptancePower(president: President, letter: Credentials) strict {
        when president(president);
        when credentials(letter);
        then power AcceptCredentials {
            holder president;
            exercise credentials_acceptance_attempt(president, letter);
            valid_when president(president);
            effect credentials_accepted(letter);
        };
        label ru-KZ official "Статья 46 подпункт 12. Президент принимает верительные и отзывные грамоты глав аккредитованных дипломатических представительств иностранных государств и глав международных организаций";
    }

    rule AwardEstablishmentPower(president: President, establishment: AwardEstablishment) strict {
        when president(president);
        when award_establishment(establishment);
        then power EstablishStateAward {
            holder president;
            exercise award_establishment_attempt(president, establishment);
            valid_when president(president);
            effect award_established(establishment);
        };
        label ru-KZ official "Статья 46 подпункт 13. Президент учреждает государственные награды и почётные звания";
    }

    rule DistinctionConferralPower(
        president: President,
        distinction: Distinction,
        kind: DistinctionKind,
    ) strict {
        when president(president);
        when distinction_kind(distinction, kind);
        when conferrable_distinction_kind(kind);
        then power ConferDistinction {
            holder president;
            exercise distinction_attempt(president, distinction);
            valid_when distinction_kind(distinction, kind);
            effect distinction_conferred(distinction);
        };
        label ru-KZ official "Статья 46 подпункт 14. Президент награждает государственными наградами, присваивает почётные звания, высшие воинские и иные звания, классные чины, дипломатические ранги и квалификационные классы";
    }

    rule CitizenshipDecisionPower(president: President, matter: CitizenshipMatter) strict {
        when president(president);
        when citizenship_matter(matter);
        then power DecideCitizenshipMatter {
            holder president;
            exercise citizenship_decision_attempt(president, matter);
            valid_when president(president);
            effect citizenship_matter_decided(matter);
        };
        label ru-KZ official "Статья 46 подпункт 15. Президент решает вопросы гражданства Республики Казахстан";
    }

    rule AsylumDecisionPower(president: President, matter: AsylumMatter) strict {
        when president(president);
        when asylum_matter(matter);
        then power GrantPoliticalAsylum {
            holder president;
            exercise asylum_decision_attempt(president, matter);
            valid_when president(president);
            effect asylum_matter_decided(matter);
        };
        label ru-KZ official "Статья 46 подпункт 15. Президент решает вопросы предоставления политического убежища";
    }

    rule PardonPower(president: President, matter: PardonMatter) strict {
        when president(president);
        when pardon_matter(matter);
        then power GrantPardon {
            holder president;
            exercise pardon_attempt(president, matter);
            valid_when president(president);
            effect pardon_granted(matter);
        };
        label ru-KZ official "Статья 46 подпункт 16. Президент осуществляет помилование";
    }

    rule ConferredPowerExercise(president: President, item: ConferredPower) strict {
        when president(president);
        when power_conferred_by_constitution_or_law(item);
        then power ExerciseConferredPower {
            holder president;
            exercise conferred_power_attempt(president, item);
            valid_when power_conferred_by_constitution_or_law(item);
            effect conferred_power_exercised(item);
        };
        label ru-KZ official "Статья 46 подпункт 22. Президент осуществляет другие полномочия в соответствии с Конституцией и законами Республики Казахстан";
    }

    // Подпункт 9, первая половина — СТАТУС, а не полномочие: «является Верховным
    // Главнокомандующим». Та же форма, что у статусов ст. 42, и она несёт вес:
    // оба полномочия над высшим командованием держат её в `valid_when`.
    rule PresidentIsCommanderInChief(president: President) strict {
        when president(president);
        then president_is_commander_in_chief(president);
        label ru-KZ official "Статья 46 подпункт 9. Президент является Верховным Главнокомандующим Вооружёнными Силами Республики Казахстан";
    }

    rule SubordinateBodyHeadReleasePower(
        president: President,
        release: OfficeRelease,
        act: StateBodyAct,
    ) strict {
        when president(president);
        when subordinate_body_head_release(release, act);
        when body_subordinate_to_president(act);
        then power ReleaseSubordinateBodyHead {
            holder president;
            exercise body_head_release_attempt(president, release);
            valid_when body_subordinate_to_president(act);
            effect body_head_release_effective(release);
        };
        label ru-KZ official "Статья 46 подпункт 6. Президент освобождает от должностей руководителей подчинённых ему государственных органов";
    }

    rule StateGuardServiceFormationPower(president: President, body: AdvisoryBody) strict {
        when president(president);
        when state_guard_service(body);
        then power FormStateGuardService {
            holder president;
            exercise body_formation_attempt(president, body);
            valid_when state_guard_service(body);
            effect state_guard_service_formed(body);
        };
        label ru-KZ official "Статья 46 подпункт 19. Президент формирует подчинённую ему Службу государственной охраны";
    }

    rule PresidentialAdministrationFormationPower(president: President, body: AdvisoryBody) strict {
        when president(president);
        when presidential_administration(body);
        then power FormPresidentialAdministration {
            holder president;
            exercise body_formation_attempt(president, body);
            valid_when presidential_administration(body);
            effect presidential_administration_formed(body);
        };
        label ru-KZ official "Статья 46 подпункт 20. Президент формирует Администрацию Президента Республики Казахстан";
    }

    rule AdvisoryBodyFormationPower(
        president: President,
        body: AdvisoryBody,
        kind: AdvisoryBodyKind,
    ) strict {
        when president(president);
        when advisory_body(body, kind);
        then power EstablishPresidentialBody {
            holder president;
            exercise body_formation_attempt(president, body);
            valid_when advisory_body(body, kind);
            effect presidential_body_established(body);
        };
        label ru-KZ official "Статья 46 подпункт 21. Президент образует Совет Безопасности, иные консультативно-совещательные органы, а также Высший Судебный Совет";
    }
}

