// Конституция РК 2026, раздел III (ст. 42–51): Президент.
// Числа ниже дословно сверены с закреплёнными ст. 43, 44, 46, 50, 51.
// Месячные сроки не заменяются произвольным числом дней: их соблюдение
// приходит как отдельный проверяемый факт календарной квалификации.

language "law.core" version "0.2";
package kz.constitution.president version "0.1.0";
namespace "urn:kz:constitution:president";

entity Person {
    label ru-KZ official "физическое лицо";
}
entity Candidate {
    label ru-KZ official "кандидат в Президенты";
}
entity President {
    label ru-KZ official "Президент Республики Казахстан";
}
entity StateAuthority {
    label ru-KZ official "государственный орган либо должностное лицо";
}
entity Kurultai {
    label ru-KZ official "Курултай Республики Казахстан";
}
entity Election {
    label ru-KZ official "выборы Президента";
}
entity Law {
    label ru-KZ official "закон, представленный Президенту";
}
entity Appointment {
    label ru-KZ official "назначение, производимое Президентом";
}
entity ConstitutionalPetition {
    label ru-KZ official "обращение в Конституционный Суд";
}
entity EmergencyMeasure {
    label ru-KZ official "мера чрезвычайного либо военного положения";
}
entity Impeachment {
    label ru-KZ official "производство об отрешении Президента от должности";
}
entity VicePresident {
    label ru-KZ official "Вице-Президент Республики Казахстан";
}
entity PresidentialAct {
    label ru-KZ official "акт Президента";
}
entity PresidentialVacancy {
    label ru-KZ official "досрочное освобождение должности Президента";
}
entity SuccessionRefusal {
    label ru-KZ official "отказ принять на себя полномочия Президента";
}
entity HealthRemoval {
    label ru-KZ official "рассмотрение вопроса о досрочном освобождении Президента от должности по состоянию здоровья";
}

relation candidate_person(candidate: Candidate, person: Person) kind empirical {
    label ru-KZ official "кандидат является данным лицом";
}
relation citizen_by_birth(person: Person) kind empirical {
    label ru-KZ official "лицо является гражданином Республики по рождению";
}
relation age_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "возраст лица в полных годах";
}
relation resides_last_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "число последних лет проживания в Казахстане";
}
relation state_service_or_elected_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "стаж работы на государственной службе либо на выборных государственных должностях";
}
relation higher_education(person: Person) kind empirical {
    label ru-KZ official "лицо имеет высшее образование";
}
relation fluent_in_state_language(person: Person) kind empirical {
    label ru-KZ official "лицо свободно владеет государственным языком";
}
relation eligible_presidential_candidate(candidate: Candidate) kind institutional {
    label ru-KZ official "лицо отвечает требованиям к кандидату в Президенты";
}

// Срок полномочий закреплён КАК QUANTITY, а не голым числом: §84.4 требует,
// чтобы единица оставалась видимой, а грамматика допускает единицу только у
// литерала (`quantity_literal = число, пробел, unit_symbol`) — из переменной
// Quantity не собрать. Поэтому единица едет вместе с закреплённой величиной,
// и правило истечения читает её целиком. Иначе число снова пришлось бы
// вписывать в тело правила — ровно та вторая копия, ради устранения которой
// заведены ворота ci/check_constitution_constants.py.
relation president_term(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок полномочий Президента — семь лет";
}
relation president_minimum_age(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "минимальный возраст Президента — сорок лет";
}
relation president_residence_years(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый срок проживания в Казахстане — пятнадцать лет";
}
relation president_experience_years(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый стаж работы — пять лет";
}
// Месячный срок — Quantity по той же причине, что и сроки полномочий:
// единица §84.4 остаётся видимой и едет вместе с величиной.
relation regular_oath_period(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок принесения присяги — один месяц";
}
relation succession_oath_days(days: Integer) kind institutional {
    key(days);
    label ru-KZ official "срок принесения присяги лицом, принявшим на себя полномочия Президента, — семь дней";
}
relation president_assumed_office_on(president: President, day: Date) kind empirical {
    label ru-KZ official "день вступления Президента в должность";
}
relation president_term_expires_on(president: President, day: Date) kind institutional {
    key(president);
    label ru-KZ official "день окончания срока полномочий Президента";
}
relation early_election_announcement_days(days: Integer) kind institutional {
    key(days);
    label ru-KZ official "срок объявления внеочередных выборов — семь дней";
}
relation impeachment_initiative_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога инициативы отрешения — одна треть";
}
relation impeachment_initiative_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога инициативы отрешения — одна треть";
}
relation impeachment_final_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога отрешения — три четверти";
}
relation impeachment_final_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога отрешения — три четверти";
}
relation impeachment_investigation_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога решения о расследовании — одна вторая";
}
relation impeachment_investigation_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога решения о расследовании — одна вторая";
}
relation presidential_election_majority_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога избрания Президента — одна вторая";
}
relation presidential_election_majority_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога избрания Президента — одна вторая";
}

relation presidential_election_attempt(election: Election, person: Person) kind empirical {
    label ru-KZ official "кандидат участвует в выборах Президента";
}
relation presidential_vote(election: Election, person: Person, votes: Integer) kind empirical {
    label ru-KZ official "число голосов, поданных за кандидата";
}
relation participating_voters(election: Election, voters: Integer) kind empirical {
    label ru-KZ official "число избирателей, принявших участие в голосовании";
}
relation previously_elected_president(person: Person) kind empirical {
    label ru-KZ official "лицо ранее избиралось Президентом Республики";
}
relation elected_president(person: Person) kind institutional {
    label ru-KZ official "лицо считается избранным Президентом";
}

relation president(authority: President) kind empirical {
    label ru-KZ official "лицо является Президентом Республики";
}
relation law_presented(law: Law, president: President) kind empirical {
    label ru-KZ official "закон представлен Президенту на подпись";
}
relation presidential_signature_attempt(president: President, law: Law) kind empirical {
    label ru-KZ official "Президент подписывает представленный закон";
}
relation presidential_return_attempt(president: President, law: Law) kind empirical {
    label ru-KZ official "Президент возвращает закон с возражениями";
}
// Ст. 46 п. 3: «подписывает представленный Курултаем закон в течение одного
// месяца». Срок вычисляется календарным шагом §86 (единица calendar_month,
// errata E-0026) — тем же способом, что присяга ст. 44.2. До 28.08.2026 он был
// эмпирическим фактом дела с величиной в ИМЕНИ предиката: дело сообщало вывод,
// ради которого норма существует.
relation presidential_signature_period(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок подписания представленного Курултаем закона — один месяц";
}
relation law_presented_on(law: Law, day: Date) kind empirical {
    label ru-KZ official "день представления закона Курултаем Президенту";
}
relation presidential_signature_day(law: Law, day: Date) kind empirical {
    label ru-KZ official "день подписания либо возврата закона Президентом";
}
relation presidential_signature_due_on(law: Law, day: Date) kind institutional {
    key(law);
    label ru-KZ official "день окончания месячного срока подписания закона";
}
relation presidential_signature_timely(law: Law) kind institutional {
    label ru-KZ official "закон подписан либо возвращён в пределах месячного срока";
}
relation law_signed(law: Law) kind institutional {
    label ru-KZ official "закон подписан Президентом";
}
relation law_returned_with_objections(law: Law) kind institutional {
    label ru-KZ official "закон возвращён в Курултай с возражениями";
}

// `appointment_candidate` СНЯТО 02.09.2026: ни одна норма раздела III не различает НАЗНАЧАЕМОЕ ЛИЦО (нормы говорят о назначении) и не выводит из самого факта объявления выборов — срок считает `early_election_announcement_day`
relation appointment_requires_kurultai_consent(appointment: Appointment) kind empirical {
    label ru-KZ official "назначение производится с согласия Курултая";
}
relation kurultai_majority_consent(appointment: Appointment) kind empirical {
    label ru-KZ official "Курултай дал согласие на назначение большинством голосов";
}
relation presidential_appointment_attempt(president: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент производит назначение";
}
relation appointment_effective(appointment: Appointment) kind institutional {
    label ru-KZ official "назначение состоялось";
}

relation repeated_refusal_of_presidential_nominee(kurultai: Kurultai) kind empirical {
    label ru-KZ official "Курултай повторно отказал в согласии на предложенную Президентом кандидатуру";
}
relation required_consultations_completed(kurultai: Kurultai) kind empirical {
    label ru-KZ official "проведены требуемые консультации перед роспуском Курултая";
}
relation emergency_or_martial_law_active() kind empirical {
    label ru-KZ official "действует чрезвычайное либо военное положение";
}
// Ст. 62 п. 3: «в последние шесть месяцев полномочий Президента, в течение
// одного года после предыдущего роспуска». Обе величины вычисляются шагом §86
// от даты, на которую ставится вопрос о роспуске; раньше оба основания
// приходили готовыми булевыми фактами, то есть дело само отвечало, защищён
// Курултай или нет.
relation dissolution_final_period(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "защищённый период перед окончанием полномочий Президента — шесть месяцев";
}
relation dissolution_interval_after_prior(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок, в течение которого Курултай не распускается после предыдущего роспуска, — один год";
}
relation dissolution_considered_on(day: Date) kind empirical {
    label ru-KZ official "день, на который ставится вопрос о роспуске Курултая";
}
relation prior_dissolution_on(day: Date) kind empirical {
    label ru-KZ official "день предыдущего роспуска Курултая";
}
relation in_final_period_of_presidential_term() kind institutional {
    label ru-KZ official "вопрос о роспуске поставлен в последние шесть месяцев полномочий Президента";
}
relation within_period_after_prior_dissolution() kind institutional {
    label ru-KZ official "со дня предыдущего роспуска Курултая не прошёл один год";
}
relation succession_president_in_office() kind empirical {
    label ru-KZ official "полномочия Президента осуществляет лицо, принявшее их в порядке замещения";
}
// §190: норм-голова обязана связывать носителя позитивным established-конъюнктом
// конечного источника. У Президента это `president(authority)`; у Курултая такого
// отношения не было, и правило-барьер ниже отвергалось как не range-restricted
// (LDC-E4101) — при том что `lawc check` на пакете красный, а регрессия зелёная:
// норма просто отсутствовала в выводе.
relation kurultai(kurultai: Kurultai) kind empirical {
    label ru-KZ official "орган является Курултаем";
}
relation dissolution_attempt(president: President, kurultai: Kurultai) kind empirical {
    label ru-KZ official "Президент распускает Курултай";
}
relation kurultai_dissolved(kurultai: Kurultai) kind institutional {
    label ru-KZ official "Курултай распущен";
}

relation referendum_decision_attempt(president: President) kind empirical {
    label ru-KZ official "Президент принимает решение о проведении референдума";
}
relation referendum_called() kind institutional {
    label ru-KZ official "всенародный референдум назначен";
}
// §190, тот же дефект, что был у Курултая выше: носитель нормы обязан
// связываться позитивным established-конъюнктом, а `exercise`/`effect`
// связывания не дают. У ст. 46 пп. 11, 17 и 18 объекта полномочия — обращения
// и меры — в теле не было вовсе, и три правила отвергались как не
// range-restricted (LDC-E4101). При этом `lower` их пропускал: CLIR содержал
// все три, `lawc check` был красным, регрессия — зелёной, а на исполнении
// нормы отвечали NEITHER при полном наборе посылок. Существование объекта
// в деле выражается отдельным эмпирическим предикатом, как `president`,
// `kurultai` и `vice_president`.
relation constitutional_petition(petition: ConstitutionalPetition) kind empirical {
    label ru-KZ official "обращение Президента в Конституционный Суд как предмет дела";
}
relation constitutional_review_petition_attempt(president: President, petition: ConstitutionalPetition) kind empirical {
    label ru-KZ official "Президент обращается в Конституционный Суд";
}
relation constitutional_review_requested(petition: ConstitutionalPetition) kind institutional {
    label ru-KZ official "конституционный контроль инициирован Президентом";
}
relation immediate_constitutional_threat() kind empirical {
    label ru-KZ official "налицо непосредственная угроза конституционному строю, правопорядку либо безопасности";
}
relation emergency_consultations_completed() kind empirical {
    label ru-KZ official "проведены требуемые консультации перед введением чрезвычайного положения";
}
// Одна сущность на оба основания: ст. 46 пп. 17 и 18 различаются условиями
// принятия, а не видом акта, и оба `_attempt` уже типизированы EmergencyMeasure.
relation emergency_measure(measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "мера, принимаемая Президентом в условиях чрезвычайного положения либо военного положения";
}
relation emergency_measure_attempt(president: President, measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "Президент вводит меры чрезвычайного положения";
}
relation emergency_measure_in_force(measure: EmergencyMeasure) kind institutional {
    label ru-KZ official "меры чрезвычайного положения введены правомерно";
}
relation aggression_or_immediate_external_threat() kind empirical {
    label ru-KZ official "налицо агрессия против Республики либо непосредственная внешняя угроза";
}
relation kurultai_immediately_informed() kind empirical {
    label ru-KZ official "Курултай незамедлительно проинформирован о принятых мерах";
}
relation martial_measure_attempt(president: President, measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "Президент вводит военное положение";
}
relation martial_measure_in_force(measure: EmergencyMeasure) kind institutional {
    label ru-KZ official "военное положение введено правомерно";
}

// Ст. 53.1 и ст. 50: база порогов импичмента — «общее число депутатов
// Курултая», а оно установлено Конституцией (сто сорок пять), а не
// сообщается делом. Кросс-пакетных импортов у корпуса пока нет (WP-35),
// поэтому величина объявлена здесь со СВОИМ якорем в ту же ст. 53;
// согласие копий по значению и якорю проверяет ci/check_constitution_constants.py.
relation kurultai_seat_count(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "общее число депутатов Курултая — сто сорок пять";
}

relation impeachment_case(impeachment: Impeachment) kind empirical {
    label ru-KZ official "производство является производством об отрешении Президента от должности";
}
relation impeachment_initiating_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число депутатов Курултая, инициировавших отрешение";
}
relation investigation_approved_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число голосов, поданных за возложение расследования обвинения";
}
relation supreme_court_charge_supported(impeachment: Impeachment) kind empirical {
    label ru-KZ official "Верховный Суд подтвердил обоснованность обвинения";
}
relation constitutional_court_procedure_confirmed(impeachment: Impeachment) kind empirical {
    label ru-KZ official "Конституционный Суд подтвердил соблюдение установленной процедуры";
}
relation final_impeachment_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число голосов при окончательном решении об отрешении";
}
// Ст. 50 п. 3: «Непринятие окончательного решения в течение двух месяцев с
// момента предъявления обвинения». Срок считается от даты предъявления.
relation impeachment_final_decision_period(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок принятия окончательного решения по обвинению — два месяца";
}
relation charge_presented_on(impeachment: Impeachment, day: Date) kind empirical {
    label ru-KZ official "день предъявления Президенту обвинения в государственной измене";
}
relation final_decision_day(impeachment: Impeachment, day: Date) kind empirical {
    label ru-KZ official "день принятия Курултаем окончательного решения по обвинению";
}
relation impeachment_final_decision_due_on(impeachment: Impeachment, day: Date) kind institutional {
    key(impeachment);
    label ru-KZ official "день окончания двухмесячного срока на окончательное решение";
}
relation impeachment_final_decision_timely(impeachment: Impeachment) kind institutional {
    label ru-KZ official "окончательное решение принято в пределах двухмесячного срока";
}
relation impeachment_initiative_valid(impeachment: Impeachment) kind institutional {
    label ru-KZ official "инициатива об отрешении заявлена управомоченным числом депутатов";
}
relation impeachment_investigation_valid(impeachment: Impeachment) kind institutional {
    label ru-KZ official "расследование обвинения возложено правомерно";
}
relation president_removed_by_impeachment(impeachment: Impeachment) kind institutional {
    label ru-KZ official "Президент отрешён от должности";
}

// Ст. 51: замещение должности Президента. Четыре основания вакансии, очередь
// из трёх должностей и её условия, отказ через Конституционный Суд, семь дней
// на объявление выборов и запреты для принявшего полномочия.
relation vacancy_by_voluntary_resignation(vacancy: PresidentialVacancy) kind empirical {
    label ru-KZ official "должность освободилась вследствие добровольной отставки Президента";
}
relation vacancy_by_health_incapacity(vacancy: PresidentialVacancy) kind empirical {
    label ru-KZ official "должность освободилась вследствие устойчивой неспособности Президента по состоянию здоровья";
}
relation vacancy_by_removal_from_office(vacancy: PresidentialVacancy) kind empirical {
    label ru-KZ official "должность освободилась вследствие отрешения Президента";
}
relation vacancy_by_death(vacancy: PresidentialVacancy) kind empirical {
    label ru-KZ official "должность освободилась вследствие смерти Президента";
}
relation presidential_vacancy(vacancy: PresidentialVacancy) kind institutional {
    label ru-KZ official "должность Президента освободилась досрочно";
}

relation vacancy_vice_president(vacancy: PresidentialVacancy, holder: Person) kind empirical {
    label ru-KZ official "лицо занимает должность Вице-Президента на момент освобождения должности";
}
