    label ru-KZ official "имеет место коллективный трудовой спор";
    label kk-KZ official "ұжымдық еңбек дауы орын алды";
}
relation strike_action(person: Person, strike: Strike) kind empirical {
    label ru-KZ official "лицо участвует в забастовке";
    label kk-KZ official "адам ереуілге қатысады";
}
relation unemployment_social_protection_ground(person: Person) kind empirical {
    label ru-KZ official "налицо основание социальной защиты от безработицы";
    label kk-KZ official "жұмыссыздықтан әлеуметтік қорғаудың негізі бар";
}
relation unemployment_social_protection_provided(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "лицу предоставлена социальная защита от безработицы";
    label kk-KZ official "адамға жұмыссыздықтан әлеуметтік қорғау берілді";
}
relation employed_under_labour_contract(person: Person) kind empirical {
    label ru-KZ official "лицо работает по трудовому договору";
    label kk-KZ official "адам еңбек шарты бойынша жұмыс істейді";
}
relation annual_paid_leave_provided(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "лицу предоставлен оплачиваемый ежегодный отпуск";
    label kk-KZ official "адамға ақы төленетін жыл сайынғы демалыс берілді";
}

// Ст. 25 п. 2. Жильё за доступную плату из государственных фондов.
relation statutory_housing_need(need: HousingNeed, person: Person) kind empirical {
    label ru-KZ official "лицо отнесено законом к нуждающимся в жилище";
    label kk-KZ official "адам заңмен тұрғын үйге мұқтаждар қатарына жатқызылды";
}
relation affordable_state_housing_provided(need: HousingNeed, person: Person) kind empirical {
    label ru-KZ official "лицу предоставлено жильё из государственных жилищных фондов за доступную плату";
    label kk-KZ official "адамға мемлекеттік тұрғын үй қорларынан қолжетімді ақыға тұрғын үй берілді";
}

// Ст. 26 п. 4. Предпринимательство.
relation entrepreneurial_action(person: Person) kind empirical {
    label ru-KZ official "лицо осуществляет предпринимательскую деятельность";
    label kk-KZ official "адам кәсіпкерлік қызметпен айналысады";
}
relation unfair_competition(person: Person) kind empirical {
    label ru-KZ official "деятельность направлена на недобросовестную конкуренцию";
    label kk-KZ official "қызмет жосықсыз бәсекеге бағытталған";
}
relation unfair_competition_prohibited(person: Person) kind institutional {
    label ru-KZ official "недобросовестная конкуренция запрещена";
    label kk-KZ official "жосықсыз бәсекеге тыйым салынған";
}

// Ст. 27 п. 3. Забота совершеннолетних детей о нетрудоспособных родителях.
relation adult_capable_child_of(child: Child, parent: Parent) kind empirical {
    label ru-KZ official "совершеннолетний трудоспособный ребёнок данного родителя";
    label kk-KZ official "осы ата-ананың кәмелетке толған еңбекке қабілетті баласы";
}
relation parent_incapacitated(parent: Parent) kind empirical {
    label ru-KZ official "родитель нетрудоспособен";
    label kk-KZ official "ата-ана еңбекке қабілетсіз";
}
relation parent_care_provided(child: Child, parent: Parent) kind empirical {
    label ru-KZ official "совершеннолетние дети заботятся о нетрудоспособных родителях";
    label kk-KZ official "кәмелетке толған балалар еңбекке қабілетсіз ата-анасына қамқорлық жасайды";
}

// Ст. 29 п. 2. Бесплатный гарантированный объём медицинской помощи.
relation guaranteed_free_medical_care_provided(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "лицу предоставлен гарантированный объём бесплатной медицинской помощи";
    label kk-KZ official "адамға тегін медициналық көмектің кепілдік берілген көлемі берілді";
}

// Ст. 30. Образование.
relation secondary_education_stage(person: Person) kind empirical {
    label ru-KZ official "лицо получает среднее образование";
    label kk-KZ official "адам орта білім алуда";
}
relation higher_education_competition_won(person: Person) kind empirical {
    label ru-KZ official "лицо на конкурсной основе получило право на бесплатное высшее образование";
    label kk-KZ official "адам конкурстық негізде тегін жоғары білім алу құқығына ие болды";
}
relation free_higher_education_provided(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "лицу обеспечено бесплатное высшее образование в государственном учебном заведении";
    label kk-KZ official "адамға мемлекеттік оқу орнында тегін жоғары білім алу қамтамасыз етілді";
}

// Ст. 31 п. 2. Сокрытие должностным лицом угрожающих фактов.
relation official(person: Official) kind empirical {
    label ru-KZ official "лицо является должностным лицом";
    label kk-KZ official "адам лауазымды адам болып табылады";
}
relation concealed_life_threatening_facts(person: Official) kind empirical {
    label ru-KZ official "должностное лицо сокрыло факты и обстоятельства, угрожающие жизни и здоровью людей";
    label kk-KZ official "лауазымды адам адамдардың өмірі мен денсаулығына қатер төндіретін фактілер мен мән-жайларды жасырды";
}
relation official_liability_arises(person: Official) kind institutional {
    label ru-KZ official "должностное лицо несёт ответственность согласно закону";
    label kk-KZ official "лауазымды адам заңға сәйкес жауапты болады";
}

// Ст. 32. Мирные собрания без оружия.
relation unarmed_peaceful_assembly(assembly: Assembly, person: Person) kind empirical {
    label ru-KZ official "собрание является мирным и проводится без оружия";
    label kk-KZ official "жиналыс бейбіт әрі қарусыз өткізіледі";
}

// Ст. 34 п. 2. Уважение государственных символов.
// `state_symbols_respected` СНЯТО 02.09.2026: объявление существовало, но его
// не читало и не выводило ни одно правило — обязанность ст. 36 п. 2 (и её
// двойник ст. 34 ред. 1995) держит условие `not state_symbols_disrespected`.
// Предикат, который ничто не читает, зовёт факт, ничего не меняющий.

// Ст. 39 п. 2–3. Согласие и политические мотивы.
relation action_harms_interethnic_or_interconfessional_accord(person: Person) kind empirical {
    label ru-KZ official "деяние наносит вред межнациональному и межконфессиональному согласию";
    label kk-KZ official "әрекет ұлтаралық және конфессияаралық келісімге зиян келтіреді";
}
relation action_unconstitutional(person: Person) kind institutional {
    label ru-KZ official "деяние конституционно недопустимо";
    label kk-KZ official "әрекетке конституциялық тұрғыда жол берілмейді";
}
relation restriction_on_political_grounds(restriction: Restriction) kind empirical {
    label ru-KZ official "ограничение введено по политическим мотивам";
    label kk-KZ official "шектеу саяси себептер бойынша енгізілді";
}
relation restriction_prohibited(restriction: Restriction) kind institutional {
    label ru-KZ official "введение такого ограничения не допускается";
    label kk-KZ official "мұндай шектеуді енгізуге жол берілмейді";
}

// Конституционный предел задержания без санкции суда. Число взято из
// закреплённого текста ст. 16 п. 2 («не более семидесяти двух часов»), а не
// из закона и не по памяти; keyed-факт делает его адресуемым и проверяемым.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_KK")
assert detention_without_court_sanction_limit_hours_1995(72);

// --- Ст. 10. Гражданство -------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART10_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART10_KK")
rule CitizenshipDeprivationPower1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when court_ordered_citizenship_deprivation(person);
    when terrorism_or_grave_vital_interest_harm(person);
    then power DepriveCitizenship1995 {
        holder authority;
        exercise citizenship_deprivation_decision(authority, person);
        valid_when court_ordered_citizenship_deprivation(person);
        effect citizenship_deprived(person);
    };
    label ru-KZ official "Статья 10 пункт 2 (ред. 1995). Лишение гражданства только по решению суда за террористические преступления или иной тяжкий вред жизненно важным интересам";
    label kk-KZ official "10-бап 2-тармақ (1995 ж. ред.). Азаматтықтан айыру — террористік қылмыстар не өмірлік маңызды мүдделерге өзге де ауыр зиян келтіргені үшін сот шешімі бойынша ғана";
}

// РАСХОЖДЕНИЕ 12. 1995 не признаёт за гражданином иное гражданство; 2026
// ст. 13 п. 3 превратил его наличие в основание ПРЕКРАЩЕНИЯ гражданства.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART10_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART10_KK")
rule ForeignCitizenshipNotRecognized1995(person: Person) strict {
    when citizen(person);
    when holds_foreign_citizenship(person);
    then foreign_citizenship_not_recognized(person);
    label ru-KZ official "Статья 10 пункт 3 (ред. 1995). За гражданином Республики не признаётся гражданство другого государства";
    label kk-KZ official "10-бап 3-тармақ (1995 ж. ред.). Республика азаматының басқа мемлекеттің азаматтығы танылмайды";
}

// --- Ст. 11. Невыдача и покровительство ----------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_KK")
rule CitizenNonExtraditionImmunity1995(person: Person) strict {
    when citizen(person);
    then immunity NonExtradition1995 {
        holder person;
        protected_effect extradited(person);
    };
    label ru-KZ official "Статья 11 пункт 1 (ред. 1995). Гражданин Республики не может быть выдан иностранному государству";
    label kk-KZ official "11-бап 1-тармақ (1995 ж. ред.). Республика азаматын шет мемлекетке ұстап беруге болмайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_KK")
rule TreatyExtraditionPower1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then power ExtraditeUnderTreaty1995 {
        holder authority;
        exercise extradition_decision(authority, person);
        valid_when treaty_allows_extradition(person);
        effect extradited(person);
    };
    label ru-KZ official "Статья 11 пункт 1 (ред. 1995). Выдача допускается, если это установлено международным договором Республики";
    label kk-KZ official "11-бап 1-тармақ (1995 ж. ред.). Ұстап беруге Республиканың халықаралық шартында белгіленген жағдайда жол беріледі";
}

priority TreatyClauseOverGeneralNonExtradition1995: TreatyExtraditionPower1995 > CitizenNonExtraditionImmunity1995 reason lex_specialis;

// РАСХОЖДЕНИЕ. 1995 обещает «защиту И ПОКРОВИТЕЛЬСТВО»; 2026 ст. 14 п. 2 —
// «защиту в соответствии с законом», то есть обещание сужено отсылкой.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART11_KK")
rule ProtectionAndPatronageAbroadDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when abroad(person);
    then duty ProtectAndPatroniseAbroad1995 {
        bearer authority;
        beneficiary person;
        goal maintenance {
            condition protection_and_patronage_provided(authority, person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy ProtectionAbroadCompleteness;
        }
    };
    label ru-KZ official "Статья 11 пункт 2 (ред. 1995). Республика гарантирует гражданам защиту и покровительство за её пределами";
    label kk-KZ official "11-бап 2-тармақ (1995 ж. ред.). Республика азаматтарына одан тыс жерде қорғау мен қамқорлыққа кепілдік береді";
}

// --- Ст. 12. Признание прав, иностранцы, предел осуществления ------------

// РАСХОЖДЕНИЕ 1 — самое сильное в разделе. Умолчание инвертировано: в 1995
// молчание закона ДАЁТ иностранцу права гражданина, в 2026 — отказывает.
// Обе редакции выражены явно, иначе impact-editions сообщал бы о появлении
// нормы там, где на деле сменилось умолчание.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART12_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART12_KK")
rule ForeignerEnjoysCitizenRightsUnlessOtherwise1995(person: Person) strict {
    when foreigner_or_stateless(person);
    when not different_regime_established_for_foreigners(person);
    then enjoys_citizen_rights_and_duties(person);
    label ru-KZ official "Статья 12 пункт 4 (ред. 1995). Иностранцы и лица без гражданства пользуются правами граждан, если иное не предусмотрено";
    label kk-KZ official "12-бап 4-тармақ (1995 ж. ред.). Өзгеше көзделмесе, шетелдіктер мен азаматтығы жоқ адамдар азаматтардың құқықтарын пайдаланады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_KK")
rule ForeignerEnjoysCitizenRightsOnlyWhereProvided(person: Person) strict {
    when foreigner_or_stateless(person);
    when different_regime_established_for_foreigners(person);
    then enjoys_citizen_rights_and_duties(person);
    label ru-KZ official "Статья 15 пункт 4. Иностранцы и лица без гражданства пользуются правами граждан в случаях, предусмотренных Конституцией, законами и договорами";
    label kk-KZ official "15-бап 4-тармақ. Шетелдіктер мен азаматтығы жоқ адамдар Конституцияда, заңдарда және шарттарда көзделген жағдайларда азаматтардың құқықтарын пайдаланады";
}

// РАСХОЖДЕНИЕ 8. Предел осуществления прав в 1995 ýже на два основания.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART12_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART12_KK")
rule RightsExerciseBoundary1995(person: Person) strict {
    when rights_exercise_harms_others_order_or_morality(person);
    then rights_exercise_constitutionally_limited(person);
    label ru-KZ official "Статья 12 пункт 5 (ред. 1995). Осуществление прав не должно нарушать прав других лиц, посягать на конституционный строй и общественную нравственность";
    label kk-KZ official "12-бап 5-тармақ (1995 ж. ред.). Құқықтарды жүзеге асыру басқа адамдардың құқықтарын бұзбауға, конституциялық құрылысқа және қоғамдық имандылыққа нұқсан келтірмеуге тиіс";
}

// --- Ст. 13. Правосубъектность и юридическая помощь ----------------------

// РАСХОЖДЕНИЕ 11. 1995 обязывает оказать помощь БЕСПЛАТНО в установленных
// законом случаях; 2026 ст. 12 п. 3 признаёт право «в соответствии с законом».
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART13_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART13_KK")
rule FreeLegalAidDuty1995(authority: StateAuthority, aid: LegalAidCase, person: Person) strict {
    when state_authority(authority);
    when legal_aid_case(aid, person);
    when statutory_free_legal_aid_ground(aid);
    then duty ProvideFreeLegalAid1995 {
        bearer authority;
        beneficiary person;
        maintain free_legal_aid_provided(aid, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 13 пункт 3 (ред. 1995). В случаях, предусмотренных законом, юридическая помощь оказывается бесплатно";
    label kk-KZ official "13-бап 3-тармақ (1995 ж. ред.). Заңда көзделген жағдайларда заң көмегі тегін көрсетіледі";
}

// --- Ст. 14, 15, 17, 18, 20, 25, 26: иммунитеты --------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART14_RU")
rule EqualityImmunity1995(person: Person) strict {
    when person(person);
    then immunity NoDiscrimination1995 {
        holder person;
        protected_effect discriminated(person);
    };
    label ru-KZ official "Статья 14 (ред. 1995). Все равны перед законом и судом; дискриминация не допускается";
    label kk-KZ official "14-бап (1995 ж. ред.). Заң мен сот алдында жұрттың бәрі тең; кемсітушілікке жол берілмейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART15_RU")
rule DeathPenaltyImmunity1995(person: Person) strict {
    when person(person);
    then immunity NoDeathPenalty1995 {
        holder person;
        protected_effect death_penalty_imposed(person);
    };
    label ru-KZ official "Статья 15 пункт 2 (ред. 1995). Смертная казнь запрещается";
    label kk-KZ official "15-бап 2-тармақ (1995 ж. ред.). Өлім жазасына тыйым салынады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART17_RU") {
    rule TortureImmunity1995(person: Person) strict {
        when person(person);
        then immunity NoTorture1995 {
            holder person;
            protected_effect tortured(person);
        };
        label ru-KZ official "Статья 17 пункт 2 (ред. 1995). Никто не должен подвергаться пыткам и жестокому обращению";
        label kk-KZ official "17-бап 2-тармақ (1995 ж. ред.). Ешкім азаптауға және қатыгез қарауға ұшырамауға тиіс";
    }

    rule DignityImmunity1995(person: Person) strict {
        when person(person);
        then immunity DignityInviolable1995 {
            holder person;
            protected_effect dignity_infringed(person);
        };
        label ru-KZ official "Статья 17 пункт 1 (ред. 1995). Достоинство человека неприкосновенно";
        label kk-KZ official "17-бап 1-тармақ (1995 ж. ред.). Адамның ар-намысына қол сұғылмайды";
    }
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_RU")
rule PrivacyImmunity1995(person: Person) strict {
    when person(person);
    then immunity PrivacyProtection1995 {
        holder person;
        protected_effect privacy_unlawfully_interfered(person);
    };
    label ru-KZ official "Статья 18 пункт 1 (ред. 1995). Неприкосновенность частной жизни, личная и семейная тайна";
    label kk-KZ official "18-бап 1-тармақ (1995 ж. ред.). Жеке өмірге қол сұғылмаушылық, жеке және отбасылық құпия";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART20_RU")
rule CensorshipImmunity1995(person: Person) strict {
    when person(person);
    then immunity NoCensorship1995 {
        holder person;
        protected_effect censorship_imposed(person);
    };
    label ru-KZ official "Статья 20 пункт 1 (ред. 1995). Цензура запрещается";
    label kk-KZ official "20-бап 1-тармақ (1995 ж. ред.). Цензураға тыйым салынады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART25_RU")
rule HomeImmunity1995(person: Person) strict {
    when person(person);
    then immunity HomeInviolability1995 {
        holder person;
        protected_effect home_unlawfully_entered(person);
    };
    label ru-KZ official "Статья 25 пункт 1 (ред. 1995). Жилище неприкосновенно; лишение жилища — только по решению суда";
    label kk-KZ official "25-бап 1-тармақ (1995 ж. ред.). Тұрғын үйге қол сұғылмайды; тұрғын үйден айыру — сот шешімі бойынша ғана";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_RU")
rule PropertyImmunity1995(person: Person) strict {
    when person(person);
    then immunity CompensatedExpropriationOnly1995 {
        holder person;
        protected_effect property_uncompensatedly_expropriated(person);
    };
    label ru-KZ official "Статья 26 пункт 3 (ред. 1995). Принудительное отчуждение — только при равноценном возмещении";
    label kk-KZ official "26-бап 3-тармақ (1995 ж. ред.). Мәжбүрлеп айыру — тең бағамен өтелген жағдайда ғана";
}

// =========================================================================
// ЗАПРЕТЫ РЕДАКЦИИ 1995 (заведены 13.09.2026).
//
// Прежняя граница пакета — «запреты заведены ТОЛЬКО для редакции 2026, слой
// 1995 служит проекции и расхождению» — держалась на опасении подделать
// содержание прекращённой редакции. Чтением закреплённого текста 1995
// проверено: ВСЕ одиннадцать абсолютных запретов раздела II 2026 года имеют
// в редакции 1995 собственную норму, и большинство стоит в ней дословно в
// той же формулировке («Смертная казнь запрещается», «Цензура запрещается»,
// «Достоинство человека неприкосновенно»). Поэтому заведение близнеца ничего
// не выдумывает, а отсутствие близнеца делало СРАВНЕНИЕ РЕДАКЦИЙ ПО ЭТОМУ
// СЛОЮ ПУСТЫМ ПО ПОСТРОЕНИЮ: дело о попытке органа на дату до 01.07.2026 не
// получало ни одной позиции, потому что иммунитет §128 блокирует эффект
// ВЛАСТИ, а власти пытать или цензурировать Конституция 1995 года не давала
// — ровно как и Конституция 2026 года.
//
// Единственное расхождение состава внутри этого слоя — предел задержания:
// 1995 ст. 16 п. 2 называет семьдесят два часа В САМОЙ Конституции, 2026
// ст. 18 п. 2 отсылает срок к закону. Запрет-близнец читает поэтому свой
// антецедент (`detention_exceeds_72_hours`), а не статутный.
//
// Носитель связан ТЕЛОМ (`state_authority(authority)`, §190) у каждого из
// одиннадцати — цена забывчивости измерена и описана в шапке файла.
// Действие запрета посылкой того же правила не стоит нигде: попытка есть то,
// что запрещено, а не то, при чём запрет возникает.

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART14_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART14_KK")
rule DiscriminationProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDiscrimination1995 {
        bearer authority;
        action discriminatory_treatment_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 14 пункт 2 (ред. 1995). Никто не может подвергаться какой-либо дискриминации по мотивам происхождения, социального, должностного и имущественного положения, пола, расы, национальности, языка, отношения к религии, убеждений, места жительства или по любым иным обстоятельствам";
    label kk-KZ official "14-бап 2-тармақ (1995 ж. ред.). Тегіне, әлеуметтік, лауазымдық және мүліктік жағдайына, жынысына, нәсіліне, ұлтына, тіліне, дінге көзқарасына, нанымына, тұрғылықты жеріне байланысты немесе кез келген өзге жағдаяттар бойынша ешкімді ешқандай кемсітуге болмайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART15_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART15_KK")
rule DeathPenaltyProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDeathPenalty1995 {
        bearer authority;
        action death_penalty_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 15 пункт 2 (ред. 1995). Никто не вправе произвольно лишать человека жизни. Смертная казнь запрещается";
    label kk-KZ official "15-бап 2-тармақ (1995 ж. ред.). Ешкімнің өз бетінше адам өмірін қиюға хақысы жоқ. Өлім жазасына тыйым салынады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART17_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART17_KK")
rule DignityInfringementProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDignityInfringement1995 {
        bearer authority;
        action dignity_infringement_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 17 пункт 1 (ред. 1995). Достоинство человека неприкосновенно";
    label kk-KZ official "17-бап 1-тармақ (1995 ж. ред.). Адамның қадір-қасиетіне қол сұғылмайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART17_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART17_KK")
rule TortureProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromTorture1995 {
        bearer authority;
        action torture_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 17 пункт 2 (ред. 1995). Никто не должен подвергаться пыткам, насилию, другому жестокому или унижающему человеческое достоинство обращению или наказанию";
    label kk-KZ official "17-бап 2-тармақ (1995 ж. ред.). Ешкімді азаптауға, оған зорлық-зомбылық жасауға, басқадай қатыгездік немесе адамдық қадір-қасиетін қорлайтындай жәбір көрсетуге не жазалауға болмайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_KK")
rule PrivacyInterferenceProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromPrivacyInterference1995 {
        bearer authority;
        action unlawful_privacy_interference_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 18 пункты 1 и 2 (ред. 1995). Каждый имеет право на неприкосновенность частной жизни, личную и семейную тайну; ограничения этого права допускаются только в случаях и в порядке, прямо установленных законом";
    label kk-KZ official "18-бап 1 және 2-тармақтар (1995 ж. ред.). Әркімнің жеке өміріне қол сұғылмауына, өзінің және отбасының құпиясы болуына құқығы бар; бұл құқықты шектеуге заңда тікелей белгіленген реттер мен тәртіп бойынша ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART20_KK")
rule CensorshipProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromCensorship1995 {
        bearer authority;
        action censorship_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 20 пункт 1 (ред. 1995). Свобода слова и творчества гарантируются. Цензура запрещается";
    label kk-KZ official "20-бап 1-тармақ (1995 ж. ред.). Сөз бен шығармашылық еркіндігіне кепілдік беріледі. Цензураға тыйым салынады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_KK")
rule ReturnBlockProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then prohibition RefrainFromBlockingReturn1995 {
        bearer authority;
        action return_block_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 21 пункт 2 (ред. 1995). Граждане Республики имеют право беспрепятственного возвращения в Республику";
    label kk-KZ official "21-бап 2-тармақ (1995 ж. ред.). Республика азаматтарының Республикаға кедергісіз қайтып оралуына құқығы бар";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART25_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART25_KK")
rule HomeEntryProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromUnlawfulHomeEntry1995 {
        bearer authority;
        action unlawful_home_entry_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 25 пункт 1 (ред. 1995). Жилище неприкосновенно; проникновение в жилище, производство его осмотра и обыска допускаются лишь в случаях и в порядке, установленных законом";
    label kk-KZ official "25-бап 1-тармақ (1995 ж. ред.). Тұрғын үйге қол сұғылмайды; тұрғын үйге басып кіруге, оны тексеруге және тінтуге заңмен белгіленген реттер мен тәртіп бойынша ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_KK")
rule UncompensatedExpropriationProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromUncompensatedExpropriation1995 {
        bearer authority;
        action uncompensated_expropriation_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 26 пункт 3 (ред. 1995). Принудительное отчуждение имущества для государственных нужд в исключительных случаях, предусмотренных законом, может быть произведено при условии равноценного его возмещения";
    label kk-KZ official "26-бап 3-тармақ (1995 ж. ред.). Заңмен көзделген ерекше жағдайларда мемлекет мұқтажы үшін мүліктен күштеп айыру оның құны тең бағамен өтелген кезде жүргізілуі мүмкін";
}

// РАСХОЖДЕНИЕ СОСТАВА ВНУТРИ СЛОЯ ЗАПРЕТОВ: у 2026 антецедентом стоит
// превышение СТАТУТНОГО срока (`detention_exceeds_statutory_period`), у 1995 —
// превышение семидесяти двух часов, названных самой Конституцией.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_KK")
rule DetentionBeyond72HoursProhibition1995(authority: StateAuthority, detention: Detention) strict {
    when state_authority(authority);
    when detention_without_court_sanction(detention);
    when detention_exceeds_72_hours(detention);
    then prohibition RefrainFromDetentionBeyond72Hours1995 {
        bearer authority;
        action continued_detention_attempt(authority, detention);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 16 пункт 2 (ред. 1995). Без санкции суда лицо может быть подвергнуто задержанию на срок не более семидесяти двух часов";
    label kk-KZ official "16-бап 2-тармақ (1995 ж. ред.). Соттың санкциясынсыз адамды жетпіс екі сағаттан аспайтын мерзімге ұстауға болады";
}

// Изъятие 1995 года — то же, что и у 2026: судебный акт о признании виновным
// либо чрезвычайное или военное положение. `unless` при норм-голове
// компилятор отбрасывает (LDC-E1302), поэтому изъятие живёт на предикате с
// литеральной головой; у слоя 1995 правило своё, иначе на дату до 01.07.2026
// посылка запрета выводилась бы правилом редакции 2026, исключённым §92.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule ForcedLabourBarredWithoutBasis1995(person: Person) defeasible {
    when person(person);
    unless forced_labour_constitutionally_admissible(person);
    then forced_labour_barred(person);
    label ru-KZ official "Статья 24 пункт 1 (ред. 1995). Принуждение к труду запрещено, пока нет судебного акта о признании виновным в уголовном или административном правонарушении либо чрезвычайного или военного положения";
    label kk-KZ official "24-бап 1-тармақ (1995 ж. ред.). Қылмыстық немесе әкімшілік құқық бұзушылық жасауға кінәлі деп тану туралы сот актісі не төтенше немесе соғыс жағдайы болмайынша еріксіз еңбекке тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule ForcedLabourProhibition1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when forced_labour_barred(person);
    then prohibition RefrainFromForcedLabour1995 {
        bearer authority;
        action forced_labour_attempt(authority, person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 24 пункт 1 (ред. 1995). Принудительный труд вне названных Конституцией оснований не допускается";
    label kk-KZ official "24-бап 1-тармақ (1995 ж. ред.). Конституцияда аталған негіздерден тыс еріксіз еңбекке жол берілмейді";
}

// --- Ст. 16. Личная свобода и конституционный предел задержания ----------

// РАСХОЖДЕНИЕ 2. Предел в семьдесят два часа стоит В САМОЙ Конституции 1995;
// 2026 ст. 18 п. 2 отсылает срок к закону. Поэтому дело о задержании на
// девяносто часов без санкции суда до 01.07.2026 разрешается прямо из
// Конституции, а после — только через закон, которого модель не домысливает.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_KK")
rule DetentionBeyond72HoursImmunity1995(detention: Detention, person: Person) strict {
    when detention_of(detention, person);
    when detention_without_court_sanction(detention);
    when detention_exceeds_72_hours(detention);
    then immunity SeventyTwoHourDetentionLimit1995 {
        holder person;
        protected_effect unlawful_continued_detention(detention);
    };
    label ru-KZ official "Статья 16 пункт 2 (ред. 1995). Без санкции суда задержание не более семидесяти двух часов";
    label kk-KZ official "16-бап 2-тармақ (1995 ж. ред.). Сот санкциясынсыз ұстау жетпіс екі сағаттан аспайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_KK")
rule ArrestRequiresCourtSanctionAndAppeal1995(detention: Detention) strict {
    when arrest_or_custody(detention);
    when court_sanction_obtained(detention);
    when appeal_right_granted(detention);
    then arrest_constitutionally_admissible(detention);
    label ru-KZ official "Статья 16 пункт 2 (ред. 1995). Арест и содержание под стражей — лишь с санкции суда и с правом обжалования";
    label kk-KZ official "16-бап 2-тармақ (1995 ж. ред.). Қамауға алу және күзетпен ұстау — сот санкциясымен және шағымдану құқығымен ғана";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART16_KK")
rule CounselFromDetentionDuty1995(
    authority: StateAuthority,
    detention: Detention,
    person: Person,
) strict {
    when state_authority(authority);
    when detention_of(detention, person);
    then duty ProvideCounselAccess1995 {
        bearer authority;
        beneficiary person;
        maintain counsel_access_provided(detention, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 16 пункт 3 (ред. 1995). Право пользоваться помощью адвоката с момента задержания, ареста или предъявления обвинения";
    label kk-KZ official "16-бап 3-тармақ (1995 ж. ред.). Ұсталған, қамауға алынған не айып тағылған сәттен бастап адвокаттың көмегін пайдалану құқығы";
}

// --- Ст. 18 п. 3, 19, 20, 21, 22 ----------------------------------------

// РАСХОЖДЕНИЕ 9. Доступ к затрагивающим документам в 1995 обещан гражданину,
// в 2026 ст. 21 п. 3 — каждому человеку: круг управомоченных расширен.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_KK")
rule CitizenAccessToAffectingDocumentsDuty1995(
    authority: StateAuthority,
    document: Document,
    person: Person,
) strict {
    when state_authority(authority);
    when citizen(person);
    when document_affects(document, person);
    then duty ProvideCitizenAccess1995 {
        bearer authority;
        beneficiary person;
        maintain citizen_access_provided(document, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 18 пункт 3 (ред. 1995). Каждому гражданину обеспечивается возможность ознакомиться с затрагивающими его документами";
    label kk-KZ official "18-бап 3-тармақ (1995 ж. ред.). Әрбір азаматқа өзін қозғайтын құжаттармен танысу мүмкіндігі қамтамасыз етіледі";
}

// РАСХОЖДЕНИЕ 14. В 1995 определяется принадлежность национальная, партийная
// и религиозная; 2026 ст. 22 п. 1 оставил только национальную.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART19_KK")
rule NationalPartyAndReligiousIdentityLiberty1995(person: Person) strict {
    when person(person);
    then liberty DeclareNationalPartyReligiousIdentity1995 {
        holder person;
        action identity_declaration_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 19 пункт 1 (ред. 1995). Каждый вправе определять и указывать или не указывать национальную, партийную и религиозную принадлежность";
    label kk-KZ official "19-бап 1-тармақ (1995 ж. ред.). Әркім өзінің ұлттық, партиялық және діни тегін анықтауға және көрсетуге немесе көрсетпеуге құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART19_KK")
rule NativeLanguageAndCultureLiberty1995(person: Person) strict {
    when person(person);
    then liberty UseNativeLanguageAndCulture1995 {
        holder person;
        action native_language_and_culture_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 19 пункт 2 (ред. 1995). Право на пользование родным языком и культурой, свободный выбор языка общения";
    label kk-KZ official "19-бап 2-тармақ (1995 ж. ред.). Ана тілі мен мәдениетін пайдалану, қарым-қатынас тілін еркін таңдау құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART20_KK")
rule ProhibitedPropaganda1995(person: Person) strict {
    when propaganda_of_prohibited_content(person);
    then propaganda_constitutionally_prohibited(person);
    label ru-KZ official "Статья 20 пункт 3 (ред. 1995). Не допускаются пропаганда или агитация насильственного изменения конституционного строя и прочего перечисленного";
    label kk-KZ official "20-бап 3-тармақ (1995 ж. ред.). Конституциялық құрылысты күштеп өзгертуді және өзге де аталғандарды насихаттауға немесе үгіттеуге жол берілмейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_KK")
rule FreedomOfMovement1995(person: Person) strict {
    when lawfully_in_kazakhstan(person);
    then liberty MoveWithinKazakhstan1995 {
        holder person;
        action movement_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 21 пункт 1 (ред. 1995). Свобода передвижения и выбора местожительства для законно находящегося в Республике";
    label kk-KZ official "21-бап 1-тармақ (1995 ж. ред.). Республикада заңды түрде жүрген адамның жүріп-тұру және тұрғылықты жерін таңдау бостандығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_KK")
rule StatutoryMovementRestriction1995(restriction: MovementRestriction, person: Person) strict {
    when movement_restriction(restriction, person);
    when movement_restriction_established_by_law(restriction);
    then movement_restriction_constitutionally_valid(restriction);
    label ru-KZ official "Статья 21 пункт 1 (ред. 1995). Ограничение передвижения допускается только в оговорённых законом случаях";
    label kk-KZ official "21-бап 1-тармақ (1995 ж. ред.). Жүріп-тұруды шектеуге заңда айтылған жағдайларда ғана жол беріледі";
}

// РАСХОЖДЕНИЕ 13. В 1995 выезд объявлен без конституционной оговорки об
// ограничении; 2026 ст. 24 п. 2 внёс «в случаях и в порядке, установленных
// законом». Поэтому свобода выезда 1995 не имеет конституционного ограничителя.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_KK")
rule ExitKazakhstanLiberty1995(person: Person) strict {
    when person(person);
    then liberty ExitKazakhstan1995 {
        holder person;
        action exit_kazakhstan_action_1995(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 21 пункт 2 (ред. 1995). Каждый имеет право выезжать за пределы Республики";
    label kk-KZ official "21-бап 2-тармақ (1995 ж. ред.). Әркім Республикадан тыс жерге шығуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART21_KK")
rule CitizenReturnImmunity1995(person: Person) strict {
    when citizen(person);
    then immunity UnobstructedReturnToKazakhstan1995 {
        holder person;
        protected_effect return_blocked(person);
    };
    label ru-KZ official "Статья 21 пункт 2 (ред. 1995). Граждане имеют право беспрепятственного возвращения в Республику";
    label kk-KZ official "21-бап 2-тармақ (1995 ж. ред.). Азаматтар Республикаға кедергісіз қайтып оралуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART22_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART22_KK")
rule FreedomOfConscienceLiberty1995(person: Person) strict {
    when person(person);
    then liberty ExerciseFreedomOfConscience1995 {
        holder person;
        action conscience_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 22 пункт 1 (ред. 1995). Каждый имеет право на свободу совести";
    label kk-KZ official "22-бап 1-тармақ (1995 ж. ред.). Әркімнің ар-ождан бостандығына құқығы бар";
}

// --- Ст. 23. Объединения ------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART23_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART23_KK")
rule FreedomOfAssociation1995(person: Person, association: Association) strict {
    when citizen(person);
    when association(association);
    then liberty JoinAssociation1995 {
        holder person;
        action association_membership_action(person, association);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 23 пункт 1 (ред. 1995). Граждане имеют право на свободу объединений";
    label kk-KZ official "23-бап 1-тармақ (1995 ж. ред.). Азаматтардың бірлесу бостандығына құқығы бар";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART23_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART23_KK")
rule RestrictedOfficePoliticalMembershipIncompatible1995(person: Person) strict {
    when restricted_political_officeholder(person);
    when political_party_or_union_membership(person);
    then restricted_office_membership_incompatible(person);
    label ru-KZ official "Статья 23 пункт 2 (ред. 1995). Перечисленные должностные лица не должны состоять в партиях и профсоюзах";
    label kk-KZ official "23-бап 2-тармақ (1995 ж. ред.). Аталған лауазымды адамдар партиялар мен кәсіптік одақтарда болмауға тиіс";
}

// --- Ст. 24. Труд, забастовка, отдых ------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule FreedomOfLabourLiberty1995(person: Person) strict {
    when person(person);
    then liberty ChooseOccupationFreely1995 {
        holder person;
        action labour_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 24 пункт 1 (ред. 1995). Право на свободу труда, свободный выбор рода деятельности и профессии";
    label kk-KZ official "24-бап 1-тармақ (1995 ж. ред.). Еңбек ету бостандығына, қызмет пен кәсіп түрін еркін таңдауға құқық";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule ForcedLabourOnlyOnJudicialOrEmergencyBasis1995(person: Person) strict {
    when judicial_act_or_emergency_basis(person);
    then forced_labour_constitutionally_admissible(person);
    label ru-KZ official "Статья 24 пункт 1 (ред. 1995). Принудительный труд допускается только по судебному акту либо в условиях чрезвычайного или военного положения";
    label kk-KZ official "24-бап 1-тармақ (1995 ж. ред.). Мәжбүрлі еңбекке сот актісі бойынша не төтенше немесе соғыс жағдайында ғана жол беріледі";
}

// РАСХОЖДЕНИЕ 3. Право на забастовку названо в Конституции 1995 прямо
// («включая право на забастовку»); 2026 ст. 27 п. 3 сохранил трудовые споры
// и забастовку из текста убрал. Свобода прекращается 01.07.2026 не законом,
// а сменой конституционного текста.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule RightToStrikeLiberty1995(person: Person, strike: Strike) strict {
    when collective_labour_dispute(strike, person);
    then liberty Strike1995 {
        holder person;
        action strike_action(person, strike);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 24 пункт 3 (ред. 1995). Признаётся право на трудовые споры, включая право на забастовку";
    label kk-KZ official "24-бап 3-тармақ (1995 ж. ред.). Ереуіл жасау құқығын қоса алғанда, еңбек дауларына құқық танылады";
}

// РАСХОЖДЕНИЕ. 1995 обещает социальную защиту ОТ БЕЗРАБОТИЦЫ; 2026 ст. 27
// п. 2 — «социальную защиту в соответствии с законом», без названного риска.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule UnemploymentProtectionDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when unemployment_social_protection_ground(person);
    then duty ProvideUnemploymentProtection1995 {
        bearer authority;
        beneficiary person;
        maintain unemployment_social_protection_provided(authority, person)
            during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 24 пункт 2 (ред. 1995). Право на социальную защиту от безработицы";
    label kk-KZ official "24-бап 2-тармақ (1995 ж. ред.). Жұмыссыздықтан әлеуметтік қорғалу құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART24_KK")
rule AnnualPaidLeaveDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when employed_under_labour_contract(person);
    then duty GuaranteeAnnualPaidLeave1995 {
        bearer authority;
        beneficiary person;
        goal maintenance {
            condition annual_paid_leave_provided(authority, person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy AnnualLeaveCompleteness;
        }
    };
    label ru-KZ official "Статья 24 пункт 4 (ред. 1995). Работающим по трудовому договору гарантируется оплачиваемый ежегодный отпуск";
    label kk-KZ official "24-бап 4-тармақ (1995 ж. ред.). Еңбек шарты бойынша жұмыс істейтіндерге ақы төленетін жыл сайынғы демалысқа кепілдік беріледі";
}

// --- Ст. 25. Жилище -----------------------------------------------------

// РАСХОЖДЕНИЕ 10. 1995 обещает жильё «за доступную плату из государственных
// жилищных фондов»; 2026 ст. 28 п. 2 условие о доступной плате убрал.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART25_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART25_KK")
rule AffordableStateHousingDuty1995(
    authority: StateAuthority,
    need: HousingNeed,
    person: Person,
) strict {
    when state_authority(authority);
    when citizen(person);
    when statutory_housing_need(need, person);
    then duty ProvideAffordableStateHousing1995 {
        bearer authority;
        beneficiary person;
        maintain affordable_state_housing_provided(need, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 25 пункт 2 (ред. 1995). Указанным в законе категориям жильё предоставляется за доступную плату из государственных жилищных фондов";
    label kk-KZ official "25-бап 2-тармақ (1995 ж. ред.). Заңда көрсетілген санаттарға тұрғын үй мемлекеттік тұрғын үй қорларынан қолжетімді ақыға беріледі";
}

// --- Ст. 26. Собственность и предпринимательство ------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_KK")
rule FreedomOfEnterpriseLiberty1995(person: Person) strict {
    when person(person);
    then liberty ConductEnterprise1995 {
        holder person;
        action entrepreneurial_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 26 пункт 4 (ред. 1995). Право на свободу предпринимательской деятельности";
    label kk-KZ official "26-бап 4-тармақ (1995 ж. ред.). Кәсіпкерлік қызмет бостандығына құқық";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART26_KK")
rule UnfairCompetitionProhibited1995(person: Person) strict {
    when unfair_competition(person);
    then unfair_competition_prohibited(person);
    label ru-KZ official "Статья 26 пункт 4 (ред. 1995). Недобросовестная конкуренция запрещается";
    label kk-KZ official "26-бап 4-тармақ (1995 ж. ред.). Жосықсыз бәсекеге тыйым салынады";
}

// --- Ст. 27. Семья ------------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_KK")
rule ParentCareDuty1995(parent: Parent, child: Child) strict {
    when parent_of(parent, child);
    then duty CareForChild1995 {
        bearer parent;
        beneficiary child;
        goal maintenance {
            condition child_care_provided(parent, child);
            window [@1995-09-05, @2026-07-01);
            completeness_policy ChildCareCompleteness;
        }
    };
    label ru-KZ official "Статья 27 пункт 2 (ред. 1995). Забота о детях и их воспитание — естественное право и обязанность родителей";
    label kk-KZ official "27-бап 2-тармақ (1995 ж. ред.). Балаларына қамқорлық жасау және оларды тәрбиелеу — ата-ананың табиғи құқығы әрі міндеті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_KK")
rule AdultChildParentCareDuty1995(child: Child, parent: Parent) strict {
    when adult_capable_child_of(child, parent);
    when parent_incapacitated(parent);
    then duty CareForIncapacitatedParent1995 {
        bearer child;
        beneficiary parent;
        goal maintenance {
            condition parent_care_provided(child, parent);
            window [@1995-09-05, @2026-07-01);
            completeness_policy ParentCareCompleteness;
        }
    };
    label ru-KZ official "Статья 27 пункт 3 (ред. 1995). Совершеннолетние трудоспособные дети обязаны заботиться о нетрудоспособных родителях";
    label kk-KZ official "27-бап 3-тармақ (1995 ж. ред.). Кәмелетке толған еңбекке қабілетті балалар еңбекке қабілетсіз ата-анасына қамқорлық жасауға міндетті";
}

// --- Ст. 28, 29. Социальное обеспечение и здоровье ----------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART28_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART28_KK")
rule SocialSecurityDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when lawful_social_security_ground(person);
    then duty ProvideSocialSecurity1995 {
        bearer authority;
        beneficiary person;
        maintain social_security_provided(authority, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 28 пункт 1 (ред. 1995). Гарантируются минимальная заработная плата и пенсия, социальное обеспечение по законным основаниям";
    label kk-KZ official "28-бап 1-тармақ (1995 ж. ред.). Ең төмен жалақы мен зейнетақыға, заңды негіздер бойынша әлеуметтік қамсыздандыруға кепілдік беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART29_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART29_KK")
rule GuaranteedFreeMedicalCareDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then duty ProvideGuaranteedFreeMedicalCare1995 {
        bearer authority;
        beneficiary person;
        goal maintenance {
            condition guaranteed_free_medical_care_provided(authority, person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy MedicalCareCompleteness;
        }
    };
    label ru-KZ official "Статья 29 пункт 2 (ред. 1995). Граждане вправе получать бесплатно гарантированный объём медицинской помощи";
    label kk-KZ official "29-бап 2-тармақ (1995 ж. ред.). Азаматтар медициналық көмектің кепілдік берілген көлемін тегін алуға құқылы";
}

// --- Ст. 30. Образование ------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_KK")
rule FreeSecondaryEducationDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when free_secondary_education_eligible(person);
    then duty ProvideFreeSecondaryEducation1995 {
        bearer authority;
        beneficiary person;
        maintain free_secondary_education_provided(authority, person)
            during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 30 пункт 1 (ред. 1995). Гражданам гарантируется бесплатное среднее образование в государственных учебных заведениях";
    label kk-KZ official "30-бап 1-тармақ (1995 ж. ред.). Азаматтарға мемлекеттік оқу орындарында тегін орта білім алуға кепілдік беріледі";
}

// РАСХОЖДЕНИЕ 5. 1995 объявляет обязательным ВСЁ среднее образование; 2026
// ст. 33 п. 1 сузил обязательность до начального и основного среднего.
// Учащийся старших классов до 01.07.2026 обязан учиться, после — нет.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_KK")
rule SecondaryEducationCompulsory1995(person: Person) strict {
    when secondary_education_stage(person);
    then compulsory_education_applies(person);
    label ru-KZ official "Статья 30 пункт 1 (ред. 1995). Среднее образование обязательно";
    label kk-KZ official "30-бап 1-тармақ (1995 ж. ред.). Орта білім алу міндетті";
}

// РАСХОЖДЕНИЕ 4. Бесплатное высшее образование на конкурсной основе в
// государственном вузе — конституционное обещание 1995. 2026 ст. 33 п. 2
// оставил право на высшее образование «в соответствии с законом», сняв и
// бесплатность, и конкурс как конституционные условия.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_KK")
rule FreeCompetitiveHigherEducationDuty1995(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when higher_education_competition_won(person);
    then duty ProvideFreeHigherEducation1995 {
        bearer authority;
        beneficiary person;
        maintain free_higher_education_provided(authority, person) during [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 30 пункт 2 (ред. 1995). Право на получение на конкурсной основе бесплатного высшего образования в государственном вузе";
    label kk-KZ official "30-бап 2-тармақ (1995 ж. ред.). Мемлекеттік жоғары оқу орнында конкурстық негізде тегін жоғары білім алу құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART30_KK")
rule EducationStandardsCompliance1995(institution: EducationInstitution) strict {
    when education_institution(institution);
    when education_standards_met(institution);
    then education_institution_constitutionally_compliant(institution);
    label ru-KZ official "Статья 30 пункт 4 (ред. 1995). Деятельность любых учебных заведений должна соответствовать общеобязательным стандартам";
    label kk-KZ official "30-бап 4-тармақ (1995 ж. ред.). Кез келген оқу орнының қызметі жалпыға міндетті стандарттарға сәйкес келуге тиіс";
}

// --- Ст. 31. Окружающая среда -------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART31_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART31_KK")
rule OfficialConcealmentLiability1995(person: Official) strict {
    when official(person);
    when concealed_life_threatening_facts(person);
    then official_liability_arises(person);
    label ru-KZ official "Статья 31 пункт 2 (ред. 1995). Сокрытие должностными лицами фактов, угрожающих жизни и здоровью людей, влечёт ответственность";
    label kk-KZ official "31-бап 2-тармақ (1995 ж. ред.). Лауазымды адамдардың адамдардың өмірі мен денсаулығына қатер төндіретін фактілерді жасыруы жауаптылыққа әкеп соғады";
}

// --- Ст. 32. Мирные собрания --------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART32_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART32_KK")
rule PeacefulAssemblyLiberty1995(person: Person, assembly: Assembly) strict {
    when citizen(person);
    when unarmed_peaceful_assembly(assembly, person);
    then liberty ParticipateInUnarmedAssembly1995 {
        holder person;
        action assembly_participation_action(person, assembly);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 32 (ред. 1995). Граждане вправе мирно и без оружия собираться, проводить собрания, митинги, демонстрации, шествия и пикетирование";
    label kk-KZ official "32-бап (1995 ж. ред.). Азаматтар бейбіт әрі қарусыз жиналуға, жиналыстар, митингілер, демонстрациялар, шерулер өткізуге және пикет қоюға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART32_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART32_KK")
rule AssemblyRestrictionRequiresLawAndGoal1995(
    restriction: Restriction,
    assembly: Assembly,
) strict {
    when assembly_restriction(restriction, assembly);
    when assembly_restriction_established_by_law(restriction);
    when assembly_restriction_has_constitutional_goal(restriction);
    then assembly_restriction_constitutionally_valid(restriction);
    label ru-KZ official "Статья 32 (ред. 1995). Ограничение права на собрания допускается законом в перечисленных конституционных целях";
    label kk-KZ official "32-бап (1995 ж. ред.). Жиналыс құқығын шектеуге аталған конституциялық мақсаттарда заңмен жол беріледі";
}

// --- Ст. 33. Участие в управлении делами государства --------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_KK")
rule StateGovernanceParticipationLiberty1995(person: Person) strict {
    when citizen(person);
    then liberty ParticipateInStateGovernance1995 {
        holder person;
        action state_governance_participation_action(person);
        window [@1995-09-05, @2026-07-01);
    };
    label ru-KZ official "Статья 33 пункт 1 (ред. 1995). Право участвовать в управлении делами государства и обращаться в государственные органы";
    label kk-KZ official "33-бап 1-тармақ (1995 ж. ред.). Мемлекет істерін басқаруға қатысу және мемлекеттік органдарға өтініш білдіру құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_KK")
rule VotingAndReferendumDisqualification1995(person: Person) strict {
    when court_declared_incapable(person)
        or imprisoned_by_court_sentence(person);
    then voting_or_referendum_ineligible(person);
    label ru-KZ official "Статья 33 пункт 3 (ред. 1995). Не имеют права избирать и участвовать в референдуме признанные судом недееспособными и содержащиеся в местах лишения свободы";
    label kk-KZ official "33-бап 3-тармақ (1995 ж. ред.). Сот әрекетке қабілетсіз деп таныған және бас бостандығынан айыру орындарында отырған адамдардың сайлауға және референдумға қатысуға құқығы жоқ";
}

// РАСХОЖДЕНИЕ 6 — расхождение исхода дела. В 1995 перечень оснований у
// «избирать» и «быть избранным» ОДИН: недееспособность и места лишения
// свободы. 2026 ст. 35 п. 3 добавил к неизбираемости непогашенную судимость
// и признанное судом коррупционное деяние. Гражданин с погашенным сроком, но
// непогашенной судимостью, до 01.07.2026 избираем, после — нет.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_KK")
rule CandidateDisqualification1995(person: Person) strict {
    when court_declared_incapable(person)
        or imprisoned_by_court_sentence(person);
    then electoral_candidate_ineligible(person);
    label ru-KZ official "Статья 33 пункт 3 (ред. 1995). Не имеют права быть избранными признанные судом недееспособными и содержащиеся в местах лишения свободы";
    label kk-KZ official "33-бап 3-тармақ (1995 ж. ред.). Сот әрекетке қабілетсіз деп таныған және бас бостандығынан айыру орындарында отырған адамдардың сайлануға құқығы жоқ";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART33_KK")
rule CivilServiceRequirementMustReflectOfficialDuties1995(
    requirement: CivilServiceRequirement,
) strict {
    when civil_service_requirement(requirement);
    when requirement_only_reflects_official_duties(requirement);
    then civil_service_requirement_admissible(requirement);
    label ru-KZ official "Статья 33 пункт 4 (ред. 1995). Требования к кандидату на должность госслужащего обусловливаются только характером должностных обязанностей";
    label kk-KZ official "33-бап 4-тармақ (1995 ж. ред.). Мемлекеттік қызметші лауазымына кандидатқа қойылатын талаптар лауазымдық міндеттердің сипатына ғана байланысты болады";
}

// --- Ст. 34–38. Обязанности ---------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART34_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART34_KK")
rule ConstitutionComplianceDuty1995(person: Person) strict {
    when person(person);
    then duty RespectConstitutionAndLaw1995 {
        bearer person;
        goal maintenance {
            condition not constitution_or_law_violated(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy ConstitutionComplianceCompleteness;
        }
    };
    label ru-KZ official "Статья 34 пункт 1 (ред. 1995). Каждый обязан соблюдать Конституцию и законодательство, уважать права и достоинство других лиц";
    label kk-KZ official "34-бап 1-тармақ (1995 ж. ред.). Әркім Конституция мен заңнаманы сақтауға, басқа адамдардың құқықтары мен ар-намысын құрметтеуге міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART34_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART34_KK")
rule StateSymbolsRespectDuty1995(person: Person) strict {
    when person(person);
    then duty RespectStateSymbols1995 {
        bearer person;
        goal maintenance {
            condition not state_symbols_disrespected(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy StateSymbolsCompleteness;
        }
    };
    label ru-KZ official "Статья 34 пункт 2 (ред. 1995). Каждый обязан уважать государственные символы Республики";
    label kk-KZ official "34-бап 2-тармақ (1995 ж. ред.). Әркім Республиканың мемлекеттік рәміздерін құрметтеуге міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART35_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART35_KK")
rule TaxPaymentDuty1995(person: Person) strict {
    when person(person);
    then duty PayLawfulTaxes1995 {
        bearer person;
        goal maintenance {
            condition not lawful_tax_unpaid(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy TaxPaymentCompleteness;
        }
    };
    label ru-KZ official "Статья 35 (ред. 1995). Уплата законно установленных налогов, сборов и иных обязательных платежей — долг и обязанность каждого";
    label kk-KZ official "35-бап (1995 ж. ред.). Заңды түрде белгіленген салықтарды, алымдарды және өзге де міндетті төлемдерді төлеу — әркімнің борышы әрі міндеті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART36_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART36_KK")
rule DefenceDuty1995(person: Person) strict {
    when citizen(person);
    then duty DefendKazakhstan1995 {
        bearer person;
        goal maintenance {
            condition not defence_duty_unperformed(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy DefenceDutyCompleteness;
        }
    };
    label ru-KZ official "Статья 36 (ред. 1995). Защита Республики — священный долг и обязанность каждого её гражданина";
    label kk-KZ official "36-бап (1995 ж. ред.). Республиканы қорғау — оның әрбір азаматының қасиетті борышы әрі міндеті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART37_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART37_KK")
rule HeritageProtectionDuty1995(person: Person) strict {
    when citizen(person);
    then duty PreserveHeritage1995 {
        bearer person;
        goal maintenance {
            condition not heritage_harmed(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy HeritageProtectionCompleteness;
        }
    };
    label ru-KZ official "Статья 37 (ред. 1995). Граждане обязаны заботиться о сохранении исторического и культурного наследия";
    label kk-KZ official "37-бап (1995 ж. ред.). Азаматтар тарихи және мәдени мұраның сақталуына қамқорлық жасауға міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART38_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART38_KK")
rule NatureProtectionDuty1995(person: Person) strict {
    when citizen(person);
    then duty ProtectNature1995 {
        bearer person;
        goal maintenance {
            condition not nature_harmed(person);
            window [@1995-09-05, @2026-07-01);
            completeness_policy NatureProtectionCompleteness;
        }
    };
    label ru-KZ official "Статья 38 (ред. 1995). Граждане обязаны сохранять природу и бережно относиться к природным богатствам";
    label kk-KZ official "38-бап (1995 ж. ред.). Азаматтар табиғатты сақтауға және табиғат байлықтарына ұқыпты қарауға міндетті";
}

// --- Ст. 39. Пределы ограничения прав -----------------------------------

// РАСХОЖДЕНИЕ 7. Неограничиваемое ядро 1995 — ДЕВЯТЬ позиций против семи в
// 2026. Сверх ядра 2026 в него входят п. 1 ст. 16 (личная свобода) и п. 2
// ст. 26 (гарантия собственности и наследования): ограничение, нацеленное на
// личную свободу, до 01.07.2026 не имело правового эффекта ни при какой
// соразмерности, после — подчиняется общему режиму ст. 41 п. 1.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_KK")
rule CoreRightsRestrictionImmunity1995(
    person: Person,
    restriction: Restriction,
    right: CoreRight1995,
) strict {
    when restriction_affects(restriction, person);
    when restriction_targets_1995(restriction, right);
    then immunity NonDerogableCore1995 {
        holder person;
        protected_effect restriction_has_legal_effect(restriction);
    };
    label ru-KZ official "Статья 39 пункт 3 (ред. 1995). Ни в каких случаях не подлежат ограничению права статей 11, 13–15, пункта 1 статьи 16, статей 17, 19, 22 и пункта 2 статьи 26";
    label kk-KZ official "39-бап 3-тармақ (1995 ж. ред.). 11, 13–15-баптарда, 16-баптың 1-тармағында, 17, 19, 22-баптарда және 26-баптың 2-тармағында көзделген құқықтар ешбір жағдайда шектелуге жатпайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_KK")
rule DerogableRestrictionClassification1995(restriction: Restriction) strict {
    when restriction_enacted_by_law(restriction);
    when restriction_has_constitutional_goal(restriction);
    when proportionality_confirmed(restriction);
    then restriction_constitutionally_justified(restriction);
    label ru-KZ official "Статья 39 пункт 1 (ред. 1995). Ограничение права конституционно оправдано при подтверждённой соразмерности";
    label kk-KZ official "39-бап 1-тармақ (1995 ж. ред.). Мөлшерлестігі расталған кезде құқықты шектеу конституциялық тұрғыда ақталған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_KK")
rule DerogableRestrictionRejected1995(restriction: Restriction) strict {
    when restriction_enacted_by_law(restriction);
    when restriction_has_constitutional_goal(restriction);
    when proportionality_disproved(restriction);
    then not restriction_constitutionally_justified(restriction);
    label ru-KZ official "Статья 39 пункт 1 (ред. 1995). Ограничение права не оправдано при опровергнутой соразмерности";
    label kk-KZ official "39-бап 1-тармақ (1995 ж. ред.). Мөлшерлестігі теріске шығарылған кезде құқықты шектеу ақталмаған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_KK")
rule InterethnicAccordViolationUnconstitutional1995(person: Person) strict {
    when action_harms_interethnic_or_interconfessional_accord(person);
    then action_unconstitutional(person);
    label ru-KZ official "Статья 39 пункт 2 (ред. 1995). Признаются неконституционными любые действия, способные нарушить межнациональное и межконфессиональное согласие";
    label kk-KZ official "39-бап 2-тармақ (1995 ж. ред.). Ұлтаралық және конфессияаралық келісімді бұзуға қабілетті кез келген әрекет конституциялық емес деп танылады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART39_KK")
rule PoliticalMotiveRestrictionProhibited1995(restriction: Restriction) strict {
    when restriction_on_political_grounds(restriction);
    then restriction_prohibited(restriction);
    label ru-KZ official "Статья 39 пункт 3 (ред. 1995). Не допускается ни в какой форме ограничение прав и свобод граждан по политическим мотивам";
    label kk-KZ official "39-бап 3-тармақ (1995 ж. ред.). Азаматтардың құқықтары мен бостандықтарын саяси себептер бойынша қандай да бір нысанда шектеуге жол берілмейді";
}

// === Достройка действующей редакции по аудиту 12.09.2026 ====================
//
// Ст. 19 была выражена только пунктом 1 (презумпция невиновности). Пункты 2 и
// 3 стояли без нормы, притом что запрет повторного привлечения существовал
// правилом `RepeatedLiabilityProhibited1995` пакета `court` — но с якорем в
// ст. 77 п. 3 редакции 1995, чьё окно закрылось 01.07.2026. В редакции 2026
// эта норма переехала из перечня принципов правосудия в ст. 19 п. 3, поэтому
// её действующий двойник заводится ЗДЕСЬ, а не рядом со ст. 78.

relation testimony_demanded_against_self_or_relatives(person: Person) kind empirical {
    label ru-KZ official "от человека потребованы показания против самого себя, супруга (супруги) либо близких родственников";
    label kk-KZ official "адамнан өз-өзіне, жұбайына (зайыбына) немесе жақын туыстарына қарсы айғақ беру талап етілді";
}
relation clergy_testimony_demanded_about_confession(person: Person) kind empirical {
    label ru-KZ official "от священнослужителя потребованы свидетельства против доверившихся ему на исповеди";
    label kk-KZ official "діни қызметшіден өзіне сеніп, сырын ашқан адамдарға қарсы куәлік ету талап етілді";
}
relation no_duty_to_testify_against_self_or_relatives(person: Person) kind institutional {
    label ru-KZ official "человек не обязан давать такие показания";
    label kk-KZ official "адам мұндай айғақ беруге міндетті емес";
}
relation clergy_not_obliged_to_testify(person: Person) kind institutional {
    label ru-KZ official "священнослужитель не обязан свидетельствовать против доверившихся ему на исповеди";
    label kk-KZ official "діни қызметші өзіне сеніп, сырын ашқан адамдарға қарсы куәлік етуге міндетті емес";
}
relation repeated_prosecution_for_same_offence(person: Person) kind empirical {
    label ru-KZ official "человек повторно привлекается к уголовной либо административной ответственности за одно и то же правонарушение";
    label kk-KZ official "адам дәл сол құқық бұзушылық үшін қылмыстық немесе әкімшілік жауаптылыққа қайта тартылуда";
}
relation repeated_prosecution_prohibited(person: Person) kind institutional {
    label ru-KZ official "повторное привлечение к ответственности за одно и то же правонарушение запрещено";
    label kk-KZ official "дәл сол құқық бұзушылық үшін жауаптылыққа қайта тартуға тыйым салынады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_KK")
rule NoDutyToTestifyAgainstSelfOrRelatives(person: Person) strict {
    when testimony_demanded_against_self_or_relatives(person);
    then no_duty_to_testify_against_self_or_relatives(person);
    label ru-KZ official "Статья 19 пункт 2. Никто не обязан давать показания против самого себя, супруга (супруги) и близких родственников, круг которых определяется законом";
    label kk-KZ official "19-бап 2-тармақ. Ешкім өз-өзіне, жұбайына (зайыбына) және заңда айқындалған жақын туыстарына қарсы айғақ беруге міндетті емес";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_KK")
rule ClergyNotObligedToTestifyAboutConfession(person: Person) strict {
    when clergy_testimony_demanded_about_confession(person);
    then clergy_not_obliged_to_testify(person);
    label ru-KZ official "Статья 19 пункт 2. Священнослужители не обязаны свидетельствовать против доверившихся им на исповеди";
    label kk-KZ official "19-бап 2-тармақ. Діни қызметшілер өздеріне сеніп, сырын ашқан адамдарға қарсы куәлік етуге міндетті емес";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_KK")
rule RepeatedProsecutionProhibited(person: Person) strict {
    when repeated_prosecution_for_same_offence(person);
    then repeated_prosecution_prohibited(person);
    label ru-KZ official "Статья 19 пункт 3. Повторное привлечение человека к уголовной или административной ответственности за одно и то же правонарушение запрещено";
    label kk-KZ official "19-бап 3-тармақ. Адамды дәл сол құқық бұзушылық үшін қылмыстық немесе әкімшілік жауаптылыққа қайта тартуға тыйым салынады";
}
