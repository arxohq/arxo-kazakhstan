// Конституция РК 2026, раздел II (ст. 12–41): права, свободы и обязанности.
//
// Границы честности:
// - ст. 12–41 закреплены дословно в kz.constitution.sources; здесь находятся
//   только исполняемые контуры, а не пересказ каждой декларативной фразы;
// - «необходимо» и соразмерность ст. 41 не вычисляются эвристикой. Предикат
//   proportionality_confirmed принадлежит именованной interpretation-группе,
//   добавляемой генератором CLIR; без выбранной интерпретации evaluator
//   возвращает INTERPRETATION_REQUIRED (§152–157);
// - ст. 18 не содержит числа часов задержания: числовой предел не выдуман;
// - межпакетные bridge-правила personal-data/marriage/OSMS подключаются через
//   pinned imports после resolve-контекста WP-35.
//
// НОСИТЕЛЬ НОРМЫ СВЯЗЫВАЕТСЯ ТЕЛОМ, А НЕ ОБЪЯВЛЕНИЕМ `for` (§190), И ЦЕНА
// ЗАБЫВЧИВОСТИ ЗДЕСЬ ИЗМЕРЕНА. До 31.08.2026 три правила редакции 2026 —
// `TreatyExtraditionPower`, `CitizenshipDeprivationPower` и
// `AccessToAffectingDocumentsDuty` — объявляли `for authority: StateAuthority`
// и не читали `state_authority(authority)` в теле. `lawc check` отвергал их
// тремя `LDC-E4101`, но `lawc lower` собирал CLIR БЕЗ ЕДИНОГО СЛОВА, пакет
// уезжал в корпус, а ворота закрепления пропускали его целиком по коду
// возврата `check`. На деле норма при этом не молчала — она была ХУЖЕ, чем
// мёртвой: позиция создавалась с ВЫДУМАННЫМ носителем
// (`urn:position:AccessToAffectingDocumentsDuty:0/holder` вместо органа
// дела). Различающая проба — собственные близнецы редакции 1995
// (`TreatyExtraditionPower1995`, `CitizenAccessToAffectingDocumentsDuty1995`):
// они связыватель читают и на том же деле дают носителем реальный орган.
// Правка — дописать `state_authority(authority)` в тело, как у близнецов.

language "law.core" version "0.2";
package kz.constitution.rights version "0.1.0";
namespace "urn:kz:constitution:rights";

entity Person {
    label ru-KZ official "физическое лицо";
    label kk-KZ official "жеке тұлға";
}
entity StateAuthority {
    label ru-KZ official "государственный орган либо должностное лицо";
    label kk-KZ official "мемлекеттік орган не лауазымды адам";
}
entity Legislature {
    label ru-KZ official "законодательный орган";
    label kk-KZ official "заң шығарушы орган";
}
pub entity Restriction {
    label ru-KZ official "ограничение прав и свобод, вводимое законом";
    label kk-KZ official "заңмен енгізілетін құқықтар мен бостандықтарды шектеу";
}
entity StateAct {
    label ru-KZ official "акт государственного органа";
    label kk-KZ official "мемлекеттік органның актісі";
}
entity Detention {
    label ru-KZ official "задержание, арест либо содержание под стражей";
    label kk-KZ official "ұстау, қамауға алу не күзетпен ұстау";
}
entity Document {
    label ru-KZ official "документ, затрагивающий права и интересы лица";
    label kk-KZ official "адамның құқықтары мен мүдделерін қозғайтын құжат";
}
entity Parent {
    label ru-KZ official "родитель";
    label kk-KZ official "ата-ана";
}
entity Child {
    label ru-KZ official "ребёнок";
    label kk-KZ official "бала";
}
entity MovementRestriction {
    label ru-KZ official "ограничение свободы передвижения";
    label kk-KZ official "жүріп-тұру бостандығын шектеу";
}
entity Association {
    label ru-KZ official "объединение граждан";
    label kk-KZ official "азаматтардың бірлестігі";
}
entity EducationInstitution {
    label ru-KZ official "организация образования";
    label kk-KZ official "білім беру ұйымы";
}
entity Assembly {
    label ru-KZ official "мирное собрание";
    label kk-KZ official "бейбіт жиналыс";
}
entity CivilServiceRequirement {
    label ru-KZ official "требование, предъявляемое к поступающим на государственную службу";
    label kk-KZ official "мемлекеттік қызметке кіретіндерге қойылатын талап";
}

enum CoreRight {
    LegalPersonality;
    NonExtradition;
    Equality;
    Life;
    Dignity;
    NationalIdentityAndLanguage;
    FreedomOfConscience;
    label ru-KZ official "право или свобода, ограничение которых Конституция 2026 года не допускает";
    label kk-KZ official "2026 жылғы Конституция шектеуге жол бермейтін құқық не бостандық";
}

relation person(person: Person) kind empirical {
    label ru-KZ official "субъект является физическим лицом";
    label kk-KZ official "субъект жеке тұлға болып табылады";
}
relation citizen(person: Person) kind empirical {
    label ru-KZ official "лицо является гражданином Республики Казахстан";
    label kk-KZ official "адам Қазақстан Республикасының азаматы болып табылады";
}
relation legislature(authority: Legislature) kind empirical {
    label ru-KZ official "орган является законодательным органом";
    label kk-KZ official "орган заң шығарушы орган болып табылады";
}
relation restriction_affects(restriction: Restriction, person: Person) kind empirical {
    label ru-KZ official "ограничение затрагивает данное лицо";
    label kk-KZ official "шектеу осы адамды қозғайды";
}
relation restriction_targets(restriction: Restriction, right: CoreRight) kind empirical {
    label ru-KZ official "ограничение направлено на данное право либо свободу";
    label kk-KZ official "шектеу осы құқыққа не бостандыққа бағытталған";
}
relation restriction_enacted_by_law(restriction: Restriction) kind empirical {
    label ru-KZ official "ограничение установлено законом";
    label kk-KZ official "шектеу заңмен белгіленген";
}
relation restriction_has_constitutional_goal(restriction: Restriction) kind empirical {
    label ru-KZ official "ограничение преследует конституционно признанную цель";
    label kk-KZ official "шектеу конституциялық тұрғыда танылған мақсатты көздейді";
}
relation proportionality_confirmed(restriction: Restriction) kind evaluative {
    label ru-KZ official "соразмерность ограничения подтверждена";
    label kk-KZ official "шектеудің мөлшерлестігі расталды";
}
relation proportionality_disproved(restriction: Restriction) kind evaluative {
    label ru-KZ official "соразмерность ограничения опровергнута";
    label kk-KZ official "шектеудің мөлшерлестігі теріске шығарылды";
}
relation restriction_attempt(authority: Legislature, restriction: Restriction) kind empirical {
    label ru-KZ official "законодательный орган вводит ограничение";
    label kk-KZ official "заң шығарушы орган шектеу енгізеді";
}
relation restriction_has_legal_effect(restriction: Restriction) kind institutional {
    label ru-KZ official "ограничение имеет правовой эффект";
    label kk-KZ official "шектеудің құқықтық күші бар";
}
relation derogable_right_target(restriction: Restriction) kind institutional {
    label ru-KZ official "ограничиваемое право допускает ограничение";
    label kk-KZ official "шектелетін құқық шектеуге жол береді";
}
relation restriction_constitutionally_justified(restriction: Restriction) kind institutional {
    label ru-KZ official "ограничение конституционно оправдано";
    label kk-KZ official "шектеу конституциялық тұрғыда ақталған";
}

relation treaty_allows_extradition(person: Person) kind empirical {
    label ru-KZ official "выдача допускается международным договором Республики";
    label kk-KZ official "ұстап беруге Республиканың халықаралық шартымен жол беріледі";
}
relation extradition_decision(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган принимает решение о выдаче лица";
    label kk-KZ official "мемлекеттік орган адамды ұстап беру туралы шешім қабылдайды";
}
relation extradited(person: Person) kind institutional {
    label ru-KZ official "лицо выдано иностранному государству";
    label kk-KZ official "адам шет мемлекетке ұстап берілді";
}
relation court_ordered_citizenship_deprivation(person: Person) kind empirical {
    label ru-KZ official "лишение гражданства произведено по решению суда";
    label kk-KZ official "азаматтықтан айыру сот шешімі бойынша жүргізілді";
}
relation terrorism_or_grave_national_harm(person: Person) kind empirical {
    label ru-KZ official "лицом совершено террористическое преступление либо причинён иной тяжкий вред жизненно важным интересам Республики";
    label kk-KZ official "адам террористік қылмыс жасады не Республиканың өмірлік маңызды мүдделеріне өзге де ауыр зиян келтірді";
}
relation citizenship_deprivation_decision(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган принимает решение о лишении гражданства";
    label kk-KZ official "мемлекеттік орган азаматтықтан айыру туралы шешім қабылдайды";
}
relation citizenship_deprived(person: Person) kind institutional {
    label ru-KZ official "лицо лишено гражданства Республики";
    label kk-KZ official "адам Республика азаматтығынан айырылды";
}

relation death_penalty_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган назначает смертную казнь";
    label kk-KZ official "мемлекеттік орган өлім жазасын тағайындайды";
}
relation death_penalty_imposed(person: Person) kind institutional {
    label ru-KZ official "смертная казнь назначена";
    label kk-KZ official "өлім жазасы тағайындалды";
}
relation torture_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган применяет пытки либо жестокое обращение";
    label kk-KZ official "мемлекеттік орган азаптауды не қатыгездікпен қарауды қолданады";
}
relation tortured(person: Person) kind institutional {
    label ru-KZ official "лицо подвергнуто пыткам либо жестокому, бесчеловечному или унижающему достоинство обращению";
    label kk-KZ official "адам азаптауға не қатыгез, адамгершілікке жатпайтын немесе ар-намысты қорлайтын қарауға ұшырады";
}
relation censorship_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган осуществляет цензуру";
    label kk-KZ official "мемлекеттік орган цензураны жүзеге асырады";
}
relation censorship_imposed(person: Person) kind institutional {
    label ru-KZ official "цензура применена";
    label kk-KZ official "цензура қолданылды";
}
relation discriminatory_treatment_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган допускает различие в обращении";
    label kk-KZ official "мемлекеттік орган қарауда алалауға жол береді";
}
relation discriminated(person: Person) kind institutional {
    label ru-KZ official "лицо подвергнуто дискриминации";
    label kk-KZ official "адам кемсітушілікке ұшырады";
}
relation unlawful_privacy_interference_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган вмешивается в частную жизнь лица";
    label kk-KZ official "мемлекеттік орган адамның жеке өміріне араласады";
}
relation privacy_unlawfully_interfered(person: Person) kind institutional {
    label ru-KZ official "неприкосновенность частной жизни нарушена";
    label kk-KZ official "жеке өмірге қол сұғылмаушылық бұзылды";
}
relation unlawful_home_entry_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган проникает в жилище лица";
    label kk-KZ official "мемлекеттік орган адамның тұрғын үйіне кіреді";
}
relation home_unlawfully_entered(person: Person) kind institutional {
    label ru-KZ official "неприкосновенность жилища нарушена";
    label kk-KZ official "тұрғын үйге қол сұғылмаушылық бұзылды";
}
relation uncompensated_expropriation_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган изымает имущество без равноценного возмещения";
    label kk-KZ official "мемлекеттік орган мүлікті тең бағамен өтемей алып қояды";
}
relation property_uncompensatedly_expropriated(person: Person) kind institutional {
    label ru-KZ official "имущество изъято без равноценного возмещения";
    label kk-KZ official "мүлік тең бағамен өтелмей алып қойылды";
}

relation detention_of(detention: Detention, person: Person) kind empirical {
    label ru-KZ official "задержание касается данного лица";
    label kk-KZ official "ұстау осы адамға қатысты";
}
relation detention_exceeds_statutory_period(detention: Detention) kind empirical {
    label ru-KZ official "срок задержания превысил установленный законом предел";
    label kk-KZ official "ұстау мерзімі заңмен белгіленген шектен асты";
}
relation continued_detention_barred(detention: Detention) kind institutional {
    label ru-KZ official "задержание сверх установленного законом срока запрещено: судебного решения нет";
    label kk-KZ official "заңмен белгіленген мерзімнен тыс ұстауға тыйым салынған: сот шешімі жоқ";
}
relation detention_has_court_decision(detention: Detention) kind empirical {
    label ru-KZ official "имеется судебное решение о продлении задержания";
    label kk-KZ official "ұстау мерзімін ұзарту туралы сот шешімі бар";
}
relation continued_detention_attempt(authority: StateAuthority, detention: Detention) kind empirical {
    label ru-KZ official "государственный орган продолжает содержание лица под стражей";
    label kk-KZ official "мемлекеттік орган адамды күзетпен ұстауды жалғастырады";
}
relation unlawful_continued_detention(detention: Detention) kind institutional {
    label ru-KZ official "продолжение содержания под стражей неправомерно";
    label kk-KZ official "күзетпен ұстауды жалғастыру заңсыз";
}

relation accused(person: Person) kind empirical {
    label ru-KZ official "лицо обвиняется в совершении преступления";
    label kk-KZ official "адам қылмыс жасады деп айыпталады";
}
relation final_conviction(person: Person) kind empirical {
    label ru-KZ official "в отношении лица вступил в законную силу обвинительный приговор";
    label kk-KZ official "адамға қатысты соттың айыптау үкімі заңды күшіне енді";
}
relation innocent(person: Person) kind institutional {
    label ru-KZ official "лицо считается невиновным";
    label kk-KZ official "адам кінәсіз деп есептеледі";
}

relation document_affects(document: Document, person: Person) kind empirical {
    label ru-KZ official "документ затрагивает права и интересы лица";
    label kk-KZ official "құжат адамның құқықтары мен мүдделерін қозғайды";
}
relation access_provided(document: Document, person: Person) kind empirical {
    label ru-KZ official "лицу обеспечен доступ к затрагивающим его документам";
    label kk-KZ official "адамға өзін қозғайтын құжаттармен танысу мүмкіндігі қамтамасыз етілді";
}
relation constitution_or_law_violated(person: Person) kind empirical {
    label ru-KZ official "лицом нарушены Конституция либо законы Республики";
    label kk-KZ official "адам Республиканың Конституциясын не заңдарын бұзды";
}
relation state_symbols_disrespected(person: Person) kind empirical {
    label ru-KZ official "лицо не проявляет уважения к государственным символам";
    label kk-KZ official "адам мемлекеттік рәміздерді құрметтемейді";
}
relation nature_harmed(person: Person) kind empirical {
    label ru-KZ official "лицом причинён вред природе";
    label kk-KZ official "адам табиғатқа зиян келтірді";
}
relation lawful_tax_unpaid(person: Person) kind empirical {
    label ru-KZ official "лицом не уплачены законно установленные налоги, сборы и иные обязательные платежи";
    label kk-KZ official "адам заңды түрде белгіленген салықтарды, алымдарды және өзге де міндетті төлемдерді төлемеді";
}
relation defence_duty_unperformed(person: Person) kind empirical {
    label ru-KZ official "гражданином не исполнена обязанность по защите Республики";
    label kk-KZ official "азамат Республиканы қорғау міндетін орындамады";
}
relation heritage_harmed(person: Person) kind empirical {
    label ru-KZ official "лицом причинён вред историко-культурному наследию";
    label kk-KZ official "адам тарихи-мәдени мұраға зиян келтірді";
}
relation parent_of(parent: Parent, child: Child) kind empirical {
    label ru-KZ official "лицо является родителем данного ребёнка";
    label kk-KZ official "адам осы баланың ата-анасы болып табылады";
}
relation child_care_provided(parent: Parent, child: Child) kind empirical {
    label ru-KZ official "родители заботятся о ребёнке и воспитывают его";
    label kk-KZ official "ата-ана балаға қамқорлық жасайды және оны тәрбиелейді";
}

// Ст. 15, 24, 26, 31, 33–35: прямые гарантии, обязанности и
// закрытые конституционные основания ограничений.
relation state_authority(authority: StateAuthority) kind empirical {
    label ru-KZ official "субъект является государственным органом либо должностным лицом";
    label kk-KZ official "субъект мемлекеттік орган не лауазымды адам болып табылады";
}
relation unlawful_state_action_harmed(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "незаконными действиями государственных органов лицу причинён вред";
    label kk-KZ official "мемлекеттік органдардың заңсыз әрекеттерімен адамға зиян келтірілді";
}
relation state_harm_compensated(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "причинённый вред возмещён государством";
    label kk-KZ official "келтірілген зиян мемлекет тарапынан өтелді";
}
relation rights_exercise_harms_others_or_constitutional_order(person: Person) kind empirical {
    label ru-KZ official "осуществление прав нарушает права других лиц либо посягает на конституционный строй";
    label kk-KZ official "құқықтарды жүзеге асыру басқа адамдардың құқықтарын бұзады не конституциялық құрылысқа нұқсан келтіреді";
}
relation rights_exercise_constitutionally_limited(person: Person) kind institutional {
    label ru-KZ official "осуществление прав и свобод ограничено конституционным пределом";
