// Нулеарные мосты прямого действия для отраслевых пакетов.
//
// У каждого моста ДВЕ редакции, и это не симметрия ради симметрии. Мост есть
// `assert` с якорем в статью КОНКРЕТНОЙ редакции, а проекция as-of §31
// снимает узлы неприменимых редакций. Пока мосты стояли только в редакции
// 2026, любой отраслевой пакет, применивший датировку, терял конституционное
// основание на всяком деле до 01.07.2026 — а такие дела в корпусе есть
// (ОСМС считает взносы на 30.06.2025 и 30.06.2026). Без датировки было
// наоборот: основание бралось из редакции, которой на дату дела нет.
pub relation constitutional_personal_data_guarantee() kind institutional {
    label ru-KZ official "Конституция гарантирует защиту персональных данных";
    label kk-KZ official "Конституция дербес деректердің қорғалуына кепілдік береді";
}
pub relation constitutional_personal_data_guarantee_1995() kind institutional {
    label ru-KZ official "Конституция 1995 года гарантировала защиту персональных данных";
    label kk-KZ official "1995 жылғы Конституция дербес деректердің қорғалуына кепілдік берді";
}
pub relation constitutional_marriage_protection() kind institutional {
    label ru-KZ official "Конституция защищает брак, семью, материнство, отцовство и детство";
    label kk-KZ official "Конституция некені, отбасын, ана болуды, әке болуды және балалық шақты қорғайды";
}
pub relation constitutional_marriage_protection_1995() kind institutional {
    label ru-KZ official "Конституция 1995 года защищала брак, семью, материнство, отцовство и детство";
    label kk-KZ official "1995 жылғы Конституция некені, отбасын, ана болуды, әке болуды және балалық шақты қорғады";
}
relation constitutional_labor_guarantee() kind institutional {
    label ru-KZ official "Конституция гарантирует условия труда, вознаграждение и отдых";
    label kk-KZ official "Конституция еңбек жағдайларына, сыйақыға және демалысқа кепілдік береді";
