pub relation constitutional_health_guarantee() kind institutional {
    label ru-KZ official "Конституция гарантирует охрану здоровья";
    label kk-KZ official "Конституция денсаулық сақтауға кепілдік береді";
}
pub relation constitutional_health_guarantee_1995() kind institutional {
    label ru-KZ official "Конституция 1995 года гарантировала охрану здоровья";
    label kk-KZ official "1995 жылғы Конституция денсаулық сақтауға кепілдік берді";
}

// Ст. 9: статус языков. Норма живёт здесь, а не в пакете источников: тот
// хранит редакции и статьи, а это утверждения о государстве, которые ст. 22
// (право пользоваться родным языком) предполагает установленными.
//
// Из этих фактов §158 сознательно НИЧЕГО не выводит. Divergence report
// сообщает о расхождении аутентичных редакций и останавливается: какая
// редакция превалирует — вопрос права, а не вывода, и `divergence_report`
// понятия превалирующего языка не имеет по построению. Факты дают отчёту
// конституционное основание считать обе редакции аутентичными и делают
// ст. 9 адресуемой (§33), а не выводящей.
pub relation state_language_is_kazakh() kind institutional {
    label ru-KZ official "государственным языком Республики Казахстан является казахский язык";
    label kk-KZ official "Қазақстан Республикасының мемлекеттік тілі — қазақ тілі";
}
pub relation russian_used_officially_in_state_bodies() kind institutional {
    label ru-KZ official "в государственных организациях и органах местного самоуправления наравне с казахским официально употребляется русский язык";
    label kk-KZ official "мемлекеттік ұйымдарда және жергілікті өзін-өзі басқару органдарында орыс тілі ресми түрде қазақ тілімен тең қолданылады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_KK")
assert constitutional_personal_data_guarantee();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART30_KK")
assert constitutional_marriage_protection();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
assert constitutional_labor_guarantee();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART32_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART32_KK")
assert constitutional_health_guarantee();

// Те же гарантии в редакции 1995: ст. 18 (неприкосновенность частной жизни),
// ст. 27 (брак и семья под защитой государства), ст. 29 (право на охрану
// здоровья). Номера статей — из закреплённых байтов той редакции, а не из
// подстановки «минус три»: нумерация разделов между редакциями сдвинута
// неравномерно.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART18_KK")
assert constitutional_personal_data_guarantee_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART27_KK")
assert constitutional_marriage_protection_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART29_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART29_KK")
assert constitutional_health_guarantee_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_KK")
assert state_language_is_kazakh();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_KK")
assert russian_used_officially_in_state_bodies();

// Ст. 41.3: семь прав образуют неограничиваемое ядро.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART12_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART12_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART16_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART17_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART17_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART25_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART25_KK")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule CoreRightsRestrictionImmunity(
    person: Person,
    restriction: Restriction,
    right: CoreRight,
) strict {
    when restriction_affects(restriction, person);
    when restriction_targets(restriction, right);
    then immunity NonDerogableCore {
        holder person;
        protected_effect restriction_has_legal_effect(restriction);
    };
    label ru-KZ official "Статья 41 пункт 3. Неограничиваемое ядро прав";
    label kk-KZ official "41-бап 3-тармақ. Шектелмейтін құқықтар өзегі";
}

// Ст. 41.1: ограничение иных прав — только законом, с конституционной целью
// и после явного разрешения оценочного вопроса соразмерности.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule DerogableRestrictionClassification(restriction: Restriction) strict {
    when restriction_enacted_by_law(restriction);
    when restriction_has_constitutional_goal(restriction);
    when proportionality_confirmed(restriction);
    then restriction_constitutionally_justified(restriction);
    label ru-KZ official "Статья 41 пункт 1. Ограничение права конституционно оправдано при подтверждённой соразмерности";
    label kk-KZ official "41-бап 1-тармақ. Мөлшерлестігі расталған кезде құқықты шектеу конституциялық тұрғыда ақталған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule DerogableRestrictionRejected(restriction: Restriction) strict {
    when restriction_enacted_by_law(restriction);
    when restriction_has_constitutional_goal(restriction);
    when proportionality_disproved(restriction);
    then not restriction_constitutionally_justified(restriction);
    label ru-KZ official "Статья 41 пункт 1. Ограничение права не оправдано при опровергнутой соразмерности";
    label kk-KZ official "41-бап 1-тармақ. Мөлшерлестігі теріске шығарылған кезде құқықты шектеу ақталмаған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule RightsLimitationPower(authority: Legislature, restriction: Restriction) strict {
    when legislature(authority);
    when derogable_right_target(restriction);
    then power RestrictDerogableRight {
        holder authority;
        exercise restriction_attempt(authority, restriction);
        valid_when restriction_constitutionally_justified(restriction);
        effect restriction_has_legal_effect(restriction);
    };
    label ru-KZ official "Статья 41 пункт 1. Права и свободы могут быть ограничены только законами и лишь в той мере, в какой это необходимо для защиты конституционного строя, прав и свобод, национальной безопасности, общественного порядка, здоровья и нравственности";
    label kk-KZ official "41-бап 1-тармақ. Құқықтар мен бостандықтар конституциялық құрылысты, құқықтар мен бостандықтарды, ұлттық қауіпсіздікті, қоғамдық тәртіпті, денсаулық пен имандылықты қорғау үшін қажет болатын шамада ғана заңдармен шектелуі мүмкін";
}

// Ст. 14: общий иммунитет и прямо конституционная treaty-оговорка.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_KK")
rule CitizenNonExtraditionImmunity(person: Person) strict {
    when citizen(person);
    then immunity NonExtradition {
        holder person;
        protected_effect extradited(person);
    };
    label ru-KZ official "Статья 14 пункт 1. Гражданин Республики Казахстан не может быть выдан иностранному государству";
    label kk-KZ official "14-бап 1-тармақ. Қазақстан Республикасының азаматын шет мемлекетке ұстап беруге болмайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_KK")
rule TreatyExtraditionPower(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then power ExtraditeUnderTreaty {
        holder authority;
        exercise extradition_decision(authority, person);
        valid_when treaty_allows_extradition(person);
        effect extradited(person);
    };
    label ru-KZ official "Статья 14 пункт 1. Выдача гражданина допустима, если это установлено международным договором Республики";
    label kk-KZ official "14-бап 1-тармақ. Азаматты ұстап беруге Республиканың халықаралық шартында белгіленген жағдайда жол беріледі";
}

priority TreatyClauseOverGeneralNonExtradition: TreatyExtraditionPower > CitizenNonExtraditionImmunity reason lex_specialis;

// Ст. 13.2: лишение гражданства — только судебное решение в двух указанных
// Конституцией классах основания; иных оснований модель не домысливает.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_KK")
rule CitizenshipDeprivationPower(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when court_ordered_citizenship_deprivation(person);
    when terrorism_or_grave_national_harm(person);
    then power DepriveCitizenship {
        holder authority;
        exercise citizenship_deprivation_decision(authority, person);
        valid_when court_ordered_citizenship_deprivation(person);
        effect citizenship_deprived(person);
    };
    label ru-KZ official "Статья 13 пункт 2. Лишение гражданства допускается только по решению суда за террористические преступления либо иной тяжкий вред национальным интересам Республики";
    label kk-KZ official "13-бап 2-тармақ. Азаматтықтан айыруға террористік қылмыстар не Республиканың ұлттық мүдделеріне өзге де ауыр зиян келтіргені үшін сот шешімі бойынша ғана жол беріледі";
}

// Ст. 16, 17, 20 и специальные запреты прочих статей раздела II.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART16_RU")
rule EqualityImmunity(person: Person) strict {
    when person(person);
    then immunity NoDiscrimination {
        holder person;
        protected_effect discriminated(person);
    };
    label ru-KZ official "Статья 16 пункт 2. Никто не может подвергаться дискриминации по происхождению, положению, полу, расе, национальности, языку, отношению к религии, убеждениям, месту жительства и любым иным обстоятельствам";
    label kk-KZ official "16-бап 2-тармақ. Тегіне, жағдайына, жынысына, нәсіліне, ұлтына, тіліне, дінге көзқарасына, нанымына, тұрғылықты жеріне және кез келген өзге де мән-жайларға байланысты ешкім кемсітілмейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART17_RU")
rule DeathPenaltyImmunity(person: Person) strict {
    when person(person);
    then immunity NoDeathPenalty {
        holder person;
        protected_effect death_penalty_imposed(person);
    };
    label ru-KZ official "Статья 17 пункт 3. Смертная казнь запрещена";
    label kk-KZ official "17-бап 3-тармақ. Өлім жазасына тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_RU")
rule TortureImmunity(person: Person) strict {
    when person(person);
    then immunity NoTorture {
        holder person;
        protected_effect tortured(person);
    };
    label ru-KZ official "Статья 20 пункт 2. Никто не должен подвергаться пыткам, насилию, другому жестокому или унижающему человеческое достоинство обращению или наказанию";
    label kk-KZ official "20-бап 2-тармақ. Ешкім азаптауға, зорлық-зомбылыққа, басқа да қатыгез немесе адамның ар-намысын қорлайтын қарауға не жазалауға ұшырамауға тиіс";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_RU")
rule PrivacyImmunity(person: Person) strict {
    when person(person);
    then immunity PrivacyProtection {
        holder person;
        protected_effect privacy_unlawfully_interfered(person);
    };
    label ru-KZ official "Статья 21 пункт 1. Право на неприкосновенность частной жизни, личную и семейную тайну и защиту персональных данных гарантируется законом";
    label kk-KZ official "21-бап 1-тармақ. Жеке өмірге қол сұғылмаушылық, жеке және отбасылық құпия және дербес деректердің қорғалу құқығына заңмен кепілдік беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART23_RU")
rule CensorshipImmunity(person: Person) strict {
    when person(person);
    then immunity NoCensorship {
        holder person;
        protected_effect censorship_imposed(person);
    };
    label ru-KZ official "Статья 23 пункт 5. Цензура запрещена";
    label kk-KZ official "23-бап 5-тармақ. Цензураға тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART28_RU")
rule HomeImmunity(person: Person) strict {
    when person(person);
    then immunity HomeInviolability {
        holder person;
        protected_effect home_unlawfully_entered(person);
    };
    label ru-KZ official "Статья 28 пункт 1. Жилище неприкосновенно; проникновение в него допускается лишь в случаях и порядке, установленных законом";
    label kk-KZ official "28-бап 1-тармақ. Тұрғын үйге қол сұғылмайды; оған кіруге заңмен белгіленген жағдайларда және тәртіппен ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_RU")
rule PropertyImmunity(person: Person) strict {
    when person(person);
    then immunity CompensatedExpropriationOnly {
        holder person;
        protected_effect property_uncompensatedly_expropriated(person);
    };
    label ru-KZ official "Статья 29 пункт 3. Принудительное отчуждение имущества для государственных нужд допускается лишь при условии равноценного его возмещения";
    label kk-KZ official "29-бап 3-тармақ. Мемлекет мұқтажы үшін мүліктен мәжбүрлеп айыруға оның құны тең бағамен өтелген жағдайда ғана жол беріледі";
}

// Ст. 18: Конституция отсылает сам числовой предел к закону.
// Ст. 18 п. 2 говорит «БЕЗ СУДЕБНОГО РЕШЕНИЯ», и до 02.09.2026 эта оговорка в
// модели не работала: предикат `detention_has_court_decision` был объявлен и не
// читался ни одним правилом, а иммунитет выводился от одного лишь превышения
// срока. Изъятие живёт на предикате с литеральной головой — `unless` при
// норм-голове компилятор отбрасывает (LDC-E1302).
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_KK")
rule ContinuedDetentionBarredWithoutCourtDecision(detention: Detention) defeasible {
    when detention_exceeds_statutory_period(detention);
    unless detention_has_court_decision(detention);
    then continued_detention_barred(detention);
    label ru-KZ official "Статья 18 пункт 2. Задержание свыше установленного законом срока запрещено, пока нет судебного решения";
    label kk-KZ official "18-бап 2-тармақ. Сот шешімі болмайынша заңмен белгіленген мерзімнен тыс ұстауға тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_RU")
rule DetentionBeyondStatutoryLimitImmunity(detention: Detention, person: Person) strict {
    when detention_of(detention, person);
    when continued_detention_barred(detention);
    then immunity CourtOrderRequiredForContinuedDetention {
        holder person;
        protected_effect unlawful_continued_detention(detention);
    };
    label ru-KZ official "Статья 18 пункт 2. Без судебного решения человек не может быть подвергнут задержанию свыше сроков, предусмотренных законом";
    label kk-KZ official "18-бап 2-тармақ. Сот шешімінсіз адамды заңда көзделген мерзімнен тыс ұстауға болмайды";
}

// Ст. 19.1: презумпция снимается только вступившим в силу приговором.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART19_KK")
presumption PresumptionOfInnocence(person: Person) {
    when accused(person);
    presume innocent(person);
    unless final_conviction(person) then not innocent(person);
    label ru-KZ official "Статья 19 пункт 1. Каждый считается невиновным, пока его виновность не будет признана вступившим в законную силу приговором суда";
    label kk-KZ official "19-бап 1-тармақ. Адамның кінәлі екендігі заңды күшіне енген сот үкімімен танылғанға дейін ол кінәсіз деп есептеледі";
}

// Ст. 21.3 и 30.3: исполняемые обязанности с открытым окном. Доказательство
// исполнения требует явного completeness-пути, молчание его не заменяет.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_RU")
rule AccessToAffectingDocumentsDuty(
    authority: StateAuthority,
    document: Document,
    person: Person,
) strict {
    when state_authority(authority);
    when document_affects(document, person);
    then duty ProvideAccess {
        bearer authority;
        beneficiary person;
        maintain access_provided(document, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 21 пункт 3. Государственные органы, объединения, должностные лица и средства массовой информации обязаны обеспечить каждому возможность ознакомиться с затрагивающими его права и интересы документами";
    label kk-KZ official "21-бап 3-тармақ. Мемлекеттік органдар, бірлестіктер, лауазымды адамдар және бұқаралық ақпарат құралдары әрбір адамға өзінің құқықтары мен мүдделерін қозғайтын құжаттармен танысу мүмкіндігін қамтамасыз етуге міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART30_RU")
rule ParentCareDuty(parent: Parent, child: Child) strict {
    when parent_of(parent, child);
    then duty CareForChild {
        bearer parent;
        beneficiary child;
        goal maintenance {
            condition child_care_provided(parent, child);
            window [@2026-07-01, infinity);
            completeness_policy ChildCareCompleteness;
        }
    };
    label ru-KZ official "Статья 30 пункт 3. Забота о детях и их воспитание — естественное право и обязанность родителей";
    label kk-KZ official "30-бап 3-тармақ. Балаларына қамқорлық жасау және оларды тәрбиелеу — ата-ананың табиғи құқығы әрі міндеті";
}

// Ст. 36–40: продолжающиеся обязанности. Они не объявляются исполненными по
// отсутствию контрпримера: completeness policy должна быть предъявлена делом.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART36_RU")
rule ConstitutionComplianceDuty(person: Person) strict {
    when person(person);
    then duty RespectConstitutionAndLaw {
        bearer person;
        goal maintenance {
            condition not constitution_or_law_violated(person);
            window [@2026-07-01, infinity);
            completeness_policy ConstitutionComplianceCompleteness;
        }
    };
    label ru-KZ official "Статья 36 пункт 1. Каждый обязан соблюдать Конституцию и законодательство Республики, уважать права, свободы, честь и достоинство других лиц";
    label kk-KZ official "36-бап 1-тармақ. Әркім Республиканың Конституциясы мен заңнамасын сақтауға, басқа адамдардың құқықтарын, бостандықтарын, абыройы мен ар-намысын құрметтеуге міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART37_RU")
rule NatureProtectionDuty(person: Person) strict {
    when citizen(person);
    then duty ProtectNature {
        bearer person;
        goal maintenance {
            condition not nature_harmed(person);
            window [@2026-07-01, infinity);
            completeness_policy NatureProtectionCompleteness;
        }
    };
    label ru-KZ official "Статья 37 пункт 1. Граждане Республики обязаны сохранять природу и бережно относиться к природным богатствам";
    label kk-KZ official "37-бап 1-тармақ. Республика азаматтары табиғатты сақтауға және табиғат байлықтарына ұқыпты қарауға міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART38_RU")
rule TaxPaymentDuty(person: Person) strict {
    when person(person);
    then duty PayLawfulTaxes {
        bearer person;
        goal maintenance {
            condition not lawful_tax_unpaid(person);
            window [@2026-07-01, infinity);
            completeness_policy TaxPaymentCompleteness;
        }
    };
    label ru-KZ official "Статья 38. Уплата законно установленных налогов, сборов и иных обязательных платежей — долг и обязанность каждого";
    label kk-KZ official "38-бап. Заңды түрде белгіленген салықтарды, алымдарды және өзге де міндетті төлемдерді төлеу — әркімнің борышы әрі міндеті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART39_RU")
rule DefenceDuty(person: Person) strict {
    when citizen(person);
    then duty DefendKazakhstan {
        bearer person;
        goal maintenance {
            condition not defence_duty_unperformed(person);
            window [@2026-07-01, infinity);
            completeness_policy DefenceDutyCompleteness;
        }
    };
    label ru-KZ official "Статья 39 пункт 1. Защита Республики Казахстан — священный долг и обязанность каждого её гражданина";
    label kk-KZ official "39-бап 1-тармақ. Қазақстан Республикасын қорғау — оның әрбір азаматының қасиетті борышы әрі міндеті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART40_RU")
rule HeritageProtectionDuty(person: Person) strict {
    when citizen(person);
    then duty PreserveHeritage {
        bearer person;
        goal maintenance {
            condition not heritage_harmed(person);
            window [@2026-07-01, infinity);
            completeness_policy HeritageProtectionCompleteness;
        }
    };
    label ru-KZ official "Статья 40. Граждане Республики обязаны заботиться о сохранении исторического и культурного наследия";
    label kk-KZ official "40-бап. Республика азаматтары тарихи және мәдени мұраның сақталуына қамқорлық жасауға міндетті";
}

// Ст. 15.6: право на возмещение вреда превращено в обязанность
// органа. Незаконность приходит как установленный факт, а не
// вычисляется по догадке.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_KK")
rule StateCompensationForUnlawfulHarm(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when unlawful_state_action_harmed(authority, person);
    then duty CompensateUnlawfulStateHarm {
        bearer authority;
        beneficiary person;
        maintain state_harm_compensated(authority, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 15 пункт 6. Государство возмещает вред от незаконных действий его органов";
    label kk-KZ official "15-бап 6-тармақ. Мемлекет өз органдарының заңсыз әрекеттерінен келтірілген зиянды өтейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART15_KK")
rule RightsExerciseBoundary(person: Person) strict {
    when rights_exercise_harms_others_or_constitutional_order(person);
    then rights_exercise_constitutionally_limited(person);
    label ru-KZ official "Статья 15 пункт 5. Осуществление прав ограничено правами других и конституционными целями";
    label kk-KZ official "15-бап 5-тармақ. Құқықтарды жүзеге асыру басқалардың құқықтарымен және конституциялық мақсаттармен шектелген";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule FreedomOfMovement(person: Person) strict {
    when lawfully_in_kazakhstan(person);
    then liberty MoveWithinKazakhstan {
        holder person;
        action movement_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 24 пункт 1. Свобода передвижения законно находящегося в Казахстане лица";
    label kk-KZ official "24-бап 1-тармақ. Қазақстанда заңды түрде жүрген адамның жүріп-тұру бостандығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule StatutoryMovementRestriction(restriction: MovementRestriction, person: Person) strict {
    when movement_restriction(restriction, person);
    when movement_restriction_established_by_law(restriction);
    then movement_restriction_constitutionally_valid(restriction);
    label ru-KZ official "Статья 24. Ограничение передвижения или выезда допускается только законом";
    label kk-KZ official "24-бап. Жүріп-тұруды не шығуды шектеуге тек заңмен жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule ReturnToKazakhstanLiberty(person: Person) strict {
    when citizen(person);
    then liberty ReturnToKazakhstan {
        holder person;
        action return_to_kazakhstan_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 24 пункт 2. Граждане Республики Казахстан имеют право беспрепятственного возвращения в Республику Казахстан";
    label kk-KZ official "24-бап 2-тармақ. Қазақстан Республикасының азаматтары Қазақстан Республикасына кедергісіз қайтып оралуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule CitizenReturnImmunity(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then immunity UnobstructedReturnToKazakhstan {
        holder person;
        protected_effect return_blocked(person);
    };
    label ru-KZ official "Статья 24 пункт 2. Гражданин вправе беспрепятственно возвращаться в Казахстан";
    label kk-KZ official "24-бап 2-тармақ. Азамат Қазақстанға кедергісіз қайтып оралуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART26_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART26_KK")
rule FreedomOfAssociation(person: Person, association: Association) strict {
    when citizen(person);
    when association(association);
    then liberty JoinAssociation {
        holder person;
        action association_membership_action(person, association);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 26 пункт 1. Свобода объединений";
    label kk-KZ official "26-бап 1-тармақ. Бірлесу бостандығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART26_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART26_KK")
rule RestrictedOfficePoliticalMembershipIncompatible(person: Person) strict {
    when restricted_political_officeholder(person);
    when political_party_or_union_membership(person);
    then restricted_office_membership_incompatible(person);
    label ru-KZ official "Статья 26 пункт 2. Партийное и профсоюзное членство несовместимо с перечисленными должностями";
    label kk-KZ official "26-бап 2-тармақ. Партияға және кәсіптік одаққа мүшелік аталған лауазымдармен сыйыспайды";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART31_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART31_KK")
rule SocialSecurityDuty(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when lawful_social_security_ground(person);
    then duty ProvideSocialSecurity {
        bearer authority;
        beneficiary person;
        maintain social_security_provided(authority, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 31 пункт 1. Социальное обеспечение по законному основанию";
    label kk-KZ official "31-бап 1-тармақ. Заңды негіз бойынша әлеуметтік қамсыздандыру";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_KK")
rule FreeSecondaryEducationDuty(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when free_secondary_education_eligible(person);
    then duty ProvideFreeSecondaryEducation {
        bearer authority;
        beneficiary person;
        maintain free_secondary_education_provided(authority, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 33 пункт 1. Бесплатное среднее образование в государственном учебном заведении";
    label kk-KZ official "33-бап 1-тармақ. Мемлекеттік оқу орнында тегін орта білім алу";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_KK")
rule PrimaryAndBasicEducationCompulsory(person: Person) strict {
    when primary_or_basic_secondary_education(person);
    then compulsory_education_applies(person);
    label ru-KZ official "Статья 33 пункт 1. Начальное и основное среднее образование обязательно";
    label kk-KZ official "33-бап 1-тармақ. Бастауыш және негізгі орта білім алу міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART33_KK")
rule EducationStandardsCompliance(institution: EducationInstitution) strict {
    when education_institution(institution);
    when education_standards_met(institution);
    then education_institution_constitutionally_compliant(institution);
    label ru-KZ official "Статья 33 пункт 4. Деятельность учебных заведений соответствует общеобязательным стандартам";
    label kk-KZ official "33-бап 4-тармақ. Оқу орындарының қызметі жалпыға міндетті стандарттарға сәйкес келеді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART34_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART34_KK")
rule PeacefulAssemblyLiberty(person: Person, assembly: Assembly) strict {
    when citizen(person);
    when peaceful_assembly(assembly, person);
    then liberty ParticipateInPeacefulAssembly {
        holder person;
        action assembly_participation_action(person, assembly);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 34. Право граждан на мирные собрания";
    label kk-KZ official "34-бап. Азаматтардың бейбіт жиналыс өткізу құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART34_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART34_KK")
rule AssemblyRestrictionRequiresLawAndGoal(restriction: Restriction, assembly: Assembly) strict {
    when assembly_restriction(restriction, assembly);
    when assembly_restriction_established_by_law(restriction);
    when assembly_restriction_has_constitutional_goal(restriction);
    then assembly_restriction_constitutionally_valid(restriction);
    label ru-KZ official "Статья 34. Ограничение мирных собраний требует закона и конституционной цели";
    label kk-KZ official "34-бап. Бейбіт жиналысты шектеу заңды және конституциялық мақсатты талап етеді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_KK")
rule StateGovernanceParticipationLiberty(person: Person) strict {
    when citizen(person);
    then liberty ParticipateInStateGovernance {
        holder person;
        action state_governance_participation_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 35 пункт 1. Право участвовать в управлении делами государства";
    label kk-KZ official "35-бап 1-тармақ. Мемлекет істерін басқаруға қатысу құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_KK")
rule VotingAndReferendumDisqualification(person: Person) strict {
    when court_declared_incapable(person)
        or imprisoned_by_court_sentence(person);
    then voting_or_referendum_ineligible(person);
    label ru-KZ official "Статья 35 пункт 3. Закрытый перечень оснований неучастия в выборах и референдуме";
    label kk-KZ official "35-бап 3-тармақ. Сайлауға және референдумға қатыспау негіздерінің жабық тізбесі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_KK")
rule CandidateDisqualification(person: Person) strict {
    when court_declared_incapable(person)
        or unexpunged_conviction(person)
        or corruption_offence_confirmed_by_court(person);
    then electoral_candidate_ineligible(person);
    label ru-KZ official "Статья 35 пункт 3. Закрытый перечень оснований неизбираемости";
    label kk-KZ official "35-бап 3-тармақ. Сайлануға болмайтын негіздердің жабық тізбесі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART35_KK")
rule CivilServiceRequirementMustReflectOfficialDuties(requirement: CivilServiceRequirement) strict {
    when civil_service_requirement(requirement);
    when requirement_only_reflects_official_duties(requirement);
    then civil_service_requirement_admissible(requirement);
    label ru-KZ official "Статья 35 пункт 4. Требования к госслужащему ограничены характером должностных обязанностей";
    label kk-KZ official "35-бап 4-тармақ. Мемлекеттік қызметшіге қойылатын талаптар лауазымдық міндеттердің сипатымен шектелген";
}

// =========================================================================
// РЕДАКЦИЯ 2026: НОРМЫ, ДОГОНЯЮЩИЕ СЛОЙ 1995 (заведены 02.09.2026).
//
// Разбор нашёл асимметрию: девятнадцать норм слоя 1995 не имели двойника в
// редакции 2026, хотя ТЕКСТ 2026 их содержит. Мера §33.1 этого не видела по
// построению — она считает СТАТЬИ, а на статью хватало одного правила либо
// одного нормативного факта; невыраженное содержание оставалось внутри
// покрытой статьи (ст. 27 и ст. 32 при этом стояли ANCHORED, то есть
// «адресуемо, но ничего не выводится»).
//
// Чего в 2026 НЕТ и потому здесь не появилось: право на забастовку
// (ст. 24 п. 3 ред. 1995 — «включая право на забастовку»; ст. 27 п. 3
// редакции 2026 говорит о трудовых спорах БЕЗ забастовки), бесплатное
// высшее образование на конкурсной основе (ст. 30 п. 2 ред. 1995 против
// ст. 33 п. 2 редакции 2026 — «в соответствии с законом»), социальная
// защита ОТ БЕЗРАБОТИЦЫ как отдельное право (ст. 24 п. 2 ред. 1995 против
// «социальной защиты в соответствии с законом» ст. 27 п. 2) и бесплатная
// юридическая помощь (ст. 13 п. 3 ред. 1995; ст. 86 редакции 2026 её не
// повторяет). Эти четыре — расхождение редакций, а не пробел, и сценарии
// KZ-CON-1995-07…09 уже требуют, чтобы после 01.07.2026 они не выводились.

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_KK")
rule ForeignCitizenshipNotRecognized(person: Person) strict {
    when citizen(person);
    when holds_foreign_citizenship(person);
    then foreign_citizenship_not_recognized(person);
    label ru-KZ official "Статья 13 пункт 3. Гражданин Республики Казахстан не может иметь двойного или множественного гражданства";
    label kk-KZ official "13-бап 3-тармақ. Қазақстан Республикасының азаматында қос немесе көп азаматтық болмайды";
}

// Расхождение с редакцией 1995: там наличие иного гражданства только НЕ
// ПРИЗНАВАЛОСЬ; редакция 2026 добавляет прямое последствие — основание для
// прекращения гражданства. Поэтому вторая норма, а не расширение первой.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART13_KK")
rule ForeignCitizenshipTerminatesCitizenship(person: Person) strict {
    when citizen(person);
    when holds_foreign_citizenship(person);
    then foreign_citizenship_is_termination_ground(person);
    label ru-KZ official "Статья 13 пункт 3. Наличие иного гражданства — основание для прекращения гражданства Республики Казахстан";
    label kk-KZ official "13-бап 3-тармақ. Өзге азаматтықтың болуы — Қазақстан Республикасының азаматтығын тоқтату негізі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART14_KK")
rule ProtectionAndPatronageAbroadDuty(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    when abroad(person);
    then duty ProtectAndPatroniseAbroad {
        bearer authority;
        beneficiary person;
        goal maintenance {
            condition protection_and_patronage_provided(authority, person);
            window [@2026-07-01, infinity);
            completeness_policy ProtectionAbroadCompleteness;
        }
    };
    label ru-KZ official "Статья 14 пункт 2. Республика Казахстан гарантирует своим гражданам защиту за её пределами";
    label kk-KZ official "14-бап 2-тармақ. Қазақстан Республикасы өз азаматтарына одан тыс жерде қорғауға кепілдік береді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_KK")
rule ArrestRequiresCourtDecisionAndAppeal(detention: Detention) strict {
    when arrest_or_custody(detention);
    when court_sanction_obtained(detention);
    when appeal_right_granted(detention);
    then arrest_constitutionally_admissible(detention);
    label ru-KZ official "Статья 18 пункт 2. Содержание под стражей допускается только по судебному решению с предоставлением права на обжалование";
    label kk-KZ official "18-бап 2-тармақ. Күзетпен ұстауға шағымдану құқығы берілген сот шешімі бойынша ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_KK")
rule CounselFromDetentionDuty(
    authority: StateAuthority,
    detention: Detention,
    person: Person,
) strict {
    when state_authority(authority);
    when detention_of(detention, person);
    then duty ProvideCounselAccess {
        bearer authority;
        beneficiary person;
        maintain counsel_access_provided(detention, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 18 пункт 4. Задержанный, подозреваемый, обвиняемый имеет право пользоваться помощью адвоката с момента задержания";
    label kk-KZ official "18-бап 4-тармақ. Ұсталған, күдікті, айыпталушы адам ұсталған сәттен бастап адвокаттың көмегін пайдалануға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_KK")
rule DignityImmunity(person: Person) strict {
    when person(person);
    then immunity DignityInviolable {
        holder person;
        protected_effect dignity_infringed(person);
    };
    label ru-KZ official "Статья 20 пункт 1. Честь и достоинство человека неприкосновенны и охраняются законом";
    label kk-KZ official "20-бап 1-тармақ. Адамның абыройы мен ар-намысына қол сұғылмайды және заңмен қорғалады";
}

// Расхождение с редакцией 1995: ст. 19 п. 1 говорила о национальной,
// ПАРТИЙНОЙ и РЕЛИГИОЗНОЙ принадлежности; ст. 22 п. 1 редакции 2026 — только
// о национальной. Предикат оставлен общий (`identity_declaration_action`),
// разводит редакции метка и якорь.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_KK")
rule NationalIdentityLiberty(person: Person) strict {
    when person(person);
    then liberty DeclareNationalIdentity {
        holder person;
        action identity_declaration_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 22 пункт 1. Каждый человек вправе определять, указывать или не указывать свою национальную принадлежность";
    label kk-KZ official "22-бап 1-тармақ. Әркім өзінің ұлттық тегін анықтауға, көрсетуге немесе көрсетпеуге құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART22_KK")
rule NativeLanguageAndCultureLiberty(person: Person) strict {
    when person(person);
    then liberty UseNativeLanguageAndCulture {
        holder person;
        action native_language_and_culture_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 22 пункт 2. Право пользоваться родным языком и культурой, свободно выбирать язык общения, воспитания, обучения и творчества";
    label kk-KZ official "22-бап 2-тармақ. Ана тілі мен мәдениетін пайдалану, қарым-қатынас, тәрбие, оқу және шығармашылық тілін еркін таңдау құқығы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART23_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART23_KK")
rule ProhibitedPropaganda(person: Person) strict {
    when propaganda_of_prohibited_content(person);
    then propaganda_constitutionally_prohibited(person);
    label ru-KZ official "Статья 23 пункт 6. Не допускаются пропаганда насильственного изменения основ конституционного строя, посягательства на территориальную целостность, войны, розни и призывы к таким действиям";
    label kk-KZ official "23-бап 6-тармақ. Конституциялық құрылысты күштеп өзгертуді, аумақтық тұтастыққа нұқсан келтіруді, соғысты, алауыздықты насихаттауға және осындай әрекеттерге шақыруға жол берілмейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule ExitKazakhstanLiberty(person: Person) strict {
    when person(person);
    then liberty ExitKazakhstan {
        holder person;
        action exit_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 24 пункт 2. Каждый человек имеет право выезжать за пределы Республики Казахстан";
    label kk-KZ official "24-бап 2-тармақ. Әркім Қазақстан Республикасынан тыс жерге шығуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART25_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART25_KK")
rule FreedomOfConscienceLiberty(person: Person) strict {
    when person(person);
    then liberty ExerciseFreedomOfConscience {
        holder person;
        action conscience_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 25 пункт 1. Каждый человек имеет право на свободу совести";
    label kk-KZ official "25-бап 1-тармақ. Әркімнің ар-ождан бостандығына құқығы бар";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
rule FreedomOfLabourLiberty(person: Person) strict {
    when person(person);
    then liberty ChooseOccupationFreely {
        holder person;
        action labour_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 27 пункт 1. Право на труд, свободный выбор рода деятельности и профессии";
    label kk-KZ official "27-бап 1-тармақ. Еңбек ету, қызмет пен кәсіп түрін еркін таңдау құқығы";
}

// Расхождение с редакцией 1995: там принудительный труд допускался ТОЛЬКО по
// названным основаниям («только на основании»); ст. 27 п. 1 редакции 2026
// слова «только» не содержит. Норма выражает то же достаточное основание, но
// исключительности перечня из текста 2026 не следует.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
rule ForcedLabourOnJudicialOrEmergencyBasis(person: Person) strict {
    when judicial_act_or_emergency_basis(person);
    then forced_labour_constitutionally_admissible(person);
    label ru-KZ official "Статья 27 пункт 1. Принудительный труд допускается на основании судебного акта о признании виновным либо в условиях чрезвычайного или военного положения";
    label kk-KZ official "27-бап 1-тармақ. Мәжбүрлі еңбекке кінәлі деп тану туралы сот актісі негізінде не төтенше немесе соғыс жағдайында жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
rule LabourDisputeLiberty(person: Person) strict {
    when labour_dispute(person);
    then liberty ResolveLabourDispute {
        holder person;
        action labour_dispute_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 27 пункт 3. Признаётся право на индивидуальные и коллективные трудовые споры с использованием установленных законом способов их разрешения";
    label kk-KZ official "27-бап 3-тармақ. Заңмен белгіленген шешу тәсілдерін пайдалана отырып, жеке және ұжымдық еңбек дауларына құқық танылады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART28_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART28_KK")
rule StatutoryHousingProvisionDuty(
    authority: StateAuthority,
    need: HousingNeed,
    person: Person,
) strict {
    when state_authority(authority);
    when citizen(person);
    when statutory_housing_need(need, person);
    then duty ProvideStatutoryHousing {
        bearer authority;
        beneficiary person;
        maintain affordable_state_housing_provided(need, person) during [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 28 пункт 2. Указанным в законе категориям граждан, нуждающихся в жилье, оно предоставляется в соответствии с установленными законом нормами";
    label kk-KZ official "28-бап 2-тармақ. Заңда көрсетілген тұрғын үйге мұқтаж азаматтар санаттарына ол заңмен белгіленген нормаларға сәйкес беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_KK")
rule FreedomOfEnterpriseLiberty(person: Person) strict {
    when person(person);
    then liberty ConductEnterprise {
        holder person;
        action entrepreneurial_action(person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 29 пункт 4. Республика Казахстан гарантирует право на свободу предпринимательской деятельности";
    label kk-KZ official "29-бап 4-тармақ. Қазақстан Республикасы кәсіпкерлік қызмет бостандығына құқыққа кепілдік береді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_KK")
rule UnfairCompetitionProhibited(person: Person) strict {
    when unfair_competition(person);
    then unfair_competition_prohibited(person);
    label ru-KZ official "Статья 29 пункт 4. Недобросовестная конкуренция запрещена";
    label kk-KZ official "29-бап 4-тармақ. Жосықсыз бәсекеге тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART30_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART30_KK")
rule AdultChildParentCareDuty(child: Child, parent: Parent) strict {
    when adult_capable_child_of(child, parent);
    when parent_incapacitated(parent);
    then duty CareForIncapacitatedParent {
        bearer child;
        beneficiary parent;
        goal maintenance {
            condition parent_care_provided(child, parent);
            window [@2026-07-01, infinity);
            completeness_policy ParentCareCompleteness;
        }
    };
    label ru-KZ official "Статья 30 пункт 4. Совершеннолетние трудоспособные дети обязаны заботиться о нетрудоспособных родителях";
    label kk-KZ official "30-бап 4-тармақ. Кәмелетке толған еңбекке қабілетті балалар еңбекке қабілетсіз ата-анасына қамқорлық жасауға міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART32_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART32_KK")
rule UnpaidMedicalCareDuty(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then duty ProvideUnpaidMedicalCare {
        bearer authority;
        beneficiary person;
        goal maintenance {
            condition guaranteed_free_medical_care_provided(authority, person);
            window [@2026-07-01, infinity);
            completeness_policy MedicalCareCompleteness;
        }
    };
    label ru-KZ official "Статья 32 пункт 2. Граждане Республики Казахстан вправе получать не оплачиваемую ими медицинскую помощь, установленную законом";
    label kk-KZ official "32-бап 2-тармақ. Қазақстан Республикасының азаматтары заңмен белгіленген, өздері ақы төлемейтін медициналық көмек алуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART36_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART36_KK")
rule StateSymbolsRespectDuty(person: Person) strict {
    when person(person);
    then duty RespectStateSymbols {
        bearer person;
        goal maintenance {
            condition not state_symbols_disrespected(person);
            window [@2026-07-01, infinity);
            completeness_policy StateSymbolsCompleteness;
        }
    };
    label ru-KZ official "Статья 36 пункт 2. Каждый человек обязан уважать государственные символы Республики Казахстан";
    label kk-KZ official "36-бап 2-тармақ. Әркім Қазақстан Республикасының мемлекеттік рәміздерін құрметтеуге міндетті";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART37_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART37_KK")
rule OfficialConcealmentLiability(person: Official) strict {
    when official(person);
    when concealed_life_threatening_facts(person);
    then official_liability_arises(person);
    label ru-KZ official "Статья 37 пункт 3. Сокрытие должностными лицами фактов и обстоятельств, угрожающих жизни и здоровью людей, окружающей среде, влечёт ответственность";
    label kk-KZ official "37-бап 3-тармақ. Лауазымды адамдардың адамдардың өмірі мен денсаулығына, қоршаған ортаға қатер төндіретін фактілер мен мән-жайларды жасыруы жауаптылыққа әкеп соғады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule InterethnicAccordViolationUnconstitutional(person: Person) strict {
    when action_harms_interethnic_or_interconfessional_accord(person);
    then action_unconstitutional(person);
    label ru-KZ official "Статья 41 пункт 2. Признаются неконституционными действия, способные нарушить межэтническое и межконфессиональное согласие";
    label kk-KZ official "41-бап 2-тармақ. Этносаралық және конфессияаралық келісімді бұзуға қабілетті әрекеттер конституциялық емес деп танылады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART41_KK")
rule PoliticalMotiveRestrictionProhibited(restriction: Restriction) strict {
    when restriction_on_political_grounds(restriction);
    then restriction_prohibited(restriction);
    label ru-KZ official "Статья 41 пункт 3. Не допускается ограничение прав и свобод граждан по политическим мотивам";
    label kk-KZ official "41-бап 3-тармақ. Азаматтардың құқықтары мен бостандықтарын саяси себептер бойынша шектеуге жол берілмейді";
}

// =========================================================================
// ЗАПРЕТЫ РЕДАКЦИИ 2026 (заведены 02.09.2026).
//
// Абсолютные запреты раздела II были выражены ОДНИМ иммунитетом §128:
// «никто не может подвергаться пыткам» — это `immunity NoTorture` с
// protected_effect `tortured(person)`. Половины при этом не хватало, и это
// видно по словарю: одиннадцать предикатов вида `<деяние>_attempt` были
// ОБЪЯВЛЕНЫ и не читались ни одним правилом. То есть дело могло сообщить
// «орган применяет пытку», и не выводилось НИЧЕГО: иммунитет блокирует эффект
// ВЛАСТИ §127, а власти пытать Конституция не даёт и дать не может.
//
// Вторая половина — запрет §125 на самом органе: носитель — государственный
// орган, действие — тот самый `<деяние>_attempt`. Теперь дело о попытке
// получает ответ, а не молчание, и словарь перестал звать факты, которых
// никто не читает.
//
// 02.09.2026 запреты были заведены ТОЛЬКО для редакции 2026 — из опасения
// подделать содержание прекращённой редакции. 13.09.2026 опасение проверено
// чтением закреплённого текста 1995 и НЕ ПОДТВЕРДИЛОСЬ: у каждого из
// одиннадцати запретов в редакции 1995 есть собственная норма. Близнецы
// заведены ниже, в разделе «ЗАПРЕТЫ РЕДАКЦИИ 1995».

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART16_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART16_KK")
rule DiscriminationProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDiscrimination {
        bearer authority;
        action discriminatory_treatment_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 16 пункт 2. Никто не может подвергаться дискриминации по перечисленным и любым иным обстоятельствам";
    label kk-KZ official "16-бап 2-тармақ. Аталған және кез келген өзге де мән-жайларға байланысты ешкім кемсітілмейді";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART17_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART17_KK")
rule DeathPenaltyProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDeathPenalty {
        bearer authority;
        action death_penalty_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 17 пункт 3. Смертная казнь запрещена";
    label kk-KZ official "17-бап 3-тармақ. Өлім жазасына тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_KK")
rule DignityInfringementProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromDignityInfringement {
        bearer authority;
        action dignity_infringement_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 20 пункт 1. Честь и достоинство человека неприкосновенны и охраняются законом";
    label kk-KZ official "20-бап 1-тармақ. Адамның абыройы мен ар-намысына қол сұғылмайды және заңмен қорғалады";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART20_KK")
rule TortureProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromTorture {
        bearer authority;
        action torture_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 20 пункт 2. Никто не должен подвергаться пыткам, насилию, другому жестокому или унижающему человеческое достоинство обращению или наказанию";
    label kk-KZ official "20-бап 2-тармақ. Ешкім азаптауға, зорлық-зомбылыққа, басқа да қатыгез немесе адамның ар-намысын қорлайтын қарауға не жазалауға ұшырамауға тиіс";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART21_KK")
rule PrivacyInterferenceProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromPrivacyInterference {
        bearer authority;
        action unlawful_privacy_interference_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 21 пункты 1 и 2. Неприкосновенность частной жизни и тайна сообщений охраняются законом; ограничение допускается лишь в случаях и порядке, установленных законом";
    label kk-KZ official "21-бап 1 және 2-тармақтар. Жеке өмірге қол сұғылмаушылық пен хабарлар құпиясы заңмен қорғалады; шектеуге заңмен белгіленген жағдайларда және тәртіппен ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART23_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART23_KK")
rule CensorshipProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromCensorship {
        bearer authority;
        action censorship_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 23 пункт 5. Цензура запрещена";
    label kk-KZ official "23-бап 5-тармақ. Цензураға тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART24_KK")
rule ReturnBlockProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when citizen(person);
    then prohibition RefrainFromBlockingReturn {
        bearer authority;
        action return_block_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 24 пункт 2. Граждане Республики Казахстан имеют право беспрепятственного возвращения в Республику Казахстан";
    label kk-KZ official "24-бап 2-тармақ. Қазақстан Республикасының азаматтары Қазақстан Республикасына кедергісіз қайтып оралуға құқылы";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART28_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART28_KK")
rule HomeEntryProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromUnlawfulHomeEntry {
        bearer authority;
        action unlawful_home_entry_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 28 пункт 1. Жилище неприкосновенно; проникновение в него, осмотр и обыск допускаются лишь в случаях и порядке, установленных законом";
    label kk-KZ official "28-бап 1-тармақ. Тұрғын үйге қол сұғылмайды; оған кіруге, қарауға және тінтуге заңмен белгіленген жағдайларда және тәртіппен ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART29_KK")
rule UncompensatedExpropriationProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when person(person);
    then prohibition RefrainFromUncompensatedExpropriation {
        bearer authority;
        action uncompensated_expropriation_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 29 пункт 3. Принудительное отчуждение имущества для государственных нужд допускается лишь при условии равноценного его возмещения";
    label kk-KZ official "29-бап 3-тармақ. Мемлекет мұқтажы үшін мүліктен мәжбүрлеп айыруға оның құны тең бағамен өтелген жағдайда ғана жол беріледі";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART18_KK")
rule ContinuedDetentionProhibition(authority: StateAuthority, detention: Detention) strict {
    when state_authority(authority);
    when continued_detention_barred(detention);
    then prohibition RefrainFromDetentionBeyondStatutoryPeriod {
        bearer authority;
        action continued_detention_attempt(authority, detention);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 18 пункт 2. Без судебного решения человек не может быть подвергнут задержанию свыше сроков, предусмотренных законом";
    label kk-KZ official "18-бап 2-тармақ. Сот шешімінсіз адамды заңда көзделген мерзімнен тыс ұстауға болмайды";
}

// Единственный запрет раздела с ИЗЪЯТИЕМ: принуждение к труду допускается по
// судебному акту либо в условиях чрезвычайного или военного положения. Изъятие
// живёт на предикате с литеральной головой, а не на норм-голове: `unless` при
// норм-голове компилятор отбрасывает (LDC-E1302).
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
rule ForcedLabourBarredWithoutBasis(person: Person) defeasible {
    when person(person);
    unless forced_labour_constitutionally_admissible(person);
    then forced_labour_barred(person);
    label ru-KZ official "Статья 27 пункт 1. Принуждение к труду запрещено, пока нет судебного акта о признании виновным либо чрезвычайного или военного положения";
    label kk-KZ official "27-бап 1-тармақ. Кінәлі деп тану туралы сот актісі не төтенше немесе соғыс жағдайы болмайынша еңбекке мәжбүрлеуге тыйым салынған";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART27_KK")
rule ForcedLabourProhibition(authority: StateAuthority, person: Person) strict {
    when state_authority(authority);
    when forced_labour_barred(person);
    then prohibition RefrainFromForcedLabour {
        bearer authority;
        action forced_labour_attempt(authority, person);
        window [@2026-07-01, infinity);
    };
    label ru-KZ official "Статья 27 пункт 1. Принудительный труд вне названных Конституцией оснований не допускается";
    label kk-KZ official "27-бап 1-тармақ. Конституцияда аталған негіздерден тыс мәжбүрлі еңбекке жол берілмейді";
}

// =========================================================================
// РЕДАКЦИЯ 1995 ГОДА, РАЗДЕЛ II «Человек и гражданин» (ст. 10–39).
//
// Правила заключают в те же предикаты, что и правила 2026, и живут в том же
// пакете (DECISION-0026, вариант «а» для разделов с сохранившимся
// институтом). Разводит их проекция as-of по машине применимости §31:
// якоря 1995 указывают на редакцию, чей `in_force` — [@1995-09-05,
// @2026-07-01), поэтому на дату до 01.07.2026 применимы правила 1995, после
// — правила 2026. Норм-позиции несут тот же интервал окном.
//
// СВОЙ ПРЕДИКАТ ЗАВЕДЁН ТАМ, ГДЕ АНТЕЦЕДЕНТ ДЕЙСТВИТЕЛЬНО ДРУГОЙ. Ниже —
// расхождения, найденные ЧТЕНИЕМ закреплённого текста обеих редакций, а не
// перенесённые по номеру статьи (номера сдвинуты на +2: 1995 ст. 10 ≈ 2026
// ст. 13):
//
//   1) ст. 12 п. 4 — УМОЛЧАНИЕ ИНВЕРТИРОВАНО. 1995: иностранцы пользуются
//      правами граждан, «если иное не предусмотрено»; 2026 ст. 15 п. 4:
//      «в случаях, предусмотренных». Молчание закона в 1995 давало права,
//      в 2026 — отказывает. Это самое сильное расхождение исхода в разделе;
//   2) ст. 16 п. 2 — ЧИСЛО ЕСТЬ В КОНСТИТУЦИИ: «задержанию на срок не более
//      семидесяти двух часов». 2026 ст. 18 п. 2 отсылает срок к закону.
//      Поэтому у 1995 предел выражен keyed-фактом, а у 2026 его нет;
//   3) ст. 24 п. 3 — ПРАВО НА ЗАБАСТОВКУ. 1995 называет его прямо; 2026
//      ст. 27 п. 3 сохранил трудовые споры и убрал забастовку;
//   4) ст. 30 п. 2 — БЕСПЛАТНОЕ ВЫСШЕЕ на конкурсной основе. 2026 ст. 33
//      п. 2 оставил «в соответствии с законом» без бесплатности;
//   5) ст. 30 п. 1 — обязательно ВСЁ среднее образование; 2026 ст. 33 п. 1
//      сузил обязательность до начального и основного среднего;
//   6) ст. 33 п. 3 — ОДИН перечень для «избирать» и «быть избранным»
//      (недееспособность, места лишения свободы). 2026 ст. 35 п. 3 добавил
//      для избираемости непогашенную судимость и коррупционное деяние:
//      гражданин с непогашенной судимостью до 01.07.2026 избираем, после —
//      нет;
//   7) ст. 39 п. 3 — неограничиваемое ядро 1995 ШИРЕ: девять позиций против
//      семи. Сверх ядра 2026 в него входят п. 1 ст. 16 (личная свобода) и
//      п. 2 ст. 26 (гарантия собственности и наследования);
//   8) ст. 12 п. 5 — предел осуществления прав в 1995 ýже: права других,
//      конституционный строй и общественная нравственность. 2026 ст. 15
//      п. 5 добавил общественный порядок и здоровье граждан;
//   9) ст. 18 п. 3 — доступ к затрагивающим документам в 1995 обещан
//      ГРАЖДАНИНУ, в 2026 ст. 21 п. 3 — каждому человеку;
//  10) ст. 25 п. 2 — жильё нуждающимся «за доступную плату из
//      государственных жилищных фондов»; 2026 ст. 28 п. 2 плату убрал;
//  11) ст. 13 п. 3 — бесплатная юридическая помощь в случаях, установленных
//      законом; 2026 ст. 12 п. 3 оставил только «в соответствии с законом»;
//  12) ст. 10 п. 3 — гражданство другого государства НЕ ПРИЗНАЁТСЯ; 2026
//      ст. 13 п. 3 сделал его основанием прекращения гражданства;
//  13) ст. 21 п. 2 — выезд за пределы Республики без конституционной
//      оговорки об ограничении; 2026 ст. 24 п. 2 такую оговорку внёс;
//  14) ст. 19 п. 1 — определять принадлежность национальную, ПАРТИЙНУЮ и
//      РЕЛИГИОЗНУЮ; 2026 ст. 22 п. 1 оставил только национальную.
//
// ОБЪЯВЛЕННАЯ ГРАНИЦА (DECISION-0012). Декларативные положения ст. 12 п. 1–2
// («признаются абсолютными и неотчуждаемыми») правилами не выражаются:
// антецедента у них нет, а придуманный антецедент был бы авторской нормой.
// Они остаются адресуемыми через постатейный слой пакета источников.

enum CoreRight1995 {
    LegalPersonality;
    NonExtradition;
    Equality;
    Life;
    PersonalLiberty;
    Dignity;
    NationalIdentityAndLanguage;
    FreedomOfConscience;
    PropertyAndInheritanceGuarantee;
    label ru-KZ official "право или свобода, ограничение которых Конституция 1995 года не допускала";
    label kk-KZ official "1995 жылғы Конституция шектеуге жол бермеген құқық не бостандық";
}

entity Strike {
    label ru-KZ official "забастовка";
    label kk-KZ official "ереуіл";
}
entity HousingNeed {
    label ru-KZ official "нуждаемость в жилище";
    label kk-KZ official "тұрғын үйге мұқтаждық";
}
entity LegalAidCase {
    label ru-KZ official "случай оказания юридической помощи";
    label kk-KZ official "заң көмегін көрсету жағдайы";
}
entity Official {
    label ru-KZ official "должностное лицо";
    label kk-KZ official "лауазымды адам";
}

relation restriction_targets_1995(restriction: Restriction, right: CoreRight1995) kind empirical {
    label ru-KZ official "ограничение направлено на данное право либо свободу (редакция 1995)";
    label kk-KZ official "шектеу осы құқыққа не бостандыққа бағытталған (1995 жылғы редакция)";
}

// Ст. 10. Гражданство.
relation terrorism_or_grave_vital_interest_harm(person: Person) kind empirical {
    label ru-KZ official "лицом совершено террористическое преступление либо причинён иной тяжкий вред жизненно важным интересам Республики";
    label kk-KZ official "адам террористік қылмыс жасады не Республиканың өмірлік маңызды мүдделеріне өзге де ауыр зиян келтірді";
}
relation holds_foreign_citizenship(person: Person) kind empirical {
    label ru-KZ official "за лицом числится гражданство другого государства";
    label kk-KZ official "адамның басқа мемлекеттің азаматтығы бар";
}
relation foreign_citizenship_not_recognized(person: Person) kind institutional {
    label ru-KZ official "гражданство другого государства за гражданином Республики не признаётся";
    label kk-KZ official "Республика азаматының басқа мемлекеттің азаматтығы танылмайды";
}

// Ст. 11 п. 2. Защита И ПОКРОВИТЕЛЬСТВО за пределами Республики.
relation abroad(person: Person) kind empirical {
    label ru-KZ official "лицо находится за пределами Республики";
    label kk-KZ official "адам Республикадан тыс жерде жүр";
}
relation protection_and_patronage_provided(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "гражданину за пределами Республики обеспечены защита и покровительство государства";
    label kk-KZ official "Республикадан тыс жердегі азаматқа мемлекеттің қорғауы мен қамқорлығы қамтамасыз етілді";
}

// Ст. 12 п. 4–5.
relation foreigner_or_stateless(person: Person) kind empirical {
    label ru-KZ official "лицо является иностранцем либо лицом без гражданства";
    label kk-KZ official "адам шетелдік не азаматтығы жоқ адам болып табылады";
}
relation different_regime_established_for_foreigners(person: Person) kind empirical {
    label ru-KZ official "для иностранцев законом либо договором установлен иной режим";
    label kk-KZ official "шетелдіктер үшін заңмен не шартпен өзгеше режим белгіленген";
}
relation enjoys_citizen_rights_and_duties(person: Person) kind institutional {
    label ru-KZ official "лицо пользуется правами и несёт обязанности наравне с гражданами";
    label kk-KZ official "адам азаматтармен тең құқықтарды пайдаланады және міндеттер атқарады";
}
relation rights_exercise_harms_others_order_or_morality(person: Person) kind empirical {
    label ru-KZ official "осуществление прав нарушает права других лиц, посягает на конституционный строй либо общественную нравственность";
    label kk-KZ official "құқықтарды жүзеге асыру басқа адамдардың құқықтарын бұзады, конституциялық құрылысқа не қоғамдық имандылыққа нұқсан келтіреді";
}

// Ст. 13 п. 3. Бесплатная юридическая помощь.
relation legal_aid_case(aid: LegalAidCase, person: Person) kind empirical {
    label ru-KZ official "случай оказания юридической помощи данному лицу";
    label kk-KZ official "осы адамға заң көмегін көрсету жағдайы";
}
relation statutory_free_legal_aid_ground(aid: LegalAidCase) kind empirical {
    label ru-KZ official "налицо предусмотренное законом основание бесплатной юридической помощи";
    label kk-KZ official "тегін заң көмегінің заңда көзделген негізі бар";
}
relation free_legal_aid_provided(aid: LegalAidCase, person: Person) kind empirical {
    label ru-KZ official "лицу оказана бесплатная юридическая помощь";
    label kk-KZ official "адамға тегін заң көмегі көрсетілді";
}

// Ст. 16. Личная свобода; конституционный предел задержания — 72 часа.
relation detention_without_court_sanction_limit_hours_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "предельный срок задержания без санкции суда — семьдесят два часа (редакция 1995)";
    label kk-KZ official "сот санкциясынсыз ұстаудың шекті мерзімі — жетпіс екі сағат (1995 жылғы редакция)";
}
relation detention_without_court_sanction(detention: Detention) kind empirical {
    label ru-KZ official "задержание произведено без санкции суда";
    label kk-KZ official "ұстау сот санкциясынсыз жүргізілді";
}
relation detention_exceeds_72_hours(detention: Detention) kind empirical {
    label ru-KZ official "срок задержания превысил семьдесят два часа";
    label kk-KZ official "ұстау мерзімі жетпіс екі сағаттан асты";
}
relation arrest_or_custody(detention: Detention) kind empirical {
    label ru-KZ official "применены арест либо содержание под стражей";
    label kk-KZ official "қамауға алу не күзетпен ұстау қолданылды";
}
relation court_sanction_obtained(detention: Detention) kind empirical {
    label ru-KZ official "получена санкция суда";
    label kk-KZ official "сот санкциясы алынды";
}
relation appeal_right_granted(detention: Detention) kind empirical {
    label ru-KZ official "задержанному предоставлено право обжалования";
    label kk-KZ official "ұсталған адамға шағымдану құқығы берілді";
}
relation arrest_constitutionally_admissible(detention: Detention) kind institutional {
    label ru-KZ official "арест либо содержание под стражей конституционно допустимы";
    label kk-KZ official "қамауға алуға не күзетпен ұстауға конституциялық тұрғыда жол беріледі";
}
relation counsel_access_provided(detention: Detention, person: Person) kind empirical {
    label ru-KZ official "задержанному обеспечен доступ к адвокату";
    label kk-KZ official "ұсталған адамға адвокатқа қол жеткізу қамтамасыз етілді";
}

// Ст. 17 п. 1. Достоинство неприкосновенно.
relation dignity_infringement_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган посягает на достоинство лица";
    label kk-KZ official "мемлекеттік орган адамның ар-намысына қол сұғады";
}
relation dignity_infringed(person: Person) kind institutional {
    label ru-KZ official "достоинство лица нарушено";
    label kk-KZ official "адамның ар-намысы бұзылды";
}

// Ст. 18 п. 3. Доступ ГРАЖДАНИНА к затрагивающим его документам.
relation citizen_access_provided(document: Document, person: Person) kind empirical {
    label ru-KZ official "гражданину обеспечен доступ к затрагивающим его документам";
    label kk-KZ official "азаматқа өзін қозғайтын құжаттармен танысу мүмкіндігі қамтамасыз етілді";
}

// Ст. 19. Принадлежность и язык.
relation identity_declaration_action(person: Person) kind empirical {
    label ru-KZ official "лицо определяет и указывает свою национальную, партийную и религиозную принадлежность";
    label kk-KZ official "адам өзінің ұлттық, партиялық және діни тегін анықтайды және көрсетеді";
}
relation native_language_and_culture_action(person: Person) kind empirical {
    label ru-KZ official "лицо пользуется родным языком и культурой";
    label kk-KZ official "адам ана тілі мен мәдениетін пайдаланады";
}

// Ст. 20 п. 3. Пределы распространения информации.
relation propaganda_of_prohibited_content(person: Person) kind empirical {
    label ru-KZ official "лицо ведёт пропаганду насильственного изменения конституционного строя, войны, социального, расового, национального, религиозного, сословного или родового превосходства";
    label kk-KZ official "адам конституциялық құрылысты күштеп өзгертуді, соғысты, әлеуметтік, нәсілдік, ұлттық, діни, тектік-топтық және рулық астамшылықты насихаттайды";
}
relation propaganda_constitutionally_prohibited(person: Person) kind institutional {
    label ru-KZ official "такая пропаганда конституционно запрещена";
    label kk-KZ official "мұндай насихатқа конституциялық тұрғыда тыйым салынған";
}

// Ст. 21 п. 2. Выезд за пределы Республики.
relation exit_kazakhstan_action_1995(person: Person) kind empirical {
    label ru-KZ official "лицо выезжает за пределы Республики (редакция 1995)";
    label kk-KZ official "адам Республикадан тыс жерге шығады (1995 жылғы редакция)";
}

// Ст. 22. Свобода совести.
relation conscience_action(person: Person) kind empirical {
    label ru-KZ official "лицо реализует свободу совести";
    label kk-KZ official "адам ар-ождан бостандығын жүзеге асырады";
}

// Ст. 24. Труд, забастовка, отдых.
relation labour_action(person: Person) kind empirical {
    label ru-KZ official "лицо реализует свободу труда";
    label kk-KZ official "адам еңбек бостандығын жүзеге асырады";
}
relation forced_labour_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган применяет принудительный труд";
    label kk-KZ official "мемлекеттік орган мәжбүрлі еңбекті қолданады";
}
relation judicial_act_or_emergency_basis(person: Person) kind empirical {
    label ru-KZ official "принудительный труд применён по приговору суда либо в условиях чрезвычайного или военного положения";
    label kk-KZ official "мәжбүрлі еңбек сот үкімі бойынша не төтенше немесе соғыс жағдайында қолданылды";
}
relation forced_labour_barred(person: Person) kind institutional {
    label ru-KZ official "принуждение к труду запрещено: названного Конституцией основания нет";
    label kk-KZ official "еңбекке мәжбүрлеуге тыйым салынған: Конституцияда аталған негіз жоқ";
}
relation forced_labour_constitutionally_admissible(person: Person) kind institutional {
    label ru-KZ official "принудительный труд конституционно допустим";
    label kk-KZ official "мәжбүрлі еңбекке конституциялық тұрғыда жол беріледі";
}
relation foreign_citizenship_is_termination_ground(person: Person) kind institutional {
    label ru-KZ official "наличие иного гражданства — основание для прекращения гражданства Республики";
    label kk-KZ official "өзге азаматтықтың болуы — Республика азаматтығын тоқтату негізі";
}
relation labour_dispute(person: Person) kind empirical {
    label ru-KZ official "лицо участвует в индивидуальном либо коллективном трудовом споре";
    label kk-KZ official "адам жеке не ұжымдық еңбек дауына қатысады";
}
relation labour_dispute_action(person: Person) kind empirical {
    label ru-KZ official "лицо использует установленные законом способы разрешения трудового спора";
    label kk-KZ official "адам еңбек дауын шешудің заңмен белгіленген тәсілдерін пайдаланады";
}
