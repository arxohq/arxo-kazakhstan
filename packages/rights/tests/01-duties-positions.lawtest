language "law.core" version "0.2";
package kz.constitution.rights version "0.1.0";
namespace "urn:kz:constitution:rights";

// НАБЛЮДЕНИЕ ДЕОНТИЧЕСКОГО СЛОЯ, ЧАСТЬ 1: обязанности редакции 2026.
//
// До этих сценариев 98 шаблонов норм пакета не наблюдал никто: `[tests]` в
// манифесте не было, а ворота оставались зелёными — понижение пакета не
// спрашивает, выводится ли хоть одна позиция. Здесь каждая обязанность
// редакции 2026 (27 шаблонов: 16 с целью, 11 десахаренных запретов —
// последние в файле 03) предъявляется делом и своим статусом §134.
//
// ЧИТАТЬ ВМЕСТЕ С ГРАНИЦАМИ, КОТОРЫЕ ЗДЕСЬ ЗАКРЕПЛЕНЫ СТОРОЖАМИ:
//
// 1) Цель ПОДДЕРЖАНИЯ §137 с открытым окном [@2026-07-01, infinity) не
//    бывает SATISFIED: закрытие требует completeness path по всему окну, а
//    окно не кончается. Соблюдённое дело даёт ACTIVE, а не SATISFIED.
// 2) Шесть обязанностей государства (ст. 15 п. 6, 18 п. 4, 21 п. 3, 28 п. 2,
//    31 п. 1, 33 п. 1) до 13.09.2026 стояли целью ДОСТИЖЕНИЯ §136 с окном
//    [@2026-07-01, infinity) и не могли стать VIOLATED никогда: §136 требует
//    закрытого окна, а срок исполнения Конституция не назначает. Переведены в
//    ПОДДЕРЖАНИЕ §137 (обязанность без назначенного срока — поддерживать
//    состояние исполнения): установленное неисполнение даёт VIOLATED в окне,
//    исполненное дело — ACTIVE, не SATISFIED.
// 3) `completeness_policy <Имя>` у восьми целей поддержания ссылается на
//    StableId, которого в программе НЕТ: узла `completeness_policy` в CLIR
//    не существует, оценщик поле не читает (единственные чтения
//    `completenessPolicy` — `lawref/verbalize.py:1080` и
//    `law-verbalize/src/render.rs:1266`, то есть словесное изложение).
//    Поэтому SATISFIED не достигается и предъявлением «политики»: путь
//    замыкания ищется по §70-замыканиям предиката условия, а не по имени.

// --- Ст. 36–40: продолжающиеся обязанности человека и гражданина ---------

test "urn:query:kzcr-duty-maintenance-active-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert person(entity_ref("urn:kz:constitution:rights:case:person:1")) { id "d01-a1"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:1")) { id "d01-a2"; origin case_input; }
    }

    // Ст. 36, 37, 38, 39, 40 и ст. 34: дело не несёт ни одного контрпримера,
    // поэтому все шесть обязанностей поддержания ACTIVE — и ни одна не
    // SATISFIED: молчание дела не есть исполнение (§137).
    evaluate positions();
    expect evaluation_status == COMPUTED;
    expect result_kind == NORM_POSITION;
    expect issues_within(info);

    expect position(RespectConstitutionAndLaw, ACTIVE);
    expect position(ProtectNature, ACTIVE);
    expect position(PayLawfulTaxes, ACTIVE);
    expect position(DefendKazakhstan, ACTIVE);
    expect position(PreserveHeritage, ACTIVE);
    expect position(RespectStateSymbols, ACTIVE);

    expect not position(RespectConstitutionAndLaw, SATISFIED);
    expect not position(PayLawfulTaxes, SATISFIED);
    expect not position(RespectConstitutionAndLaw, VIOLATED);
    expect not position(PayLawfulTaxes, VIOLATED);
}

test "urn:query:kzcr-duty-maintenance-violated-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert person(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a1"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a2"; origin case_input; }

        // §137: контрпример УСТАНОВЛЕН делом. Отсутствие факта отрицанием не
        // является, поэтому каждый контрпример подан явно.
        assert constitution_or_law_violated(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a3"; origin case_input; }
        assert nature_harmed(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a4"; origin case_input; }
        assert lawful_tax_unpaid(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a5"; origin case_input; }
        assert defence_duty_unperformed(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a6"; origin case_input; }
        assert heritage_harmed(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a7"; origin case_input; }
        assert state_symbols_disrespected(entity_ref("urn:kz:constitution:rights:case:person:2")) { id "d02-a8"; origin case_input; }
    }

    // Ст. 38: неуплата законно установленного налога установлена → VIOLATED.
    evaluate positions();
    expect issues_within(info);

    expect position(RespectConstitutionAndLaw, VIOLATED);
    expect position(ProtectNature, VIOLATED);
    expect position(PayLawfulTaxes, VIOLATED);
    expect position(DefendKazakhstan, VIOLATED);
    expect position(PreserveHeritage, VIOLATED);
    expect position(RespectStateSymbols, VIOLATED);

    expect not position(PayLawfulTaxes, ACTIVE);
    expect not position(PayLawfulTaxes, SATISFIED);
}

// --- Ст. 30 п. 3 и ст. 30 п. 2: забота в семье ---------------------------

test "urn:query:kzcr-duty-family-active-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert parent_of(entity_ref("urn:kz:constitution:rights:case:parent:1"),
                         entity_ref("urn:kz:constitution:rights:case:child:1")) { id "d03-a1"; origin case_input; }
        assert adult_capable_child_of(entity_ref("urn:kz:constitution:rights:case:child:2"),
                                      entity_ref("urn:kz:constitution:rights:case:parent:2")) { id "d03-a2"; origin case_input; }
        assert parent_incapacitated(entity_ref("urn:kz:constitution:rights:case:parent:2")) { id "d03-a3"; origin case_input; }

        // Забота ОКАЗАНА. §137: положительное условие поддержания в открытом
        // окне даёт ACTIVE, а не SATISFIED — окно не закрыто, закрывать
        // нечем. Сторож ниже это и фиксирует.
        assert child_care_provided(entity_ref("urn:kz:constitution:rights:case:parent:1"),
                                   entity_ref("urn:kz:constitution:rights:case:child:1")) { id "d03-a4"; origin case_input; }
    }

    evaluate positions();
    expect issues_within(info);

    expect position(CareForChild, ACTIVE);
    expect position(CareForIncapacitatedParent, ACTIVE);
    expect not position(CareForChild, SATISFIED);
    expect not position(CareForChild, VIOLATED);
}

test "urn:query:kzcr-duty-family-violated-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert parent_of(entity_ref("urn:kz:constitution:rights:case:parent:3"),
                         entity_ref("urn:kz:constitution:rights:case:child:3")) { id "d04-a1"; origin case_input; }
        assert adult_capable_child_of(entity_ref("urn:kz:constitution:rights:case:child:4"),
                                      entity_ref("urn:kz:constitution:rights:case:parent:4")) { id "d04-a2"; origin case_input; }
        assert parent_incapacitated(entity_ref("urn:kz:constitution:rights:case:parent:4")) { id "d04-a3"; origin case_input; }

        // §137: контрпример у ПОЛОЖИТЕЛЬНОГО условия — явное отрицание факта.
        assert not child_care_provided(entity_ref("urn:kz:constitution:rights:case:parent:3"),
                                       entity_ref("urn:kz:constitution:rights:case:child:3")) { id "d04-a4"; origin case_input; }
        assert not parent_care_provided(entity_ref("urn:kz:constitution:rights:case:child:4"),
                                        entity_ref("urn:kz:constitution:rights:case:parent:4")) { id "d04-a5"; origin case_input; }
    }

    evaluate positions();
    expect issues_within(info);

    expect position(CareForChild, VIOLATED);
    expect position(CareForIncapacitatedParent, VIOLATED);
    expect not position(CareForChild, ACTIVE);
}

// --- Ст. 14 п. 2 и ст. 32: обязанности органа с целью поддержания --------

test "urn:query:kzcr-duty-authority-maintenance-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert state_authority(entity_ref("urn:kz:constitution:rights:case:authority:1")) { id "d05-a1"; origin case_input; }
        assert person(entity_ref("urn:kz:constitution:rights:case:person:3")) { id "d05-a2"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:3")) { id "d05-a3"; origin case_input; }
        assert abroad(entity_ref("urn:kz:constitution:rights:case:person:3")) { id "d05-a4"; origin case_input; }
    }

    // Ст. 14 п. 2: защита и покровительство гражданину за пределами Республики;
    // ст. 32: гарантированный объём бесплатной медицинской помощи.
    evaluate positions();
    expect issues_within(info);

    expect position(ProtectAndPatroniseAbroad, ACTIVE);
    expect position(ProvideUnpaidMedicalCare, ACTIVE);
}

