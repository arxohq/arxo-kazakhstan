// --- Обязанности с целью ДОСТИЖЕНИЯ: ст. 15.6, 21.3, 18.3, 28.2, 31, 33 --

test "urn:query:kzcr-duty-achievement-active-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert state_authority(entity_ref("urn:kz:constitution:rights:case:authority:3")) { id "d07-a1"; origin case_input; }
        assert person(entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a2"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a3"; origin case_input; }

        // Ст. 15 п. 6: вред от незаконных действий органа установлен делом.
        assert unlawful_state_action_harmed(entity_ref("urn:kz:constitution:rights:case:authority:3"),
                                            entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a4"; origin case_input; }
        // Ст. 21 п. 3: документ затрагивает права лица.
        assert document_affects(entity_ref("urn:kz:constitution:rights:case:document:1"),
                                entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a5"; origin case_input; }
        // Ст. 18 п. 3: помощь адвоката с момента задержания.
        assert detention_of(entity_ref("urn:kz:constitution:rights:case:detention:1"),
                            entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a6"; origin case_input; }
        // Ст. 31: основание социального обеспечения.
        assert lawful_social_security_ground(entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a7"; origin case_input; }
        // Ст. 33 п. 1: право на бесплатное среднее образование.
        assert free_secondary_education_eligible(entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a8"; origin case_input; }
        // Ст. 28 п. 2: нуждаемость в жилище, установленная законом.
        assert statutory_housing_need(entity_ref("urn:kz:constitution:rights:case:housing:1"),
                                      entity_ref("urn:kz:constitution:rights:case:person:5")) { id "d07-a9"; origin case_input; }
    }

    evaluate positions();
    expect issues_within(info);

    expect position(CompensateUnlawfulStateHarm, ACTIVE);
    expect position(ProvideAccess, ACTIVE);
    expect position(ProvideCounselAccess, ACTIVE);
    expect position(ProvideSocialSecurity, ACTIVE);
    expect position(ProvideFreeSecondaryEducation, ACTIVE);
    expect position(ProvideStatutoryHousing, ACTIVE);
}

test "urn:query:kzcr-state-duty-maintained-active-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert state_authority(entity_ref("urn:kz:constitution:rights:case:authority:4")) { id "d08-a1"; origin case_input; }
        assert person(entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a2"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a3"; origin case_input; }

        assert unlawful_state_action_harmed(entity_ref("urn:kz:constitution:rights:case:authority:4"),
                                            entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a4"; origin case_input; }
        assert document_affects(entity_ref("urn:kz:constitution:rights:case:document:2"),
                                entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a5"; origin case_input; }
        assert detention_of(entity_ref("urn:kz:constitution:rights:case:detention:2"),
                            entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a6"; origin case_input; }
        assert lawful_social_security_ground(entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a7"; origin case_input; }
        assert free_secondary_education_eligible(entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a8"; origin case_input; }
        assert statutory_housing_need(entity_ref("urn:kz:constitution:rights:case:housing:2"),
                                      entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a9"; origin case_input; }

        // §137: исполнение УСТАНОВЛЕНО в окне → ACTIVE (SATISFIED недостижим при открытом окне).
        assert state_harm_compensated(entity_ref("urn:kz:constitution:rights:case:authority:4"),
                                      entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a10"; origin case_input; }
        assert access_provided(entity_ref("urn:kz:constitution:rights:case:document:2"),
                               entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a11"; origin case_input; }
        assert counsel_access_provided(entity_ref("urn:kz:constitution:rights:case:detention:2"),
                                       entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a12"; origin case_input; }
        assert social_security_provided(entity_ref("urn:kz:constitution:rights:case:authority:4"),
                                        entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a13"; origin case_input; }
        assert free_secondary_education_provided(entity_ref("urn:kz:constitution:rights:case:authority:4"),
                                                 entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a14"; origin case_input; }
        assert affordable_state_housing_provided(entity_ref("urn:kz:constitution:rights:case:housing:2"),
                                                 entity_ref("urn:kz:constitution:rights:case:person:6")) { id "d08-a15"; origin case_input; }
    }

    evaluate positions();
    expect issues_within(info);

    expect position(CompensateUnlawfulStateHarm, ACTIVE);
    expect position(ProvideAccess, ACTIVE);
    expect position(ProvideCounselAccess, ACTIVE);
    expect position(ProvideSocialSecurity, ACTIVE);
    expect position(ProvideFreeSecondaryEducation, ACTIVE);
    expect position(ProvideStatutoryHousing, ACTIVE);
    expect not position(ProvideAccess, SATISFIED);
    expect not position(ProvideAccess, VIOLATED);
}

test "urn:query:kzcr-state-duty-counterexample-violated-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert state_authority(entity_ref("urn:kz:constitution:rights:case:authority:5")) { id "d09-a1"; origin case_input; }
        assert person(entity_ref("urn:kz:constitution:rights:case:person:7")) { id "d09-a2"; origin case_input; }

        assert unlawful_state_action_harmed(entity_ref("urn:kz:constitution:rights:case:authority:5"),
                                            entity_ref("urn:kz:constitution:rights:case:person:7")) { id "d09-a3"; origin case_input; }
        assert document_affects(entity_ref("urn:kz:constitution:rights:case:document:3"),
                                entity_ref("urn:kz:constitution:rights:case:person:7")) { id "d09-a4"; origin case_input; }

        // ЯВНОЕ НЕИСПОЛНЕНИЕ §136.3 предъявлено делом.
        assert not state_harm_compensated(entity_ref("urn:kz:constitution:rights:case:authority:5"),
                                          entity_ref("urn:kz:constitution:rights:case:person:7")) { id "d09-a5"; origin case_input; }
        assert not access_provided(entity_ref("urn:kz:constitution:rights:case:document:3"),
                                   entity_ref("urn:kz:constitution:rights:case:person:7")) { id "d09-a6"; origin case_input; }
    }

    // §137: обязанность поддержания нарушена контрпримером в окне —
    // установленное неисполнение (FALSE_ONLY) даёт VIOLATED. До 13.09.2026
    // обе нормы стояли достижением с открытым окном и оставались ACTIVE
    // при том же деле (нарушение было недостижимо).
    evaluate positions();
    expect issues_within(info);

    expect position(CompensateUnlawfulStateHarm, VIOLATED);
    expect position(ProvideAccess, VIOLATED);
    expect not position(CompensateUnlawfulStateHarm, ACTIVE);
    expect not position(ProvideAccess, ACTIVE);
}

// --- Граница носителя §190: обязанность органа без факта статуса ---------

test "urn:query:kzcr-duty-bearer-must-be-bound-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        // Документ затрагивает лицо, но СТАТУС ОРГАНА делом не установлен.
        assert person(entity_ref("urn:kz:constitution:rights:case:person:8")) { id "d10-a1"; origin case_input; }
        assert document_affects(entity_ref("urn:kz:constitution:rights:case:document:4"),
                                entity_ref("urn:kz:constitution:rights:case:person:8")) { id "d10-a2"; origin case_input; }
    }

    // §190: носитель связывается ТЕЛОМ правила. Без `state_authority(a)`
    // посылка не выведена, позиции нет вовсе — и это правильный ответ, а не
    // позиция с выдуманным носителем (шапка `rights.law` описывает ровно ту
    // ошибку, которую этот сторож не даёт вернуть).
    evaluate positions();
    expect issues_within(info);

    expect not position(ProvideAccess, ACTIVE);
    expect not position(ProvideAccess, PENDING);
    expect position(RespectConstitutionAndLaw, ACTIVE);
}
