test "urn:query:kzcr-prohibition-1995-absent-in-2026-1" {
    given {
        context {
            decision_time @2026-09-01T12:00:00+05:00;
            knowledge_time @2026-09-01T12:00:00+05:00;
            legal_time @2026-09-01;
            timezone "Asia/Qyzylorda";
        }

        assert state_authority(entity_ref("urn:kz:constitution:rights:case:authority:31")) { id "p11-a1"; origin case_input; }
        assert person(entity_ref("urn:kz:constitution:rights:case:person:31")) { id "p11-a2"; origin case_input; }
        assert citizen(entity_ref("urn:kz:constitution:rights:case:person:31")) { id "p11-a3"; origin case_input; }
        assert detention_of(entity_ref("urn:kz:constitution:rights:case:detention:31"),
                            entity_ref("urn:kz:constitution:rights:case:person:31")) { id "p11-a4"; origin case_input; }
        assert detention_without_court_sanction(entity_ref("urn:kz:constitution:rights:case:detention:31")) { id "p11-a5"; origin case_input; }
        assert detention_exceeds_72_hours(entity_ref("urn:kz:constitution:rights:case:detention:31")) { id "p11-a6"; origin case_input; }
    }

    // ЗЕРКАЛО: на дату редакции 2026 слой 1995 исключён проекцией §92 целиком.
    // Не EXPIRED — позиции НЕТ В ДОКУМЕНТЕ: исключён сам узел правила.
    evaluate positions();
    expect issues_within(info);
    expect issue(EDITION_NOT_APPLICABLE);

    expect not position(RefrainFromDiscrimination1995, ACTIVE);
    expect not position(RefrainFromDeathPenalty1995, ACTIVE);
    expect not position(RefrainFromDignityInfringement1995, ACTIVE);
    expect not position(RefrainFromTorture1995, ACTIVE);
    expect not position(RefrainFromPrivacyInterference1995, ACTIVE);
    expect not position(RefrainFromCensorship1995, ACTIVE);
    expect not position(RefrainFromBlockingReturn1995, ACTIVE);
    expect not position(RefrainFromUnlawfulHomeEntry1995, ACTIVE);
    expect not position(RefrainFromUncompensatedExpropriation1995, ACTIVE);
    expect not position(RefrainFromForcedLabour1995, ACTIVE);
    expect not position(RefrainFromDetentionBeyond72Hours1995, ACTIVE);
    expect not position(RefrainFromTorture1995, EXPIRED);
    expect not position(RefrainFromCensorship1995, EXPIRED);

    // Запреты редакции 2026 на ту же дату применимы.
    expect position(RefrainFromTorture, ACTIVE);
    expect position(RefrainFromCensorship, ACTIVE);
}
