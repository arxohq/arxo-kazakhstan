// -------------------------------------------------------------------------
// Две нормы редакции 1995, у которых нет соответствия в редакции 2026.
// Их форма была оставлена на решение человека; решение принято 27.08.2026 и
// записано в DECISION-0026 §4.
//
// СТ. 4 П. 3 — ПРИОРИТЕТ РАТИФИЦИРОВАННОГО ДОГОВОРА НАД ЗАКОНОМ.
// Выражена ОБЫЧНЫМ ПРАВИЛОМ, выводящим факт `treaty_prevails_over_law`, а не
// defeasible-правилом с priority. Основание — измеренное, а не стилистическое:
// приоритет между правилами в 0.1 объявляется ТОЛЬКО между defeasible
// (§192/§114), и попытка объявить его над strict-правилом — ошибка
// компиляции `LDC-E4105`, а не молчаливый no-op. Все конституционные правила
// корпуса — strict, поэтому доктрина приоритета, которая ДЕЙСТВИТЕЛЬНО
// побеждала бы норму закона в выводе, потребовала бы сперва перевести
// побеждаемые правила в defeasible. Это самостоятельное проектное изменение с
// широким радиусом, и оно не делается попутно.
// Масштабируемая цель, когда такой перевод состоится, — НЕ попарные
// `priority`, а `priority policy` §118: одна декларация над парами
// grounded-применений, где старшинство источника приходит ФАКТОМ
// (`senior`/`higher_legal_force`), как в зелёном векторе LAY-L1-PRIORITY-POLICY.
// Попарная форма квадратична и теряет покрытие молча: каждое новое правило,
// выведенное из закона, ускользает от приоритета, пока кто-то не впишет пару.
//
// СТ. 5 П. 5 — СОГЛАСОВАНИЕ ИНОСТРАННЫХ РЕЛИГИОЗНЫХ ОБЪЕДИНЕНИЙ. Обычное
// правило: Конституция называет условие («по согласованию с соответствующими
// государственными органами»), и из него выводится допустимость.

entity Treaty {
    label ru-KZ unofficial "Международный договор" {
        genitive "Международного договора";
    }
}
entity Statute {
    label ru-KZ unofficial "Закон Республики" {
        genitive "Закона Республики";
    }
}
entity ForeignReligiousBody {
    label ru-KZ unofficial "Иностранное религиозное объединение" {
        genitive "Иностранного религиозного объединения";
    }
}

relation treaty_ratified_by_republic(treaty: Treaty) kind empirical {
    label ru-KZ unofficial "международный договор ратифицирован Республикой";
}
relation treaty_conflicts_with_statute(treaty: Treaty, statute: Statute) kind empirical {
    label ru-KZ unofficial "международный договор и закон Республики расходятся";
}
relation treaty_prevails_over_statute(treaty: Treaty, statute: Statute) kind institutional {
    label ru-KZ unofficial "международный договор имеет приоритет перед законом Республики (ред. 1995)";
}

relation foreign_religious_body_activity(body: ForeignReligiousBody) kind empirical {
    label ru-KZ unofficial "на территории Республики действует иностранное религиозное объединение";
}
relation foreign_centre_appoints_leader(body: ForeignReligiousBody) kind empirical {
    label ru-KZ unofficial "руководители религиозного объединения назначаются иностранным религиозным центром";
}
relation agreed_with_state_bodies(body: ForeignReligiousBody) kind empirical {
    label ru-KZ unofficial "деятельность согласована с соответствующими государственными органами";
}
relation foreign_religious_activity_admissible_1995(body: ForeignReligiousBody) kind institutional {
    label ru-KZ unofficial "деятельность иностранного религиозного объединения допустима (ред. 1995)";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_KK")
rule RatifiedTreatyPrevailsOverStatute1995(treaty: Treaty, statute: Statute) strict {
    when treaty_ratified_by_republic(treaty);
    when treaty_conflicts_with_statute(treaty, statute);
    then treaty_prevails_over_statute(treaty, statute);
    label ru-KZ official "Статья 4 пункт 3 (ред. 1995). Международные договоры, ратифицированные Республикой, имеют приоритет перед её законами";
}

// --- СТ. 4 П. 3 (РЕД. 1995) КАК ДЕЙСТВУЮЩИЙ ПРИОРИТЕТ, А НЕ ФАКТ О ПАРЕ АКТОВ
//
// Правило `RatifiedTreatyPrevailsOverStatute1995` выше выводит `treaty_prevails_
// over_statute` — верную половину статьи: узнав, что договор старше закона,
// движок НИЧЕГО не делал с выводами, которые из этих актов следуют. Вторая
// половина высказывается политикой §118, и ровно её рекомендовал комментарий
// этого файла: «масштабируемая цель — не попарные `priority`, а `priority
// policy` §118, где старшинство источника приходит ФАКТОМ».
//
// СТАРШИНСТВО НЕ ОБЪЯВЛЯЕТСЯ ТАБЛИЦЕЙ. Ступеней здесь нет вовсе: политика
// спрашивает УЖЕ ВЫВЕДЕННЫЙ `treaty_prevails_over_statute(t, s)` — то есть
// стоит на самой статье 4 пункт 3, с её условиями (договор ратифицирован И
// расходится с законом). Придумать рядом числовую шкалу значило бы завести
// второй носитель того же утверждения, который разойдётся с первым молча.
//
// ПРЕДМЕТ СПОРА НЕ НАЗВАН НАМЕРЕННО. Статья говорит о приоритете перед
// ЗАКОНАМИ вообще, а не о конкретном предмете; поэтому противоположные выводы
// здесь — «поведение допустимо» и «недопустимо», а какое именно поведение
// регулируется, приносит дело. Назвать предмет значило бы сузить норму.
//
// ОБА ПРАВИЛА ПОРАЖАЕМЫЕ — не по вкусу: приоритет в 0.1 объявляется ТОЛЬКО
// между поражаемыми (§192/§114), а над strict-правилом это ошибка компиляции
// LDC-E4105. Именно поэтому доктрина и стояла невыраженной: все остальные
// правила конституционного пакета строгие, и перевод ВСЕХ побеждаемых был бы
// изменением широкого радиуса. Здесь переведены только два — те, которые
// доктрина и рассудила.
//
// В РЕДАКЦИИ 2026 ГОДА ЭТОЙ ДОКТРИНЫ НЕТ. Закреплённые байты говорят это
// прямо: слово «приоритет» встречается в тексте 2026 года ровно один раз — о
// праве Президента определять приоритетность рассмотрения законопроектов
// (ст. 62 п. 2), — а статья 5 пункт 3 сохранила только вторую фразу прежней
// нормы: «Порядок действия на территории Республики Казахстан международных
// договоров определяется законами». Поэтому и правило, и политика носят
// суффикс `1995`, и ни одно дело действующей редакции их не касается.

entity RegulatedConduct {
    label ru-KZ unofficial "Поведение, о допустимости которого расходятся договор и закон";
}

// Мета-домен политики §118: пара сравниваемых применений. Объявляется
// пакетом, как в примере спецификации `spec/examples/kz/legal-acts-art12.law`
// и в `kz.corpus.legal_acts`.
entity RuleApplication {
    label ru-KZ unofficial "Применение нормы";
}

relation treaty_norm_permits(conduct: RegulatedConduct, treaty: Treaty) kind empirical {
    label ru-KZ unofficial "норма ратифицированного международного договора допускает это поведение";
}
relation statute_norm_forbids(conduct: RegulatedConduct, statute: Statute) kind empirical {
    label ru-KZ unofficial "норма закона Республики запрещает это поведение";
}
relation conduct_admissible_1995(conduct: RegulatedConduct) kind institutional {
    label ru-KZ unofficial "поведение допустимо (спор договора и закона, ред. 1995)";
}

// Какой акт читает норма — факт о САМОЙ норме: политика §118 получает пару
// применений мета-доменом, и мост от применения к акту идёт через `rule_of`
// §180. Имя правила в аргументе понижается в `const_ref` на его StableId —
// тот же идентификатор, который публикует `rule_of`.
relation rule_reads_treaty(rule_name: Text, treaty: Treaty) kind institutional {
    label ru-KZ unofficial "норма выведена из этого международного договора";
}
relation rule_reads_statute(rule_name: Text, statute: Statute) kind institutional {
    label ru-KZ unofficial "норма выведена из этого закона Республики";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_KK")
rule ConductPermittedByTreaty1995(conduct: RegulatedConduct, treaty: Treaty) defeasible {
    when treaty_norm_permits(conduct, treaty);
    when treaty_ratified_by_republic(treaty);
    then conduct_admissible_1995(conduct);
    label ru-KZ official "Статья 4 пункт 3 (ред. 1995). Вывод из нормы ратифицированного международного договора";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_KK")
rule ConductForbiddenByStatute1995(conduct: RegulatedConduct, statute: Statute) defeasible {
    when statute_norm_forbids(conduct, statute);
    then not conduct_admissible_1995(conduct);
    label ru-KZ official "Статья 4 пункт 3 (ред. 1995). Вывод из нормы закона Республики";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART4_KK")
priority policy RatifiedTreatyOverStatuteInInference1995 {
    label ru-KZ official "Статья 4 пункт 3 (ред. 1995). При противоречии выводов действует вывод из ратифицированного международного договора, а не из закона";
    for high: RuleApplication;
    for low: RuleApplication;
    when conflicts(high, low)
        and exists hr in (collect hr: Text where rule_of(high, hr))
            where exists t in (collect t: Treaty where rule_reads_treaty(hr, t))
                where exists lr in (collect lr: Text where rule_of(low, lr))
                    where exists st in (collect st: Statute where rule_reads_statute(lr, st))
                        where treaty_prevails_over_statute(t, st);
    prefer high over low;
    reason lex_superior;
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART5_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART5_KK")
rule ForeignReligiousActivityRequiresAgreement1995(body: ForeignReligiousBody) strict {
    when (foreign_religious_body_activity(body)
          or foreign_centre_appoints_leader(body))
        and agreed_with_state_bodies(body);
    then foreign_religious_activity_admissible_1995(body);
    label ru-KZ official "Статья 5 пункт 5 (ред. 1995). Деятельность иностранных религиозных объединений и назначение иностранными центрами руководителей осуществляются по согласованию с соответствующими государственными органами";
}

// -------------------------------------------------------------------------
// Достройка действующей редакции по аудиту 12.09.2026
// (`docs/audits/2026-09-12/KZ-CONSTITUTION-GRAMMAR-AUDIT.ru.md`).
//
// Ст. 2 и ст. 9 редакции 2026 стояли почти пустыми, тогда как их двойники
// 1995 (ст. 2 и ст. 7) несут по пять и по три конститутивных факта. Ниже —
// та же форма для действующей редакции: точные факты, без домысленных
// антецедентов, ровно как у ст. 1, 3, 10 и 11 выше.
//
// Сверх паритета — ДВА ЗАМЫКАНИЯ §70. Ст. 2 п. 4 и п. 6 содержат не
// декларацию, а определённое описание («Столица — город Астана») и
// исключительное право («Республике принадлежит исключительное право
// эмиссии»). Без замыкания на вопрос «является ли X столицей» модель могла
// ответить только «да» про Астану и молчала про всё остальное; урок
// `capital_city` в kz-independence ровно об этом. Домен у обоих — факт ДЕЛА
// (`checked_*`): выводимый домен даёт пустое замыкание молча.

pub relation unitary_state_presidential_form() kind institutional {
    label ru-KZ unofficial "Республика Казахстан — унитарное государство с президентской формой правления";
}
pub relation sovereignty_covers_whole_territory() kind institutional {
    label ru-KZ unofficial "суверенитет Республики распространяется на всю её территорию; государство обеспечивает целостность, неприкосновенность и неотчуждаемость территории";
}
pub relation administrative_territorial_structure_delegated() kind institutional {
    label ru-KZ unofficial "административно-территориальное устройство Республики определяется конституционным законом";
}
pub relation capital_status_delegated() kind institutional {
    label ru-KZ unofficial "статус столицы Республики определяется конституционным законом";
}
pub relation republic_names_equivalent() kind institutional {
    label ru-KZ unofficial "наименования Республика Казахстан и Казахстан равнозначны";
}
pub relation national_currency_is_tenge() kind institutional {
    label ru-KZ unofficial "национальная валюта (денежная единица) Республики Казахстан — теңге";
}
pub relation state_cares_for_language_development() kind institutional {
    label ru-KZ unofficial "государство заботится о создании условий для изучения и развития языков единого народа Казахстана";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert unitary_state_presidential_form();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert sovereignty_covers_whole_territory();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert administrative_territorial_structure_delegated();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert capital_status_delegated();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert republic_names_equivalent();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert national_currency_is_tenge();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART9_KK")
assert state_cares_for_language_development();

// --- Ст. 2 п. 4. Столица: определённое описание -----------------------------

entity City {
    label ru-KZ unofficial "Город" {
        genitive "Города";
    }
}

const Astana: City = entity_ref("urn:kz:constitution:sources#Astana") {
    label ru-KZ official "город Астана";
}

pub relation capital_city(city: City) kind institutional {
    label ru-KZ official "город является столицей Республики Казахстан";
}
relation checked_capital_claimant(city: City) kind empirical {
    label ru-KZ unofficial "город, о котором дело спрашивает, столица ли он";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert capital_city(Astana);

closure CapitalCityClosure {
    label ru-KZ official "Статья 2 пункт 4. Столица Республики Казахстан — город Астана";
    predicate capital_city;
    domain checked_capital_claimant;
    snapshot "urn:kz:snapshot:constitution-capital:2026-07-01";
    complete_as_of @2026-07-01T00:00:00Z;
    derive_explicit_negative true;
}

// --- Ст. 2 п. 6. Исключительное право эмиссии теңге -------------------------
//
// Замыкание здесь не украшение: запрет читает ОТРИЦАНИЕ носителя права
// (`not tenge_emission_right_holder`), а классическое отрицание без
// негативного продюсера не срабатывает никогда. Продюсером служит
// `derive_explicit_negative` замыкания НАД ТЕМ ЖЕ предикатом — единственная
// форма, в которой такое чтение работает.

const RepublicOfKazakhstan: ConstitutionalActor =
    entity_ref("urn:kz:constitution:sources#RepublicOfKazakhstan") {
    label ru-KZ official "Республика Казахстан";
}

pub relation tenge_emission_right_holder(actor: ConstitutionalActor) kind institutional {
    label ru-KZ official "субъекту принадлежит право эмиссии теңге";
}
relation checked_emission_claimant(actor: ConstitutionalActor) kind empirical {
    label ru-KZ unofficial "субъект, о котором дело спрашивает, вправе ли он эмитировать теңге";
}
relation tenge_emission_attempt(actor: ConstitutionalActor) kind empirical {
    label ru-KZ official "субъектом предпринята эмиссия теңге";
}
relation tenge_emission_prohibited(actor: ConstitutionalActor) kind institutional {
    label ru-KZ official "эмиссия теңге данным субъектом не допускается: право эмиссии принадлежит исключительно Республике";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
assert tenge_emission_right_holder(RepublicOfKazakhstan);

closure TengeEmissionRightClosure {
    label ru-KZ official "Статья 2 пункт 6. Республике Казахстан принадлежит исключительное право эмиссии теңге";
    predicate tenge_emission_right_holder;
    domain checked_emission_claimant;
    snapshot "urn:kz:snapshot:constitution-emission:2026-07-01";
    complete_as_of @2026-07-01T00:00:00Z;
    derive_explicit_negative true;
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_2026_ART2_KK")
rule TengeEmissionOutsideRepublicProhibited(actor: ConstitutionalActor) strict {
    when checked_emission_claimant(actor);
    when tenge_emission_attempt(actor);
    when not tenge_emission_right_holder(actor);
    then tenge_emission_prohibited(actor);
    label ru-KZ official "Статья 2 пункт 6. Эмиссия теңге субъектом, которому право эмиссии не принадлежит, не допускается";
}
