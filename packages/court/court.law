}

relation election_dispute_petition(petition: Petition) kind empirical {
    label ru-KZ official "обращение оспаривает правильность выборов";
}
relation pre_signature_law_petition(petition: Petition, act: LegalAct) kind empirical {
    label ru-KZ official "обращение внесено до подписания закона Президентом";
}
relation pre_ratification_treaty_petition(petition: Petition, treaty: Treaty) kind empirical {
    label ru-KZ official "обращение внесено до ратификации международного договора";
}
relation presidential_inauguration_suspended(petition: Petition) kind institutional {
    label ru-KZ official "вступление в должность Президента приостановлено до решения Конституционного Суда";
}
relation deputy_registration_suspended(petition: Petition) kind institutional {
    label ru-KZ official "регистрация избранного депутата приостановлена до решения Конституционного Суда";
}
relation referendum_results_suspended(petition: Petition) kind institutional {
    label ru-KZ official "итоги референдума не подводятся до решения Конституционного Суда";
}
relation signature_deadline_suspended(act: LegalAct) kind institutional {
    label ru-KZ official "течение срока подписания закона приостановлено";
}
relation ratification_deadline_suspended(treaty: Treaty) kind institutional {
    label ru-KZ official "течение срока ратификации международного договора приостановлено";
}

relation declared_unconstitutional(act: LegalAct) kind empirical {
    label ru-KZ official "акт признан неконституционным";
}
relation decision_date(act: LegalAct, date: Date) kind empirical {
    label ru-KZ official "день принятия решения Конституционным Судом";
}
relation court_specified_termination_date(act: LegalAct, date: Date) kind empirical {
    label ru-KZ official "день, с которого суд определил прекращение действия акта";
}
relation assessment_date(act: LegalAct, date: Date) kind empirical {
    label ru-KZ official "день, на который оценивается действие акта";
}
relation act_ceased_to_apply(act: LegalAct) kind institutional {
    label ru-KZ official "акт утратил силу и не подлежит применению";
}
relation declared_constitutional_in_interpretation(act: LegalAct) kind empirical {
    label ru-KZ official "акт признан конституционным в данном Судом истолковании";
}
// `pub`: вывод статьи 75 читает отраслевой пакет. Первый потребитель —
// `kz.corpus.peacefulassembly`: нормативное постановление № 61-НП признало
// подпункт 10) пункта 1 статьи 14 Закона о мирных собраниях конституционным
// В ИСТОЛКОВАНИИ, и условие применения этого подпункта живёт в отраслевом
// акте, а обязательность истолкования — здесь.
pub relation required_constitutional_interpretation_applied(act: LegalAct) kind institutional {
    label ru-KZ official "акт применяется только в истолковании, при котором он признан конституционным";
}

