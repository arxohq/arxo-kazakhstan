// Срок закреплён КАК QUANTITY: единица §84.4 обязана оставаться видимой, а
// грамматика допускает её только у литерала — из переменной Quantity не
// собрать. Величина едет с единицей, и правило истечения читает её целиком.
relation supreme_court_chair_term(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок полномочий Председателя Верховного Суда — шесть лет";
}
// Срок закреплён КАК QUANTITY: единица §84.4 обязана оставаться видимой, а
// грамматика допускает её только у литерала — из переменной Quantity не
// собрать. Величина едет с единицей, и правило истечения читает её целиком.
relation prosecutor_general_term(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок полномочий Генерального Прокурора — шесть лет";
}
relation prior_supreme_court_chair_term(person: Person) kind empirical {
    label ru-KZ official "лицо ранее занимало должность Председателя Верховного Суда";
}
relation supreme_court_chair_reappointment_attempt(person: Person) kind empirical {
    label ru-KZ official "предпринята попытка повторного назначения Председателем Верховного Суда";
}
relation supreme_court_chair_reappointment_prohibited(person: Person) kind institutional {
    label ru-KZ official "повторное назначение Председателем Верховного Суда не допускается";
}
relation prior_prosecutor_general_term(person: Person) kind empirical {
    label ru-KZ official "лицо ранее занимало должность Генерального Прокурора";
}
relation prosecutor_general_reappointment_attempt(person: Person) kind empirical {
    label ru-KZ official "предпринята попытка повторного назначения Генеральным Прокурором";
}
relation prosecutor_general_reappointment_prohibited(person: Person) kind institutional {
    label ru-KZ official "повторное назначение Генеральным Прокурором не допускается";
}

// Срок закреплён КАК QUANTITY: единица §84.4 обязана оставаться видимой, а
// грамматика допускает её только у литерала — из переменной Quantity не
// собрать. Величина едет с единицей, и правило истечения читает её целиком.
relation maslikhat_term(length: Quantity) kind institutional {
    key(length);
    label ru-KZ official "срок полномочий маслихата — пять лет";
}
relation maslikhat_deputy_minimum_age(value: Integer) kind institutional {
