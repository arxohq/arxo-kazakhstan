    key(value);
    label ru-KZ official "знаменатель порога выражения вотума недоверия акиму — одна вторая";
}
relation maslikhat_candidate(candidate: Candidate, person: Person) kind empirical {
    label ru-KZ official "кандидат в депутаты маслихата является данным лицом";
}
