    label ru-KZ official "знаменатель порога согласия маслихата на назначение акима — одна вторая";
}
relation akim_no_confidence_initiative_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога инициативы о вотуме недоверия акиму — одна пятая";
}
relation akim_no_confidence_initiative_denominator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога инициативы о вотуме недоверия акиму — одна пятая";
}
relation akim_no_confidence_numerator(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога выражения вотума недоверия акиму — одна вторая";
}
