}
relation akim_candidate_consented(candidate: Candidate) kind institutional {
    label ru-KZ official "маслихат дал согласие на назначение кандидата акимом";
}
relation akim_no_confidence_initiating_votes(akim: Akim, votes: Integer) kind empirical {
    label ru-KZ official "число депутатов маслихата, инициировавших вотум недоверия акиму";
}
relation akim_no_confidence_votes(akim: Akim, votes: Integer) kind empirical {
    label ru-KZ official "число голосов, поданных за вотум недоверия акиму";
}
relation total_maslikhat_deputies(akim: Akim, total: Integer) kind empirical {
    label ru-KZ official "общее число депутатов маслихата";
}
relation akim_no_confidence(akim: Akim) kind institutional {
    label ru-KZ official "маслихат выразил вотум недоверия акиму";
}

relation local_revenue_reducing_or_spending_increasing(local_act: LocalDecision) kind empirical {
    label ru-KZ official "решение предусматривает сокращение местных доходов либо увеличение расходов";
}
relation positive_akim_opinion(local_act: LocalDecision) kind empirical {
    label ru-KZ official "по решению имеется положительное заключение акима";
}
relation local_decision_admissible(local_act: LocalDecision) kind institutional {
    label ru-KZ official "решение маслихата обязательно на соответствующей территории";
}
relation local_self_government_action(local_act: LocalDecision) kind empirical {
    label ru-KZ official "акт принят органом местного самоуправления";
}
relation within_statutory_local_power(local_act: LocalDecision) kind empirical {
    label ru-KZ official "решение принято в пределах компетенции, установленной законом";
}
relation local_self_government_autonomy(local_act: LocalDecision) kind institutional {
