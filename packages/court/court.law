// Ст. 77, 85, 86: судебная власть, Уполномоченный и адвокатура.
relation legal_application_case(legal_case: Case) kind empirical {
    label ru-KZ official "по делу применяется закон";
}
relation within_judicial_power(legal_case: Case) kind institutional {
    label ru-KZ official "дело относится к судебной власти";
}
relation judicial_decision(act: LegalAct, court: Court) kind empirical {
    label ru-KZ official "акт является решением данного суда";
}
relation judicial_decision_binding_nationwide(act: LegalAct) kind institutional {
    label ru-KZ official "решение суда обязательно на всей территории Республики";
}

relation ombudsman(ombudsman: Ombudsman) kind empirical {
    label ru-KZ official "лицо является Уполномоченным по правам человека";
}
relation ombudsman_appointment_attempt(ombudsman: Ombudsman) kind empirical {
    label ru-KZ official "производится назначение Уполномоченного по правам человека";
}
relation presidential_appointment_of_ombudsman(ombudsman: Ombudsman) kind empirical {
