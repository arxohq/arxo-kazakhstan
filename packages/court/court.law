    label ru-KZ official "субъект осуществляет правосудие";
}
relation court(court: Court) kind empirical {
    label ru-KZ official "орган является судом";
}
relation court_handles(court: Court, legal_case: Case) kind empirical {
    label ru-KZ official "дело рассматривается данным судом";
}
relation justice_lawful(legal_case: Case) kind institutional {
    label ru-KZ official "правосудие осуществлено правомерно";
}
relation special_or_emergency_court(court: Court) kind empirical {
