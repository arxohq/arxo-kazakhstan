}
relation petition_by_one_fifth_of_deputies(petition: Petition) kind empirical {
    label ru-KZ official "обращение внесено не менее чем одной пятой депутатов Курултая";
}
relation petition_by_citizen_affecting_constitutional_rights(petition: Petition) kind empirical {
    label ru-KZ official "обращение внесено гражданином по вопросу его конституционных прав и свобод";
}
relation petition_by_prosecutor_general(petition: Petition) kind empirical {
