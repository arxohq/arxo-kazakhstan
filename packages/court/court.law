}
relation petition_by_ombudsman_affecting_rights(petition: Petition) kind empirical {
    label ru-KZ official "обращение внесено Уполномоченным по правам человека по вопросу прав и свобод";
}
relation petition_by_court_under_article_79(petition: Petition) kind empirical {
    label ru-KZ official "обращение внесено судом в порядке статьи 79 Конституции";
}
relation petition_admissible(petition: Petition) kind institutional {
