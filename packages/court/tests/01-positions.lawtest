test "urn:query:kzcc-6" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c6-1": judge(entity_ref("urn:kz:constitution:court:test:judge5")) { origin case_input; }
        assert "c6-2": judge_detention_attempt(entity_ref("urn:kz:constitution:court:test:judge5")) { origin case_input; }
        assert "c6-3": required_judge_detention_consent(entity_ref("urn:kz:constitution:court:test:judge5")) { origin case_input; }
    }
    evaluate positions();
