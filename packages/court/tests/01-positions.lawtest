language "law.core" version "0.2";
package kz.constitution.court version "0.1.0";
namespace "urn:kz:constitution:court";

// ПОЗИЦИИ §§122–137 ПАКЕТА «КОНСТИТУЦИОННЫЙ СУД, СУДЫ И МЕСТНОЕ УПРАВЛЕНИЕ».
//
// В пакете девять норм-шаблонов: шесть иммунитетов §128, два полномочия §127
// и один запрет §130 (десахарен в duty с goal.kind = forbearance). Набор
// наблюдает каждый.
//
// ПРОЕКЦИЯ РЕДАКЦИЙ (13.09.2026). Мир сценария склеен с пакетом источников
// `kz.constitution.sources` (`concat` в law.toml). Якоря редакций теперь
// разрешаются, и условие 3 §92 (E-0095) исключает узлы неприменимой редакции
// с info EDITION_NOT_APPLICABLE. Следствие, перевернувшее четыре ожидания:
// на дате дела @2026-09-01 иммунитеты редакции 1995 ОТСУТСТВУЮТ. Прежнее
// «иммунитет 1995 ACTIVE на дате 2026» было артефактом мира без редакций.
// Живая сторона всех четырёх наблюдается делом kzcc-22 на @2020-01-01.
//
// ЧЕТЫРЕ ИММУНИТЕТА РЕДАКЦИИ 1995 ГОДА (`*1995`) стоят на КЛАССИЧЕСКОМ
// отрицании (`when not parliament_consent_for_judge(judge)` и т. п.). У этих
// предикатов в пакете нет негативного продюсера, поэтому отсутствие факта
// согласия позицию НЕ создаёт: дело обязано ОТРИЦАТЬ согласие явно
// (`assert not …`). Это измерено здесь, а не предположено, и объясняет,
// почему сценарий каждого из них подаёт отрицательные факты поимённо.
//
// ЗАЩИЩЁННЫЙ ЭФФЕКТ ЧЕТЫРЁХ ИММУНИТЕТОВ 1995 ГОДА (`*_immunity_infringed_1995`)
// не производится в пакете ничем: ни power §127, ни правилом. Внутри пакета
// они НЕАТАКУЕМЫ, и наблюдаемое у них — только существование позиции.
// Поэтому issue EFFECT_BLOCKED_BY_IMMUNITY не ожидается ни в одном деле
// этого набора.

// --- ст. 76 п. 1: запрет внесудебного правосудия (§130) -----------------

// Запрет активен, пока открыто окно нормы.
test "urn:query:kzcc-1" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c1-1": justice_act(entity_ref("urn:kz:constitution:court:test:actor1"), entity_ref("urn:kz:constitution:court:test:case1")) { origin case_input; }
        assert "c1-2": non_court_justice_attempt(entity_ref("urn:kz:constitution:court:test:case1")) { origin case_input; }
    }
    evaluate positions();
    expect issues_within(info);
    expect position(RefrainFromNonCourtJustice, ACTIVE);
    // СТОРОЖ ГРАНИЦЫ §130: акт «правосудия» вне суда уже совершён, и запрет
    // всё равно остаётся ACTIVE — forbearance-цель в Core 0.1 не получает
    // VIOLATED. Тест обязан упасть, если однажды придёт VIOLATED.
    expect not position(RefrainFromNonCourtJustice, VIOLATED);
}

// Дело разбирает суд: внесудебной попытки нет, запрет не создаётся.
test "urn:query:kzcc-2" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c2-1": justice_act(entity_ref("urn:kz:constitution:court:test:judge1"), entity_ref("urn:kz:constitution:court:test:case2")) { origin case_input; }
        assert "c2-2": court(entity_ref("urn:kz:constitution:court:test:court1")) { origin case_input; }
        assert "c2-3": court_handles(entity_ref("urn:kz:constitution:court:test:court1"), entity_ref("urn:kz:constitution:court:test:case2")) { origin case_input; }
    }
    evaluate positions();
    expect not position(RefrainFromNonCourtJustice, ACTIVE);

    evaluate truth(justice_lawful(entity_ref("urn:kz:constitution:court:test:case2")));
    expect truth_status == TRUE_ONLY;
}

// --- ст. 80 п. 2: неприкосновенность судьи (§128) ------------------------

// Оснований нет — защита действует, задержания нет.
test "urn:query:kzcc-3" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c3-1": judge(entity_ref("urn:kz:constitution:court:test:judge2")) { origin case_input; }
        assert "c3-2": judge_detention_attempt(entity_ref("urn:kz:constitution:court:test:judge2")) { origin case_input; }
    }
    evaluate positions();
    expect position(JudgePersonalImmunity, ACTIVE);

    evaluate truth(judge_detained(entity_ref("urn:kz:constitution:court:test:judge2")));
    expect truth_status == NEITHER;
}

