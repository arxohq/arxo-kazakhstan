        assert "c4-1": judge(entity_ref("urn:kz:constitution:court:test:judge3")) { origin case_input; }
        assert "c4-2": judge_detention_attempt(entity_ref("urn:kz:constitution:court:test:judge3")) { origin case_input; }
        assert "c4-3": judge_caught_at_crime_scene(entity_ref("urn:kz:constitution:court:test:judge3")) { origin case_input; }
    }
    evaluate positions();
    expect not position(JudgePersonalImmunity, ACTIVE);

    evaluate truth(judge_detained(entity_ref("urn:kz:constitution:court:test:judge3")));
    expect truth_status == TRUE_ONLY;
}

