        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c21-1": ombudsman_arrest_attempt(entity_ref("urn:kz:constitution:court:test:ombudsman5")) { origin case_input; }
        assert "c21-2": not senate_consent_for_ombudsman(entity_ref("urn:kz:constitution:court:test:ombudsman5")) { origin case_input; }
        assert "c21-3": ombudsman_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:ombudsman5")) { origin case_input; }
    }
    evaluate positions();
    expect not position(OmbudsmanInviolability1995, ACTIVE);
}

// --- Живая сторона четырёх близнецов 1995 года ---------------------------
//
// ЗАЧЕМ ЭТО ДЕЛО. С 13.09.2026 мир сценария склеен с пакетом источников, и
// четыре иммунитета редакции 1995 на дате 2026 исчезли (kzcc-13, kzcc-16,
// kzcc-18, kzcc-20). Само по себе исчезновение не доказывает, что нормы
// работают: их точно так же не было бы, будь они мертвы. Дело ниже ведётся
// на @2020-01-01 — внутри окна in_force [@1995-09-05, @2026-07-01) — и
// показывает все четыре позиции сразу.
//
// ЗДЕСЬ ЖЕ СОХРАНЕНО ИЗМЕРЕНИЕ КЛАССИЧЕСКОГО ОТРИЦАНИЯ: у предикатов
// согласия в пакете нет негативного продюсера, поэтому дело обязано ОТРИЦАТЬ
// согласие поимённо. Молчание факта позицию не создаёт.
test "urn:query:kzcc-22" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "c22-1": constitutional_judge(entity_ref("urn:kz:constitution:court:test:cjudge4")) { origin case_input; }
        assert "c22-2": constitutional_judge_arrest_attempt(entity_ref("urn:kz:constitution:court:test:cjudge4")) { origin case_input; }
        assert "c22-3": not parliament_consent_for_judge(entity_ref("urn:kz:constitution:court:test:cjudge4")) { origin case_input; }
        assert "c22-4": not judge_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:cjudge4")) { origin case_input; }
        assert "c22-5": judge_arrest_attempt(entity_ref("urn:kz:constitution:court:test:judge8")) { origin case_input; }
        assert "c22-6": not presidential_consent_on_council_conclusion(entity_ref("urn:kz:constitution:court:test:judge8")) { origin case_input; }
        assert "c22-7": not senate_consent_for_judge(entity_ref("urn:kz:constitution:court:test:judge8")) { origin case_input; }
        assert "c22-8": not ordinary_judge_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:judge8")) { origin case_input; }
        assert "c22-9": prosecutor_general_arrest_attempt(entity_ref("urn:kz:constitution:court:test:prosecutor3")) { origin case_input; }
        assert "c22-10": not senate_consent_for_prosecutor(entity_ref("urn:kz:constitution:court:test:prosecutor3")) { origin case_input; }
        assert "c22-11": not prosecutor_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:prosecutor3")) { origin case_input; }
        assert "c22-12": ombudsman_arrest_attempt(entity_ref("urn:kz:constitution:court:test:ombudsman6")) { origin case_input; }
        assert "c22-13": not senate_consent_for_ombudsman(entity_ref("urn:kz:constitution:court:test:ombudsman6")) { origin case_input; }
        assert "c22-14": not ombudsman_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:ombudsman6")) { origin case_input; }
    }
    evaluate positions();
    expect position(ConstitutionalJudgeInviolability1995, ACTIVE);
    expect position(JudicialInviolability1995, ACTIVE);
    expect position(ProsecutorGeneralInviolability1995, ACTIVE);
    expect position(OmbudsmanInviolability1995, ACTIVE);
}
