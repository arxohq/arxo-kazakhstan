// --- ст. 80 п. 3: делегирование требований к судьям (§127) ---------------

// Полномочие создано конституционным законом; осуществления (принятия закона)
// нет — позиция ACTIVE, эффекта нет.
test "urn:query:kzcc-10" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c10-1": constitutional_law(entity_ref("urn:kz:constitution:court:test:act1")) { origin case_input; }
    }
    evaluate positions();
    expect position(DetermineJudgeRequirements, ACTIVE);
    expect position(EstablishJudicialCollegia, ACTIVE);

    evaluate truth(judge_requirements_determined(entity_ref("urn:kz:constitution:court:test:act1")));
    expect truth_status == NEITHER;
}

// Закон принят: осуществление состоялось, `valid_when` выполнено, оба эффекта
// наступают.
//
// ГРАНИЦА, ИЗМЕРЕННАЯ ЗДЕСЬ: `valid_when` обоих полномочий читает тот же
// предикат `constitutional_law(act)`, что и посылка правила. Пара
// «действительное / недействительное осуществление» для них поэтому
// НЕВЫРАЗИМА: где полномочие есть, там условие действительности выполнено
// всегда. Наблюдаемая пара — наличие и отсутствие осуществления.
test "urn:query:kzcc-11" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c11-1": constitutional_law(entity_ref("urn:kz:constitution:court:test:act2")) { origin case_input; }
        assert "c11-2": constitutional_law_adopted(entity_ref("urn:kz:constitution:court:test:act2")) { origin case_input; }
    }
    evaluate positions();
    expect position(DetermineJudgeRequirements, ACTIVE);

    evaluate truth(judge_requirements_determined(entity_ref("urn:kz:constitution:court:test:act2")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(judicial_collegia_established(entity_ref("urn:kz:constitution:court:test:act2")));
    expect truth_status == TRUE_ONLY;
}

// Акт не является конституционным законом: полномочия нет вовсе, и принятие
// акта эффекта не создаёт.
test "urn:query:kzcc-12" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c12-1": constitutional_law_adopted(entity_ref("urn:kz:constitution:court:test:act3")) { origin case_input; }
    }
    evaluate positions();
    expect not position(DetermineJudgeRequirements, ACTIVE);
    expect not position(EstablishJudicialCollegia, ACTIVE);

    evaluate truth(judicial_collegia_established(entity_ref("urn:kz:constitution:court:test:act3")));
    expect truth_status == NEITHER;
}

// --- ст. 71 п. 5 (ред. 1995): неприкосновенность судьи КС ----------------

test "urn:query:kzcc-13" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c13-1": constitutional_judge(entity_ref("urn:kz:constitution:court:test:cjudge1")) { origin case_input; }
        assert "c13-2": constitutional_judge_arrest_attempt(entity_ref("urn:kz:constitution:court:test:cjudge1")) { origin case_input; }
        assert "c13-3": not parliament_consent_for_judge(entity_ref("urn:kz:constitution:court:test:cjudge1")) { origin case_input; }
        assert "c13-4": not judge_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:cjudge1")) { origin case_input; }
    }
    evaluate positions();
    // ПЕРЕВЁРНУТО 13.09.2026 вместе с включением пакета источников в мир
    // сценария: на legal_time @2026-09-01 редакция 1995 не применима, узел
    // исключён условием 3 §92, и позиции нет. Прежнее ожидание «иммунитет
    // 1995 ACTIVE на дате 2026» было следствием мира БЕЗ редакций, а не
    // прочтения нормы. Живая сторона нормы наблюдается делом kzcc-22.
    expect not position(ConstitutionalJudgeInviolability1995, ACTIVE);
    expect issue(EDITION_NOT_APPLICABLE);
}

// Согласие Парламента дано: позиции нет.
test "urn:query:kzcc-14" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c14-1": constitutional_judge(entity_ref("urn:kz:constitution:court:test:cjudge2")) { origin case_input; }
        assert "c14-2": constitutional_judge_arrest_attempt(entity_ref("urn:kz:constitution:court:test:cjudge2")) { origin case_input; }
        assert "c14-3": parliament_consent_for_judge(entity_ref("urn:kz:constitution:court:test:cjudge2")) { origin case_input; }
        assert "c14-4": not judge_caught_in_act_or_grave_crime(entity_ref("urn:kz:constitution:court:test:cjudge2")) { origin case_input; }
    }
    evaluate positions();
    expect not position(ConstitutionalJudgeInviolability1995, ACTIVE);
}

// ИЗМЕРЕНИЕ ГРАНИЦЫ КЛАССИЧЕСКОГО ОТРИЦАНИЯ: согласие не отрицается, а просто
// не подано. Позиции нет — молчание факта не есть его отрицание.
test "urn:query:kzcc-15" {
    given {
        context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
        assert "c15-1": constitutional_judge(entity_ref("urn:kz:constitution:court:test:cjudge3")) { origin case_input; }
        assert "c15-2": constitutional_judge_arrest_attempt(entity_ref("urn:kz:constitution:court:test:cjudge3")) { origin case_input; }
    }
    evaluate positions();
    expect not position(ConstitutionalJudgeInviolability1995, ACTIVE);
}

