language "law.core" version "0.2";
package kz.constitution.sources version "0.1.0";
namespace "urn:kz:constitution:sources";
// Fictional act; inputs match the retained Article 4 publication rule.
test "official-publication-required" {
 given {
  context { decision_time @2026-09-01T12:00:00+05:00; knowledge_time @2026-09-01T12:00:00+05:00; legal_time @2026-09-01; timezone "Asia/Almaty"; }
  assert "pub-1": legal_act_affects_citizen_rights_or_duties(entity_ref("urn:demo:kz:act")) { origin case_input; }
  assert "pub-2": legal_act_officially_published(entity_ref("urn:demo:kz:act")) { origin case_input; }
 }
 evaluate truth(legal_act_application_condition_satisfied(entity_ref("urn:demo:kz:act")));
 expect truth_status == TRUE_ONLY;
}
