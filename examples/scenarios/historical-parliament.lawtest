// Reader copy of the retained historical suite with an explicit disputed reading for the full assembly.
language "law.core" version "0.2";
package kz.constitution1995.parliament version "0.1.0";
namespace "urn:kz:constitution1995:parliament";

// ПОЗИЦИИ §§122–137 РАЗДЕЛА IV «ПАРЛАМЕНТ» РЕДАКЦИИ 1995 ГОДА (13.09.2026).
//
// В пакете 11 норм-шаблонов: семь полномочий §127 и четыре иммунитета §128.
// Набор наблюдает каждый.
//
// У КАЖДОГО ПОЛНОМОЧИЯ УСЛОВИЕ ДЕЙСТВИТЕЛЬНОСТИ — ОТДЕЛЬНЫЙ ФАКТ ДЕЛА:
// консультации перед роспуском, согласие Палаты на привлечение депутата,
// представление Президента по должности, предложение Президента об
// использовании Вооружённых Сил и о внесении изменений в Конституцию,
// управомоченная инициатива одной пятой депутатов. Вакуумный `valid_when`,
// повторяющий посылку, в пакете не заведён ни разу: у такого полномочия пара
// «действительно / недействительно» невыразима.
//
// ЧТО ЗДЕСЬ ПОЯВИЛОСЬ ВПЕРВЫЕ. До этого изменения `DeputyInviolability1995`
// был в пакете НЕАТАКУЕМ: защищённый эффект `deputy_immunity_infringed_1995`
// не производился ничем, и issue EFFECT_BLOCKED_BY_IMMUNITY не появлялся ни в
// одном деле. Полномочие ст. 52 п. 4 даёт иммунитету противника, и обе
// стороны нормы стали наблюдаемы.
//
// ПРОЕКЦИЯ РЕДАКЦИЙ. Мир склеен с `kz.constitution.sources` (`concat` в
// law.toml): редакция KZ_CONSTITUTION_1995 объявлена там как in_force
// [@1995-09-05, @2026-07-01). Дела ведутся на @2020-01-01; последнее дело
// проверяет обратное — на @2026-09-01 узлы редакции 1995 исключены условием
// 3 §92 и ни одной позиции нет.

// ─────────────────────────────────────────────────────────────────────────
// Ст. 63. Роспуск Парламента: полномочие и три барьера.
// ─────────────────────────────────────────────────────────────────────────

// Консультации проведены, защищённого периода нет: роспуск состоялся.
test "urn:query:kzq95-1" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b1-1": president_1995(entity_ref("urn:kz:constitution1995:parliament:test:president1")) { origin case_input; }
        assert "b1-2": parliament(entity_ref("urn:kz:constitution1995:parliament:test:parliament1")) { origin case_input; }
        assert "b1-3": dissolution_of(entity_ref("urn:kz:constitution1995:parliament:test:dissolution1"), entity_ref("urn:kz:constitution1995:parliament:test:parliament1")) { origin case_input; }
        assert "b1-4": dissolution_consultations_completed(entity_ref("urn:kz:constitution1995:parliament:test:dissolution1")) { origin case_input; }
        assert "b1-5": dissolution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:dissolution1")) { origin case_input; }
    }
    evaluate positions();
    expect issues_within(info);
    expect position(DissolveParliament1995, ACTIVE);
    expect not position(NoDissolutionInEmergency1995, ACTIVE);
    expect not position(NoDissolutionInLastSixMonths1995, ACTIVE);
    expect not position(NoDissolutionWithinYearAfterPrior1995, ACTIVE);

    evaluate truth(parliament_dissolved_1995(entity_ref("urn:kz:constitution1995:parliament:test:parliament1")));
    expect truth_status == TRUE_ONLY;
}

// Консультаций не было: полномочие остаётся, осуществление недействительно.
test "urn:query:kzq95-2" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b2-1": president_1995(entity_ref("urn:kz:constitution1995:parliament:test:president1")) { origin case_input; }
        assert "b2-2": parliament(entity_ref("urn:kz:constitution1995:parliament:test:parliament2")) { origin case_input; }
        assert "b2-3": dissolution_of(entity_ref("urn:kz:constitution1995:parliament:test:dissolution2"), entity_ref("urn:kz:constitution1995:parliament:test:parliament2")) { origin case_input; }
        assert "b2-4": dissolution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:dissolution2")) { origin case_input; }
    }
    evaluate positions();
    expect position(DissolveParliament1995, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(parliament_dissolved_1995(entity_ref("urn:kz:constitution1995:parliament:test:parliament2")));
    expect truth_status == NEITHER;
}

// Основание первое — чрезвычайное либо военное положение. Консультации
// проведены, и роспуск всё равно заблокирован.
test "urn:query:kzq95-3" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b3-1": president_1995(entity_ref("urn:kz:constitution1995:parliament:test:president1")) { origin case_input; }
        assert "b3-2": parliament(entity_ref("urn:kz:constitution1995:parliament:test:parliament3")) { origin case_input; }
        assert "b3-3": dissolution_of(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3"), entity_ref("urn:kz:constitution1995:parliament:test:parliament3")) { origin case_input; }
        assert "b3-4": dissolution_consultations_completed(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3")) { origin case_input; }
        assert "b3-5": emergency_or_martial_law_active() { origin case_input; }
        assert "b3-6": dissolution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3")) { origin case_input; }
    }
    evaluate positions();
    expect position(NoDissolutionInEmergency1995, ACTIVE);
    expect issue(EFFECT_BLOCKED_BY_IMMUNITY);

    evaluate truth(parliament_dissolved_1995(entity_ref("urn:kz:constitution1995:parliament:test:parliament3")));
    expect truth_status == NEITHER;
}

