// ─────────────────────────────────────────────────────────────────────────
// Ст. 52 п. 4. Неприкосновенность депутата и полномочие, ей противостоящее.
// ─────────────────────────────────────────────────────────────────────────

// Согласия Палаты нет, исключений нет: защита держит, эффекта нет.
//
// ГРАНИЦА, ИЗМЕРЕННАЯ ЗДЕСЬ. Ожидать EFFECT_BLOCKED_BY_IMMUNITY в этом деле
// НЕЛЬЗЯ, и это свойство нормы ст. 52 п. 4, а не пробел набора: посылки
// иммунитета в точности отрицают условие действительности полномочия, так
// что действительное осуществление и защита не сосуществуют. Эффект здесь не
// блокируется — он не доходит до материализации, потому что осуществление
// недействительно. Блокировка §128 наблюдается у трёх барьеров ст. 63
// (дела kzq95-3, kzq95-4, kzq95-5), где полномочие осуществлено ДЕЙСТВИТЕЛЬНО.
test "urn:query:kzq95-6" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b6-1": deputy(entity_ref("urn:kz:constitution1995:parliament:test:deputy1")) { origin case_input; }
        assert "b6-2": state_authority(entity_ref("urn:kz:constitution1995:parliament:test:authority1")) { origin case_input; }
        assert "b6-3": arrest_or_prosecution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:deputy1")) { origin case_input; }
        assert "b6-4": not chamber_consent_given(entity_ref("urn:kz:constitution1995:parliament:test:deputy1")) { origin case_input; }
        assert "b6-5": not caught_in_the_act_or_grave_crime(entity_ref("urn:kz:constitution1995:parliament:test:deputy1")) { origin case_input; }
        assert "b6-6": deputy_prosecution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:authority1"), entity_ref("urn:kz:constitution1995:parliament:test:deputy1")) { origin case_input; }
    }
    evaluate positions();
    expect position(DeputyInviolability1995, ACTIVE);
    expect position(ProsecuteDeputy1995, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(deputy_immunity_infringed_1995(entity_ref("urn:kz:constitution1995:parliament:test:deputy1")));
    expect truth_status == NEITHER;
}

// Палата дала согласие: иммунитета нет, осуществление действительно.
test "urn:query:kzq95-7" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b7-1": deputy(entity_ref("urn:kz:constitution1995:parliament:test:deputy2")) { origin case_input; }
        assert "b7-2": state_authority(entity_ref("urn:kz:constitution1995:parliament:test:authority1")) { origin case_input; }
        assert "b7-3": arrest_or_prosecution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:deputy2")) { origin case_input; }
        assert "b7-4": chamber_consent_given(entity_ref("urn:kz:constitution1995:parliament:test:deputy2")) { origin case_input; }
        assert "b7-5": not caught_in_the_act_or_grave_crime(entity_ref("urn:kz:constitution1995:parliament:test:deputy2")) { origin case_input; }
        assert "b7-6": deputy_prosecution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:authority1"), entity_ref("urn:kz:constitution1995:parliament:test:deputy2")) { origin case_input; }
    }
    evaluate positions();
    expect not position(DeputyInviolability1995, ACTIVE);
    expect position(ProsecuteDeputy1995, ACTIVE);

    evaluate truth(deputy_immunity_infringed_1995(entity_ref("urn:kz:constitution1995:parliament:test:deputy2")));
    expect truth_status == TRUE_ONLY;
}

