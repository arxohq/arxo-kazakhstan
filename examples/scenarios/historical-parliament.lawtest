    expect truth_status == NEITHER;
}

// ─────────────────────────────────────────────────────────────────────────
// Проекция редакций §92: те же факты на дате действия редакции 2026.
// ─────────────────────────────────────────────────────────────────────────

// Дело kzq95-3 слово в слово, но legal_time @2026-09-01: узлы редакции 1995
// исключены условием 3 §92, ни полномочия, ни барьера нет.
test "urn:query:kzq95-18" {
    given {
        context { decision_time @2026-09-01T12:00:00+06:00; knowledge_time @2026-09-01T12:00:00+06:00; legal_time @2026-09-01; timezone "Asia/Almaty"; interpretation ListItselfEntrenchedReading; }
        assert "b18-1": president_1995(entity_ref("urn:kz:constitution1995:parliament:test:president1")) { origin case_input; }
        assert "b18-2": parliament(entity_ref("urn:kz:constitution1995:parliament:test:parliament3")) { origin case_input; }
        assert "b18-3": dissolution_of(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3"), entity_ref("urn:kz:constitution1995:parliament:test:parliament3")) { origin case_input; }
        assert "b18-4": dissolution_consultations_completed(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3")) { origin case_input; }
        assert "b18-5": emergency_or_martial_law_active() { origin case_input; }
        assert "b18-6": dissolution_attempt(entity_ref("urn:kz:constitution1995:parliament:test:dissolution3")) { origin case_input; }
    }
    evaluate positions();
    expect not position(DissolveParliament1995, ACTIVE);
    expect not position(NoDissolutionInEmergency1995, ACTIVE);

    evaluate truth(parliament_dissolved_1995(entity_ref("urn:kz:constitution1995:parliament:test:parliament3")));
    expect truth_status == NEITHER;
}

// То же для неприкосновенности депутата: дело kzq95-6 на дате 2026.
test "urn:query:kzq95-19" {
    given {
