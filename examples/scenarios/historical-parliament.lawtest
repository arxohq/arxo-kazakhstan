        assert "b16-1": mazhilis(entity_ref("urn:kz:constitution1995:parliament:test:mazhilis1")) { origin case_input; }
        assert "b16-2": no_confidence_motion(entity_ref("urn:kz:constitution1995:parliament:test:motion1"), entity_ref("urn:kz:constitution1995:parliament:test:government1")) { origin case_input; }
        assert "b16-3": motion_initiating_deputies(entity_ref("urn:kz:constitution1995:parliament:test:motion1"), 25) { origin case_input; }
        assert "b16-4": motion_mazhilis_total(entity_ref("urn:kz:constitution1995:parliament:test:motion1"), 98) { origin case_input; }
        assert "b16-5": no_confidence_vote_attempt(entity_ref("urn:kz:constitution1995:parliament:test:mazhilis1"), entity_ref("urn:kz:constitution1995:parliament:test:motion1")) { origin case_input; }
    }
    evaluate positions();
