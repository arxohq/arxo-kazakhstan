        assert "b17-4": motion_mazhilis_total(entity_ref("urn:kz:constitution1995:parliament:test:motion2"), 98) { origin case_input; }
        assert "b17-5": no_confidence_vote_attempt(entity_ref("urn:kz:constitution1995:parliament:test:mazhilis1"), entity_ref("urn:kz:constitution1995:parliament:test:motion2")) { origin case_input; }
