// Канал суждения §47.3 (DECISION-0194, выбор сделан при касании пакета
// 12.09.2026). Обоснованность обвинения Конституция не вычисляет и не отдаёт
// автору дела: она НАЗЫВАЕТ ОРГАН — «при наличии заключения Верховного Суда
// об обоснованности обвинения». Плоским эмпирическим фактом это означало бы,
// что содержание оценки целиком пришло из дела, а доказательство лишь
// повторило сказанное ему (строка линта `evaluative-fact-without-producer`).
// Читатель `ImpeachmentFinalStage` строгий, поэтому канал доходит до ответа:
// без заключения — REQUIRES_JUDGMENT, с ответом (`origin adjudicated`) —
// обычный вывод.
external judgment relation supreme_court_charge_supported(impeachment: Impeachment) {
    authority SupremeCourt;
    label ru-KZ official "Верховный Суд дал заключение об обоснованности обвинения";
}
relation senate_final_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число голосов Сената при окончательном решении";
}
relation mazhilis_final_votes(impeachment: Impeachment, votes: Integer) kind empirical {
    label ru-KZ official "число голосов Мажилиса при окончательном решении";
}
