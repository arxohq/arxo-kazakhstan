@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART40_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART40_KK")
assert president_ensures_concerted_branch_functioning_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART44_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART44_KK")
assert president_addresses_annual_message_1995();

