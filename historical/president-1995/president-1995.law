// Конституция РК 1995, раздел III (ст. 40–48): Президент.
//
// ОТДЕЛЬНЫЙ ПАКЕТ, А НЕ СЛОЙ В kz.constitution.president (DECISION-0026,
// вариант «в»). Основание — институт другой, а не текст:
//   - преемство 1995 идёт по цепочке Председатель Сената → Председатель
//     Мажилиса → Премьер-Министр; в 2026 полномочия принимает
//     Вице-Президент, которого в 1995 нет вовсе;
//   - отрешение 1995 распределено между двумя Палатами (Мажилис выдвигает,
//     Сенат расследует, совместное заседание решает); в 2026 весь процесс
//     идёт в однопалатном Курултае.
// Держать это одними предикатами значило бы утверждать тождество органов,
// которого нет. Цена решения названа прямо: `impact-editions` берёт ОДИН
// ir.json и две даты, поэтому по разделу III diff исходов между редакциями
// из коробки не считается — сравнение идёт через audit-world
// kz-constitution-linked и отдельные сценарии.
//
// Числа сверены с закреплённым текстом ст. 41, 42, 47 (см.
// corpus/laws/sources/constitution/constitution-1995-ru.txt); ни одно не
// взято из редакции 2026 и ни одно не восстановлено по памяти.
//
// РАСХОЖДЕНИЯ С РЕДАКЦИЕЙ 2026, найденные чтением:
//   1) у кандидата 1995 НЕТ ценза стажа государственной службы; 2026 ст. 43
//      добавил пять лет — кандидат без стажа избираем до 01.07.2026 и
//      неизбираем после;
//   2) присяга преемника в 1995 приносится в течение ОДНОГО МЕСЯЦА; в 2026
//      срок сжат до семи дней;
//   3) ст. 41 п. 5 — конституционный порог избрания (более пятидесяти
//      процентов) и повторное голосование записаны в самой Конституции 1995;
//   4) ст. 47 п. 2 — отклонение обвинения в государственной измене влечёт
//      досрочное прекращение полномочий депутатов-инициаторов: санкция за
//      неудавшийся импичмент, которой в 2026 нет;
//   5) ст. 48 п. 2 — преемник не вправе инициировать изменения Конституции.
//
// ОБЪЯВЛЕННАЯ ГРАНИЦА (DECISION-0012). Ст. 40 (статус главы государства) и
// перечень полномочий ст. 44 в части, не имеющей конституционного условия
// («награждает», «ведёт переговоры», «формирует Администрацию»), записаны
// фактами: у них нет антецедента, и придуманный антецедент был бы авторской
// нормой. Полномочия с названным Конституцией условием — согласие Палаты,
// консультации, срок — выражены правилами.

language "law.core" version "0.2";
package kz.constitution1995.president version "0.1.0";
namespace "urn:kz:constitution1995:president";

entity Person {
    label ru-KZ official "физическое лицо";
}

entity StateAuthority {
    label ru-KZ official "государственный орган либо должностное лицо";
}
entity Candidate {
    label ru-KZ official "кандидат в Президенты";
}
entity President {
    label ru-KZ official "Президент Республики Казахстан (редакция 1995)";
}
entity Senate {
    label ru-KZ official "Сенат Парламента";
}
entity Mazhilis {
    label ru-KZ official "Мажилис Парламента";
}
entity Parliament {
    label ru-KZ official "Парламент Республики Казахстан";
}
entity Election {
    label ru-KZ official "выборы Президента";
}
entity Law {
    label ru-KZ official "закон, представленный Президенту";
}
entity Appointment {
    label ru-KZ official "назначение, производимое Президентом";
}
entity ConstitutionalPetition {
    label ru-KZ official "обращение в Конституционный Суд";
}
entity EmergencyMeasure {
    label ru-KZ official "мера чрезвычайного либо военного положения";
}
entity Impeachment {
    label ru-KZ official "производство об отрешении Президента от должности либо освобождении по состоянию здоровья";
}
entity PresidentialAct {
    label ru-KZ official "акт Президента";
}
entity Referendum {
    label ru-KZ official "республиканский референдум";
}
entity SuccessionEvent {
    label ru-KZ official "случай перехода полномочий Президента";
}
entity GovernmentDecision {
    label ru-KZ official "решение Президента по структуре и составу Правительства";
}

// --- Конституционные числа редакции 1995 (ст. 41, 42, 47) ---------------

relation president_term_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "срок полномочий Президента — семь лет";
}
relation president_minimum_age_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "минимальный возраст Президента — сорок лет";
}
relation president_residence_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый срок проживания в Казахстане — пятнадцать лет";
}
relation election_majority_percent_1995(percent: Integer) kind institutional {
    key(percent);
    label ru-KZ official "порог избрания Президента — более пятидесяти процентов голосов";
}
relation succession_oath_months_1995(months: Integer) kind institutional {
    key(months);
    label ru-KZ official "срок принесения присяги при переходе полномочий — один месяц";
}
relation law_signature_months_1995(months: Integer) kind institutional {
    key(months);
    label ru-KZ official "срок подписания представленного закона — один месяц";
}
relation impeachment_initiative_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога инициативы отрешения — одна треть";
}
relation impeachment_initiative_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога инициативы отрешения — одна треть";
}
relation impeachment_final_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога отрешения — три четверти";
}
relation impeachment_final_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога отрешения — три четверти";
}
relation impeachment_deadline_months_1995(months: Integer) kind institutional {
    key(months);
    label ru-KZ official "срок принятия окончательного решения об отрешении — два месяца";
}
relation incapacity_release_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога освобождения по состоянию здоровья — три четверти";
}
relation incapacity_release_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога освобождения по состоянию здоровья — три четверти";
}

// --- Ст. 40. Статус (адресуемые факты, вывода нет) ----------------------

pub relation president_is_head_of_state_1995() kind institutional {
    label ru-KZ official "Президент — глава государства, высшее должностное лицо Республики";
}
pub relation president_is_symbol_and_guarantor_of_unity_1995() kind institutional {
    label ru-KZ official "Президент — символ и гарант единства народа и государственной власти";
}
pub relation president_ensures_concerted_branch_functioning_1995() kind institutional {
    label ru-KZ official "Президент обеспечивает согласованное функционирование ветвей государственной власти";
}

