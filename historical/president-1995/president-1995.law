    label ru-KZ official "кандидат является данным лицом";
}
relation citizen_by_birth(person: Person) kind empirical {
    label ru-KZ official "лицо является гражданином Республики по рождению";
}
relation age_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "возраст лица в полных годах";
}
relation resides_last_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "число последних лет проживания в Казахстане";
}
relation higher_education(person: Person) kind empirical {
    label ru-KZ official "лицо имеет высшее образование";
}
relation fluent_in_state_language(person: Person) kind empirical {
    label ru-KZ official "лицо свободно владеет государственным языком";
}
relation eligible_presidential_candidate_1995(candidate: Candidate) kind institutional {
    label ru-KZ official "лицо отвечает требованиям к кандидату в Президенты";
}

relation presidential_election(election: Election) kind empirical {
    label ru-KZ official "событие является выборами Президента";
}
relation presidential_vote(election: Election, person: Person, votes: Integer) kind empirical {
    label ru-KZ official "число голосов, поданных за кандидата";
}
relation participating_voters(election: Election, voters: Integer) kind empirical {
    label ru-KZ official "число избирателей, принявших участие в голосовании";
}
relation runoff_ballot(election: Election) kind empirical {
    label ru-KZ official "голосование является повторным";
}
relation highest_vote_in_runoff(election: Election, person: Person) kind empirical {
    label ru-KZ official "кандидат набрал большее число голосов при повторном голосовании";
}
relation previously_elected_president(person: Person) kind empirical {
    label ru-KZ official "лицо ранее избиралось Президентом Республики";
}
relation elected_president_1995(person: Person) kind institutional {
    label ru-KZ official "лицо считается избранным Президентом";
}
relation runoff_required_1995(election: Election) kind institutional {
    label ru-KZ official "проводится повторное голосование";
}
relation no_candidate_reached_majority(election: Election) kind empirical {
    label ru-KZ official "ни один кандидат не набрал более половины голосов";
}

relation regular_election_on_first_december_sunday(election: Election) kind empirical {
    label ru-KZ official "очередные выборы назначены на первое воскресенье декабря";
}
relation coincides_with_parliament_election(election: Election) kind empirical {
    label ru-KZ official "выборы Президента совпадают по срокам с выборами нового состава Парламента";
}
relation regular_election_date_admissible_1995(election: Election) kind institutional {
    label ru-KZ official "срок очередных выборов Президента допустим";
}

// --- Ст. 42. Присяга, прекращение полномочий, однократность -------------

relation oath_taken(person: Person) kind empirical {
    label ru-KZ official "лицо принесло присягу народу Казахстана";
}
relation president_assumed_office_1995(person: Person) kind institutional {
    label ru-KZ official "лицо вступило в должность Президента";
}
relation succession_event(occasion: SuccessionEvent, person: Person) kind empirical {
    label ru-KZ official "полномочия Президента переходят к данному лицу";
}
relation succession_oath_within_one_month(occasion: SuccessionEvent) kind empirical {
    label ru-KZ official "присяга принесена в течение месяца со дня принятия полномочий";
}
relation succession_oath_timely_1995(occasion: SuccessionEvent) kind institutional {
    label ru-KZ official "присяга при переходе полномочий принесена в срок";
}
relation new_president_assumed_office(person: Person) kind empirical {
    label ru-KZ official "новый Президент вступил в должность";
}
relation early_release_or_removal(person: Person) kind empirical {
    label ru-KZ official "Президент досрочно освобождён либо отрешён от должности";
}
relation president_deceased(person: Person) kind empirical {
    label ru-KZ official "Президент умер";
}
relation presidential_powers_terminated_1995(person: Person) kind institutional {
    label ru-KZ official "полномочия Президента прекращены";
}
relation removed_from_office(person: Person) kind empirical {
    label ru-KZ official "лицо отрешено от должности Президента";
}
relation former_president_title_held_1995(person: Person) kind institutional {
    label ru-KZ official "за бывшим Президентом сохраняется звание Президента Республики";
}
relation repeated_election_attempt(person: Person) kind empirical {
    label ru-KZ official "предпринята попытка повторного избрания лица Президентом";
}
relation repeated_election_prohibited_1995(person: Person) kind institutional {
    label ru-KZ official "повторное избрание одного и того же лица Президентом не допускается";
}

// --- Ст. 43. Несовместимости --------------------------------------------

relation president(authority: President) kind empirical {
    label ru-KZ official "лицо является Президентом Республики";
}
relation president_person(authority: President, person: Person) kind empirical {
    label ru-KZ official "Президент является данным физическим лицом";
}
relation president_holds_representative_mandate(authority: President) kind empirical {
    label ru-KZ official "Президент является депутатом представительного органа";
}
relation president_holds_other_paid_office(authority: President) kind empirical {
    label ru-KZ official "Президент занимает иную оплачиваемую должность";
}
relation president_conducts_business(authority: President) kind empirical {
    label ru-KZ official "Президент осуществляет предпринимательскую деятельность";
}
relation president_party_member(authority: President) kind empirical {
    label ru-KZ official "Президент состоит в политической партии";
}
relation presidential_office_incompatible_1995(authority: President) kind institutional {
    label ru-KZ official "должность Президента несовместима с занимаемой должностью либо деятельностью";
}
relation close_relative_of_president(person: Person, authority: President) kind empirical {
    label ru-KZ official "лицо является близким родственником Президента";
}
relation relative_holds_political_office_or_quasistate_leadership(person: Person) kind empirical {
    label ru-KZ official "родственник занимает политическую государственную должность либо руководит организацией квазигосударственного сектора";
}
relation presidential_relative_position_prohibited_1995(person: Person) kind institutional {
    label ru-KZ official "занятие родственником Президента такой должности не допускается";
}

// --- Ст. 44. Полномочия с конституционным условием -----------------------

relation law_presented(law: Law, authority: President) kind empirical {
    label ru-KZ official "закон представлен Президенту на подпись";
}
relation presidential_signature_attempt(authority: President, law: Law) kind empirical {
    label ru-KZ official "Президент подписывает представленный закон";
}
relation presidential_return_attempt(authority: President, law: Law) kind empirical {
    label ru-KZ official "Президент возвращает закон для повторного обсуждения";
}
relation signature_within_one_month(law: Law) kind empirical {
    label ru-KZ official "закон подписан в месячный срок";
}
relation law_signed_1995(law: Law) kind institutional {
    label ru-KZ official "закон подписан Президентом";
}
relation law_returned_for_reconsideration_1995(law: Law) kind institutional {
    label ru-KZ official "закон возвращён для повторного обсуждения и голосования";
}

// `appointment_candidate` СНЯТО 02.09.2026: ни одна норма редакции 1995 не различает назначаемое лицо: нормы говорят о назначении и о согласии Палаты
relation appointment_requires_mazhilis_consent(appointment: Appointment) kind empirical {
    label ru-KZ official "назначение производится с согласия Мажилиса";
}
relation mazhilis_consent_given(appointment: Appointment) kind empirical {
    label ru-KZ official "Мажилис дал согласие на назначение";
}
relation fraction_consultations_completed(appointment: Appointment) kind empirical {
    label ru-KZ official "проведены консультации с фракциями политических партий";
}
relation appointment_requires_senate_consent(appointment: Appointment) kind empirical {
    label ru-KZ official "назначение производится с согласия Сената";
}
relation senate_consent_given(appointment: Appointment) kind empirical {
    label ru-KZ official "Сенат дал согласие на назначение";
}
relation presidential_appointment_attempt(authority: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент производит назначение";
}
relation appointment_effective_1995(appointment: Appointment) kind institutional {
    label ru-KZ official "назначение состоялось";
}

relation referendum_proposal(referendum: Referendum) kind empirical {
    label ru-KZ official "заявлено предложение о проведении республиканского референдума";
}
relation referendum_decision_attempt(authority: President, referendum: Referendum) kind empirical {
    label ru-KZ official "Президент принимает решение о проведении референдума";
}
relation referendum_called_1995(referendum: Referendum) kind institutional {
    label ru-KZ official "республиканский референдум назначен";
}
relation constitutional_petition(petition: ConstitutionalPetition) kind empirical {
    label ru-KZ official "обращение направлено в Конституционный Суд";
}
relation constitutional_review_petition_attempt(authority: President, petition: ConstitutionalPetition) kind empirical {
    label ru-KZ official "Президент обращается в Конституционный Суд";
}
relation petition_protects_rights_or_security(petition: ConstitutionalPetition) kind empirical {
    label ru-KZ official "обращение направлено на защиту прав и свобод человека либо безопасности государства";
}
relation constitutional_review_requested_1995(petition: ConstitutionalPetition) kind institutional {
    label ru-KZ official "конституционный контроль инициирован правомерно";
}

relation serious_and_immediate_threat() kind empirical {
    label ru-KZ official "налицо серьёзная и непосредственная угроза безопасности, конституционному строю либо общественному порядку";
}
relation constitutional_organs_functioning_disrupted() kind empirical {
    label ru-KZ official "нарушено нормальное функционирование конституционных органов";
}
relation emergency_consultations_with_pm_and_chairs_completed() kind empirical {
    label ru-KZ official "проведены консультации с Премьер-Министром и председателями Палат Парламента";
}
relation parliament_immediately_informed() kind empirical {
    label ru-KZ official "Парламент незамедлительно проинформирован о принятых мерах";
}
relation emergency_measure(measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "мера является мерой чрезвычайного положения";
}
relation emergency_measure_attempt(authority: President, measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "Президент вводит меры чрезвычайного положения";
}
relation emergency_measure_in_force_1995(measure: EmergencyMeasure) kind institutional {
    label ru-KZ official "меры чрезвычайного положения введены правомерно";
}
relation aggression_or_immediate_external_threat() kind empirical {
    label ru-KZ official "налицо агрессия против Республики либо непосредственная внешняя угроза";
}
relation martial_measure_attempt(authority: President, measure: EmergencyMeasure) kind empirical {
    label ru-KZ official "Президент вводит военное положение";
}
relation martial_measure_in_force_1995(measure: EmergencyMeasure) kind institutional {
