}

// Полномочия без конституционного условия — адресуемые факты.
pub relation president_addresses_annual_message_1995() kind institutional {
    label ru-KZ official "Президент обращается с ежегодным посланием о положении в стране";
}
pub relation president_is_supreme_commander_1995() kind institutional {
    label ru-KZ official "Президент — Верховный Главнокомандующий Вооружёнными Силами";
}
pub relation president_decides_citizenship_and_asylum_1995() kind institutional {
    label ru-KZ official "Президент решает вопросы гражданства и предоставления политического убежища";
}
pub relation president_exercises_pardon_1995() kind institutional {
    label ru-KZ official "Президент осуществляет помилование граждан";
}
pub relation president_forms_state_guard_service_1995() kind institutional {
    label ru-KZ official "Президент образует Службу государственной охраны";
}
pub relation president_forms_security_council_and_assembly_1995() kind institutional {
    label ru-KZ official "Президент образует Совет Безопасности и Ассамблею народа Казахстана";
}

// Ст. 44 подпункты 3 и 7, деонтический слой 13.09.2026. Текст 1995 называет
// у ЭТИХ действий собственное условие действительности — консультации с
// фракциями, представление Премьер-Министра, пятилетний срок назначения, —
// и условие это отдельный факт дела, а не повторение посылки. Вакуумный
// `valid_when` редакции 2026 (27 полномочий из 31 читают предикат, уже
// стоящий посылкой) здесь НЕ воспроизводится: где условие не отделимо от
// посылки, полномочие не заводится вовсе.
relation pm_nomination_attempt(authority: President, appointment: Appointment) kind empirical {
    label ru-KZ official "Президент вносит кандидатуру Премьер-Министра на рассмотрение Мажилиса";
}
relation pm_nomination_submitted_1995(appointment: Appointment) kind institutional {
    label ru-KZ official "кандидатура Премьер-Министра внесена правомерно";
}
relation government_structure_decision(act_item: GovernmentDecision) kind empirical {
    label ru-KZ official "решение определяет структуру Правительства";
}
relation prime_minister_structure_submission(act_item: GovernmentDecision) kind empirical {
