// Ст. 47 пункты 2 и 3, деонтический слой 13.09.2026. Пункт 2 читается как
// ИММУНИТЕТ с единственным исключением: «несёт ответственность за действия,
// совершённые при исполнении своих обязанностей, ТОЛЬКО в случае
// государственной измены». Блокируемое правовое изменение названо текстом —
// привлечение к ответственности за должностные действия; исключение названо
// тем же пунктом и потому выражено полномочием с приоритетом, а не
// переписыванием иммунитета. Пункт 3 — второй барьер: он блокирует
// возбуждение вопроса об отрешении, пока Президент рассматривает вопрос о
// роспуске Парламента.
relation mazhilis_chamber(house: Mazhilis) kind empirical {
    label ru-KZ official "орган является Мажилисом Парламента";
}
relation presidential_liability_attempt(authority: StateAuthority, person: Person) kind empirical {
    label ru-KZ official "государственный орган привлекает Президента к ответственности за действия, совершённые при исполнении обязанностей";
}
relation state_treason_by_president_1995(person: Person) kind empirical {
    label ru-KZ official "действия Президента образуют государственную измену";
}
relation president_held_liable_for_acts_in_office_1995(person: Person) kind institutional {
    label ru-KZ official "Президент привлечён к ответственности за действия, совершённые при исполнении обязанностей";
}
