// Консультации с фракциями проведены, согласие Мажилиса дано: оба полномочия
// осуществлены действительно.
test "urn:query:kzp95-5" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a5-1": president(entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a5-2": appointment_requires_mazhilis_consent(entity_ref("urn:kz:constitution1995:president:test:appointment1")) { origin case_input; }
        assert "a5-3": fraction_consultations_completed(entity_ref("urn:kz:constitution1995:president:test:appointment1")) { origin case_input; }
        assert "a5-4": mazhilis_consent_given(entity_ref("urn:kz:constitution1995:president:test:appointment1")) { origin case_input; }
        assert "a5-5": pm_nomination_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:appointment1")) { origin case_input; }
        assert "a5-6": presidential_appointment_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:appointment1")) { origin case_input; }
    }
    evaluate positions();
    expect position(NominatePrimeMinister1995, ACTIVE);
    expect position(AppointWithMazhilisConsent1995, ACTIVE);

    evaluate truth(pm_nomination_submitted_1995(entity_ref("urn:kz:constitution1995:president:test:appointment1")));
    expect truth_status == TRUE_ONLY;

    evaluate truth(appointment_effective_1995(entity_ref("urn:kz:constitution1995:president:test:appointment1")));
    expect truth_status == TRUE_ONLY;
}

// Ни консультаций, ни согласия: оба осуществления недействительны.
test "urn:query:kzp95-6" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
