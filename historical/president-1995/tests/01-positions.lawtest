// РАСХОЖДЕНИЕ С 2026, ИЗМЕРЕННОЕ ЗДЕСЬ: у обращения в Конституционный Суд
// редакция 1995 называет собственную цель («в интересах защиты прав и свобод
// … безопасности»), и потому недействительное обращение выразимо. В редакции
// 2026 `valid_when` того же полномочия читает `president(president)` —
// повторение посылки, и этого дела там построить нельзя.
test "urn:query:kzp95-16" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a16-1": president(entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a16-2": constitutional_petition(entity_ref("urn:kz:constitution1995:president:test:petition2")) { origin case_input; }
        assert "a16-3": constitutional_review_petition_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:petition2")) { origin case_input; }
    }
    evaluate positions();
    expect position(PetitionConstitutionalCourt1995, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(constitutional_review_requested_1995(entity_ref("urn:kz:constitution1995:president:test:petition2")));
    expect truth_status == NEITHER;
}

test "urn:query:kzp95-17" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a17-1": president(entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a17-2": emergency_measure(entity_ref("urn:kz:constitution1995:president:test:measure1")) { origin case_input; }
        assert "a17-3": serious_and_immediate_threat() { origin case_input; }
        assert "a17-4": constitutional_organs_functioning_disrupted() { origin case_input; }
        assert "a17-5": emergency_consultations_with_pm_and_chairs_completed() { origin case_input; }
        assert "a17-6": parliament_immediately_informed() { origin case_input; }
        assert "a17-7": emergency_measure_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:measure1")) { origin case_input; }
