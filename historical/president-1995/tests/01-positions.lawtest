        assert "a23-2": mazhilis_chamber(entity_ref("urn:kz:constitution1995:president:test:mazhilis1")) { origin case_input; }
        assert "a23-3": impeachment_case(entity_ref("urn:kz:constitution1995:president:test:process1")) { origin case_input; }
        assert "a23-4": treason_charge(entity_ref("urn:kz:constitution1995:president:test:process1")) { origin case_input; }
        assert "a23-5": mazhilis_initiating_votes(entity_ref("urn:kz:constitution1995:president:test:process1"), 40) { origin case_input; }
        assert "a23-6": mazhilis_total_deputies(entity_ref("urn:kz:constitution1995:president:test:process1"), 98) { origin case_input; }
        assert "a23-7": impeachment_initiation_attempt(entity_ref("urn:kz:constitution1995:president:test:mazhilis1"), entity_ref("urn:kz:constitution1995:president:test:process1")) { origin case_input; }
    }
    evaluate positions();
    expect position(InitiateImpeachment1995, ACTIVE);
    expect not position(NoImpeachmentDuringDissolutionReview1995, ACTIVE);

    evaluate truth(impeachment_initiated_1995(entity_ref("urn:kz:constitution1995:president:test:process1")));
    expect truth_status == TRUE_ONLY;
}

