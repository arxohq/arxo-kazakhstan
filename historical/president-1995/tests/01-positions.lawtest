language "law.core" version "0.2";
package kz.constitution1995.president version "0.1.0";
namespace "urn:kz:constitution1995:president";

// ПОЗИЦИИ §§122–137 РАЗДЕЛА III «ПРЕЗИДЕНТ» РЕДАКЦИИ 1995 ГОДА (13.09.2026).
//
// В пакете 19 норм-шаблонов: 14 полномочий §127, четыре иммунитета §128 и
// одна обязанность §136/§138. Набор наблюдает каждый.
//
// ОТЛИЧИЕ ОТ РЕДАКЦИИ 2026, РАДИ КОТОРОГО ЗАВЕДЁН СЛОЙ. У 27 полномочий из
// 31 в пакете 2026 `valid_when` читает предикат, уже стоящий посылкой
// создающего правила, и недействительное осуществление там невозможно по
// построению. Здесь условие действительности у КАЖДОГО полномочия — отдельный
// эмпирический факт дела (месячный срок, согласие Палаты, представление
// Премьер-Министра, консультации с фракциями, пятилетний срок назначения,
// информирование Парламента, государственная измена, управомоченное число
// инициаторов), поэтому пара «действительно / недействительно» наблюдаема у
// всех четырнадцати.
//
// ПРОЕКЦИЯ РЕДАКЦИЙ. Мир сценария склеен с пакетом источников
// `kz.constitution.sources` (`concat` в law.toml), где редакция
// KZ_CONSTITUTION_1995 объявлена как in_force [@1995-09-05, @2026-07-01).
// Поэтому дела ведутся на `legal_time @2020-01-01`, а последнее дело набора
// проверяет обратное: на @2026-09-01 узлы редакции 1995 исключены условием 3
// §92, ни одной позиции нет, эффекта нет.

// ─────────────────────────────────────────────────────────────────────────
// Ст. 44 подп. 2. Подписание закона и возвращение для повторного обсуждения.
// ─────────────────────────────────────────────────────────────────────────

// Закон подписан в месячный срок: оба полномочия есть, эффект наступает.
// Здесь же наблюдаются обе презумпции неприкосновенности действующего
// Президента — ст. 46 п. 1 и ст. 47 п. 2.
test "urn:query:kzp95-1" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a1-1": president(entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a1-2": president_person(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:person1")) { origin case_input; }
        assert "a1-3": law_presented(entity_ref("urn:kz:constitution1995:president:test:law1"), entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a1-4": signature_within_one_month(entity_ref("urn:kz:constitution1995:president:test:law1")) { origin case_input; }
        assert "a1-5": presidential_signature_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:law1")) { origin case_input; }
    }
    evaluate positions();
    expect issues_within(info);
    expect position(SignPresentedLaw1995, ACTIVE);
    expect position(ReturnLawForReconsideration1995, ACTIVE);
    expect position(PresidentialInviolability1995, ACTIVE);
    expect position(PresidentialLiabilityOnlyForTreason1995, ACTIVE);

    evaluate truth(law_signed_1995(entity_ref("urn:kz:constitution1995:president:test:law1")));
    expect truth_status == TRUE_ONLY;
}

// Тот же закон подписан за пределами месячного срока: полномочие остаётся,
// эффекта нет, осуществление помечено недействительным.
test "urn:query:kzp95-2" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a2-1": president(entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a2-2": law_presented(entity_ref("urn:kz:constitution1995:president:test:law2"), entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a2-3": presidential_signature_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:law2")) { origin case_input; }
    }
    evaluate positions();
    expect position(SignPresentedLaw1995, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(law_signed_1995(entity_ref("urn:kz:constitution1995:president:test:law2")));
    expect truth_status == NEITHER;
}

