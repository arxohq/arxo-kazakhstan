        assert "a21-3": state_authority(entity_ref("urn:kz:constitution1995:president:test:authority1")) { origin case_input; }
        assert "a21-4": presidential_liability_attempt(entity_ref("urn:kz:constitution1995:president:test:authority1"), entity_ref("urn:kz:constitution1995:president:test:person1")) { origin case_input; }
    }
    evaluate positions();
    expect position(PresidentialLiabilityOnlyForTreason1995, ACTIVE);
    expect position(HoldPresidentLiableForTreason1995, ACTIVE);
    expect issue(POWER_INVALID_EXERCISE);

    evaluate truth(president_held_liable_for_acts_in_office_1995(entity_ref("urn:kz:constitution1995:president:test:person1")));
    expect truth_status == NEITHER;
}

