        assert "a6-3": pm_nomination_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:appointment2")) { origin case_input; }
        assert "a6-4": presidential_appointment_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:appointment2")) { origin case_input; }
