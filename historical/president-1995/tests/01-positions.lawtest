        assert "a28-3": law_presented(entity_ref("urn:kz:constitution1995:president:test:law1"), entity_ref("urn:kz:constitution1995:president:test:president1")) { origin case_input; }
        assert "a28-4": signature_within_one_month(entity_ref("urn:kz:constitution1995:president:test:law1")) { origin case_input; }
        assert "a28-5": presidential_signature_attempt(entity_ref("urn:kz:constitution1995:president:test:president1"), entity_ref("urn:kz:constitution1995:president:test:law1")) { origin case_input; }
    }
