// ─────────────────────────────────────────────────────────────────────────
// Ст. 46. Экс-Президент: иммунитет и обязанность государства.
// ─────────────────────────────────────────────────────────────────────────

test "urn:query:kzp95-26" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a26-1": former_president(entity_ref("urn:kz:constitution1995:president:test:person3")) { origin case_input; }
        assert "a26-2": state_authority(entity_ref("urn:kz:constitution1995:president:test:authority1")) { origin case_input; }
        assert "a26-3": state_funded_protection_provided(entity_ref("urn:kz:constitution1995:president:test:person3")) { origin case_input; }
    }
    evaluate positions();
    expect position(FormerPresidentialInviolability1995, ACTIVE);
    // ГРАНИЦА, ИЗМЕРЕННАЯ ЗДЕСЬ, А НЕ ПРЕДПОЛОЖЕННАЯ: охрана обеспечена, и
    // обязанность всё равно остаётся ACTIVE. Цель редакции 1995 —
    // `maintenance` с окном нормы, а не `achieve`; исполненное условие
    // поддержания SATISFIED не даёт. Та же обязанность 2026 записана через
    // `achieve` и SATISFIED получает — расхождение в ФОРМЕ ЦЕЛИ, и тест
    // обязан упасть, если однажды придёт SATISFIED.
    expect position(ProvideStateFundedProtection1995, ACTIVE);
    expect not position(ProvideStateFundedProtection1995, SATISFIED);
}

// Охрана не обеспечена: обязанность держится, нарушением не становится —
// цель maintenance не получает VIOLATED без установленного провала.
test "urn:query:kzp95-27" {
    given {
        context { decision_time @2020-01-01T12:00:00+06:00; knowledge_time @2020-01-01T12:00:00+06:00; legal_time @2020-01-01; timezone "Asia/Almaty"; }
        assert "a27-1": former_president(entity_ref("urn:kz:constitution1995:president:test:person4")) { origin case_input; }
        assert "a27-2": state_authority(entity_ref("urn:kz:constitution1995:president:test:authority1")) { origin case_input; }
    }
    evaluate positions();
    expect position(FormerPresidentialInviolability1995, ACTIVE);
    expect position(ProvideStateFundedProtection1995, ACTIVE);
    expect not position(ProvideStateFundedProtection1995, VIOLATED);
}

