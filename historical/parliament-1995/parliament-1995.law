// Конституция РК 1995, раздел IV (ст. 49–63): Парламент.
//
// ОТДЕЛЬНЫЙ ПАКЕТ (DECISION-0026, вариант «в»). Основание — институт другой:
// Парламент 1995 ДВУХПАЛАТНЫЙ (Сенат и Мажилис), и почти каждый порог здесь
// считается «от общего числа депутатов КАЖДОЙ из Палат». Курултай редакции
// 2026 однопалатен, поэтому те же три четверти в нём — одно число, а здесь
// два независимых условия. Свести их в один предикат значило бы утверждать
// тождество органов, которого нет.
//
// Числа сверены с закреплённым текстом ст. 50–63. Ни одно не перенесено из
// редакции 2026 и ни одно не восстановлено по памяти.
//
// ОБЪЯВЛЕННАЯ ГРАНИЦА (DECISION-0012). Перечни ведения (ст. 53, 55, 56, 57)
// выражены правилами ТОЛЬКО там, где Конституция называет условие —
// большинство, инициативу, срок, представление. Пункты вида «решает вопросы
// войны и мира», «формирует координационные и рабочие органы» записаны
// фактами: у них нет антецедента, и придуманный антецедент был бы авторской
// нормой. Ст. 61 п. 3 (перечень предметов законодательного регулирования)
// оставлен адресуемым фактом по той же причине: он делит предметы, а не
// выводит последствие.

language "law.core" version "0.2";
package kz.constitution1995.parliament version "0.1.0";
namespace "urn:kz:constitution1995:parliament";

entity Person {
    label ru-KZ official "физическое лицо";
}
entity Deputy {
    label ru-KZ official "депутат Парламента";
}
entity Chamber {
    label ru-KZ official "Палата Парламента — Сенат либо Мажилис";
}
entity Parliament {
    label ru-KZ official "Парламент Республики Казахстан (редакция 1995)";
}
entity Bill {
    label ru-KZ official "законопроект";
}
entity Statute {
    label ru-KZ official "закон либо иной акт Парламента";
}
entity Objection {
    label ru-KZ official "возражение Президента по закону";
}
entity Appointment {
    label ru-KZ official "назначение, производимое с согласия Палаты";
}
entity Government {
    label ru-KZ official "Правительство Республики Казахстан";
}
entity NoConfidenceMotion {
    label ru-KZ official "инициатива о вотуме недоверия Правительству либо о заслушивании отчёта члена Правительства";
}
entity Dissolution {
    label ru-KZ official "роспуск Парламента либо Мажилиса";
}
entity Session {
    label ru-KZ official "сессия Парламента";
}
entity Sitting {
    label ru-KZ official "совместное либо раздельное заседание Палат";
}
entity Committee {
    label ru-KZ official "постоянный комитет Палаты";
}
entity ChamberChair {
    label ru-KZ official "Председатель Палаты Парламента";
}
entity Referendum {
    label ru-KZ official "республиканский референдум";
}
entity ConfidenceQuestion {
    label ru-KZ official "вопрос о доверии Правительству";
}

// --- Конституционные числа редакции 1995 ---------------------------------

relation mazhilis_seats_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "число депутатов Мажилиса — девяносто восемь";
}
relation senate_appointed_by_president_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "число депутатов Сената, назначаемых Президентом, — десять";
}
relation senate_appointed_on_assembly_proposal_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "число депутатов Сената, назначаемых по предложению Ассамблеи народа Казахстана, — пять";
}
relation senate_term_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "срок полномочий депутата Сената — шесть лет";
}
relation mazhilis_term_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "срок полномочий депутата Мажилиса — пять лет";
}
relation senate_rotation_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "периодичность обновления половины депутатов Сената — три года";
}
relation deputy_residence_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый срок проживания депутата в Казахстане — десять лет";
}
relation senator_minimum_age_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "минимальный возраст депутата Сената — тридцать лет";
}
relation senator_work_experience_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый стаж работы депутата Сената — пять лет";
}
relation senator_regional_residence_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "требуемый срок проживания депутата Сената в регионе — три года";
}
relation mazhilis_deputy_minimum_age_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "минимальный возраст депутата Мажилиса — двадцать пять лет";
}
relation first_session_convocation_days_1995(days: Integer) kind institutional {
    key(days);
    label ru-KZ official "срок созыва первой сессии — тридцать дней со дня опубликования итогов выборов";
}
relation senate_review_days_1995(days: Integer) kind institutional {
    key(days);
    label ru-KZ official "срок рассмотрения законопроекта Сенатом — шестьдесят дней";
}
relation presentation_to_president_days_1995(days: Integer) kind institutional {
    key(days);
    label ru-KZ official "срок представления принятого закона на подпись — десять дней";
}
relation priority_bill_months_1995(months: Integer) kind institutional {
    key(months);
    label ru-KZ official "срок первоочередного рассмотрения приоритетного законопроекта — два месяца";
}
relation confidence_vote_wait_hours_1995(hours: Integer) kind institutional {
    key(hours);
    label ru-KZ official "срок между постановкой вопроса о доверии и голосованием — сорок восемь часов";
}
relation confidence_uses_per_year_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "предел обращения Правительства к вопросу о доверии — два раза в год";
}
relation standing_committees_max_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "предельное число постоянных комитетов Палаты — семь";
}
relation constitutional_court_judges_per_chamber_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "число судей Конституционного Суда, назначаемых каждой Палатой самостоятельно, — трое";
}
relation unexcused_absences_limit_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "порог применения мер взыскания за отсутствие — более трёх раз";
}
relation quorum_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель кворума заседания — две трети";
}
relation quorum_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель кворума заседания — две трети";
}
relation amendment_majority_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель парламентского порога изменения Конституции — три четверти";
}
relation amendment_majority_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель парламентского порога изменения Конституции — три четверти";
}
relation constitutional_law_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога принятия конституционного закона — две трети";
}
relation constitutional_law_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога принятия конституционного закона — две трети";
}
relation veto_override_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога преодоления возражений Президента — две трети";
}
relation veto_override_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога преодоления возражений Президента — две трети";
}
relation no_confidence_initiative_numerator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "числитель порога инициативы о вотуме недоверия — одна пятая";
}
relation no_confidence_initiative_denominator_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "знаменатель порога инициативы о вотуме недоверия — одна пятая";
}
relation minimum_readings_1995(value: Integer) kind institutional {
    key(value);
    label ru-KZ official "минимальное число чтений законопроекта — два";
}
relation dissolution_protected_months_1995(months: Integer) kind institutional {
    key(months);
    label ru-KZ official "защищённый период перед окончанием полномочий Президента — шесть месяцев";
}
relation dissolution_cooldown_years_1995(years: Integer) kind institutional {
    key(years);
    label ru-KZ official "срок, в течение которого Парламент не распускается после предыдущего роспуска, — один год";
}

// --- Ст. 49–50. Состав и полномочия --------------------------------------

pub relation parliament_is_supreme_representative_body_1995() kind institutional {
    label ru-KZ official "Парламент — высший представительный орган, осуществляющий законодательные функции";
}
pub relation parliament_has_two_chambers_1995() kind institutional {
    label ru-KZ official "Парламент состоит из двух Палат — Сената и Мажилиса";
}

relation parliament(body: Parliament) kind empirical {
    label ru-KZ official "орган является Парламентом Республики";
}
relation senate(chamber: Chamber) kind empirical {
    label ru-KZ official "Палата является Сенатом";
}
relation mazhilis(chamber: Chamber) kind empirical {
    label ru-KZ official "Палата является Мажилисом";
}
relation first_session_opened(body: Parliament) kind empirical {
    label ru-KZ official "открылась первая сессия Парламента";
}
relation new_convocation_first_session_started(body: Parliament) kind empirical {
    label ru-KZ official "открылась первая сессия Парламента нового созыва";
}
relation parliament_powers_active_1995(body: Parliament) kind institutional {
    label ru-KZ official "полномочия Парламента данного созыва осуществляются";
}
relation deputy_of(deputy: Deputy, chamber: Chamber) kind empirical {
    label ru-KZ official "депутат входит в состав данной Палаты";
}
relation deputy_member_of_both_chambers(deputy: Deputy) kind empirical {
    label ru-KZ official "лицо одновременно является депутатом обеих Палат";
}
relation dual_membership_prohibited_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "одновременное членство в обеих Палатах не допускается";
}

// --- Ст. 51. Выборы и цензы депутатов ------------------------------------

relation candidate_deputy(deputy: Deputy, person: Person) kind empirical {
    label ru-KZ official "депутатский мандат принадлежит данному лицу";
}
relation citizen(person: Person) kind empirical {
    label ru-KZ official "лицо является гражданином Республики Казахстан";
}
relation resides_in_kazakhstan_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "число последних лет проживания в Казахстане";
}
relation age_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "возраст лица в полных годах";
}
relation higher_education(person: Person) kind empirical {
    label ru-KZ official "лицо имеет высшее образование";
}
relation work_experience_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "стаж работы лица в полных годах";
}
relation resides_in_region_years(person: Person, years: Integer) kind empirical {
    label ru-KZ official "число последних лет проживания на территории соответствующей области либо города";
}
relation seeks_senate_seat(deputy: Deputy) kind empirical {
    label ru-KZ official "лицо претендует на депутатский мандат Сената";
}
relation seeks_mazhilis_seat(deputy: Deputy) kind empirical {
    label ru-KZ official "лицо претендует на депутатский мандат Мажилиса";
}
relation eligible_senator_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "лицо отвечает требованиям к депутату Сената";
}
relation eligible_mazhilis_deputy_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "лицо отвечает требованиям к депутату Мажилиса";
}

// --- Ст. 52. Обязанности, несовместимости, неприкосновенность ------------

relation deputy(deputy: Deputy) kind empirical {
    label ru-KZ official "лицо является депутатом Парламента";
}
relation unexcused_absences(deputy: Deputy, count: Integer) kind empirical {
    label ru-KZ official "число случаев отсутствия депутата на заседаниях без уважительных причин";
}
relation vote_delegated(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат передал право голоса другому лицу";
}
relation deputy_sanction_applies_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "к депутату применимы установленные законом меры взыскания";
}
relation deputy_holds_other_representative_mandate(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат является депутатом другого представительного органа";
}
relation deputy_holds_other_paid_office(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат занимает иную оплачиваемую должность";
}
relation office_is_teaching_research_or_creative(deputy: Deputy) kind empirical {
    label ru-KZ official "занятие относится к разрешённой преподавательской, научной либо творческой деятельности";
}
relation deputy_conducts_business(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат осуществляет предпринимательскую деятельность";
}
relation deputy_in_commercial_governing_body(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат входит в руководящий орган либо наблюдательный совет коммерческой организации";
}
relation deputy_powers_terminated_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "полномочия депутата прекращены";
}
relation arrest_or_prosecution_attempt(deputy: Deputy) kind empirical {
    label ru-KZ official "предпринята попытка ареста либо привлечения депутата к уголовной ответственности";
}
relation chamber_consent_given(deputy: Deputy) kind empirical {
    label ru-KZ official "Палата дала согласие на привлечение депутата к ответственности";
}
relation caught_in_the_act_or_grave_crime(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат задержан на месте преступления либо совершил тяжкое преступление";
}
relation deputy_immunity_infringed_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "нарушена неприкосновенность депутата";
}
relation resignation_submitted(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат подал в отставку";
}
relation deputy_deceased(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат умер";
}
relation court_declared_incapable_dead_or_missing(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат признан судом недееспособным, умершим либо безвестно отсутствующим";
}
relation permanent_departure_from_kazakhstan(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат выехал на постоянное место жительства за пределы Казахстана";
}
relation criminal_conviction_in_force(deputy: Deputy) kind empirical {
    label ru-KZ official "в отношении депутата вступил в законную силу обвинительный приговор";
}
relation citizenship_lost(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат утратил гражданство Республики Казахстан";
}
relation deputy_mandate_forfeited_1995(deputy: Deputy) kind institutional {
    label ru-KZ official "депутат лишается своего мандата";
}
relation elected_on_party_list(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат избран по партийному списку";
}
relation left_or_expelled_from_party(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат вышел либо исключён из политической партии, от которой избран";
}
relation party_ceased_activity(deputy: Deputy) kind empirical {
    label ru-KZ official "политическая партия, от которой избран депутат, прекратила деятельность";
}
relation elected_in_single_mandate_district(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат избран по одномандатному округу";
}
relation recalled_by_voters(deputy: Deputy) kind empirical {
    label ru-KZ official "депутат отозван избирателями";
}

// --- Ст. 53, 54, 62. Пороги голосования в ДВУХ Палатах ------------------

relation senate_total_deputies(item: Bill, total: Integer) kind empirical {
    label ru-KZ official "общее число депутатов Сената";
}
relation mazhilis_total_deputies(item: Bill, total: Integer) kind empirical {
    label ru-KZ official "общее число депутатов Мажилиса";
}
relation senate_votes(item: Bill, votes: Integer) kind empirical {
    label ru-KZ official "число голосов депутатов Сената, поданных за законопроект";
}
relation mazhilis_votes(item: Bill, votes: Integer) kind empirical {
    label ru-KZ official "число голосов депутатов Мажилиса, поданных за законопроект";
}
relation constitutional_amendment_bill(item: Bill) kind empirical {
    label ru-KZ official "законопроект вносит изменения и дополнения в Конституцию";
}
relation constitutional_law_bill(item: Bill) kind empirical {
    label ru-KZ official "законопроект является проектом конституционного закона";
}
// `ordinary_bill` СНЯТО 02.09.2026: следствие несёт отрицательная сторона (`budget_report_rejected` → вотум недоверия), а принятие обычного закона выражено парой `mazhilis_adopted`/`senate_approved` без классификации законопроекта
relation presidential_proposal(item: Bill) kind empirical {
    label ru-KZ official "Президент определил приоритетность рассмотрения законопроекта";
}
relation constitutional_amendment_adopted_1995(item: Bill) kind institutional {
    label ru-KZ official "изменения и дополнения в Конституцию приняты Парламентом";
}
relation constitutional_law_adopted_1995(item: Bill) kind institutional {
    label ru-KZ official "конституционный закон принят Парламентом";
}
relation readings_held(item: Bill, count: Integer) kind empirical {
    label ru-KZ official "число проведённых чтений по законопроекту";
}
relation reading_requirement_met_1995(item: Bill) kind institutional {
    label ru-KZ official "требование о числе чтений соблюдено";
}

relation presidential_objection(objection: Objection, item: Bill) kind empirical {
    label ru-KZ official "Президент заявил возражения по данному закону";
}
relation objection_reconsidered_within_one_month(objection: Objection) kind empirical {
    label ru-KZ official "повторное обсуждение проведено в месячный срок";
}
relation objection_on_constitutional_law(objection: Objection) kind empirical {
    label ru-KZ official "возражения заявлены по конституционному закону";
}
relation objection_senate_votes(objection: Objection, votes: Integer) kind empirical {
    label ru-KZ official "число голосов Сената при преодолении возражений";
}
relation objection_mazhilis_votes(objection: Objection, votes: Integer) kind empirical {
    label ru-KZ official "число голосов Мажилиса при преодолении возражений";
}
relation objection_senate_total(objection: Objection, total: Integer) kind empirical {
    label ru-KZ official "общее число депутатов Сената при преодолении возражений";
}
relation objection_mazhilis_total(objection: Objection, total: Integer) kind empirical {
    label ru-KZ official "общее число депутатов Мажилиса при преодолении возражений";
}
relation objection_overridden_1995(objection: Objection) kind institutional {
    label ru-KZ official "возражения Президента преодолены Парламентом";
}
relation objections_accepted_1995(objection: Objection) kind institutional {
    label ru-KZ official "возражения Президента считаются принятыми";
}

// `budget_report_confirmed` СНЯТО 02.09.2026: следствие несёт отрицательная сторона (`budget_report_rejected` → вотум недоверия), а принятие обычного закона выражено парой `mazhilis_adopted`/`senate_approved` без классификации законопроекта
relation budget_report_rejected(item: Bill) kind empirical {
    label ru-KZ official "отчёт Правительства об исполнении республиканского бюджета не утверждён";
}
relation no_confidence_expressed_1995(item: Bill) kind institutional {
    label ru-KZ official "неутверждение отчёта означает выражение вотума недоверия Правительству";
}

// --- Ст. 55, 56, 57. Ведение Палат ---------------------------------------

relation appointment_requires_senate_consent(appointment: Appointment) kind empirical {
