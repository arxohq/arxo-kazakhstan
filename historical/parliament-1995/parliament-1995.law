// Эффекты полномочий НЕ совпадают с выводами арифметических правил ст. 53 и
// ст. 56: порог голосов остаётся у своего правила, полномочие отвечает за
// действие палаты. Иначе эффект §127 производил бы принятие акта в обход
// конституционного большинства.
relation constitutional_amendment_introduced_1995(item: Bill) kind institutional {
    label ru-KZ official "изменения и дополнения в Конституцию внесены Парламентом на совместном заседании Палат";
}
relation government_no_confidence_declared_1995(motion: NoConfidenceMotion) kind institutional {
    label ru-KZ official "вотум недоверия Правительству выражен Мажилисом";
}

// =========================================================================
// Конституционные числа. Каждое сверено с закреплённым текстом ст. 50–63.

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert mazhilis_seats_1995(98);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert senate_appointed_by_president_1995(10);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert senate_appointed_on_assembly_proposal_1995(5);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert senate_term_years_1995(6);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert mazhilis_term_years_1995(5);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert senate_rotation_years_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert deputy_residence_years_1995(10);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert senator_minimum_age_1995(30);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert senator_work_experience_years_1995(5);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert senator_regional_residence_years_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
assert mazhilis_deputy_minimum_age_1995(25);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
assert unexcused_absences_limit_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
assert constitutional_law_numerator_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
assert constitutional_law_denominator_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_KK")
assert veto_override_numerator_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_KK")
assert veto_override_denominator_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
assert no_confidence_initiative_numerator_1995(1);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
assert no_confidence_initiative_denominator_1995(5);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_KK")
assert constitutional_court_judges_per_chamber_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
assert first_session_convocation_days_1995(30);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
assert quorum_numerator_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
assert quorum_denominator_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART60_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART60_KK")
assert standing_committees_max_1995(7);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert senate_review_days_1995(60);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert presentation_to_president_days_1995(10);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert priority_bill_months_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert confidence_vote_wait_hours_1995(48);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert confidence_uses_per_year_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
assert amendment_majority_numerator_1995(3);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
assert amendment_majority_denominator_1995(4);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
assert minimum_readings_1995(2);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
assert dissolution_protected_months_1995(6);

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
assert dissolution_cooldown_years_1995(1);

// --- Ст. 49–50. Конститутивные факты и полномочия Парламента -------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART49_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART49_KK")
assert parliament_is_supreme_representative_body_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
assert parliament_has_two_chambers_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
assert parliament_regulates_listed_subjects_1995();

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART49_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART49_KK")
rule ParliamentPowersActive1995(body: Parliament) strict {
    when parliament(body);
    when first_session_opened(body);
    when not new_convocation_first_session_started(body);
    then parliament_powers_active_1995(body);
    label ru-KZ official "Статья 49 пункт 2 (ред. 1995). Полномочия Парламента начинаются с открытия первой сессии и заканчиваются с началом первой сессии Парламента нового созыва";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
rule DualChamberMembershipProhibited1995(deputy: Deputy) strict {
    when deputy_member_of_both_chambers(deputy);
    then dual_membership_prohibited_1995(deputy);
    label ru-KZ official "Статья 50 пункт 4 (ред. 1995). Депутат Парламента не может быть одновременно членом обеих Палат";
}

// --- Ст. 51. Цензы депутатов ----------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
// Принадлежность депутата Палате была объявлена (`deputy_of`, `senate`,
// `mazhilis`) и не читалась ничем: требования к сенатору и к депутату Мажилиса
// брали готовые признаки `seeks_senate_seat` / `seeks_mazhilis_seat`. Два
// правила ниже связывают одно с другим, оставляя прежний путь: место, на
// которое лицо претендует, теперь выводимо из состава Палаты.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
rule SenateSeatFromChamberMembership1995(deputy: Deputy, chamber: Chamber) strict {
    when deputy_of(deputy, chamber);
    when senate(chamber);
    then seeks_senate_seat(deputy);
    label ru-KZ official "Статья 50 пункт 2 (ред. 1995). Депутат, входящий в состав Сената, занимает сенаторское место";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART50_KK")
rule MazhilisSeatFromChamberMembership1995(deputy: Deputy, chamber: Chamber) strict {
    when deputy_of(deputy, chamber);
    when mazhilis(chamber);
    then seeks_mazhilis_seat(deputy);
    label ru-KZ official "Статья 50 пункт 3 (ред. 1995). Депутат, входящий в состав Мажилиса, занимает мажилисовское место";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
rule EligibleSenator1995(
    deputy: Deputy,
    person: Person,
    age: Integer,
    residence: Integer,
    experience: Integer,
    regional: Integer,
) strict {
    when candidate_deputy(deputy, person)
        and seeks_senate_seat(deputy)
        and citizen(person)
        and resides_in_kazakhstan_years(person, residence)
        and age_years(person, age)
        and higher_education(person)
        and work_experience_years(person, experience)
        and resides_in_region_years(person, regional)
        and (residence >= 10)
        and (age >= 30)
        and (experience >= 5)
        and (regional >= 3);
    then eligible_senator_1995(deputy);
    label ru-KZ official "Статья 51 пункт 4 (ред. 1995). Депутатом Сената может быть лицо не моложе тридцати лет с высшим образованием, стажем не менее пяти лет, проживающее в регионе не менее трёх лет и в Республике последние десять лет";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART51_KK")
rule EligibleMazhilisDeputy1995(
    deputy: Deputy,
    person: Person,
    age: Integer,
    residence: Integer,
) strict {
    when candidate_deputy(deputy, person)
        and seeks_mazhilis_seat(deputy)
        and citizen(person)
        and resides_in_kazakhstan_years(person, residence)
        and age_years(person, age)
        and (residence >= 10)
        and (age >= 25);
    then eligible_mazhilis_deputy_1995(deputy);
    label ru-KZ official "Статья 51 пункт 4 (ред. 1995). Депутатом Мажилиса может быть лицо, достигшее двадцати пяти лет, состоящее в гражданстве и проживающее в Республике последние десять лет";
}

// --- Ст. 52. Дисциплина, несовместимости, неприкосновенность --------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputySanctionForAbsenceOrDelegation1995(deputy: Deputy, count: Integer) strict {
    when deputy(deputy)
        and unexcused_absences(deputy, count)
        and (count > 3);
    then deputy_sanction_applies_1995(deputy);
    label ru-KZ official "Статья 52 пункт 2 (ред. 1995). Отсутствие без уважительных причин более трёх раз влечёт применение установленных законом мер взыскания";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyVoteDelegationSanction1995(deputy: Deputy) strict {
    when deputy(deputy);
    when vote_delegated(deputy);
    then deputy_sanction_applies_1995(deputy);
    label ru-KZ official "Статья 52 пункт 2 (ред. 1995). Передача права голоса влечёт применение установленных законом мер взыскания";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyIncompatibilityTerminatesPowers1995(deputy: Deputy) strict {
    when deputy_holds_other_representative_mandate(deputy)
        or deputy_conducts_business(deputy)
        or deputy_in_commercial_governing_body(deputy);
    then deputy_powers_terminated_1995(deputy);
    label ru-KZ official "Статья 52 пункт 3 (ред. 1995). Нарушение запрета совмещения влечёт прекращение полномочий депутата";
}

// Оплачиваемая должность прекращает полномочия, КРОМЕ преподавательской,
// научной и иной творческой: исключение названо Конституцией, поэтому
// выражено отрицательным конъюнктом, а не отдельным правилом-исключением.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyPaidOfficeTerminatesPowers1995(deputy: Deputy) strict {
    when deputy_holds_other_paid_office(deputy);
    when not office_is_teaching_research_or_creative(deputy);
    then deputy_powers_terminated_1995(deputy);
    label ru-KZ official "Статья 52 пункт 3 (ред. 1995). Занятие иной оплачиваемой должности, кроме преподавательской, научной или иной творческой, прекращает полномочия депутата";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyImmunityFromArrest1995(deputy: Deputy) strict {
    when deputy(deputy);
    when arrest_or_prosecution_attempt(deputy);
    when not chamber_consent_given(deputy);
    when not caught_in_the_act_or_grave_crime(deputy);
    then immunity DeputyInviolability1995 {
        holder deputy;
        protected_effect deputy_immunity_infringed_1995(deputy);
    };
    label ru-KZ official "Статья 52 пункт 4 (ред. 1995). Депутат не может быть арестован или привлечён к уголовной ответственности без согласия Палаты, кроме задержания на месте преступления и тяжких преступлений";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyPowersTerminatedOnGeneralGrounds1995(deputy: Deputy) strict {
    when resignation_submitted(deputy)
        or deputy_deceased(deputy)
        or court_declared_incapable_dead_or_missing(deputy);
    then deputy_powers_terminated_1995(deputy);
    label ru-KZ official "Статья 52 пункт 5 (ред. 1995). Полномочия прекращаются при отставке, смерти либо признании судом недееспособным, умершим или безвестно отсутствующим";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyMandateForfeited1995(deputy: Deputy) strict {
    when permanent_departure_from_kazakhstan(deputy)
        or criminal_conviction_in_force(deputy)
        or citizenship_lost(deputy);
    then deputy_mandate_forfeited_1995(deputy);
    label ru-KZ official "Статья 52 пункт 5 (ред. 1995). Депутат лишается мандата при выезде на постоянное жительство за пределы Казахстана, вступлении в силу обвинительного приговора и утрате гражданства";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule MazhilisDeputyPartyMandateForfeited1995(deputy: Deputy) strict {
    when elected_on_party_list(deputy)
        and (left_or_expelled_from_party(deputy)
             or party_ceased_activity(deputy));
    then deputy_mandate_forfeited_1995(deputy);
    label ru-KZ official "Статья 52 пункт 5 (ред. 1995). Депутат Мажилиса лишается мандата при выходе или исключении из партии, по списку которой избран, и при прекращении её деятельности";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule SingleMandateDeputyRecalled1995(deputy: Deputy) strict {
    when elected_in_single_mandate_district(deputy);
    when recalled_by_voters(deputy);
    then deputy_mandate_forfeited_1995(deputy);
    label ru-KZ official "Статья 52 пункт 5 (ред. 1995). Депутат, избранный по одномандатному округу, лишается мандата при отзыве избирателями";
}

// --- Ст. 53, 54, 62. Пороги в ДВУХ Палатах --------------------------------
//
// Здесь и есть несущее институциональное отличие от редакции 2026: каждое
// квалифицированное большинство проверяется ОТДЕЛЬНО по Сенату и по Мажилису.
// В однопалатном Курултае то же требование — одно сравнение.

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
rule ConstitutionalAmendmentAdopted1995(
    item: Bill,
    senate_yes: Integer,
    senate_all: Integer,
    mazhilis_yes: Integer,
    mazhilis_all: Integer,
    readings: Integer,
) strict {
    when constitutional_amendment_bill(item)
        and presidential_proposal(item)
        and readings_held(item, readings)
        and senate_votes(item, senate_yes)
        and senate_total_deputies(item, senate_all)
        and mazhilis_votes(item, mazhilis_yes)
        and mazhilis_total_deputies(item, mazhilis_all)
        and (readings >= 2)
        and (senate_yes * 4 >= senate_all * 3)
        and (mazhilis_yes * 4 >= mazhilis_all * 3);
    then constitutional_amendment_adopted_1995(item);
    label ru-KZ official "Статья 62 пункт 3 (ред. 1995). Изменения и дополнения в Конституцию вносятся большинством не менее трёх четвертей голосов от общего числа депутатов каждой из Палат";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
rule ConstitutionalLawAdopted1995(
    item: Bill,
    senate_yes: Integer,
    senate_all: Integer,
    mazhilis_yes: Integer,
    mazhilis_all: Integer,
    readings: Integer,
) strict {
    when constitutional_law_bill(item)
        and readings_held(item, readings)
        and senate_votes(item, senate_yes)
        and senate_total_deputies(item, senate_all)
        and mazhilis_votes(item, mazhilis_yes)
        and mazhilis_total_deputies(item, mazhilis_all)
        and (readings >= 2)
        and (senate_yes * 3 >= senate_all * 2)
        and (mazhilis_yes * 3 >= mazhilis_all * 2);
    then constitutional_law_adopted_1995(item);
    label ru-KZ official "Статья 62 пункт 4 (ред. 1995). Конституционные законы принимаются большинством не менее двух третей голосов от общего числа депутатов каждой из Палат";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
rule ReadingRequirementMet1995(item: Bill, readings: Integer) strict {
    when (constitutional_amendment_bill(item) or constitutional_law_bill(item))
        and readings_held(item, readings)
        and (readings >= 2);
    then reading_requirement_met_1995(item);
    label ru-KZ official "Статья 62 пункт 6 (ред. 1995). Проведение не менее двух чтений по изменениям Конституции и по проектам конституционных законов обязательно";
}

// Ст. 53 подпункт 1-2: возражения Президента по КОНСТИТУЦИОННОМУ закону
// преодолеваются тремя четвертями каждой Палаты; ст. 54 п. 2 подпункт 2:
// по обычному закону — двумя третями каждой Палаты. Пороги разные, и это
// две разные нормы, а не одна с параметром.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
rule ConstitutionalLawObjectionOverridden1995(
    objection: Objection,
    senate_yes: Integer,
    senate_all: Integer,
    mazhilis_yes: Integer,
    mazhilis_all: Integer,
) strict {
    when objection_on_constitutional_law(objection)
        and objection_reconsidered_within_one_month(objection)
        and objection_senate_votes(objection, senate_yes)
        and objection_senate_total(objection, senate_all)
        and objection_mazhilis_votes(objection, mazhilis_yes)
        and objection_mazhilis_total(objection, mazhilis_all)
        and (senate_yes * 4 >= senate_all * 3)
        and (mazhilis_yes * 4 >= mazhilis_all * 3);
    then objection_overridden_1995(objection);
    label ru-KZ official "Статья 53 подпункт 1-2 (ред. 1995). Возражения Президента по конституционному закону преодолеваются большинством в три четверти голосов от общего числа депутатов каждой из Палат";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_KK")
rule OrdinaryLawObjectionOverridden1995(
    objection: Objection,
    senate_yes: Integer,
    senate_all: Integer,
    mazhilis_yes: Integer,
    mazhilis_all: Integer,
) strict {
    when objection_reconsidered_within_one_month(objection)
        and not objection_on_constitutional_law(objection)
        and objection_senate_votes(objection, senate_yes)
        and objection_senate_total(objection, senate_all)
        and objection_mazhilis_votes(objection, mazhilis_yes)
        and objection_mazhilis_total(objection, mazhilis_all)
        and (senate_yes * 3 >= senate_all * 2)
        and (mazhilis_yes * 3 >= mazhilis_all * 2);
    then objection_overridden_1995(objection);
    label ru-KZ official "Статья 54 пункт 2 подпункт 2 (ред. 1995). Возражения Президента по закону преодолеваются большинством в две трети голосов от общего числа депутатов каждой из Палат";
}

// Несоблюдение месячного срока ОЗНАЧАЕТ принятие возражений — это прямая
// норма текста, а не молчаливый вывод из отсутствия голосования.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART54_KK")
rule ObjectionsAcceptedOnMissedDeadline1995(objection: Objection, item: Bill) strict {
    when presidential_objection(objection, item);
    when not objection_reconsidered_within_one_month(objection);
    then objections_accepted_1995(objection);
    label ru-KZ official "Статья 54 пункт 2 подпункт 2 (ред. 1995). Несоблюдение месячного срока означает принятие возражений Президента";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
rule BudgetReportRejectionIsNoConfidence1995(item: Bill) strict {
    when budget_report_rejected(item);
    then no_confidence_expressed_1995(item);
    label ru-KZ official "Статья 53 подпункт 2 (ред. 1995). Неутверждение отчёта Правительства об исполнении республиканского бюджета означает выражение вотума недоверия Правительству";
}

// --- Ст. 55, 56, 57. Ведение Палат ----------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_KK")
rule SenateConsentAppointment1995(appointment: Appointment) strict {
    when appointment_requires_senate_consent(appointment);
    when senate_consent_given(appointment);
    then appointment_effective_1995(appointment);
    label ru-KZ official "Статья 55 подпункт 2 (ред. 1995). Сенат даёт согласие на назначение Председателя Конституционного Суда, Председателя Национального Банка, Председателя Высшего Судебного Совета, Генерального Прокурора и Председателя КНБ";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_KK")
rule SenateActsForParliament1995 strict {
    when mazhilis_absent_after_early_termination();
    then senate_exercises_parliament_functions_1995();
    label ru-KZ official "Статья 55 подпункт 5 (ред. 1995). Сенат выполняет функции Парламента по принятию законов в период временного отсутствия Мажилиса";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
rule MazhilisConsentToPrimeMinister1995(
    appointment: Appointment,
    votes: Integer,
    total: Integer,
) strict {
    when pm_consent_request(appointment)
        and mazhilis_consent_votes(appointment, votes)
        and mazhilis_consent_total(appointment, total)
        and (votes * 2 > total);
    then pm_consent_given_1995(appointment);
    label ru-KZ official "Статья 56 пункт 1 подпункт 2 (ред. 1995). Мажилис большинством голосов от общего числа депутатов Палаты даёт согласие Президенту на назначение Премьер-Министра";
}

// Ст. 56 п. 2: инициатива — не менее ОДНОЙ ПЯТОЙ депутатов Мажилиса.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
rule NoConfidenceMotionValid1995(
    motion: NoConfidenceMotion,
    government: Government,
    initiators: Integer,
    total: Integer,
) strict {
    when no_confidence_motion(motion, government)
        and motion_initiating_deputies(motion, initiators)
        and motion_mazhilis_total(motion, total)
        and (initiators * 5 >= total);
    then no_confidence_motion_valid_1995(motion);
    label ru-KZ official "Статья 56 пункт 2 (ред. 1995). Вотум недоверия выражается по инициативе не менее одной пятой от общего числа депутатов Мажилиса";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
rule GovernmentNoConfidence1995(
    motion: NoConfidenceMotion,
    government: Government,
    votes: Integer,
    total: Integer,
) strict {
    when no_confidence_motion_valid_1995(motion)
        and no_confidence_motion(motion, government)
        and motion_supporting_votes(motion, votes)
        and motion_mazhilis_total(motion, total)
        and (votes * 2 > total);
    then government_no_confidence_1995(government);
    label ru-KZ official "Статья 56 пункт 2 (ред. 1995). Мажилис большинством голосов от общего числа депутатов вправе выразить вотум недоверия Правительству";
}

// Ст. 57 подпункт 6: инициатива одной трети, обращение — двумя третями, и
// освобождение члена Правительства становится ОБЯЗАННОСТЬЮ Президента
// («В этом случае Президент освобождает»), а не его усмотрением.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_KK")
rule MinisterHearingInitiativeValid1995(
    motion: NoConfidenceMotion,
    votes: Integer,
    total: Integer,
) strict {
    when minister_report_hearing(motion)
        and hearing_initiating_votes(motion, votes)
        and hearing_chamber_total(motion, total)
        and (votes * 3 >= total);
    then hearing_initiative_valid_1995(motion);
    label ru-KZ official "Статья 57 подпункт 6 (ред. 1995). Палата вправе по инициативе не менее одной трети от общего числа своих депутатов заслушивать отчёты членов Правительства";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_KK")
rule AddressToPresidentValid1995(
    motion: NoConfidenceMotion,
    votes: Integer,
    total: Integer,
) strict {
    when hearing_initiative_valid_1995(motion)
        and minister_failed_to_execute_laws(motion)
        and address_supporting_votes(motion, votes)
        and hearing_chamber_total(motion, total)
        and (votes * 3 >= total * 2);
    then address_to_president_valid_1995(motion);
    label ru-KZ official "Статья 57 подпункт 6 (ред. 1995). Обращение к Президенту об освобождении члена Правительства принимается большинством не менее двух третей голосов от общего числа депутатов Палаты";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART57_KK")
rule MinisterReleaseRequired1995(motion: NoConfidenceMotion) strict {
    when address_to_president_valid_1995(motion);
    then minister_release_required_1995(motion);
    label ru-KZ official "Статья 57 подпункт 6 (ред. 1995). В этом случае Президент Республики освобождает от должности члена Правительства";
}

// --- Ст. 58. Председатели Палат -------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART58_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART58_KK")
rule SenateChairElected1995(
    chair: ChamberChair,
    person: Person,
    votes: Integer,
    total: Integer,
) strict {
    when chair_of_senate(chair)
        and chair_candidate(chair, person)
        and fluent_in_state_language(person)
        and nominated_by_president(chair)
        and chair_election_votes(chair, votes)
        and chair_chamber_total(chair, total)
        and (votes * 2 > total);
    then chair_elected_1995(chair);
    label ru-KZ official "Статья 58 пункт 1 (ред. 1995). Кандидатура Председателя Сената выдвигается Президентом; избрание — тайным голосованием большинством голосов от общего числа депутатов Палаты";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART58_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART58_KK")
rule MazhilisChairElected1995(
    chair: ChamberChair,
    person: Person,
    votes: Integer,
    total: Integer,
) strict {
    when chair_of_mazhilis(chair)
        and chair_candidate(chair, person)
        and fluent_in_state_language(person)
        and nominated_by_deputies(chair)
        and chair_election_votes(chair, votes)
        and chair_chamber_total(chair, total)
        and (votes * 2 > total);
    then chair_elected_1995(chair);
    label ru-KZ official "Статья 58 пункт 1 (ред. 1995). Кандидатуры Председателя Мажилиса выдвигаются депутатами Палаты; избрание — большинством голосов от общего числа депутатов";
}

// --- Ст. 59, 60. Сессии, кворум, комитеты ---------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
// Тридцатидневный срок ст. 59 п. 2 СЧИТАЕТСЯ, а не сообщается делом. Прежде
// его нёс единственный булев признак `first_session_within_thirty_days`, а
// закреплённые даты (`election_results_published`, `first_session_convened`) и
// само число дней не читались ничем: дело сообщало вывод, ради которого норма
// существует. Правило-двойник редакции 2026 (`FirstSessionThirtyDays`) считает,
// и здесь теперь тоже. Булев путь оставлен рядом: он не обязывает дело
// приносить обе даты, когда они неизвестны, — но больше не единственный.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule FirstSessionThirtyDaysComputed1995(
    sitting: Session,
    published: Date,
    convened: Date,
    limit_days: Integer,
) strict {
    when election_results_published(sitting, published)
        and first_session_convened(sitting, convened)
        and first_session_convocation_days_1995(limit_days)
        and (days_between(published, convened) <= limit_days);
    then first_session_timely_1995(sitting);
    label ru-KZ official "Статья 59 пункт 2 (ред. 1995). Первая сессия Парламента созывается не позднее тридцати дней со дня опубликования итогов выборов";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule FirstSessionTimely1995(sitting: Session) strict {
    when first_session_within_thirty_days(sitting);
    then first_session_timely_1995(sitting);
    label ru-KZ official "Статья 59 пункт 2 (ред. 1995). Первая сессия Парламента созывается Президентом не позднее тридцати дней со дня опубликования итогов выборов";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule ExtraordinarySessionByChairs1995(sitting: Session) strict {
    when extraordinary_session_request(sitting);
    when request_by_chamber_chairs(sitting);
    then extraordinary_session_valid_1995(sitting);
    label ru-KZ official "Статья 59 пункт 4 (ред. 1995). Внеочередная сессия может быть созвана по предложению председателей Палат";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule ExtraordinarySessionByThird1995(sitting: Session, votes: Integer, total: Integer) strict {
    when extraordinary_session_request(sitting)
        and request_initiating_votes(sitting, votes)
        and parliament_total_deputies(sitting, total)
        and (votes * 3 >= total);
    then extraordinary_session_valid_1995(sitting);
    label ru-KZ official "Статья 59 пункт 4 (ред. 1995). Внеочередная сессия может быть созвана по предложению не менее одной трети от общего числа депутатов Парламента";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule ExtraordinaryAgendaLimited1995(sitting: Session) strict {
    when extraordinary_session_valid_1995(sitting);
    then extraordinary_agenda_limited_1995(sitting);
    label ru-KZ official "Статья 59 пункт 4 (ред. 1995). На внеочередной сессии могут рассматриваться лишь вопросы, послужившие основанием для её созыва";
}

// Кворум ст. 59 п. 5 — две трети В КАЖДОЙ Палате, а не от общего числа
// депутатов Парламента.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART59_KK")
rule SittingQuorate1995(
    seating: Sitting,
    senate_here: Integer,
    senate_all: Integer,
    mazhilis_here: Integer,
    mazhilis_all: Integer,
) strict {
    when joint_or_separate_sitting(seating)
        and senate_present(seating, senate_here)
        and senate_seats(seating, senate_all)
        and mazhilis_present(seating, mazhilis_here)
        and mazhilis_seats(seating, mazhilis_all)
        and (senate_here * 3 >= senate_all * 2)
        and (mazhilis_here * 3 >= mazhilis_all * 2);
    then sitting_quorate_1995(seating);
    label ru-KZ official "Статья 59 пункт 5 (ред. 1995). Заседания Палат проводятся при присутствии не менее двух третей от общего числа депутатов каждой из Палат";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART60_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART60_KK")
rule CommitteeCountAdmissible1995(chamber: Chamber, count: Integer) strict {
    when standing_committees(chamber, count)
        and (count <= 7);
    then committee_count_admissible_1995(chamber);
    label ru-KZ official "Статья 60 пункт 1 (ред. 1995). Число постоянных комитетов не превышает семи в каждой Палате";
}

// --- Ст. 61. Законодательная процедура -------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule LegislativeInitiativeValid1995(item: Bill) strict {
    when (legislative_initiative_by_president(item)
          or legislative_initiative_by_deputy(item)
          or legislative_initiative_by_government(item))
        and introduced_in_mazhilis(item);
    then legislative_initiative_valid_1995(item);
    label ru-KZ official "Статья 61 пункт 1 (ред. 1995). Право законодательной инициативы принадлежит Президенту, депутатам Парламента и Правительству и реализуется исключительно в Мажилисе";
}

// Ст. 61 п. 6: заключение Правительства требуется, КРОМЕ законопроектов
// президентской инициативы — исключение названо Конституцией.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule FiscalBillRequiresGovernmentOpinion1995(item: Bill) strict {
    when reduces_revenue_or_increases_expenditure(item);
    when positive_government_opinion(item);
    then bill_admissible_1995(item);
    label ru-KZ official "Статья 61 пункт 6 (ред. 1995). Проекты, сокращающие доходы или увеличивающие расходы, могут быть внесены лишь при положительном заключении Правительства";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule PresidentialFiscalBillExempt1995(item: Bill) strict {
    when reduces_revenue_or_increases_expenditure(item);
    when legislative_initiative_by_president(item);
    then bill_admissible_1995(item);
    label ru-KZ official "Статья 61 пункт 6 (ред. 1995). Для законопроектов президентской инициативы заключение Правительства не требуется";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule ApprovedLawPresentedToPresident1995(item: Bill) strict {
    when mazhilis_adopted(item);
    when senate_approved(item);
    then presented_to_president_1995(item);
    label ru-KZ official "Статья 61 пункт 4 (ред. 1995). Закон, одобренный большинством голосов от общего числа депутатов Сената, в течение десяти дней представляется Президенту на подпись";
}

// Молчание Сената свыше шестидесяти дней ИМЕЕТ последствие по тексту: закон
// уходит Президенту. Это норма, а не вывод из отсутствия факта.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule SenateSilencePresentsLaw1995(item: Bill) strict {
    when mazhilis_adopted(item);
    when senate_review_days_elapsed(item);
    when senate_took_no_decision(item);
    then presented_to_president_1995(item);
    label ru-KZ official "Статья 61 пункт 4 (ред. 1995). Если Сенат в течение шестидесяти дней не принял решения, закон представляется Президенту на подпись";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule RejectedBillReturnedToInitiator1995(item: Bill) strict {
    when mazhilis_rejected_bill(item);
    then bill_returned_to_initiator_1995(item);
    label ru-KZ official "Статья 61 пункт 4 (ред. 1995). Отклонённый Мажилисом законопроект считается непринятым и возвращается инициатору";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule MazhilisConfirmsEarlierVersion1995(item: Bill, votes: Integer, total: Integer) strict {
    when conciliation_version(item)
        and mazhilis_repeat_votes(item, votes)
        and mazhilis_total_deputies(item, total)
        and (votes * 3 >= total * 2);
    then mazhilis_confirmed_earlier_version_1995(item);
    label ru-KZ official "Статья 61 пункт 5 (ред. 1995). Если при повторном голосовании Мажилис большинством в две трети голосов подтвердит ранее принятое решение, закон представляется Президенту на подпись";
}

// Ст. 61 п. 7: вопрос о доверии. Сорок восемь часов и «не более двух раз в
// год» — конституционные числа редакции 1995.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule BillAdoptedWithoutVoteOnConfidence1995(
    question: ConfidenceQuestion,
    government: Government,
    uses: Integer,
) strict {
    when confidence_question(question, government)
        and confidence_vote_after_48_hours(question)
        and no_confidence_failed_in_both_chambers(question)
        and confidence_uses_this_year(government, uses)
        and (uses <= 2);
    then bill_adopted_without_vote_1995(question);
    label ru-KZ official "Статья 61 пункт 7 (ред. 1995). Если предложение о вотуме недоверия не наберёт большинства голосов от общего числа депутатов каждой из Палат, проект закона считается принятым без голосования";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART61_KK")
rule ConfidenceRightExhausted1995(government: Government, uses: Integer) strict {
    when confidence_uses_this_year(government, uses)
        and (uses > 2);
    then confidence_right_exhausted_1995(government);
    label ru-KZ official "Статья 61 пункт 7 (ред. 1995). Правительство не может пользоваться этим правом более двух раз в год";
}

// --- Ст. 62. Акты Парламента ------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
rule LawInForceAfterPresidentialSignature1995(item: Statute) strict {
    when parliamentary_act(item);
    when act_signed_by_president(item);
    then act_in_force_1995(item);
    label ru-KZ official "Статья 62 пункт 2 (ред. 1995). Законы Республики вступают в силу после их подписания Президентом Республики";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART62_KK")
rule ActContradictingConstitutionInvalid1995(item: Statute) strict {
    when parliamentary_act(item);
    when act_contradicts_constitution(item);
    then act_invalid_1995(item);
    label ru-KZ official "Статья 62 пункт 7 (ред. 1995). Законы Республики, постановления Парламента и его Палат не должны противоречить Конституции";
}

// --- Ст. 63. Роспуск ---------------------------------------------------------

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule DissolutionAdmissible1995(dissolution: Dissolution) strict {
    when dissolution_attempt(dissolution);
    when dissolution_consultations_completed(dissolution);
    when not emergency_or_martial_law_active();
    when not last_six_months_of_presidential_term();
    when not within_one_year_after_prior_dissolution();
    then dissolution_admissible_1995(dissolution);
    label ru-KZ official "Статья 63 (ред. 1995). Президент после консультаций с председателями Палат и Премьер-Министром может распустить Парламент или Мажилис вне защищённых периодов";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule DissolutionBarred1995(dissolution: Dissolution) strict {
    when dissolution_attempt(dissolution)
        and (emergency_or_martial_law_active()
             or last_six_months_of_presidential_term()
             or within_one_year_after_prior_dissolution());
    then dissolution_barred_1995(dissolution);
    label ru-KZ official "Статья 63 пункт 2 (ред. 1995). Парламент и Мажилис не могут быть распущены в период чрезвычайного или военного положения, в последние шесть месяцев полномочий Президента и в течение одного года после предыдущего роспуска";
}

// --- Деонтический слой §§127–128 (13.09.2026) -------------------------------

// Ст. 63 п. 1: полномочие Президента распустить Парламент либо Мажилис.
// Условие действительности — консультации с председателями Палат и
// Премьер-Министром; это отдельный факт дела, и недействительное
// осуществление здесь выразимо.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule ParliamentDissolutionPower1995(
    authority: President,
    body: Parliament,
    dissolution: Dissolution,
) strict {
    when president_1995(authority);
    when parliament(body);
    when dissolution_of(dissolution, body);
    then power DissolveParliament1995 {
        holder authority;
        exercise dissolution_attempt(dissolution);
        valid_when dissolution_consultations_completed(dissolution);
        effect parliament_dissolved_1995(body);
    };
    label ru-KZ official "Статья 63 пункт 1 (ред. 1995). Президент Республики после консультаций с председателями Палат Парламента и Премьер-Министром может распустить Парламент или Мажилис Парламента";
}

// Ст. 63 п. 2 перечисляет ТРИ основания через запятую. Одна инлайн-норма на
// три правила дала бы `A3 StableId collision` на lowering (`lawc check`
// коллизии не видит), поэтому норма названа ПО ОСНОВАНИЮ — ответ заодно
// называет, чем именно защищён Парламент.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule DissolutionBarrierEmergency1995(body: Parliament) strict {
    when parliament(body);
    when emergency_or_martial_law_active();
    then immunity NoDissolutionInEmergency1995 {
        holder body;
        protected_effect parliament_dissolved_1995(body);
    };
    label ru-KZ official "Статья 63 пункт 2 (ред. 1995). Парламент и Мажилис Парламента не могут быть распущены в период чрезвычайного или военного положения";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule DissolutionBarrierLastSixMonths1995(body: Parliament) strict {
    when parliament(body);
    when last_six_months_of_presidential_term();
    then immunity NoDissolutionInLastSixMonths1995 {
        holder body;
        protected_effect parliament_dissolved_1995(body);
    };
    label ru-KZ official "Статья 63 пункт 2 (ред. 1995). Парламент и Мажилис Парламента не могут быть распущены в последние шесть месяцев полномочий Президента";
}

@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART63_KK")
rule DissolutionBarrierWithinYear1995(body: Parliament) strict {
    when parliament(body);
    when within_one_year_after_prior_dissolution();
    then immunity NoDissolutionWithinYearAfterPrior1995 {
        holder body;
        protected_effect parliament_dissolved_1995(body);
    };
    label ru-KZ official "Статья 63 пункт 2 (ред. 1995). Парламент и Мажилис Парламента не могут быть распущены в течение одного года после предыдущего роспуска";
}

priority ProtectedPeriodOverDissolutionEmergency1995: DissolutionBarrierEmergency1995 > ParliamentDissolutionPower1995 reason lex_specialis;

priority ProtectedPeriodOverDissolutionLastMonths1995: DissolutionBarrierLastSixMonths1995 > ParliamentDissolutionPower1995 reason lex_specialis;

priority ProtectedPeriodOverDissolutionAfterPrior1995: DissolutionBarrierWithinYear1995 > ParliamentDissolutionPower1995 reason lex_specialis;

// Ст. 52 п. 4 — вторая сторона уже заведённого иммунитета депутата: без
// полномочия, производящего защищённый эффект, `DeputyInviolability1995`
// внутри пакета был неатакуем. Условие действительности названо самим
// пунктом — согласие соответствующей Палаты.
//
// ИЗМЕРЕНО, А НЕ ПРЕДПОЛОЖЕНО (тест kzq95-6): issue EFFECT_BLOCKED_BY_IMMUNITY
// у этой пары НЕДОСТИЖИМ, и это свойство самой нормы, а не пробел набора.
// Посылки иммунитета — `not chamber_consent_given` и `not caught_in_the_act…` —
// в точности отрицают условие действительности полномочия, поэтому защита и
// действительное осуществление не сосуществуют ни в одном деле: где согласие
// есть, иммунитета нет, а где его нет, осуществление недействительно и
// эффекту нечего блокировать. Наблюдаемая пара здесь — POWER_INVALID_EXERCISE
// и наступивший эффект. По той же причине приоритет §116 между этими двумя
// правилами НЕ объявлен: он не сработал бы ни разу.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART52_KK")
rule DeputyProsecutionPower1995(authority: StateAuthority, deputy: Deputy) strict {
    when state_authority(authority);
    when deputy(deputy);
    then power ProsecuteDeputy1995 {
        holder authority;
        exercise deputy_prosecution_attempt(authority, deputy);
        valid_when chamber_consent_given(deputy);
        effect deputy_immunity_infringed_1995(deputy);
    };
    label ru-KZ official "Статья 52 пункт 4 (ред. 1995). Депутат Парламента в течение срока своих полномочий не может быть арестован, привлечён к уголовной ответственности без согласия соответствующей Палаты";
}

// Ст. 55 подпункт 1: Сенат избирает Председателя и судей Верховного Суда ПО
// ПРЕДСТАВЛЕНИЮ Президента — представление и есть условие действительности.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_KK")
rule SenateSupremeCourtElectionPower1995(chamber: Chamber, appointment: Appointment) strict {
    when senate(chamber);
    when supreme_court_office_appointment(appointment);
    then power ElectSupremeCourtJudge1995 {
        holder chamber;
        exercise senate_election_attempt(chamber, appointment);
        valid_when presidential_submission_for_office(appointment);
        effect appointment_effective_1995(appointment);
    };
    label ru-KZ official "Статья 55 подпункт 1 (ред. 1995). К исключительному ведению Сената относится избрание и освобождение от должности по представлению Президента Республики Председателя Верховного Суда и судей Верховного Суда";
}

// Ст. 55 подпункт 1-1: та же форма, отдельная должность и отдельный срок.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART55_KK")
rule SenateOmbudsmanElectionPower1995(chamber: Chamber, appointment: Appointment) strict {
    when senate(chamber);
    when ombudsman_office_appointment(appointment);
    then power ElectOmbudsman1995 {
        holder chamber;
        exercise senate_election_attempt(chamber, appointment);
        valid_when presidential_submission_for_office(appointment);
        effect appointment_effective_1995(appointment);
    };
    label ru-KZ official "Статья 55 подпункт 1-1 (ред. 1995). К исключительному ведению Сената относится по представлению Президента Республики избрание на должность сроком на пять лет и освобождение от должности Уполномоченного по правам человека";
}

// Ст. 53 подпункт 5: решение принимается ПО ПРЕДЛОЖЕНИЮ Президента.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
rule ArmedForcesDeploymentPower1995(body: Parliament, deployment: ArmedForcesDeployment) strict {
    when parliament(body);
    when armed_forces_deployment(deployment);
    then power DecideArmedForcesDeployment1995 {
        holder body;
        exercise armed_forces_deployment_attempt(body, deployment);
        valid_when presidential_armed_forces_proposal(deployment);
        effect armed_forces_deployment_decided_1995(deployment);
    };
    label ru-KZ official "Статья 53 подпункт 5 (ред. 1995). Парламент на совместном заседании Палат принимает по предложению Президента Республики решение об использовании Вооружённых Сил Республики для выполнения международных обязательств по поддержанию мира и безопасности";
}

// Ст. 53 подпункт 1: учредительная инициатива принадлежит Президенту, а не
// самому Парламенту. Порог трёх четвертей остаётся у `ConstitutionalAmendmentAdopted1995`.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART53_KK")
rule ConstitutionalAmendmentPower1995(body: Parliament, item: Bill) strict {
    when parliament(body);
    when constitutional_amendment_bill(item);
    then power IntroduceConstitutionalAmendment1995 {
        holder body;
        exercise amendment_adoption_attempt(body, item);
        valid_when presidential_amendment_proposal(item);
        effect constitutional_amendment_introduced_1995(item);
    };
    label ru-KZ official "Статья 53 подпункт 1 (ред. 1995). Парламент на совместном заседании Палат по предложению Президента Республики Казахстан вносит изменения и дополнения в Конституцию";
}

// Ст. 56 п. 2: условие действительности — инициатива не менее одной пятой
// депутатов, выводимая `NoConfidenceMotionValid1995`.
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_RU")
@source("urn:kz:constitution:sources#KZ_CONSTITUTION_1995_ART56_KK")
rule NoConfidencePower1995(
    chamber: Chamber,
    motion: NoConfidenceMotion,
    government: Government,
) strict {
    when mazhilis(chamber);
    when no_confidence_motion(motion, government);
    then power ExpressNoConfidence1995 {
        holder chamber;
        exercise no_confidence_vote_attempt(chamber, motion);
        valid_when no_confidence_motion_valid_1995(motion);
        effect government_no_confidence_declared_1995(motion);
    };
    label ru-KZ official "Статья 56 пункт 2 (ред. 1995). Мажилис большинством голосов от общего числа депутатов Мажилиса по инициативе не менее одной пятой от общего числа депутатов Мажилиса вправе выразить вотум недоверия Правительству";
}
